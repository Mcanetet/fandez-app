<%- include('../partials/head', { bodyClass: 'admin-page' }) %>

<div class="max-w-5xl mx-auto min-h-screen flex flex-col zilo-page-enter">
  <header class="sticky top-0 z-50 bg-zilo-bg/95 backdrop-blur-xl border-b border-zilo-border px-5 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="<%= typeof adminBase !== 'undefined' ? adminBase : '/admin' %>" class="zilo-icon-btn" title="Volver al admin">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </a>
        <div>
          <span class="zilo-label !text-[9px]">Admin</span>
          <h1 class="text-base font-semibold">Configuración de precios</h1>
        </div>
      </div>
      <a href="/logout" class="zilo-icon-btn" title="Cerrar sesión">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
      </a>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-10">
    <% if (typeof query !== 'undefined' && query.ok) { %>
      <div class="mb-4 p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-sm text-emerald-700">Precios actualizados correctamente.</div>
    <% } %>

    <!-- Test Visa / marcas MP: arriba del todo para no perderse entre precios -->
    <section id="mpVisaTestBox" class="mb-5 p-4 rounded-2xl border-2 border-amber-400 bg-amber-50 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-wide text-amber-900 mb-1">Test Visa · Mercado Pago</p>
      <h2 class="text-base font-semibold text-amber-950 mb-2">¿Tu cuenta acepta Visa?</h2>
      <p class="text-xs text-amber-950/80 mb-3">Consulta <code class="text-[11px]">GET /v1/payment_methods</code> con el Access Token activo. Soporte MP pide: <strong>id + status + payment_type_id</strong> de Visa, Mastercard y Amex (prueba y producción).</p>
      <p class="text-sm text-gray-800 mb-2" id="mpCredProfileLine">Cargando perfil…</p>
      <p class="text-sm font-medium text-gray-900 mb-2" id="mpCardBrandsLine">Marcas tarjeta: cargando…</p>
      <pre id="mpBrandAuditBox" class="hidden text-[11px] leading-relaxed p-3 rounded-xl bg-white border border-amber-200 text-gray-800 overflow-x-auto mb-3 whitespace-pre-wrap"></pre>
      <div class="flex flex-wrap gap-2 mb-2">
        <button type="button" class="btn-mp-phase text-[11px] px-2.5 py-1.5 rounded-lg border border-amber-500 bg-white font-semibold" data-phase="demo">Credenciales de prueba</button>
        <button type="button" class="btn-mp-phase text-[11px] px-2.5 py-1.5 rounded-lg border border-emerald-600 bg-white font-semibold" data-phase="productivo">Credenciales de producción</button>
        <a id="mpPaymentMethodsJsonLink" href="<%= typeof adminBase !== 'undefined' ? adminBase : '/admin' %>/mp/payment-methods" target="_blank" rel="noopener" class="text-[11px] px-2.5 py-1.5 rounded-lg border border-zilo-accent/40 text-zilo-accent font-semibold">Abrir JSON completo</a>
      </div>
      <p class="text-[10px] text-amber-900/70">También: Admin (icono $ Precios) → esta caja amarilla al inicio. URL directa: <code class="text-[10px]">/admin/precios#mpVisaTestBox</code></p>
    </section>

    <form method="POST" action="<%= typeof adminBase !== 'undefined' ? adminBase : '/admin' %>/precios" id="pricingForm" class="space-y-5">
      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-4">Tarifas base</h2>
        <div class="grid grid-cols-1 gap-3">
          <div>
            <label class="text-xs text-gray-500">Visita diagnóstico mínima (CLP)</label>
            <input type="number" name="visitPrice" value="<%= pricing.visitPrice %>" min="19990" step="10" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Total al cliente (IVA incluido). Soft launch Plan A: solo diagnóstico $19.990. Mínimo técnico $19.990.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Precio base del trabajo (CLP)</label>
            <input type="number" name="servicePrice" value="<%= pricing.servicePrice %>" min="80000" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Fallback del cálculo dinámico (mín. $80.000 IVA incl.). Los SKUs del catálogo tienen prioridad. Precios = total cliente IVA incluido.</p>
          </div>
        </div>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-1">Cancelaciones</h2>
        <p class="text-xs text-gray-500 mb-4">Monto retenido al cancelar (CLP). Devolución = visita pagada − retención. Escala según avance del servicio.</p>
        <% const cancelCfg = pricing.cancellations || { beforeAccepted: 0, afterTechAccepted: 0, enRoute: 10000, onSiteVerified: 15000, afterDiagnosis: 20000 }; %>
        <div class="grid grid-cols-1 gap-3">
          <div>
            <label class="text-xs text-gray-500">Antes de que el técnico acepte</label>
            <input type="number" name="cancelBeforeAccepted" value="<%= cancelCfg.beforeAccepted %>" min="0" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Búsqueda, programada o asignado pendiente. Default $0.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Técnico aceptó (aún no en camino)</label>
            <input type="number" name="cancelAfterTechAccepted" value="<%= cancelCfg.afterTechAccepted %>" min="0" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Default $0 — el cargo empieza en camino.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Técnico en camino</label>
            <input type="number" name="cancelEnRoute" value="<%= cancelCfg.enRoute != null ? cancelCfg.enRoute : 10000 %>" min="0" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">También aplica si llegó al domicilio pero aún no validó el código. Default $10.000.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Llegó y validó código de verificación</label>
            <input type="number" name="cancelOnSiteVerified" value="<%= cancelCfg.onSiteVerified != null ? cancelCfg.onSiteVerified : 15000 %>" min="0" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Default $15.000.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Después del diagnóstico</label>
            <input type="number" name="cancelAfterDiagnosis" value="<%= cancelCfg.afterDiagnosis != null ? cancelCfg.afterDiagnosis : (cancelCfg.enRouteOrOnSite || 20000) %>" min="0" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Diagnóstico, reparación, presupuesto, materiales. Default $20.000.</p>
          </div>
        </div>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-1">Referidos (crédito)</h2>
        <p class="text-xs text-gray-500 mb-4">
          El programa se enciende/apaga en <strong>Admin → Módulos → Referidos e invitaciones</strong> (ahora OFF).
          Aquí solo defines el monto cuando lo reactives.
        </p>
        <% const refCfg = pricing.referrals || { creditCLP: 5000, referrerPoints: 200 }; %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="text-xs text-gray-500">Crédito por referido (CLP)</label>
            <input type="number" name="referralCreditClp" value="<%= refCfg.creditCLP %>" min="0" step="1000" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Se acredita al invitador y al invitado al usar el código. Default $5.000.</p>
          </div>
          <div>
            <label class="text-[10px] text-gray-500">Puntos al invitador (si Puntos Fandez está ON)</label>
            <input type="number" name="referralReferrerPoints" value="<%= refCfg.referrerPoints %>" min="0" step="10" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Bonus de puntos al socio/cliente que invita. Default 200.</p>
          </div>
        </div>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-4">Comisiones y liquidación al socio</h2>
        <p class="text-xs text-gray-500 mb-4">
          El cliente paga <strong>un solo precio</strong> (IVA incluido). No le sumamos recargo de tarjeta.
          Fandez recauda el 100% y al socio se descuenta: <strong>15% de la app (IVA incluido)</strong>
          + <strong>costo Mercado Pago a valor presente</strong>. Materiales al socio al 100%.
        </p>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="text-xs text-gray-500">Comisión app — mano de obra (%)</label>
            <input type="number" name="laborCommissionPercent" value="<%= Math.round(pricing.laborCommissionRate * 1000) / 10 %>" min="0" max="100" step="0.1" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Default 15%. IVA incluido: no se le suma 19% encima.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Comisión app — materiales</label>
            <input type="hidden" name="materialsCommissionPercent" value="0">
            <div class="zilo-input w-full mt-1 text-gray-500 bg-gray-50">0% · a costo</div>
            <p class="text-[10px] text-gray-400 mt-1">El material se entrega íntegro al socio.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Mercado Pago online, 1 cuota (% sin IVA)</label>
            <input type="number" name="mpOnlineRatePercent" value="<%= pricing.mpOnlineRatePercent != null ? pricing.mpOnlineRatePercent : 3.19 %>" min="0" max="20" step="0.01" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Publicado MP Chile ~3,19%. Con IVA 19% ≈ <%= (Number(pricing.merchantCardFeePercent) || 3.8).toFixed(2) %>% efectivo al contado.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">IVA para desglose y fee MP (%)</label>
            <input type="number" name="ivaPercent" value="<%= Math.round((pricing.ivaRate != null ? pricing.ivaRate : 0.19) * 100) %>" min="0" max="100" step="1" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Solo desglose contable + para calcular el costo MP. No se cobra extra al cliente ni se apila sobre el 15%.</p>
          </div>
        </div>
        <p class="text-[11px] text-gray-500 mt-3">
          Ejemplo $100.000 de mano de obra con tarjeta 1 cuota:
          app $12.000 + MP ≈ $3.796 → socio $84.204.
          Si el cliente paga en más cuotas, MP descuenta más (valor presente) y eso también sale del socio, no del cliente.
        </p>
        <% const pvExtra = pricing.mpPresentValueExtra || {}; %>
        <p class="text-xs font-medium text-gray-600 mt-4 mb-2">Extra valor presente MP (% sin IVA, sobre la tasa online)</p>
        <div class="grid grid-cols-5 gap-2">
          <% [1, 3, 6, 9, 12].forEach((cuotas) => { %>
            <div>
              <label class="text-[10px] text-gray-400"><%= cuotas %> cuota<%= cuotas > 1 ? 's' : '' %></label>
              <input type="number" name="mpPvExtra<%= cuotas %>" value="<%= Math.round((Number(pvExtra[cuotas]) || 0) * 10000) / 100 %>" min="0" max="40" step="0.1" class="zilo-input w-full mt-1">
            </div>
          <% }); %>
        </div>
        <p class="text-[10px] text-gray-400 mt-1">1 cuota = 0. En 3/6/9/12 MP deja menos plata hoy; ese extra se descuenta al socio. Ajústalo si cambia la tabla de MP Chile.</p>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-4">Pagos</h2>
        <div class="grid grid-cols-1 gap-3 mb-4">
          <div>
            <p class="text-sm text-gray-700">Recargo tarjeta al cliente: <strong>0%</strong></p>
            <input type="hidden" name="cardSurchargePercent" value="0">
            <p class="text-[10px] text-gray-400 mt-1">El cliente no paga recargo por tarjeta. El costo MP se descuenta al socio.</p>
          </div>
          <div>
            <label class="text-xs text-gray-500">Máximo de cuotas en crédito</label>
            <select name="maxCardInstallments" class="zilo-input w-full mt-1">
              <% [1, 3, 6, 9, 12].forEach((n) => { %>
                <option value="<%= n %>" <%= Number(pricing.maxCardInstallments) === n ? 'selected' : '' %>>
                  <%= n === 1 ? 'Solo 1 pago (sin cuotas)' : `Hasta ${n} cuotas` %>
                </option>
              <% }); %>
            </select>
            <p class="text-[10px] text-gray-400 mt-1">En Mercado Pago el cliente no verá 6/9/12 si el tope es 3. Débito y pago al contado siguen en 1 cuota. Transbank se configura en el portal del comercio.</p>
          </div>
          <div class="flex flex-wrap gap-4">
            <label class="flex items-center gap-2 text-sm cursor-pointer">
              <input type="checkbox" name="cardEnabled" <%= pricing.cardEnabled !== false ? 'checked' : '' %> class="rounded accent-zilo-accent">
              Tarjeta activa
            </label>
            <label class="flex items-center gap-2 text-sm cursor-pointer">
              <input type="checkbox" name="transferEnabled" <%= pricing.transferEnabled !== false ? 'checked' : '' %> class="rounded accent-zilo-accent">
              Transferencia activa
            </label>
          </div>
        </div>
        <h3 class="text-xs font-semibold text-gray-600 mb-2">Cuenta para transferencias</h3>
        <div class="grid grid-cols-1 gap-2">
          <input type="text" name="bankName" value="<%= pricing.bankTransfer.bankName %>" placeholder="Banco" class="zilo-input !py-2 text-sm">
          <input type="text" name="bankAccountType" value="<%= pricing.bankTransfer.accountType %>" placeholder="Tipo de cuenta" class="zilo-input !py-2 text-sm">
          <input type="text" name="bankAccountNumber" value="<%= pricing.bankTransfer.accountNumber %>" placeholder="Número de cuenta" class="zilo-input !py-2 text-sm">
          <input type="text" name="bankHolderName" value="<%= pricing.bankTransfer.holderName %>" placeholder="Titular" class="zilo-input !py-2 text-sm">
          <input type="text" name="bankHolderRut" value="<%= pricing.bankTransfer.holderRut %>" placeholder="RUT titular" class="zilo-input !py-2 text-sm">
          <input type="email" name="bankEmail" value="<%= pricing.bankTransfer.email %>" placeholder="Email pagos" class="zilo-input !py-2 text-sm">
        </div>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-3">Pasarelas de pago</h2>
        <p class="text-xs text-gray-500 mb-4">Activa o desactiva cada pasarela. Las credenciales API van en variables de entorno del servidor (nunca en el cliente).</p>
        <div class="space-y-3">
          <% const gw = typeof gatewayStatus !== 'undefined' ? gatewayStatus : {}; %>
          <% ['transbank','mercadopago','paypal'].forEach(id => { const g = gw[id]; if (!g) return; const cfg = pricing.paymentGateways[id] || {}; %>
            <div class="p-4 rounded-xl bg-gray-50 border border-gray-200">
              <input type="hidden" name="gwId" value="<%= id %>">
              <div class="flex items-start justify-between gap-3 mb-2">
                <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
                  <input type="checkbox" name="gwEnabled" value="<%= id %>" <%= cfg.enabled !== false ? 'checked' : '' %> class="rounded accent-zilo-accent">
                  <%= g.label %>
                </label>
                <span class="text-[10px] px-2 py-0.5 rounded-full <%= g.configured ? 'bg-emerald-500/10 text-emerald-700' : 'bg-gray-200 text-gray-500' %>">
                  <%= g.configured ? 'Credenciales OK' : 'Sin credenciales' %>
                </span>
              </div>
              <div class="flex items-center gap-2">
                <label class="text-xs text-gray-500 shrink-0">Prioridad</label>
                <input type="number" name="gwOrder" value="<%= cfg.sortOrder || 1 %>" min="1" max="9" class="zilo-input w-20 !py-1.5 text-sm">
                <span class="text-[10px] text-gray-400">Menor número = se usa primero</span>
              </div>
            </div>
          <% }); %>
        </div>
        <div class="mt-4 p-3 rounded-xl border border-amber-200 bg-amber-50/50 text-xs">
          <p class="font-semibold text-amber-950 mb-1">Test Visa</p>
          <p class="text-amber-900/80">El diagnóstico de marcas (Visa OK/NO) está en la <a href="#mpVisaTestBox" class="underline font-semibold text-zilo-accent">caja amarilla al inicio de esta página</a>.</p>
          <p class="text-[10px] text-gray-500 mt-2">Hostinger: prueba → <code>MP_TEST_PUBLIC_KEY</code> + <code>MP_TEST_ACCESS_TOKEN</code> · producción → <code>MP_PUBLIC_KEY</code> + <code>MP_ACCESS_TOKEN</code></p>
        </div>
        <p class="text-[10px] text-gray-400 mt-3">
          Transbank: <code>TRANSBANK_COMMERCE_CODE</code>, <code>TRANSBANK_API_KEY</code>, <code>TRANSBANK_ENV</code> ·
          PayPal: <code>PAYPAL_CLIENT_ID</code>, <code>PAYPAL_CLIENT_SECRET</code>, <code>PAYPAL_ENV</code>
        </p>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-sm font-semibold">Recargos por horario</h2>
          <span class="text-[10px] text-gray-500">Hora local del cliente</span>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          Se aplican sobre el precio base según la hora del celular/computador del cliente.
          Franjas fijas: 09:00–17:00 normal, 17:01–21:00 tarde, 21:01–08:59 nocturno/madrugada.
        </p>
        <% const schedule = pricing.scheduleSurcharges || { normalPercent: 0, tardePercent: 25, nocturnoPercent: 50 }; %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="text-xs text-gray-500">Normal (09–17) %</label>
            <input type="number" name="scheduleNormalPercent" value="<%= schedule.normalPercent %>" min="-50" max="200" step="1" class="zilo-input w-full mt-1" required>
          </div>
          <div>
            <label class="text-xs text-gray-500">Tarde (17:01–21) %</label>
            <input type="number" name="scheduleTardePercent" value="<%= schedule.tardePercent %>" min="-50" max="200" step="1" class="zilo-input w-full mt-1" required>
          </div>
          <div>
            <label class="text-xs text-gray-500">Nocturno / madrugada %</label>
            <input type="number" name="scheduleNocturnoPercent" value="<%= schedule.nocturnoPercent %>" min="-50" max="200" step="1" class="zilo-input w-full mt-1" required>
            <p class="text-[10px] text-gray-400 mt-1">Default 50%.</p>
          </div>
        </div>
      </section>

      <%
        const zoneCfg = pricing.zonePricing || {};
        const zoneOrigin = zoneCfg.origin || {};
        const zoneDist = zoneCfg.distance || {};
        const zoneSupply = zoneCfg.supply || {};
        const defaultZoneCommunes = [
          { code: 'nunoa', name: 'Ñuñoa', percent: 0 },
          { code: 'providencia', name: 'Providencia', percent: 5 },
          { code: 'las-condes', name: 'Las Condes', percent: 10 },
          { code: 'la-reina', name: 'La Reina', percent: 10 },
          { code: 'vitacura', name: 'Vitacura', percent: 15 },
          { code: 'lo-barnechea', name: 'Lo Barnechea', percent: 20 },
          { code: 'colina', name: 'Colina', percent: 20 }
        ];
        const zoneCommunes = Array.isArray(zoneCfg.communes) && zoneCfg.communes.length
          ? zoneCfg.communes
          : defaultZoneCommunes;
        const zoneBands = Array.isArray(zoneDist.bands) && zoneDist.bands.length ? zoneDist.bands : [{ maxKm: 4, percent: 0 }, { maxKm: 8, percent: 5 }, { maxKm: 12, percent: 10 }, { maxKm: 18, percent: 16 }, { maxKm: 999, percent: 22 }];
        const zoneSupplyTiers = Array.isArray(zoneSupply.tiers) && zoneSupply.tiers.length ? zoneSupply.tiers : [{ minTechs: 5, percent: 0 }, { minTechs: 3, percent: 4 }, { minTechs: 2, percent: 9 }, { minTechs: 1, percent: 16 }, { minTechs: 0, percent: 24 }];
        const zoneMode = zoneCfg.mode || 'commune';
      %>
      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <div class="flex justify-between items-start mb-4 gap-2 flex-wrap">
          <div>
            <h2 class="text-sm font-semibold">Precio por zona (por comuna)</h2>
            <p class="text-xs text-gray-500 mt-1">Recargo sobre el precio base <strong>antes</strong> de horario y urgencia. Hub: <%= zoneOrigin.label || 'Ñuñoa' %>. Ej.: dentro de Ñuñoa 0%, Providencia 5%.</p>
          </div>
          <label class="flex items-center gap-2 text-sm font-medium cursor-pointer shrink-0">
            <input type="checkbox" name="zoneEnabled" <%= zoneCfg.enabled !== false ? 'checked' : '' %> class="rounded accent-zilo-accent">
            Activo
          </label>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
          <div>
            <label class="text-xs text-gray-500">Etiqueta hub</label>
            <input type="text" name="zoneOriginLabel" value="<%= zoneOrigin.label || 'Ñuñoa' %>" class="zilo-input w-full mt-1 !py-2 text-sm">
          </div>
          <div>
            <label class="text-xs text-gray-500">Modo de cálculo</label>
            <select name="zoneMode" class="zilo-input w-full mt-1 !py-2 text-sm">
              <option value="commune" <%= zoneMode !== 'bands' && zoneMode !== 'per_km' ? 'selected' : '' %>>Por comuna (recomendado)</option>
              <option value="bands" <%= zoneMode === 'bands' ? 'selected' : '' %>>Tramos por km (legado)</option>
              <option value="per_km" <%= zoneMode === 'per_km' ? 'selected' : '' %>>Por km (legado)</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-gray-500">% si comuna no está en tabla</label>
            <input type="number" name="zoneDefaultCommunePercent" value="<%= zoneCfg.defaultCommunePercent != null ? zoneCfg.defaultCommunePercent : 15 %>" min="0" max="100" step="0.5" class="zilo-input w-full mt-1 !py-2 text-sm" required>
          </div>
          <div>
            <label class="text-xs text-gray-500">Tope total recargo zona %</label>
            <input type="number" name="zoneMaxTotalPercent" value="<%= zoneCfg.maxTotalPercent != null ? zoneCfg.maxTotalPercent : 35 %>" min="0" max="100" step="0.5" class="zilo-input w-full mt-1 !py-2 text-sm" required>
          </div>
        </div>
        <input type="hidden" name="zoneOriginLat" value="<%= zoneOrigin.lat != null ? zoneOrigin.lat : -33.456 %>">
        <input type="hidden" name="zoneOriginLng" value="<%= zoneOrigin.lng != null ? zoneOrigin.lng : -70.598 %>">
        <input type="hidden" name="zoneOriginRegionCode" value="<%= zoneOrigin.regionCode || 'region-metropolitana' %>">
        <input type="hidden" name="zoneOriginCommuneCode" value="<%= zoneOrigin.communeCode || 'nunoa' %>">

        <div class="mb-4 p-3 rounded-xl bg-gray-50 border border-gray-200">
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="text-xs font-semibold text-gray-700">Tabla de comunas y recargo %</p>
            <button type="button" id="btnAddZoneCommune" class="text-xs font-semibold text-zilo-accent hover:underline">+ Agregar comuna</button>
          </div>
          <p class="text-[10px] text-gray-500 mb-3">Código slug (ej. <code>providencia</code>, <code>las-condes</code>). Ñuñoa = 0%.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm" id="zoneCommuneTable">
              <thead>
                <tr class="text-[10px] uppercase tracking-wide text-gray-500 text-left">
                  <th class="pb-2 pr-2 font-semibold">Código</th>
                  <th class="pb-2 pr-2 font-semibold">Comuna</th>
                  <th class="pb-2 pr-2 font-semibold w-28">Recargo %</th>
                  <th class="pb-2 w-10"></th>
                </tr>
              </thead>
              <tbody id="zoneCommuneRows">
                <% zoneCommunes.forEach(function(c) { %>
                  <tr class="zone-commune-row border-t border-gray-200">
                    <td class="py-1.5 pr-2">
                      <input type="text" name="zoneCommuneCode" value="<%= c.code %>" class="zilo-input !py-1.5 text-sm w-full" placeholder="nunoa" required>
                    </td>
                    <td class="py-1.5 pr-2">
                      <input type="text" name="zoneCommuneName" value="<%= c.name %>" class="zilo-input !py-1.5 text-sm w-full" placeholder="Ñuñoa" required>
                    </td>
                    <td class="py-1.5 pr-2">
                      <input type="number" name="zoneCommunePercent" value="<%= c.percent %>" min="0" max="100" step="0.5" class="zilo-input !py-1.5 text-sm w-full" required>
                    </td>
                    <td class="py-1.5">
                      <button type="button" class="zone-commune-remove text-red-600 text-xs font-semibold px-1" title="Quitar">✕</button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <details class="mb-4 p-3 rounded-xl bg-gray-50 border border-gray-200">
          <summary class="text-xs font-semibold text-gray-700 cursor-pointer">Avanzado: distancia por km (legado)</summary>
          <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3">
            <div>
              <label class="text-[10px] text-gray-500">Modo distancia</label>
              <select name="zoneDistanceMode" class="zilo-input w-full mt-0.5 !py-2 text-sm">
                <option value="bands" <%= zoneDist.mode !== 'per_km' ? 'selected' : '' %>>Tramos (km)</option>
                <option value="per_km" <%= zoneDist.mode === 'per_km' ? 'selected' : '' %>>Por km</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] text-gray-500">Factor carretera</label>
              <input type="number" name="zoneRoadFactor" value="<%= zoneDist.roadFactor != null ? zoneDist.roadFactor : 1.2 %>" min="1" max="2" step="0.05" class="zilo-input w-full mt-0.5 !py-2 text-sm">
            </div>
            <div>
              <label class="text-[10px] text-gray-500">Km gratis</label>
              <input type="number" name="zoneFreeKm" value="<%= zoneDist.freeKm != null ? zoneDist.freeKm : 3 %>" min="0" step="0.5" class="zilo-input w-full mt-0.5 !py-2 text-sm">
            </div>
            <div>
              <label class="text-[10px] text-gray-500">% / km</label>
              <input type="number" name="zonePercentPerKm" value="<%= zoneDist.percentPerKm != null ? zoneDist.percentPerKm : 1.25 %>" min="0" step="0.1" class="zilo-input w-full mt-0.5 !py-2 text-sm">
            </div>
          </div>
          <input type="hidden" name="zoneMaxDistancePercent" value="<%= zoneDist.maxDistancePercent != null ? zoneDist.maxDistancePercent : 22 %>">
          <div class="space-y-2">
            <% zoneBands.forEach(function(b) { %>
              <div class="grid grid-cols-2 gap-2 max-w-md">
                <input type="number" name="zoneBandMaxKm" value="<%= b.maxKm %>" min="0.5" step="0.5" placeholder="Hasta km" class="zilo-input !py-1.5 text-sm">
                <input type="number" name="zoneBandPercent" value="<%= b.percent %>" min="0" max="100" step="0.5" placeholder="Recargo %" class="zilo-input !py-1.5 text-sm">
              </div>
            <% }); %>
          </div>
        </details>

        <div class="p-3 rounded-xl bg-gray-50 border border-gray-200">
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="text-xs font-semibold text-gray-700">Disponibilidad de técnicos (opcional, se suma al %)</p>
            <label class="flex items-center gap-2 text-xs font-medium cursor-pointer">
              <input type="checkbox" name="zoneSupplyEnabled" <%= zoneSupply.enabled === true ? 'checked' : '' %> class="rounded accent-zilo-accent">
              Usar oferta local
            </label>
          </div>
          <div class="mb-2 max-w-xs">
            <label class="text-[10px] text-gray-500">Radio para contar técnicos listos (km)</label>
            <input type="number" name="zoneSupplyRadiusKm" value="<%= zoneSupply.radiusKm != null ? zoneSupply.radiusKm : 14 %>" min="1" max="80" step="1" class="zilo-input w-full mt-0.5 !py-2 text-sm">
          </div>
          <p class="text-[10px] text-gray-500 mb-2">Desactivado por defecto. Si lo activas, se suma al % de la comuna.</p>
          <div class="space-y-2">
            <% zoneSupplyTiers.forEach(function(t) { %>
              <div class="grid grid-cols-2 gap-2 max-w-md">
                <input type="number" name="zoneSupplyMinTechs" value="<%= t.minTechs %>" min="0" step="1" placeholder="Mín. técnicos" class="zilo-input !py-1.5 text-sm">
                <input type="number" name="zoneSupplyPercent" value="<%= t.percent %>" min="0" max="100" step="0.5" placeholder="Recargo %" class="zilo-input !py-1.5 text-sm">
              </div>
            <% }); %>
          </div>
        </div>
      </section>
      <script>
        (function () {
          var tbody = document.getElementById('zoneCommuneRows');
          var addBtn = document.getElementById('btnAddZoneCommune');
          if (!tbody || !addBtn) return;
          function bindRemove(btn) {
            btn.addEventListener('click', function () {
              var row = btn.closest('tr');
              if (row && tbody.querySelectorAll('tr').length > 1) row.remove();
            });
          }
          tbody.querySelectorAll('.zone-commune-remove').forEach(bindRemove);
          addBtn.addEventListener('click', function () {
            var tr = document.createElement('tr');
            tr.className = 'zone-commune-row border-t border-gray-200';
            tr.innerHTML = '<td class="py-1.5 pr-2"><input type="text" name="zoneCommuneCode" value="" class="zilo-input !py-1.5 text-sm w-full" placeholder="macul" required></td>'
              + '<td class="py-1.5 pr-2"><input type="text" name="zoneCommuneName" value="" class="zilo-input !py-1.5 text-sm w-full" placeholder="Macul" required></td>'
              + '<td class="py-1.5 pr-2"><input type="number" name="zoneCommunePercent" value="10" min="0" max="100" step="0.5" class="zilo-input !py-1.5 text-sm w-full" required></td>'
              + '<td class="py-1.5"><button type="button" class="zone-commune-remove text-red-600 text-xs font-semibold px-1" title="Quitar">✕</button></td>';
            tbody.appendChild(tr);
            bindRemove(tr.querySelector('.zone-commune-remove'));
          });
        })();
      </script>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-sm font-semibold">Tiempo de llegada y recargo</h2>
          <span class="text-[10px] text-gray-500">Inmediato · Hoy · Mañana · 2 días</span>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          El cliente elige el compromiso de llegada. El precio final se calcula así:
          <strong>(precio base × recargo horario) × (1 + recargo llegada/100)</strong>.
          Usa % negativo para descuento (ej. En 2 días = -10).
        </p>

        <div class="space-y-3" id="tiersList">
          <% pricing.urgencyTiers.forEach((tier, i) => { %>
            <div class="p-4 rounded-xl bg-gray-50 border border-gray-200 tier-row">
              <input type="hidden" name="tierId" value="<%= tier.id %>">
              <input type="hidden" name="tierOrder" value="<%= tier.sortOrder %>">
              <div class="flex items-start justify-between gap-2 mb-2">
                <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
                  <input type="checkbox" name="tierEnabled" value="<%= tier.id %>" <%= tier.enabled !== false ? 'checked' : '' %> class="rounded accent-zilo-accent">
                  Activo
                </label>
                <span class="text-[10px] font-mono text-gray-400"><%= tier.id %></span>
              </div>
              <div class="grid gap-2">
                <input type="text" name="tierLabel" value="<%= tier.label %>" placeholder="Nombre" class="zilo-input w-full !py-2 text-sm" required>
                <input type="text" name="tierDesc" value="<%= tier.description %>" placeholder="Descripción para el cliente" class="zilo-input w-full !py-2 text-sm">
                <div class="grid grid-cols-2 gap-2">
                  <div class="flex items-center gap-2">
                    <label class="text-xs text-gray-500 shrink-0" title="Solo se usa en el cálculo interno de urgencia; no se muestra al cliente">Min. internos</label>
                    <input type="number" name="tierMinutes" value="<%= tier.responseMinutes || 180 %>" min="0" step="15" class="zilo-input flex-1 !py-2 text-sm" required>
                  </div>
                  <div class="flex items-center gap-2">
                    <label class="text-xs text-gray-500 shrink-0">Recargo %</label>
                    <input type="number" name="tierPercent" value="<%= tier.surchargePercent != null ? tier.surchargePercent : (tier.adjustmentPercent || 0) %>" min="-50" max="200" step="1" class="zilo-input flex-1 !py-2 text-sm" required>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <div class="flex justify-between items-start mb-2 gap-2 flex-wrap">
          <div>
            <h2 class="text-sm font-semibold">Servicios · precios base por tipo</h2>
            <p class="text-xs text-gray-500 mt-1">
              Despliega cada especialidad. Precio Fandez = total cliente (IVA incl.). Comparativo = mercado
              <strong>Región Metropolitana</strong> (<%= typeof marketRegion !== 'undefined' ? marketRegion : 'RM' %>, ref. <%= typeof marketUpdated !== 'undefined' ? marketUpdated : '2026-09' %>).
            </p>
          </div>
          <span class="text-[10px] text-gray-500"><%= (typeof catalogRows !== 'undefined' ? catalogRows.length : 0) %> actividades</span>
        </div>
        <p class="text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 mb-4">
          Δ vs mercado: verde ≈ al mercado (±5%), azul = Fandez más bajo, ámbar = Fandez más alto. Los rangos bajo/medio/alto son editables.
        </p>

        <% if (typeof serviceCatalog !== 'undefined' && serviceCatalog.length) { %>
          <div class="space-y-2" id="serviceCatalogAccordions">
            <% serviceCatalog.forEach(function(specialty, sIdx) { %>
              <details class="rounded-xl border border-gray-200 overflow-hidden bg-white" <%= sIdx === 0 ? 'open' : '' %>>
                <summary class="px-3 py-3 bg-gray-50 cursor-pointer list-none flex items-center justify-between gap-3 select-none">
                  <span class="min-w-0">
                    <strong class="text-sm text-gray-900"><%= specialty.name %></strong>
                    <span class="text-[10px] font-mono text-gray-400 ml-2"><%= specialty.id %></span>
                  </span>
                  <span class="shrink-0 text-[11px] text-gray-600">
                    <%= specialty.activities.length %> ·
                    <span class="<%= Math.abs(specialty.marketSummary && specialty.marketSummary.avgPct || 0) <= 5 ? 'text-emerald-700' : ((specialty.marketSummary && specialty.marketSummary.avgPct) < 0 ? 'text-blue-700' : 'text-amber-700') %>">
                      <%= specialty.marketSummary ? specialty.marketSummary.label : '—' %>
                    </span>
                  </span>
                </summary>
                <div class="overflow-x-auto border-t border-gray-100">
                  <table class="w-full text-left text-sm min-w-[760px]">
                    <thead>
                      <tr class="text-[10px] uppercase tracking-wide text-gray-500 border-b border-gray-100 bg-white">
                        <th class="px-3 py-2 font-medium">Actividad</th>
                        <th class="px-3 py-2 font-medium w-24">Tipo</th>
                        <th class="px-3 py-2 font-medium w-28">Precio Fandez</th>
                        <th class="px-3 py-2 font-medium w-24">Mercado bajo</th>
                        <th class="px-3 py-2 font-medium w-24">Mercado mid</th>
                        <th class="px-3 py-2 font-medium w-24">Mercado alto</th>
                        <th class="px-3 py-2 font-medium w-36">Δ vs RM</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% specialty.activities.forEach(function(activity) {
                        const d = activity.delta || {};
                        const tone = d.tone === 'ok' ? 'text-emerald-700 bg-emerald-50' : (d.tone === 'low' ? 'text-blue-700 bg-blue-50' : (d.tone === 'high' ? 'text-amber-800 bg-amber-50' : 'text-gray-500 bg-gray-50'));
                      %>
                        <tr class="border-b border-gray-50 last:border-0 align-top">
                          <td class="px-3 py-2.5">
                            <input type="hidden" name="catalogActivityId" value="<%= activity.id %>">
                            <p class="font-medium text-gray-800 leading-snug"><%= activity.name %></p>
                            <p class="text-[10px] font-mono text-gray-400"><%= activity.id %><% if (activity.pricingUnit === 'm2') { %> · / m²<% } %></p>
                          </td>
                          <td class="px-3 py-2.5">
                            <span class="text-[10px] px-2 py-0.5 rounded-full <%= activity.kind === 'correctiva' ? 'bg-orange-50 text-orange-700' : 'bg-emerald-50 text-emerald-700' %>">
                              <%= activity.kind === 'correctiva' ? 'Correctiva' : 'Preventiva' %>
                            </span>
                          </td>
                          <td class="px-3 py-2.5">
                            <input type="number" name="catalogBasePrice" value="<%= activity.basePrice %>"
                              min="<%= activity.pricingUnit === 'm2' ? 1000 : 80000 %>"
                              step="<%= activity.pricingUnit === 'm2' ? 100 : 1000 %>"
                              class="zilo-input !py-1.5 text-sm w-full js-fandez-price" required>
                          </td>
                          <td class="px-3 py-2.5">
                            <input type="number" name="catalogMarketLow" value="<%= activity.market.low %>" min="0" step="1000" class="zilo-input !py-1.5 text-sm w-full">
                          </td>
                          <td class="px-3 py-2.5">
                            <input type="number" name="catalogMarketMid" value="<%= activity.market.mid %>" min="0" step="1000" class="zilo-input !py-1.5 text-sm w-full js-market-mid">
                          </td>
                          <td class="px-3 py-2.5">
                            <input type="number" name="catalogMarketHigh" value="<%= activity.market.high %>" min="0" step="1000" class="zilo-input !py-1.5 text-sm w-full">
                          </td>
                          <td class="px-3 py-2.5">
                            <span class="inline-block text-[10px] font-semibold px-2 py-1 rounded-full <%= tone %> js-delta-badge"><%= d.label || '—' %></span>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </details>
            <% }); %>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" id="btnExpandAllServices" class="text-xs font-medium text-zilo-accent hover:underline">Expandir todos</button>
            <button type="button" id="btnCollapseAllServices" class="text-xs font-medium text-gray-500 hover:underline">Colapsar todos</button>
          </div>
        <% } else { %>
          <p class="text-xs text-red-600">No hay catálogo cargado.</p>
        <% } %>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <h2 class="text-sm font-semibold mb-1">Materiales · autonomía boletas</h2>
        <p class="text-xs text-gray-500 mb-4">
          Umbrales para auto-aprobación IA vs revisión del founder. Por defecto $15.000 CLP.
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <div>
            <label class="text-[11px] font-semibold text-gray-600">Incluido en servicio hasta (CLP)</label>
            <input type="number" name="materialsIncludedThresholdClp" value="<%= pricing.materialsIncludedThresholdClp != null ? pricing.materialsIncludedThresholdClp : 10000 %>" min="0" step="500" class="zilo-input w-full mt-1">
            <p class="text-[10px] text-gray-400 mt-1">Bajo este monto no se cobra aparte.</p>
          </div>
          <div>
            <label class="text-[11px] font-semibold text-gray-600">Auto-aprobar hasta (CLP)</label>
            <input type="number" name="materialsAutoApproveMaxClp" value="<%= pricing.materialsAutoApproveMaxClp != null ? pricing.materialsAutoApproveMaxClp : 15000 %>" min="0" step="500" class="zilo-input w-full mt-1">
          </div>
          <div>
            <label class="text-[11px] font-semibold text-gray-600">Revisión founder desde (CLP)</label>
            <input type="number" name="materialsFounderReviewMinClp" value="<%= pricing.materialsFounderReviewMinClp != null ? pricing.materialsFounderReviewMinClp : 15000 %>" min="0" step="500" class="zilo-input w-full mt-1">
          </div>
          <div>
            <label class="text-[11px] font-semibold text-gray-600">Confianza mínima IA (0–1)</label>
            <input type="number" name="materialsAutoApproveMinConfidence" value="<%= pricing.materialsAutoApproveMinConfidence != null ? pricing.materialsAutoApproveMinConfidence : 0.85 %>" min="0" max="1" step="0.05" class="zilo-input w-full mt-1">
          </div>
        </div>
      </section>

      <section class="zilo-card-premium rounded-2xl p-5 border border-gray-200">
        <div class="flex justify-between items-start gap-2 flex-wrap mb-2">
          <div>
            <h2 class="text-sm font-semibold">Materiales y productos · por servicio</h2>
            <p class="text-xs text-gray-500 mt-1">
              Despliega por tipo. Precio Fandez = costo al cliente (0% comisión). Comparativo retail RM (bajo / mid / alto).
            </p>
          </div>
        </div>
        <%
          const matGroups = (typeof materialsGrouped !== 'undefined' && materialsGrouped)
            ? materialsGrouped
            : { appServices: [], groups: [], all: [] };
          const appServices = matGroups.appServices && matGroups.appServices.length
            ? matGroups.appServices
            : [
              { id: 'gasfiter', name: 'Gasfitería' },
              { id: 'electrico', name: 'Electricidad' },
              { id: 'aires', name: 'Aire acondicionado' },
              { id: 'termos', name: 'Termos' },
              { id: 'cerrajero', name: 'Cerrajería' },
              { id: 'calderas', name: 'Calderas' },
              { id: 'generadores', name: 'Generadores' },
              { id: 'pintura', name: 'Pintura' },
              { id: 'jardineria', name: 'Jardinería y paisajismo' },
              { id: 'limpieza', name: 'Limpieza' },
              { id: 'escombros', name: 'Retiro de Escombros y Limpieza Profunda' },
              { id: 'otros', name: 'Otros' }
            ];
        %>
        <div class="space-y-2 mb-3" id="materialsAccordions">
          <% (matGroups.groups || []).forEach(function(group, gIdx) { %>
            <details class="rounded-xl border border-gray-200 overflow-hidden bg-white" <%= gIdx === 0 ? 'open' : '' %>>
              <summary class="px-3 py-3 bg-gray-50 cursor-pointer list-none flex items-center justify-between gap-3 select-none">
                <strong class="text-sm"><%= group.name %></strong>
                <span class="text-[11px] text-gray-500"><%= group.materials.length %> ítems</span>
              </summary>
              <div class="overflow-x-auto border-t border-gray-100">
                <table class="w-full text-sm min-w-[820px]">
                  <thead>
                    <tr class="text-[10px] uppercase tracking-wide text-gray-500 border-b border-gray-100">
                      <th class="px-3 py-2 font-medium text-left">Material</th>
                      <th class="px-3 py-2 font-medium w-20">Unidad</th>
                      <th class="px-3 py-2 font-medium w-28">Precio Fandez</th>
                      <th class="px-3 py-2 font-medium w-24">Mercado bajo</th>
                      <th class="px-3 py-2 font-medium w-24">Mercado alto</th>
                      <th class="px-3 py-2 font-medium w-32">Vs retail RM</th>
                      <th class="px-3 py-2 font-medium">Especialidades</th>
                      <th class="px-3 py-2 font-medium w-16 text-center">Activo</th>
                    </tr>
                  </thead>
                  <tbody class="materialsCatalogBody">
                    <% group.materials.forEach(function(m) {
                      const md = m.delta || {};
                      const mtone = md.tone === 'ok' ? 'text-emerald-700 bg-emerald-50' : (md.tone === 'low' ? 'text-blue-700 bg-blue-50' : (md.tone === 'high' ? 'text-amber-800 bg-amber-50' : 'text-gray-500 bg-gray-50'));
                    %>
                      <tr class="border-b border-gray-50 align-top">
                        <td class="px-3 py-2">
                          <input type="hidden" name="matId" value="<%= m.id %>">
                          <input type="text" name="matName" value="<%= m.name %>" class="zilo-input !py-1.5 text-sm w-full" required>
                          <p class="text-[10px] font-mono text-gray-400 mt-0.5"><%= m.id %></p>
                        </td>
                        <td class="px-3 py-2">
                          <input type="text" name="matUnit" value="<%= m.unit || 'unidad' %>" class="zilo-input !py-1.5 text-sm w-full" required>
                        </td>
                        <td class="px-3 py-2">
                          <input type="number" name="matPrice" value="<%= m.marketPrice %>" min="0" step="100" class="zilo-input !py-1.5 text-sm w-full" required>
                        </td>
                        <td class="px-3 py-2">
                          <input type="number" name="matMarketLow" value="<%= m.marketLow != null ? m.marketLow : m.market.low %>" min="0" step="100" class="zilo-input !py-1.5 text-sm w-full">
                        </td>
                        <td class="px-3 py-2">
                          <input type="number" name="matMarketHigh" value="<%= m.marketHigh != null ? m.marketHigh : m.market.high %>" min="0" step="100" class="zilo-input !py-1.5 text-sm w-full">
                        </td>
                        <td class="px-3 py-2">
                          <span class="inline-block text-[10px] font-semibold px-2 py-1 rounded-full <%= mtone %>"><%= md.label || '—' %></span>
                        </td>
                        <td class="px-3 py-2">
                          <div class="flex flex-wrap gap-x-2 gap-y-1">
                            <% appServices.forEach(function(s) { %>
                              <label class="inline-flex items-center gap-1 text-[11px] text-gray-600 cursor-pointer">
                                <input type="checkbox" name="matSpec_<%= m.id %>" value="<%= s.id %>" <%= (m.specialtyIds || []).includes(s.id) ? 'checked' : '' %> class="rounded accent-zilo-accent">
                                <%= s.name %>
                              </label>
                            <% }); %>
                          </div>
                        </td>
                        <td class="px-3 py-2 text-center">
                          <input type="checkbox" name="matEnabled" value="<%= m.id %>" <%= m.enabled !== false ? 'checked' : '' %> class="rounded accent-zilo-accent">
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </details>
          <% }); %>
        </div>
        <button type="button" id="btnAddMaterialRow" class="text-xs font-medium text-zilo-accent hover:underline">+ Agregar material</button>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" id="btnExpandAllMats" class="text-xs font-medium text-zilo-accent hover:underline">Expandir materiales</button>
          <button type="button" id="btnCollapseAllMats" class="text-xs font-medium text-gray-500 hover:underline">Colapsar materiales</button>
        </div>
        <template id="matRowTemplate">
          <tr class="border-b border-gray-50 align-top">
            <td class="px-3 py-2">
              <input type="hidden" name="matId" value="">
              <input type="text" name="matName" value="" placeholder="Nombre" class="zilo-input !py-1.5 text-sm w-full" required>
            </td>
            <td class="px-3 py-2">
              <input type="text" name="matUnit" value="unidad" class="zilo-input !py-1.5 text-sm w-full" required>
            </td>
            <td class="px-3 py-2">
              <input type="number" name="matPrice" value="0" min="0" step="100" class="zilo-input !py-1.5 text-sm w-full" required>
            </td>
            <td class="px-3 py-2">
              <input type="number" name="matMarketLow" value="0" min="0" step="100" class="zilo-input !py-1.5 text-sm w-full">
            </td>
            <td class="px-3 py-2">
              <input type="number" name="matMarketHigh" value="0" min="0" step="100" class="zilo-input !py-1.5 text-sm w-full">
            </td>
            <td class="px-3 py-2">
              <span class="inline-block text-[10px] font-semibold px-2 py-1 rounded-full text-gray-500 bg-gray-50">Nuevo</span>
            </td>
            <td class="px-3 py-2">
              <div class="flex flex-wrap gap-x-2 gap-y-1 mat-spec-wrap" data-new="1">
                <% appServices.forEach(function(s) { %>
                  <label class="inline-flex items-center gap-1 text-[11px] text-gray-600 cursor-pointer">
                    <input type="checkbox" data-spec="<%= s.id %>" value="<%= s.id %>" class="rounded accent-zilo-accent mat-spec-cb">
                    <%= s.name %>
                  </label>
                <% }); %>
              </div>
            </td>
            <td class="px-3 py-2 text-center">
              <input type="checkbox" data-enabled-new="1" class="rounded accent-zilo-accent" checked>
            </td>
          </tr>
        </template>
        <script>
          (function () {
            function toggleAll(rootId, open) {
              document.querySelectorAll('#' + rootId + ' details').forEach(function (d) {
                d.open = open;
              });
            }
            document.getElementById('btnExpandAllServices')?.addEventListener('click', function () {
              toggleAll('serviceCatalogAccordions', true);
            });
            document.getElementById('btnCollapseAllServices')?.addEventListener('click', function () {
              toggleAll('serviceCatalogAccordions', false);
            });
            document.getElementById('btnExpandAllMats')?.addEventListener('click', function () {
              toggleAll('materialsAccordions', true);
            });
            document.getElementById('btnCollapseAllMats')?.addEventListener('click', function () {
              toggleAll('materialsAccordions', false);
            });

            const bodies = document.querySelectorAll('.materialsCatalogBody');
            const body = bodies[bodies.length - 1] || document.querySelector('.materialsCatalogBody');
            const tpl = document.getElementById('matRowTemplate');
            let newIdx = 0;
            document.getElementById('btnAddMaterialRow')?.addEventListener('click', function () {
              if (!body || !tpl) return;
              const parentDetails = body.closest('details');
              if (parentDetails) parentDetails.open = true;
              const node = tpl.content.cloneNode(true);
              const id = 'mat-new-' + Date.now().toString(36) + '-' + (newIdx++);
              const idInput = node.querySelector('input[name="matId"]');
              if (idInput) idInput.value = id;
              node.querySelectorAll('.mat-spec-cb').forEach(function (cb) {
                cb.name = 'matSpec_' + id;
              });
              const en = node.querySelector('[data-enabled-new]');
              if (en) {
                en.name = 'matEnabled';
                en.value = id;
              }
              body.appendChild(node);
            });

            function refreshDelta(row) {
              const f = Number(row.querySelector('.js-fandez-price')?.value);
              const m = Number(row.querySelector('.js-market-mid')?.value);
              const badge = row.querySelector('.js-delta-badge');
              if (!badge || !Number.isFinite(f) || !Number.isFinite(m) || m <= 0) return;
              const pct = Math.round(((f - m) / m) * 1000) / 10;
              let label; let cls;
              if (Math.abs(pct) <= 5) {
                label = (pct > 0 ? '+' : '') + pct + '% · al mercado';
                cls = 'inline-block text-[10px] font-semibold px-2 py-1 rounded-full text-emerald-700 bg-emerald-50 js-delta-badge';
              } else if (pct < -5) {
                label = pct + '% · bajo mercado';
                cls = 'inline-block text-[10px] font-semibold px-2 py-1 rounded-full text-blue-700 bg-blue-50 js-delta-badge';
              } else {
                label = '+' + pct + '% · sobre mercado';
                cls = 'inline-block text-[10px] font-semibold px-2 py-1 rounded-full text-amber-800 bg-amber-50 js-delta-badge';
              }
              badge.textContent = label;
              badge.className = cls;
            }
            document.getElementById('serviceCatalogAccordions')?.addEventListener('input', function (ev) {
              const row = ev.target.closest('tr');
              if (row) refreshDelta(row);
            });
          })();
        </script>
      </section>

      <button type="submit" class="w-full py-3 rounded-xl zilo-btn-primary">Guardar configuración</button>
    </form>

    <section class="mt-6 p-4 rounded-2xl bg-zilo-accent/5 border border-zilo-accent/20">
      <p class="text-xs text-gray-600"><strong>Vista previa:</strong> Diagnóstico mínimo <%= formatCLP(pricing.visitPrice) %>. Trabajo base (servicePrice) <%= formatCLP(pricing.servicePrice) %> — el total del cliente aplica horario × urgencia. Liquidación: <%= Math.round(pricing.laborCommissionRate * 100) %>% Fandez IVA incl. + Mercado Pago valor presente. Materiales 0% comisión.</p>
    </section>
  </main>
</div>

<script>
(function () {
  const base = '<%= typeof adminBase !== "undefined" ? adminBase : "/admin" %>';
  const line = document.getElementById('mpCredProfileLine');
  const brandsLine = document.getElementById('mpCardBrandsLine');
  function renderBrandAudit(data) {
    const auditBox = document.getElementById('mpBrandAuditBox');
    if (!auditBox) return;
    const rows = Array.isArray(data.brandAudit) ? data.brandAudit : [];
    if (!rows.length) {
      auditBox.classList.remove('hidden');
      auditBox.textContent = 'brandAudit vacío: la API no devolvió visa/master/amex (o falló el token).';
      return;
    }
    auditBox.classList.remove('hidden');
    auditBox.textContent = 'Perfil: ' + (data.credentialProfile || '?') + '\n'
      + rows.map(function (r) {
        return r.id + ' | status=' + r.status + ' | payment_type_id=' + r.payment_type_id
          + ' | secure_thumbnail=' + (r.secure_thumbnail ? 'sí' : 'no');
      }).join('\n');
  }
  async function refreshMpBrands() {
    if (!brandsLine) return;
    try {
      const res = await fetch(base + '/mp/payment-methods', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!data.success) {
        brandsLine.textContent = 'Marcas tarjeta: no se pudo consultar /v1/payment_methods.';
        return;
      }
      const b = data.brands || {};
      const flag = (on) => (on ? 'OK' : 'NO');
      const visa = data.visa || {};
      brandsLine.innerHTML = 'GET /v1/payment_methods → Visa <strong class="' + (b.visa ? 'text-emerald-700' : 'text-amber-700') + '">' + flag(b.visa) + '</strong>'
        + ' · Mastercard <strong>' + flag(b.master) + '</strong>'
        + ' · Amex <strong>' + flag(b.amex) + '</strong>'
        + (visa.diagnosis ? '<br><span class="text-amber-800">' + visa.diagnosis + '</span>' : '')
        + '<br><a class="text-zilo-accent font-semibold underline" href="' + base + '/mp/payment-methods" target="_blank" rel="noopener">Ver JSON completo (brandAudit)</a>';
      renderBrandAudit(data);
    } catch (_) {
      brandsLine.textContent = 'Error al cargar marcas MP.';
    }
  }
  async function refreshMpProfile() {
    if (!line) return;
    try {
      const res = await fetch(base + '/modo', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!data.success) {
        line.textContent = 'No se pudo leer el perfil MP.';
        await refreshMpBrands();
        return;
      }
      const mp = data.mercadopago || {};
      const phase = data.operationalPhase?.phase === 'productivo' ? 'producción' : 'prueba';
      line.textContent = 'Activo: credenciales de ' + phase + '. '
        + (mp.publicKeyConfigured && mp.accessTokenConfigured ? 'Par configurado en servidor.' : 'Faltan variables en Hostinger (' + (mp.publicKeyEnv || '') + ', ' + (mp.accessTokenEnv || '') + ').');
      if (data.mpCardMethodsOk != null) {
        const b = data.mpCardBrands || {};
        const flag = (on) => (on ? 'OK' : 'NO');
        const visa = data.mpVisaDiagnosis || {};
        if (brandsLine) {
          brandsLine.innerHTML = 'GET /v1/payment_methods → Visa <strong class="' + (b.visa ? 'text-emerald-700' : 'text-amber-700') + '">' + flag(b.visa) + '</strong>'
            + ' · Mastercard <strong>' + flag(b.master) + '</strong>'
            + ' · Amex <strong>' + flag(b.amex) + '</strong>'
            + (visa.diagnosis ? '<br><span class="text-amber-800">' + visa.diagnosis + '</span>' : '')
            + '<br><a class="text-zilo-accent font-semibold underline" href="' + base + '/mp/payment-methods" target="_blank" rel="noopener">Ver JSON completo (brandAudit)</a>';
        }
        renderBrandAudit({
          credentialProfile: data.mercadopago && data.mercadopago.profile,
          brandAudit: data.mpBrandAudit || []
        });
      } else {
        await refreshMpBrands();
      }
    } catch (_) {
      line.textContent = 'Error al cargar perfil MP.';
      await refreshMpBrands();
    }
  }
  document.querySelectorAll('.btn-mp-phase').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const phase = btn.dataset.phase;
      if (!confirm(phase === 'productivo'
        ? '¿Activar Mercado Pago de PRODUCCIÓN? Solo si las credenciales live están en Hostinger.'
        : '¿Activar Mercado Pago de PRUEBA (sandbox)?')) return;
      try {
        const res = await fetch(base + '/operational-phase', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ phase })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          alert(data.error || 'No se pudo cambiar el perfil.');
          return;
        }
        await refreshMpProfile();
        alert('Perfil MP: ' + (phase === 'productivo' ? 'producción' : 'prueba'));
      } catch (_) {
        alert('Error de red');
      }
    });
  });
  refreshMpBrands();
  refreshMpProfile();
})();
</script>

<%- include('../partials/footer') %>
