<%
  var canMail = (typeof hasPerm === 'function')
    ? (hasPerm('comunicaciones.send') || hasPerm('usuarios.manage'))
    : true;
%>
<% if (!canMail) { %>
  <p class="text-sm text-gray-500 p-4 rounded-xl border border-gray-200">Sin permiso para enviar correos masivos (<code>comunicaciones.send</code>).</p>
<% } else { %>
<div class="p-4 sm:p-5 rounded-2xl bg-zilo-card border border-gray-200" id="admin-correos-masivos" data-can-send="1">
  <h4 class="text-base font-semibold mb-1">Correo masivo</h4>
  <p class="text-[11px] text-gray-500 mb-4">
    Envía un mismo mensaje a clientes, socios, técnicos o a todos. Máximo <%= typeof mailMaxRecipients !== 'undefined' ? mailMaxRecipients : 250 %> destinatarios por envío.
    <% if (!notificationStats.emailConfigured) { %>
      <span class="text-amber-700 block mt-1">SMTP no configurado: modo demo (solo log en servidor).</span>
    <% } %>
  </p>
  <form id="ecosystemMailForm" class="space-y-4">
    <fieldset class="space-y-2">
      <legend class="text-xs font-semibold text-gray-700">Audiencia</legend>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
        <label class="inline-flex items-center gap-2 p-2.5 rounded-xl border border-gray-200 cursor-pointer hover:border-zilo-accent/40 has-[:checked]:border-zilo-accent has-[:checked]:bg-zilo-accent/5">
          <input type="radio" name="mailAudience" value="all"> <span><strong>Todos</strong> — clientes, socios y técnicos</span>
        </label>
        <label class="inline-flex items-center gap-2 p-2.5 rounded-xl border border-gray-200 cursor-pointer hover:border-zilo-accent/40 has-[:checked]:border-zilo-accent has-[:checked]:bg-zilo-accent/5">
          <input type="radio" name="mailAudience" value="clients"> Todos los clientes
        </label>
        <label class="inline-flex items-center gap-2 p-2.5 rounded-xl border border-gray-200 cursor-pointer hover:border-zilo-accent/40 has-[:checked]:border-zilo-accent has-[:checked]:bg-zilo-accent/5">
          <input type="radio" name="mailAudience" value="providers" checked> Todos los socios
        </label>
        <label class="inline-flex items-center gap-2 p-2.5 rounded-xl border border-gray-200 cursor-pointer hover:border-zilo-accent/40 has-[:checked]:border-zilo-accent has-[:checked]:bg-zilo-accent/5">
          <input type="radio" name="mailAudience" value="technicians"> Todos los técnicos
        </label>
        <label class="inline-flex items-center gap-2 p-2.5 rounded-xl border border-gray-200 cursor-pointer hover:border-zilo-accent/40 has-[:checked]:border-zilo-accent has-[:checked]:bg-zilo-accent/5">
          <input type="radio" name="mailAudience" value="providers_and_technicians"> Socios y técnicos
        </label>
        <label class="inline-flex items-center gap-2 p-2.5 rounded-xl border border-gray-200 cursor-pointer hover:border-zilo-accent/40 has-[:checked]:border-zilo-accent has-[:checked]:bg-zilo-accent/5">
          <input type="radio" name="mailAudience" value="custom_clients"> Clientes seleccionados
        </label>
      </div>
    </fieldset>
    <div id="ecosystemClientPicker" class="hidden space-y-2 p-3 rounded-xl bg-gray-50 border border-gray-200">
      <div class="flex gap-2">
        <input type="search" id="ecosystemClientSearch" class="admin-filter-q flex-1" placeholder="Buscar cliente por nombre o correo…" autocomplete="off">
        <button type="button" id="ecosystemClientSearchBtn" class="px-3 py-2 rounded-lg bg-gray-800 text-white text-xs font-semibold">Buscar</button>
      </div>
      <div id="ecosystemClientResults" class="space-y-1 max-h-40 overflow-y-auto"></div>
      <div id="ecosystemClientSelected" class="flex flex-wrap gap-1.5"></div>
    </div>
    <p id="ecosystemMailPreview" class="text-sm font-medium text-gray-700 py-2 px-3 rounded-xl bg-gray-50 border border-gray-100">Destinatarios estimados: —</p>
    <div>
      <label class="text-xs font-semibold text-gray-700 block mb-1" for="ecosystemMailSubject">Asunto</label>
      <input type="text" id="ecosystemMailSubject" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm" maxlength="200" required>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-700 block mb-1" for="ecosystemMailBody">Mensaje</label>
      <textarea id="ecosystemMailBody" class="w-full px-3 py-2 rounded-xl border border-gray-200 text-sm min-h-[140px]" maxlength="12000" required placeholder="Escribe el mensaje…"></textarea>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <button type="submit" id="ecosystemMailSubmit" class="px-4 py-2.5 rounded-xl bg-zilo-accent text-white text-sm font-semibold">Enviar correo</button>
      <span id="ecosystemMailStatus" class="text-xs text-gray-500"></span>
    </div>
  </form>
</div>
<% } %>
