<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0a0a0c">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Fandez Admin">
  <meta name="robots" content="noindex, nofollow">
  <link rel="manifest" href="<%= adminBase %>/app.webmanifest">
  <link rel="apple-touch-icon" href="/icons/fandez-admin-180.png?v=2">
  <link rel="icon" href="/icons/fandez-admin-192.png?v=2">
  <title>Instalar Fandez Admin</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: #0a0a0c;
      color: #f4f4f5;
      font-family: system-ui, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .card {
      max-width: 440px;
      width: 100%;
      background: #151518;
      border: 1px solid #2a2a30;
      border-radius: 20px;
      padding: 28px 22px;
      text-align: center;
    }
    img { width: 88px; height: 88px; border-radius: 20px; margin-bottom: 14px; }
    h1 { font-size: 22px; margin: 0 0 8px; }
    p { color: #a1a1aa; font-size: 14px; line-height: 1.45; margin: 0 0 12px; }
    ol { text-align: left; color: #d4d4d8; font-size: 14px; line-height: 1.55; margin: 0 0 14px; padding-left: 1.2rem; }
    .btn {
      display: inline-block;
      margin: 6px 4px 0;
      border: 0;
      background: #c45c14;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      padding: 14px 20px;
      border-radius: 999px;
      cursor: pointer;
    }
    .btn.secondary { background: #27272a; color: #f4f4f5; }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .note { font-size: 12px; color: #71717a; margin-top: 14px; }
    .warn {
      text-align: left;
      background: #1c1917;
      border: 1px solid #a16207;
      border-radius: 14px;
      padding: 12px 14px;
      margin: 0 0 14px;
      font-size: 13px;
      color: #fde68a;
      line-height: 1.45;
    }
    .warn strong { color: #fef3c7; }
    .ok-box {
      text-align: left;
      background: #052e16;
      border: 1px solid #166534;
      border-radius: 14px;
      padding: 12px 14px;
      margin: 0 0 14px;
      font-size: 13px;
      color: #bbf7d0;
      line-height: 1.45;
    }
    .status {
      display: none;
      margin: 0 0 12px;
      padding: 10px 12px;
      border-radius: 12px;
      font-size: 13px;
      line-height: 1.4;
    }
    .status.show { display: block; }
    .status.ok { background: #052e16; border: 1px solid #166534; color: #bbf7d0; }
    .status.info { background: #1e1b4b; border: 1px solid #4338ca; color: #c7d2fe; }
  </style>
</head>
<body>
  <div class="card">
    <img src="/icons/fandez-admin-512.png?v=2" alt="Fandez Admin">
    <h1>Instalar Fandez Admin</h1>
    <p>No es una descarga de Play Store. Se instala como <strong>acceso directo</strong> (PWA) en tu celular.</p>

    <div id="statusBox" class="status"></div>

    <div class="warn">
      <strong>Importante:</strong>
      Si Chrome ofrece “Instalar app” y Play Protect la bloquea, cancela y usa
      <em>Añadir a la pantalla de inicio</em> (pasos de abajo).
    </div>

    <button type="button" class="btn" id="btnInstallChrome" style="display:none;width:calc(100% - 8px)">Instalar en este celular</button>

    <div class="ok-box" id="androidBox">
      <strong>Android · Chrome (recomendado)</strong>
      <ol style="margin:8px 0 0;padding-left:1.1rem;color:#bbf7d0">
        <li>Quédate en esta pantalla (ya iniciaste sesión).</li>
        <li>Menú <strong>⋮</strong> arriba a la derecha.</li>
        <li><strong>Añadir a la pantalla de inicio</strong> / Crear acceso directo.</li>
        <li>Confirma. Aparece el ícono negro <strong>Fandez Admin</strong>.</li>
        <li>Ábrelo → <strong>Activar avisos</strong>.</li>
      </ol>
    </div>

    <div class="ok-box" id="iosBox" style="display:none;background:#1a120c;border-color:#3f2a1a;color:#fbbf8a">
      <strong>iPhone · Safari</strong>
      <ol style="margin:8px 0 0;padding-left:1.1rem;color:#fbbf8a">
        <li>Botón <strong>Compartir</strong>.</li>
        <li><strong>Añadir a pantalla de inicio</strong>.</li>
        <li>Nombre: Fandez Admin → Añadir.</li>
      </ol>
    </div>

    <a class="btn secondary" href="<%= installUrl %>">Abrir bandeja ahora</a>
    <a class="btn secondary" href="<%= adminBase %>">Ir al panel completo</a>

    <p class="note">Si no ves el menú de instalar: abre este mismo enlace otra vez en Chrome (no en Instagram/WhatsApp in-app browser).</p>
  </div>

  <script>
  (function () {
    var statusBox = document.getElementById('statusBox');
    function setStatus(msg, kind) {
      if (!statusBox) return;
      statusBox.textContent = msg;
      statusBox.className = 'status show ' + (kind || 'info');
    }

    var isIos = /iPad|iPhone|iPod/.test(navigator.userAgent)
      || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (isIos) {
      document.getElementById('iosBox').style.display = 'block';
      document.getElementById('androidBox').style.display = 'none';
      setStatus('En iPhone usa Safari → Compartir → Añadir a pantalla de inicio.', 'info');
    }

    var standalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone;
    if (standalone) {
      setStatus('Ya está instalada. Abre la bandeja y activa avisos.', 'ok');
    }

    // Solo mostrar botón nativo si Chrome lo ofrece (no forzar WebAPK siempre).
    var deferredPrompt = null;
    var btn = document.getElementById('btnInstallChrome');
    window.addEventListener('beforeinstallprompt', function (e) {
      e.preventDefault();
      deferredPrompt = e;
      if (btn) btn.style.display = 'inline-block';
      setStatus('Chrome puede instalarla con el botón naranja.', 'info');
    });
    btn?.addEventListener('click', async function () {
      if (!deferredPrompt) {
        setStatus('Usa el menú ⋮ → Añadir a la pantalla de inicio.', 'info');
        return;
      }
      deferredPrompt.prompt();
      try {
        var choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          setStatus('Instalada. Busca el ícono negro Fandez Admin.', 'ok');
        } else {
          setStatus('Cancelado. Prueba ⋮ → Añadir a la pantalla de inicio.', 'info');
        }
      } catch (_) {
        setStatus('Usa ⋮ → Añadir a la pantalla de inicio.', 'info');
      }
      deferredPrompt = null;
      btn.style.display = 'none';
    });

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/service-worker.js?v=41', { scope: '/' }).catch(function () {
        navigator.serviceWorker.register('/sw.js?v=41', { scope: '/' }).catch(function () {});
      });
    }
  })();
  </script>
</body>
</html>
