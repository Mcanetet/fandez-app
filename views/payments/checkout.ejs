<%- include('../partials/head') %>
<% const mpGwOnly = (typeof enabledCardGateways !== 'undefined' && enabledCardGateways.some(g => g.id === 'mercadopago'))
  || (typeof cardGateway !== 'undefined' && cardGateway?.id === 'mercadopago')
  || (typeof mpEmbedCheckout !== 'undefined' && mpEmbedCheckout); %>
<% const mpCanShowBrick = Boolean(typeof mpPublicKey !== 'undefined' && mpPublicKey); %>
<% const paymentFirst = Boolean(typeof mpEmbedCheckout !== 'undefined' && mpEmbedCheckout && mpGwOnly); %>
<% const hidePaymentPicker = paymentFirst && !(summary.transferEnabled); %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col pb-8 zilo-page-enter" id="checkoutPage"
  data-request-id="<%= request.id %>"
  data-card-enabled="<%= summary.cardEnabled %>"
  data-transfer-enabled="<%= summary.transferEnabled %>"
  data-card-surcharge="<%= summary.cardSurchargePercent %>"
  data-mp-embed="<%= mpEmbedCheckout ? '1' : '0' %>"
  data-mp-public-key="<%= typeof mpPublicKey !== 'undefined' ? mpPublicKey : '' %>"
  data-mp-token-configured="<%= mpConfigured ? '1' : '0' %>"
  data-mp-gw-only="<%= mpGwOnly ? '1' : '0' %>"
  data-default-card-gateway="<%= (enabledCardGateways && enabledCardGateways[0] && enabledCardGateways[0].id) || (cardGateway && cardGateway.id) || '' %>"
  data-max-installments="<%= Number(summary.maxCardInstallments) || 3 %>"
  data-initial-amount="<%= Number(summary.amountDue) || 0 %>"
  data-mp-can-brick="<%= mpCanShowBrick ? '1' : '0' %>">

  <% if (mpGwOnly || mpCanShowBrick) { %>
  <input type="hidden" id="hiddenPaymentMethodCard" value="card">
  <input type="hidden" id="defaultCardGatewayInput" value="mercadopago">
  <% } %>

  <header class="sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border px-5 py-4">
    <div class="flex items-center gap-3">
      <a href="/cliente/servicio/<%= request.serviceId %>?resume=<%= request.id %>" class="w-10 h-10 rounded-full zilo-card-premium flex items-center justify-center">
        <svg class="w-5 h-5 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <div class="min-w-0">
        <p class="zilo-label"><%= t('checkout.title') %></p>
        <h1 class="font-semibold truncate"><%= service.name %></h1>
        <% if (paymentFirst) { %><p class="text-[11px] text-zilo-muted mt-0.5"><%= t('checkout.pay_subtitle') %></p><% } %>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 space-y-4 pb-28">
    <div id="checkoutInAppWarn" class="hidden rounded-2xl border border-amber-300 bg-amber-50 p-4 text-left" role="alert">
      <p class="text-sm font-semibold text-amber-950 mb-1"><%= t('checkout.inapp_title') %></p>
      <p class="text-xs text-amber-900/90 leading-relaxed"><%= t('checkout.inapp_body') %></p>
    </div>
    <%- include('../partials/checkout-progress', { checkoutStep: 2 }) %>

    <% const billing = summary.billingSnapshot || profile.billing || { type: 'natural', rut: '', legalName: profile.name, giro: '', fiscalAddress: profile.address || '', invoiceEmail: profile.email }; %>
    <% const billingComplete = Boolean(billing.rut && billing.legalName && billing.fiscalAddress && billing.invoiceEmail && (billing.type !== 'empresa' || billing.giro)); %>

    <section class="checkout-pay-hero zilo-card-premium rounded-2xl p-5 border border-zilo-accent/20 bg-gradient-to-br from-white to-zilo-accent/[0.04]" aria-labelledby="checkoutPayTotal">
      <p class="text-xs text-zilo-muted truncate mb-2"><%= request.address %></p>
      <div class="flex items-end justify-between gap-3">
        <div>
          <p id="checkoutPayTotal" class="text-[10px] font-semibold uppercase tracking-wide text-zilo-muted"><%= paymentFirst ? t('checkout.pay_subtitle') : 'Total a pagar' %></p>
          <p class="text-3xl font-bold text-zilo-accent tabular-nums leading-none mt-1" id="lineTotalHero"><%= formatCLP(summary.amountDue) %></p>
          <p class="text-[10px] text-zilo-muted mt-1.5">IVA incluido · visita técnica</p>
        </div>
      </div>
    </section>

    <% if (!billingComplete) { %>
    <section class="zilo-card-premium rounded-2xl p-5" id="billingSection" data-complete="0">
      <div class="flex items-start justify-between gap-3 mb-3">
        <div>
          <h2 class="zilo-label mb-0"><%= t('checkout.billing_title') %></h2>
          <p class="text-[11px] text-zilo-muted mt-1">Necesarios para pagar y emitir boleta</p>
        </div>
      </div>
      <div id="billingFields">
        <div class="grid grid-cols-2 gap-2 mb-3">
          <label class="flex items-center gap-2 p-2.5 rounded-xl border cursor-pointer billing-type-option text-xs <%= billing.type !== 'empresa' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>">
            <input type="radio" name="billingType" value="natural" <%= billing.type !== 'empresa' ? 'checked' : '' %> class="accent-[#C45C14]">
            <%= t('checkout.billing_natural') %>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl border cursor-pointer billing-type-option text-xs <%= billing.type === 'empresa' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>">
            <input type="radio" name="billingType" value="empresa" <%= billing.type === 'empresa' ? 'checked' : '' %> class="accent-[#C45C14]">
            <%= t('checkout.billing_company') %>
          </label>
        </div>
        <div class="space-y-2">
          <input type="text" id="billRut" value="<%= billing.rut %>" placeholder="RUT" class="zilo-input !py-2 text-sm">
          <input type="text" id="billLegalName" value="<%= billing.legalName %>" placeholder="Nombre o razón social" class="zilo-input !py-2 text-sm">
          <input type="text" id="billGiro" value="<%= billing.giro %>" placeholder="Giro comercial (empresa)" class="zilo-input !py-2 text-sm <%= billing.type === 'empresa' ? '' : 'hidden' %>">
          <input type="text" id="billFiscalAddress" value="<%= billing.fiscalAddress %>" placeholder="Dirección fiscal" class="zilo-input !py-2 text-sm">
          <input type="email" id="billInvoiceEmail" value="<%= billing.invoiceEmail %>" placeholder="Email facturación" class="zilo-input !py-2 text-sm">
        </div>
      </div>
    </section>
    <% } %>

    <% const mpCred = typeof mpCredentialStatus !== 'undefined' ? mpCredentialStatus : {}; %>
    <% if (typeof mpSandboxPayments !== 'undefined' && mpSandboxPayments && mpCred.sandboxCredentialSource === 'prod_in_demo_blocked') { %>
    <p class="text-xs text-red-900 p-3 rounded-xl border border-red-200 bg-red-50 text-center" id="mpProdInDemoWarn">
      <strong>Demo no usa credenciales de producción.</strong> Tienes <code>MP_PUBLIC_KEY</code> / <code>MP_ACCESS_TOKEN</code> pero faltan <code>MP_TEST_PUBLIC_KEY</code> y <code>MP_TEST_ACCESS_TOKEN</code> (bloque «Credenciales de prueba»). Puedes dejar las de producción en Hostinger; en demo solo se leen las <code>MP_TEST_*</code>.
    </p>
    <% } else if (typeof mpSandboxMissingTestPk !== 'undefined' && mpSandboxMissingTestPk) { %>
    <p class="text-xs text-red-900 p-3 rounded-xl border border-red-200 bg-red-50 text-center" id="mpSandboxTestPkWarn">
      <strong>Pago en prueba bloqueado:</strong> falta <code>MP_TEST_PUBLIC_KEY</code> en Hostinger. Mercado Pago Developers → tu app → <strong>Credenciales de prueba</strong> → copia <strong>Public Key</strong> ahí. Reinicia la app.
    </p>
    <% } else if (typeof mpSandboxMissingTestToken !== 'undefined' && mpSandboxMissingTestToken) { %>
    <p class="text-xs text-red-900 p-3 rounded-xl border border-red-200 bg-red-50 text-center" id="mpSandboxTestTokenWarn">
      <strong>Falta el Access Token de prueba:</strong> crea <code>MP_TEST_ACCESS_TOKEN</code> en Hostinger con el valor de <strong>Credenciales de prueba → Access Token</strong> (misma pantalla que la Public Key). No uses <code>MP_ACCESS_TOKEN</code> de producción en DEMO.
    </p>
    <% } else if (typeof mpCredentialMismatch !== 'undefined' && mpCredentialMismatch) { %>
    <p class="text-xs text-red-900 p-3 rounded-xl border border-red-200 bg-red-50 text-center" id="mpCredentialMismatchWarn">
      <strong>Credenciales Mercado Pago mezcladas.</strong> En Hostinger, <code>MP_PUBLIC_KEY</code> y <code>MP_ACCESS_TOKEN</code> deben copiarse del <strong>mismo bloque</strong> (Credenciales de prueba o de producción) en Mercado Pago Developers. Si no, aparece «Card Token not found».
    </p>
    <% } else if (typeof mpSandboxPayments !== 'undefined' && mpSandboxPayments && mpCred.testEnvPresent) { %>
    <p class="text-xs text-sky-900 p-3 rounded-xl border border-sky-200 bg-sky-50 text-center">
      Modo <strong>demo</strong> — usa el bloque <strong>Credenciales de prueba</strong> de Mercado Pago en <code>MP_TEST_*</code>.
      En el formulario: nombre del titular <strong>APRO</strong>, RUT <strong>123456789</strong>, CVV cualquiera.
      Si MP dice «producción en modo prueba», el valor de <code>MP_TEST_ACCESS_TOKEN</code> es de producción: vuelve a copiarlo del bloque amarillo de prueba y reinicia la app.
    </p>
    <% } else if (typeof mpSandboxPayments !== 'undefined' && !mpSandboxPayments) { %>
    <p class="text-xs text-amber-900 p-3 rounded-xl border border-amber-200 bg-amber-50 text-center">
      Modo <strong>productivo</strong> — las tarjetas de prueba de Mercado Pago no funcionan. Usa tarjeta real o cambia a Demo en Admin.
    </p>
    <% } else if (mpGwOnly && mpConfigured && !mpEmbedCheckout) { %>
    <p class="text-xs text-amber-900 p-3 rounded-xl border border-amber-200 bg-amber-50 text-center" id="mpEmbedSetupWarn">
      Falta <strong>MP_PUBLIC_KEY</strong> en el servidor para el formulario de tarjeta en Fandez. Mientras tanto no uses el botón que abre Mercado Pago: configura la clave pública en Hostinger o paga por transferencia.
    </p>
    <% } %>

    <section id="mpEmbedSection" class="<%= mpEmbedCheckout ? '' : 'hidden' %> zilo-card-premium rounded-2xl p-4 sm:p-5 checkout-mp-block" aria-label="Pago con tarjeta Mercado Pago">
      <h2 class="zilo-label mb-1"><%= t('checkout.payment_title') %></h2>
      <p class="text-xs text-zilo-muted mb-2">Pagas sin salir de Fandez. Mercado Pago procesa el cobro de forma segura.</p>
      <%- include('../partials/mp-card-brands') %>
      <% if (typeof mpSandboxPayments !== 'undefined' && mpSandboxPayments) { %>
      <p class="text-[11px] text-sky-900 mb-3 p-2 rounded-lg bg-sky-50 border border-sky-100">
        Prueba: titular <strong>APRO</strong> · RUT <strong>123456789</strong> · CVV 123 · vencimiento futuro.
      </p>
      <% } %>
      <div id="mpBrickLoading" class="mp-brick-skeleton" aria-live="polite" aria-busy="true">
        <p class="text-sm font-semibold text-zilo-text mb-1">Preparando formulario seguro…</p>
        <p class="text-[11px] text-zilo-muted mb-4">Tu pago se carga en esta misma pantalla. No cierres ni vuelvas atrás.</p>
        <div class="mp-brick-skeleton__field"></div>
        <div class="mp-brick-skeleton__row">
          <div class="mp-brick-skeleton__field"></div>
          <div class="mp-brick-skeleton__field"></div>
        </div>
        <div class="mp-brick-skeleton__field"></div>
        <div class="mp-brick-skeleton__field"></div>
        <div class="mp-brick-skeleton__btn"></div>
      </div>
      <div id="mpCardPaymentBrick"></div>
      <p class="text-[10px] text-zilo-muted mt-3 text-center">Fandez no guarda datos de tu tarjeta</p>
    </section>

    <% if (billingComplete) { %>
    <section class="zilo-card-premium rounded-2xl p-4" id="billingSection" data-complete="1">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="zilo-label mb-0"><%= t('checkout.billing_compact') %></h2>
          <p class="text-[11px] text-zilo-muted mt-1 truncate" id="billingSummaryLine">
            <%= billing.legalName %> · <%= billing.rut %>
          </p>
        </div>
        <button type="button" id="btnEditBilling" class="text-xs font-semibold text-zilo-accent shrink-0"><%= t('checkout.billing_edit') %></button>
      </div>
      <div id="billingFields" class="hidden mt-3">
        <div class="grid grid-cols-2 gap-2 mb-3">
          <label class="flex items-center gap-2 p-2.5 rounded-xl border cursor-pointer billing-type-option text-xs <%= billing.type !== 'empresa' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>">
            <input type="radio" name="billingType" value="natural" <%= billing.type !== 'empresa' ? 'checked' : '' %> class="accent-[#C45C14]">
            <%= t('checkout.billing_natural') %>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl border cursor-pointer billing-type-option text-xs <%= billing.type === 'empresa' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>">
            <input type="radio" name="billingType" value="empresa" <%= billing.type === 'empresa' ? 'checked' : '' %> class="accent-[#C45C14]">
            <%= t('checkout.billing_company') %>
          </label>
        </div>
        <div class="space-y-2">
          <input type="text" id="billRut" value="<%= billing.rut %>" placeholder="RUT" class="zilo-input !py-2 text-sm">
          <input type="text" id="billLegalName" value="<%= billing.legalName %>" placeholder="Nombre o razón social" class="zilo-input !py-2 text-sm">
          <input type="text" id="billGiro" value="<%= billing.giro %>" placeholder="Giro comercial (empresa)" class="zilo-input !py-2 text-sm <%= billing.type === 'empresa' ? '' : 'hidden' %>">
          <input type="text" id="billFiscalAddress" value="<%= billing.fiscalAddress %>" placeholder="Dirección fiscal" class="zilo-input !py-2 text-sm">
          <input type="email" id="billInvoiceEmail" value="<%= billing.invoiceEmail %>" placeholder="Email facturación" class="zilo-input !py-2 text-sm">
        </div>
      </div>
      <p class="text-[11px] text-emerald-700 mt-2" id="billingUseProfileHint"><%= t('checkout.billing_use_profile') %></p>
    </section>
    <% } %>

    <details class="checkout-details zilo-card-premium rounded-2xl overflow-hidden group">
      <summary class="p-4 cursor-pointer list-none flex items-center justify-between gap-2 text-sm font-semibold text-zilo-text">
        <span><%= t('checkout.detail_toggle') %></span>
        <span class="text-zilo-muted text-xs font-normal group-open:hidden"><%= service.name %></span>
      </summary>
      <div class="px-4 pb-4 pt-0 space-y-2 border-t border-zilo-border/80">
    <div class="pt-3 text-xs text-zilo-muted">
        <p class="mb-1"><%= request.address %></p>
      <% if (request.squareMeters) { %>
        <p class="text-xs text-zilo-muted mt-1"><%= request.squareMeters %> m² · <%= request.activityName || service.name %></p>
      <% } %>
      <% if (request.gardenIntake && request.gardenIntake.serviceTypeLabels) { %>
        <div class="text-xs text-zilo-muted mt-2 leading-relaxed space-y-1">
          <p><strong class="text-zilo-text">Paisajismo</strong> · <%= request.gardenIntake.serviceTypeLabels.join(', ') %></p>
          <p><%= request.gardenIntake.locationSector %> · <%= request.gardenIntake.propertyTypeLabel %></p>
          <% if (request.gardenIntake.hasDigitalPlan) { %>
            <p>Con plano digital<% if (request.gardenIntake.planFileUrl) { %> · <a href="<%= request.gardenIntake.planFileUrl %>" class="text-zilo-accent underline" target="_blank" rel="noopener">Ver PDF</a><% } %></p>
          <% } else { %>
            <p>Sin plano · visita de levantamiento confirmada</p>
          <% } %>
          <% if (request.gardenIntake.maintenanceFrequencyLabel) { %>
            <p>Mantención: <%= request.gardenIntake.maintenanceFrequencyLabel %></p>
          <% } %>
          <% if (request.gardenIntake.designAddonLabels && request.gardenIntake.designAddonLabels.length) { %>
            <p>Complementos diseño: <%= request.gardenIntake.designAddonLabels.join(', ') %></p>
          <% } %>
          <% if (request.gardenIntake.constructionScopeLabel) { %>
            <p><%= request.gardenIntake.constructionScopeLabel %></p>
          <% } %>
          <p class="text-[11px]">Pago inicial: evaluación técnica. Modalidades de obra según servicio aceptadas.</p>
        </div>
      <% } else if (request.landscapeProject && request.landscapeProject.standardLabel) { %>
        <p class="text-xs text-zilo-muted mt-1 leading-relaxed">
          <%= request.landscapeProject.standardLabel %>
          · <%= request.landscapeProject.terrainLabel %>
          · <%= request.landscapeProject.speciesLabel %>
          <% const inc = request.landscapeProject.includes || {}; %>
          <% const incList = []; %>
          <% if (inc.design) incList.push('diseño'); %>
          <% if (inc.irrigation) incList.push('riego'); %>
          <% if (inc.earthwork) incList.push('mov. tierra'); %>
          <% if (inc.lighting) incList.push('iluminación'); %>
          <% if (incList.length) { %> · Incluye: <%= incList.join(', ') %><% } %>
        </p>
      <% } %>
      <% if (request.cleaningFactors) { %>
        <p class="text-xs text-zilo-muted mt-1 leading-relaxed">
          Materiales incluidos
          <% if (request.cleaningFactors.hasPets) { %> · Mascotas (+15%)<% } %>
          <% if (request.cleaningFactors.postEvent) { %> · Post evento (+15%)<% } %>
        </p>
      <% } %>
      <% if (request.urgencyTierLabel) {
        const arrival = (typeof summary !== 'undefined' && summary.arrivalDisplay)
          || { urgent: request.urgencyTier === 'immediate' || request.urgencyTier === 'critical', prefix: (request.urgencyTier === 'immediate' || request.urgencyTier === 'critical') ? 'Urgencia' : 'Llegada', label: request.urgencyTierLabel };
      %>
        <p class="text-xs <%= arrival.urgent ? 'text-zilo-accent' : 'text-zilo-muted' %> mt-2"><%= arrival.prefix %>: <strong><%= arrival.label || request.urgencyTierLabel %></strong></p>
      <% } %>
      <% if (request.isGift) { %>
        <p class="text-xs text-zilo-accent mt-2">Regalo para <strong><%= request.beneficiaryName %></strong></p>
      <% } %>
    </div>

    <section class="pt-3 mt-3 border-t border-zilo-border/80" id="summaryBox">
      <h2 class="zilo-label mb-3 text-[10px]">Desglose</h2>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between checkout-line pb-2">
          <span class="text-zilo-muted">Visita técnica (base)</span>
          <span id="lineVisitBase"><%= formatCLP(summary.visitBaseBeforeZone != null ? summary.visitBaseBeforeZone : (summary.visitBasePrice || summary.visitSubtotal)) %></span>
        </div>
        <% const zoneAmt = Number(summary.zoneAdjustmentAmount) || 0; const zoneMeta = summary.zone || null; %>
        <div class="flex justify-between checkout-line pb-2 <%= zoneAmt ? '' : 'hidden' %>" id="lineZoneRow">
          <span class="text-zilo-muted" id="lineZoneLabel">
            <% if (zoneAmt && zoneMeta) {
              const km = zoneMeta.distanceKm != null ? zoneMeta.distanceKm : '—';
              const origin = zoneMeta.originLabel || 'Ñuñoa';
              const commune = zoneMeta.communeName || '';
              const pct = Math.abs(zoneMeta.totalPercent || zoneMeta.communePercent || zoneMeta.distancePercent || 0);
            %>
              <% if (zoneMeta.mode === 'commune' || commune) { %>
                Adicional por comuna (<%= commune || 'zona' %><% if (pct) { %> · +<%= pct %>%<% } %>)
              <% } else { %>
                Adicional por zona / distancia (<%= origin %> · <%= km %> km<% if (pct) { %> · +<%= pct %>%<% } %>)
              <% } %>
            <% } else { %>
              Adicional por comuna
            <% } %>
          </span>
          <span id="lineZone" class="text-orange-600"><%= zoneAmt ? ('+' + formatCLP(zoneAmt)) : '—' %></span>
        </div>
        <div class="flex justify-between checkout-line pb-2 <%= summary.scheduleAdjustmentAmount ? '' : 'hidden' %>" id="lineScheduleRow">
          <span class="text-zilo-muted" id="lineScheduleLabel">
            <% if (summary.scheduleAdjustmentAmount) {
              const band = summary.scheduleBand === 'tarde' ? 'tarde' : (summary.scheduleBand === 'nocturno' ? 'madrugada' : 'horario');
              const pct = Math.abs(summary.scheduleAdjustmentPercent || 0);
            %>
              Recargo <%= band %><% if (pct) { %> (+<%= pct %>%)<% } %>
            <% } else { %>
              Recargo horario
            <% } %>
          </span>
          <span id="lineSchedule"><%= summary.scheduleAdjustmentAmount ? ((summary.scheduleAdjustmentAmount > 0 ? '+' : '') + formatCLP(summary.scheduleAdjustmentAmount)) : '—' %></span>
        </div>
        <div class="flex justify-between checkout-line pb-2 <%= summary.urgencyOnlyAdjustmentAmount ? '' : 'hidden' %>" id="lineUrgencyRow">
          <span class="text-zilo-muted" id="lineUrgencyLabel">
            <% if (summary.urgencyOnlyAdjustmentAmount) {
              const upct = summary.urgencyOnlyPercent != null ? Math.abs(summary.urgencyOnlyPercent) : null;
            %>
              <%= summary.urgencyTierLabel || 'Ajuste urgencia' %><% if (upct) { %> (<%= summary.urgencyOnlyAdjustmentAmount > 0 ? '+' : '' %><%= upct %>%)<% } %>
            <% } else { %>
              <%= summary.urgencyTierLabel || 'Ajuste urgencia' %>
            <% } %>
          </span>
          <span id="lineUrgency"><%= summary.urgencyOnlyAdjustmentAmount ? ((summary.urgencyOnlyAdjustmentAmount > 0 ? '+' : '') + formatCLP(summary.urgencyOnlyAdjustmentAmount)) : '—' %></span>
        </div>
        <div class="flex justify-between checkout-line pb-2 border-b border-zilo-border">
          <span class="text-zilo-muted font-medium">Subtotal visita</span>
          <span id="lineBase" class="font-medium"><%= formatCLP(summary.basePrice) %></span>
        </div>
        <div class="flex justify-between checkout-line pb-2 text-zilo-muted/80 <%= summary.servicePriceBase ? '' : 'hidden' %>">
          <span class="text-xs">Servicio estimado <span class="text-[10px]">(se paga en sitio)</span></span>
          <span id="lineService" class="text-xs"><%= formatCLP(summary.servicePriceBase || 0) %></span>
        </div>
        <div class="flex justify-between checkout-line pb-2 hidden" id="linePromoRow">
          <span class="text-zilo-muted">Promoción</span>
          <span id="linePromo" class="checkout-discount">—</span>
        </div>
        <div class="flex justify-between checkout-line pb-2 hidden" id="lineCreditsRow">
          <span class="text-zilo-muted">Crédito Fandez</span>
          <span id="lineCredits" class="checkout-discount">—</span>
        </div>
        <div class="flex justify-between checkout-line pb-2 hidden" id="linePointsRow">
          <span class="text-zilo-muted">Puntos canjeados</span>
          <span id="linePoints" class="checkout-discount">—</span>
        </div>
        <div class="flex justify-between pt-2">
          <strong>Total a pagar</strong>
          <strong class="text-zilo-accent text-lg" id="lineTotal"><%= formatCLP(summary.amountDue) %></strong>
        </div>
        <p class="text-[10px] text-zilo-muted mt-2 text-right">Precio final · IVA incluido</p>
      </div>
    </section>
      </div>
    </details>

    <details class="checkout-details zilo-card-premium rounded-2xl overflow-hidden group">
      <summary class="p-4 cursor-pointer list-none text-sm font-semibold text-zilo-text"><%= t('checkout.extras_toggle') %></summary>
      <div class="px-4 pb-4 pt-0 border-t border-zilo-border/80 space-y-4">

    <% if (hidePaymentPicker && summary.cardEnabled && enabledCardGateways && enabledCardGateways.length === 1) { %>
    <input type="hidden" name="paymentMethod" value="card" id="hiddenPaymentMethodCard">
    <input type="hidden" name="cardGateway" value="<%= enabledCardGateways[0].id %>" id="defaultCardGatewayInput">
    <% } %>

    <section class="pt-3 space-y-4">
      <h2 class="zilo-label">Beneficios Fandez</h2>

      <% if (referral.creditsCLP > 0) { %>
      <label class="flex items-center justify-between gap-3 cursor-pointer">
        <div>
          <strong class="text-sm block">Usar abono / crédito Fandez</strong>
          <span class="text-xs text-zilo-success"><%= formatCLP(referral.creditsCLP) %> disponible</span>
        </div>
        <input type="checkbox" id="useCredits" class="w-5 h-5 rounded accent-[#C45C14]" checked>
      </label>
      <% } %>

      <% if (mod('client_puntos') && referral.points > 0) { %>
      <label class="flex items-center justify-between gap-3 cursor-pointer <%= referral.creditsCLP > 0 ? 'pt-3 border-t border-gray-200' : '' %>">
        <div>
          <strong class="text-sm block">Canjear Puntos Fandez</strong>
          <span class="text-xs text-zilo-muted"><%= referral.points %> pts = <%= formatCLP(referral.points * pointsValue) %></span>
        </div>
        <input type="checkbox" id="usePoints" class="w-5 h-5 rounded accent-[#C45C14]">
      </label>
      <% } %>

      <div class="<%= (referral.creditsCLP > 0 || (mod('client_puntos') && referral.points > 0)) ? 'pt-3 border-t border-gray-200' : '' %>">
        <label class="zilo-label block mb-2">Código promocional</label>
        <div class="flex gap-2">
          <input type="text" id="promoCode" placeholder="Ingresa tu código" maxlength="24" autocomplete="off"
            class="zilo-input flex-1 uppercase font-mono text-sm">
          <button type="button" id="btnApplyPromo" class="zilo-btn-ghost shrink-0">Aplicar</button>
        </div>
        <p id="promoFeedback" class="hidden text-[11px] mt-1.5"></p>
      </div>
    </section>
      </div>
    </details>

    <section id="paymentMethodSection" class="zilo-card-premium rounded-2xl p-5 space-y-3 <%= hidePaymentPicker ? 'hidden' : '' %>">
      <h2 class="zilo-label"><%= t('checkout.payment_title') %></h2>
      <% if (summary.cardEnabled && typeof enabledCardGateways !== 'undefined' && enabledCardGateways.length) { %>
      <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer payment-option <%= (summary.paymentMethod || 'card') === 'card' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>" data-method="card">
        <input type="radio" name="paymentMethod" value="card" <%= (summary.paymentMethod || 'card') === 'card' ? 'checked' : '' %> class="mt-0.5 accent-[#C45C14]">
        <div class="flex-1">
          <strong class="text-sm block">Tarjeta débito / crédito</strong>
          <span class="text-xs text-zilo-muted">Pago seguro · crédito hasta <%= Number(summary.maxCardInstallments) || 3 %> cuotas</span>
        </div>
      </label>
      <% if (enabledCardGateways.length > 1) { %>
      <div id="cardGatewayPicker" class="ml-4 pl-3 border-l-2 border-zilo-border space-y-2 <%= (summary.paymentMethod || 'card') === 'card' ? '' : 'hidden' %>">
        <% enabledCardGateways.forEach((gw, i) => { %>
          <label class="flex items-center gap-2 text-xs cursor-pointer">
            <input type="radio" name="cardGateway" value="<%= gw.id %>" <%= i === 0 ? 'checked' : '' %> class="accent-[#C45C14]">
            <%= gw.label %>
          </label>
        <% }); %>
      </div>
      <% } else if (enabledCardGateways.length === 1 && !hidePaymentPicker) { %>
      <input type="hidden" name="cardGateway" value="<%= enabledCardGateways[0].id %>" id="defaultCardGatewayInput">
      <% } %>
      <% } %>
      <% if (summary.transferEnabled) { %>
      <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer payment-option <%= summary.paymentMethod === 'transfer' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>" data-method="transfer">
        <input type="radio" name="paymentMethod" value="transfer" <%= summary.paymentMethod === 'transfer' ? 'checked' : '' %> class="mt-0.5 accent-[#C45C14]">
        <div class="flex-1">
          <strong class="text-sm block">Transferencia bancaria</strong>
          <span class="text-xs text-emerald-600">Sin recargo</span>
        </div>
      </label>
      <% } %>
    </section>

    <% if (!mpConfigured && (summary.paymentMethod || 'card') === 'card') { %>
    <p class="text-xs text-amber-800 p-3 rounded-xl border border-amber-200 bg-amber-50 text-center">
      Sin pasarela real — al tocar pagar se confirma un Mercado Pago de prueba y el pedido sigue
    </p>
    <% } else if (!paymentFirst && cardGateway && (summary.paymentMethod || 'card') === 'card') { %>
    <p class="text-xs text-zilo-muted p-3 rounded-xl border border-zilo-border bg-zilo-bg/50 text-center" id="checkoutGatewayHint">
      Pago seguro con <strong><%= cardGateway.label %></strong>.
    </p>
    <% } %>

    <button type="button" id="btnPay" class="zilo-btn-primary <%= (mpCanShowBrick && mpEmbedCheckout) ? 'hidden' : '' %>">
      <span id="btnPayLabel"><%= t('checkout.continue') %></span>
    </button>
    <a href="/cliente" class="block text-center text-sm text-zilo-muted hover:text-gray-700 py-2">Cancelar</a>
  </main>

  <div id="stickyCheckoutBar" class="sticky-order-bar is-visible">
    <div class="sticky-order-inner max-w-lg mx-auto">
      <div class="min-w-0">
        <p class="text-[10px] text-zilo-muted uppercase tracking-wide">Total a pagar</p>
        <strong class="text-zilo-accent text-base" id="stickyCheckoutTotal"><%= formatCLP(summary.amountDue) %></strong>
      </div>
      <button type="button" id="btnPaySticky" class="sticky-order-btn"><%= t('checkout.pay_now') %></button>
    </div>
  </div>
</div>

<% if (mpEmbedCheckout) { %>
<script src="https://sdk.mercadopago.com/js/v2"></script>
<script src="/js/checkout-mp-brick.js?v=20261009-visa3"></script>
<% } %>

<%- include('../partials/footer', { extraScripts: ['/js/checkout-page.js'] }) %>
