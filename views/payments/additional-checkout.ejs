<%- include('../partials/head') %>
<%
  const isApprox = charge.approximate === true
    || charge.reason === 'materials_approx'
    || ((charge.materialsApproxBase || 0) > 0 && (charge.reason === 'activity_change' || charge.reason === 'change_order'));
  const isTrueUp = charge.reason === 'materials' && charge.approximate !== true;
  const laborPart = Math.max(0, charge.laborDeltaBase || 0);
  const matPart = Math.max(0, charge.materialsApproxBase || 0);
%>

<div class="max-w-lg mx-auto min-h-screen flex flex-col pb-8 zilo-page-enter" id="additionalCheckout"
  data-request-id="<%= request.id %>" data-charge-id="<%= charge.id %>">
  <header class="sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border px-5 py-4">
    <div class="flex items-center gap-3">
      <a href="/cliente/servicio/<%= request.serviceId %>?tracking=<%= request.id %>"
        class="w-10 h-10 rounded-full zilo-card-premium flex items-center justify-center">
        <svg class="w-5 h-5 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <p class="zilo-label"><%= isTrueUp ? 'Regularización por boleta o factura' : (isApprox ? 'Cobro aproximado' : 'Ajuste aprobado') %></p>
        <h1 class="font-semibold"><%= service.name %></h1>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 space-y-4 pb-28">
    <section class="zilo-card-premium rounded-2xl p-5">
      <p class="zilo-label mb-2">Detalle</p>
      <p class="text-sm font-medium"><%= charge.description %></p>
      <% if (isApprox) { %>
        <div class="mt-3 p-3 rounded-xl border border-amber-200 bg-amber-50 text-[11px] text-amber-950 space-y-1.5 leading-relaxed">
          <p><strong>Precio aproximado</strong> según catálogo de mercado.</p>
          <p>1. Ahora se cobra este monto a tu tarjeta para autorizar la compra.</p>
          <p>2. El técnico sube la boleta o factura real del producto.</p>
          <p>3. Validamos el precio final: si la boleta o factura es mayor o menor, habrá un ajuste (cobro o devolución). Así te aseguras el monto más correcto.</p>
        </div>
      <% } else if (isTrueUp) { %>
        <div class="mt-3 p-3 rounded-xl border border-emerald-200 bg-emerald-50 text-[11px] text-emerald-950 leading-relaxed">
          Este cobro es la <strong>diferencia validada con la boleta o factura</strong> respecto al monto aproximado que ya pagaste. Es el precio correcto del producto.
        </div>
      <% } else { %>
        <p class="text-xs text-zilo-muted mt-2">El trabajo continuará cuando se confirme este pago.</p>
      <% } %>
    </section>

    <section class="zilo-card-premium rounded-2xl p-5">
      <h2 class="zilo-label mb-4"><%= isApprox ? 'Total aproximado a pagar' : 'Total del ajuste' %></h2>
      <div class="space-y-2 text-sm">
        <% if (laborPart > 0) { %>
        <div class="flex justify-between">
          <span class="text-zilo-muted">Mano de obra / servicio</span>
          <span><%= formatCLP(laborPart) %></span>
        </div>
        <% } %>
        <% if (matPart > 0) { %>
        <div class="flex justify-between">
          <span class="text-zilo-muted">Producto / material <%= isApprox ? '(aprox.)' : '' %></span>
          <span><%= formatCLP(matPart) %></span>
        </div>
        <% } %>
        <% if (!laborPart && !matPart) { %>
        <div class="flex justify-between">
          <span class="text-zilo-muted"><%= isTrueUp ? 'Diferencia por boleta o factura' : 'Servicio adicional' %></span>
          <span><%= formatCLP(charge.baseAmount) %></span>
        </div>
        <% } %>
        <div class="flex justify-between pt-3 border-t border-zilo-border">
          <strong><%= isApprox ? 'Total aprox.' : 'Total a pagar' %></strong>
          <strong class="text-zilo-accent text-lg"><%= formatCLP(charge.amountDue) %></strong>
        </div>
      </div>
      <% if (isApprox) { %>
        <p class="text-[11px] text-zilo-muted mt-3">Pueden haber modificaciones al validar la boleta o factura. Te avisaremos si hay diferencia.</p>
      <% } %>
    </section>

    <% if (enabledCardGateways.length > 1) { %>
    <section class="zilo-card-premium rounded-2xl p-5">
      <p class="zilo-label mb-3">Pasarela de pago</p>
      <div class="space-y-2">
        <% enabledCardGateways.forEach((gateway, index) => { %>
        <label class="flex items-center gap-3 p-3 rounded-xl border border-zilo-border cursor-pointer">
          <input type="radio" name="cardGateway" value="<%= gateway.id %>" <%= index === 0 ? 'checked' : '' %>>
          <span class="text-sm"><%= gateway.label %></span>
        </label>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% if (demoMode) { %>
    <p class="text-xs text-zilo-warning/90 p-3 rounded-xl border border-zilo-warning/20 bg-zilo-warning/5 text-center">
      Sin pasarela de tarjeta configurada — confirmación de prueba para no bloquear el servicio
    </p>
    <% } else if (cardGateway) { %>
    <p class="text-xs text-zilo-muted text-center">Pago seguro con <strong><%= cardGateway.label %></strong>.</p>
    <% } %>

    <button type="button" id="btnPayAdjustment" class="zilo-btn-primary">
      <%= demoMode ? 'Confirmar y continuar' : (isApprox ? 'Pagar monto aproximado' : 'Pagar ajuste con tarjeta') %>
    </button>
  </main>
</div>

<script>
(function () {
  const page = document.getElementById('additionalCheckout');
  const btn = document.getElementById('btnPayAdjustment');
  btn.addEventListener('click', async () => {
    btn.disabled = true;
    try {
      const endpoint = <%- JSON.stringify(demoMode ? '/pagos/ajuste/demo/confirmar' : '/pagos/ajuste/crear') %>;
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          requestId: page.dataset.requestId,
          chargeId: page.dataset.chargeId,
          cardGateway: document.querySelector('input[name="cardGateway"]:checked')?.value || null
        })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.error || 'No se pudo procesar el pago');
      if (data.demo) {
        const confirmRes = await fetch('/pagos/ajuste/demo/confirmar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ requestId: page.dataset.requestId, chargeId: page.dataset.chargeId })
        });
        const confirmed = await confirmRes.json().catch(() => ({}));
        if (!confirmRes.ok || !confirmed.success) throw new Error(confirmed.error || 'No se pudo confirmar');
        window.location.href = confirmed.redirect;
        return;
      }
      if (!data.redirect) throw new Error('No se recibió el enlace de pago');
      window.location.href = data.redirect;
    } catch (err) {
      btn.disabled = false;
      FandezNotify.show(err.message || 'Error al pagar', 'error');
    }
  });
})();
</script>

<%- include('../partials/footer') %>
