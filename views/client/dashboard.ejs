<%- include('../partials/head') %>

<%
  const firstName = typeof profile !== 'undefined'
    ? (profile.displayFirstName || profile.firstName || user.name.split(' ')[0])
    : user.name.split(' ')[0];
  function livePhase(req) {
    const ts = String(req && req.techStatus || '');
    if (['en_sitio', 'diagnostico', 'reparando', 'comprando', 'presupuesto_pendiente', 'presupuesto_aprobado'].includes(ts)) return 3;
    if (ts === 'en_camino') return 2;
    if (req && (req.status === 'assigned' || req.status === 'in_progress')) return 1;
    return 0;
  }
%>
<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter home-client" id="clientDashboard">
  <header class="app-session-header client-session-header sticky top-0 z-50" data-tour="welcome">
    <div class="app-session-header__row client-session-header__row">
      <a href="/cliente/perfil" class="app-session-header__identity client-session-header__identity group" aria-label="<%= t('nav.profile') %>">
        <div class="app-session-header__avatar client-session-header__avatar">
          <%= typeof profile !== 'undefined' ? (profile.avatar || '?') : '?' %>
        </div>
        <div class="app-session-header__meta client-session-header__meta">
          <h1 class="client-session-header__name"><%= firstName %></h1>
        </div>
      </a>
      <div class="app-session-header__end client-session-header__end">
        <%- include('../partials/lang-switcher') %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
    <% const canSwitchModes = typeof canSwitchToProvider !== 'undefined' && canSwitchToProvider; %>
    <% if (canSwitchModes) { %>
    <div class="px-5 pb-3">
      <%- include('../partials/session-mode-switch', { activeMode: 'client' }) %>
      <p class="session-mode-switch__hint"><%= t('session.switch.hint') %></p>
    </div>
    <% } %>
  </header>

  <main class="flex-1 px-5 py-5 pb-24">
    <%- include('../partials/site-alert') %>
    <% if (typeof profile !== 'undefined' && profile && !profile.emailVerifiedAt) { %>
    <a href="/verificar-email" class="mb-4 block px-3 py-2 rounded-xl border border-amber-200 bg-amber-50 text-amber-950 text-xs font-medium">
      Confirma tu correo cuando puedas. Ya puedes pedir un técnico.
    </a>
    <% } %>

    <% const refundAttention = (typeof attentionItems !== 'undefined' ? attentionItems : []).filter(function(i){ return i.type === 'refund_pending'; }); %>
    <%
      function compactRefundBits(item) {
        const raw = String(item && item.body || '');
        const cut = raw.indexOf(':');
        const name = cut > 0 ? raw.slice(0, cut).trim() : String(item && item.title || '');
        const amountMatch = raw.match(/\$\s*[\d.]+/);
        const amount = amountMatch ? amountMatch[0].replace(/\s/g, '') : '';
        return { name: name || t('client.dashboard.refund_kicker'), amount: amount };
      }
    %>
    <% const hasActive = activeRequests && activeRequests.length > 0; %>
    <% const isReturning = Boolean((typeof lastCompleted !== 'undefined' && lastCompleted) || (passport && passport.entries && passport.entries.length)); %>

    <%
      let refundTotal = 0;
      refundAttention.forEach(function(item) {
        const bits = compactRefundBits(item);
        refundTotal += parseInt(String(bits.amount || '').replace(/[^\d]/g, ''), 10) || 0;
      });
      const refundHref = (refundAttention[0] && refundAttention[0].url) || '/cliente/historial';
    %>
    <% if (refundAttention.length || hasActive) { %>
    <section class="home-pulse-stack" aria-label="<%= t('client.dashboard.refund_section') %>">
      <% if (hasActive) { %>
      <div class="home-live-stack" id="clientActiveRequests">
        <% activeRequests.forEach(function(req) {
          const phase = livePhase(req);
          const barPct = Math.round(((phase + 1) / 4) * 100);
          const shortStatus = phase >= 3
            ? t('client.dashboard.live_step_home')
            : phase === 2
              ? t('client.dashboard.live_step_road')
              : phase === 1
                ? t('client.dashboard.live_step_assigned')
                : t('client.dashboard.live_step_search');
        %>
          <a href="/cliente/servicio/<%= req.serviceId %>?tracking=<%= req.id %>" class="home-live">
            <strong class="home-live__title"><%= req.serviceName %></strong>
            <p class="home-live__status"><%= shortStatus %></p>
            <span class="home-live__bar" aria-hidden="true"><i style="width:<%= barPct %>%"></i></span>
            <span class="home-live__cta"><%= t('client.dashboard.live_cta') %></span>
          </a>
        <% }); %>
      </div>
      <% } %>

      <% if (refundAttention.length && refundTotal > 0) { %>
      <a href="<%= refundHref %>" class="home-refund-line">
        <%= t('client.dashboard.refund_line', { amount: formatCLP(refundTotal) }) %>
      </a>
      <% } else if (refundAttention.length) { %>
      <a href="<%= refundHref %>" class="home-refund-line">
        <%= t('client.dashboard.refund_hook') %>
      </a>
      <% } %>
    </section>
    <% } %>

    <% if (hasActive) { %>
    <section class="mb-5">
      <% if (mod('client_solicitar')) { %>
        <div class="space-y-5 mb-2" data-tour="services" id="servicesSection">
          <div class="mb-1">
            <%- include('../partials/task-search', {
              taskSearchIndex: typeof taskSearchIndex !== 'undefined' ? taskSearchIndex : [],
              taskSearchMode: 'client',
              taskSearchVariant: 'home',
              taskSearchLabel: t('client.dashboard.ask_label'),
              taskSearchPlaceholder: t('client.dashboard.ask_label'),
              taskSearchHint: t('client.dashboard.ask_hint')
            }) %>
          </div>
          <div>
            <h3 class="home-section-title"><%= t('client.dashboard.now_title_active') %></h3>
            <%- include('../partials/client-service-grid', {
              services: (typeof servicesNow !== 'undefined' ? servicesNow : services).slice(0, 2),
              camino: 'ahora',
              gridId: 'servicesGridNowActive',
              formatCLP: formatCLP,
              t: t,
              lean: true
            }) %>
          </div>
        </div>
      <% } %>
    </section>

    <% } else { %>
    <!-- Modo calma: CTA única + servicios -->
    <section class="home-hero mb-5">
      <h2 class="home-hero__title"><%= t('client.dashboard.hero_title') %></h2>
      <% if (mod('client_solicitar')) { %>
      <div class="mb-1">
        <%- include('../partials/task-search', {
          taskSearchIndex: typeof taskSearchIndex !== 'undefined' ? taskSearchIndex : [],
          taskSearchMode: 'client',
          taskSearchVariant: 'home',
          taskSearchLabel: t('client.dashboard.ask_label'),
          taskSearchPlaceholder: t('client.dashboard.ask_label'),
          taskSearchHint: t('client.dashboard.ask_hint')
        }) %>
      </div>
      <% } %>
    </section>

    <% if (typeof lastCompleted !== 'undefined' && lastCompleted && mod('client_solicitar')) { %>
    <a href="/cliente/servicio/<%= lastCompleted.serviceId %>" class="home-repeat">
      <span class="home-repeat__kicker"><%= t('client.dashboard.repeat') %></span>
      <strong class="home-repeat__name"><%= lastCompleted.serviceName %></strong>
      <span class="home-repeat__sub"><%= t('client.dashboard.repeat_sub') %></span>
    </a>
    <% } %>

    <% if (mod('client_solicitar')) { %>
    <div class="space-y-6 mb-5" data-tour="services">
      <section>
        <h2 class="home-section-title"><%= t('client.dashboard.now_title') %></h2>
        <%- include('../partials/client-service-grid', { services: typeof servicesNow !== 'undefined' ? servicesNow : services, camino: 'ahora', gridId: 'servicesGridNow', formatCLP: formatCLP, t: t }) %>
      </section>
      <% if (mod('client_proyectos')) { %>
      <section class="pt-1">
        <h2 class="home-section-title"><%= t('client.dashboard.project_title') %></h2>
        <%- include('../partials/client-service-grid', { services: typeof servicesProject !== 'undefined' ? servicesProject : [], camino: 'proyecto', gridId: 'servicesGridProject', formatCLP: formatCLP, t: t }) %>
      </section>
      <% } %>
    </div>
    <% } else { %>
      <div class="zilo-empty zilo-card-premium rounded-2xl mb-5">
        <p class="zilo-display"><%= t('client.requests_paused') %></p>
        <p class="text-sm"><%= t('client.requests_paused_desc') %></p>
      </div>
    <% } %>

    <% if (isReturning && typeof passport !== 'undefined' && passport && mod('client_pasaporte')) { %>
    <a href="/cliente/hogar" data-tour="passport" class="block zilo-card-premium rounded-2xl p-4 mb-5 border border-zilo-accent/15 hover:border-zilo-accent/30 transition">
      <div class="flex items-center gap-4">
        <div class="zilo-health-ring !w-16 !h-16 shrink-0">
          <svg width="64" height="64" viewBox="0 0 64 64" class="!w-16 !h-16">
            <circle cx="32" cy="32" r="28" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="5"/>
            <circle cx="32" cy="32" r="28" fill="none" stroke="#C45C14" stroke-width="5" stroke-linecap="round"
              stroke-dasharray="<%= 2 * Math.PI * 28 %>"
              stroke-dashoffset="<%= 2 * Math.PI * 28 * (1 - passport.healthScore / 100) %>"/>
          </svg>
          <div class="score">
            <strong class="text-lg text-zilo-accent font-semibold"><%= passport.healthScore %></strong>
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <p class="zilo-label mb-0.5"><%= t('client.passport') %></p>
          <strong class="text-sm block"><%= t('client.passport.level.' + (passport.levelKey || 'fair')) %></strong>
          <span class="text-xs text-zilo-muted"><%= t('client.passport_records', { count: passport.entries.length }) %></span>
        </div>
        <svg class="w-5 h-5 text-zilo-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </div>
    </a>
    <% } %>

    <% if (isReturning && mod('client_referidos')) { %>
    <a href="/cliente/invitar" data-tour="points" class="flex items-center justify-between p-4 mb-5 rounded-2xl zilo-card-premium border border-zilo-accent/15 hover:border-zilo-accent/30 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-zilo-accent/10 flex items-center justify-center">
          <svg class="w-4 h-4 text-zilo-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div>
          <strong class="text-sm block"><%= t('client.dashboard.refer_cta_title') %></strong>
          <span class="text-[10px] text-zilo-muted"><%= t('client.dashboard.refer_cta_sub') %></span>
        </div>
      </div>
      <span class="text-xs text-zilo-accent font-medium"><%= t('client.invite_arrow') %></span>
    </a>
    <% } %>

    <details class="mb-2 group">
      <summary class="text-xs text-zilo-muted cursor-pointer list-none flex items-center gap-1 py-2">
        <span class="group-open:hidden"><%= t('client.dashboard.more_help') %></span>
        <span class="hidden group-open:inline"><%= t('client.dashboard.less_help') %></span>
      </summary>
      <div class="pt-2">
        <%- include('../partials/guide-card', {
          title: t('client.guide.card_title'),
          summary: t('client.guide.summary'),
          linkText: t('client.guide.link')
        }) %>
      </div>
    </details>
    <% } %>

    <% if (mod('client_historial')) { %>
    <a href="/cliente/historial" class="home-quiet-link">
      <span><%= t('client.dashboard.history_link_title') %></span>
      <span><%= t('client.dashboard.history_link_cta') %></span>
    </a>
    <% } %>
  </main>

  <%- include('../partials/nav-client', { navActive: 'inicio' }) %>
</div>

<%- include('../partials/guide-modal', {
  role: 'client',
  title: t('client.guide.title'),
  steps: [
    { title: t('client.guide.step1_title'), body: t('client.guide.step1_body'), tip: t('client.guide.step1_tip') },
    { title: t('client.guide.step2_title'), body: t('client.guide.step2_body'), tip: t('client.guide.step2_tip') },
    { title: t('client.guide.step3_title'), body: t('client.guide.step3_body'), tip: t('client.guide.step3_tip') },
    { title: t('client.guide.step4_title'), body: t('client.guide.step4_body'), tip: t('client.guide.step4_tip') },
    { title: t('client.guide.step5_title'), body: t('client.guide.step5_body') }
  ],
  extras: [
    { title: t('client.guide.extra_support_title'), body: t('client.guide.extra_support_body') },
    { title: t('client.guide.extra_gift_title'), body: t('client.guide.extra_gift_body') }
  ]
}) %>

<%- include('../partials/onboarding-tour') %>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  <% if (typeof referralBonus !== 'undefined' && referralBonus) { %>
  document.addEventListener('DOMContentLoaded', () => {
    const bonusMsg = (typeof FandezI18n !== 'undefined')
      ? FandezI18n.t('client.js.referral_bonus', { amount: '<%= referralBonus.toLocaleString(locale === "en" ? "en-US" : "es-CL") %>' })
      : '¡$<%= referralBonus.toLocaleString("es-CL") %> de crédito por invitación!';
    FandezNotify.show(bonusMsg, 'success');
  });
  <% } %>
  socket.on('modules_updated', ({ modules }) => {
    setTimeout(() => location.reload(), 600);
  });
  socket.on('services_updated', ({ services }) => {
    const grid = document.getElementById('servicesGrid');
    if (!grid) return;
    const active = services.filter(s => s.enabled);
    const locale = document.documentElement.lang === 'en' ? 'en-US' : 'es-CL';
    const fmt = n => new Intl.NumberFormat(locale, { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
    const averageLabel = (typeof FandezI18n !== 'undefined') ? FandezI18n.t('client.js.from_price') : 'promedio';
    const noServices = (typeof FandezI18n !== 'undefined') ? FandezI18n.t('client.js.no_services') : 'No hay servicios disponibles.';
    if (active.length === 0) {
      grid.innerHTML = `<div class="col-span-2 text-center py-16 text-zilo-muted"><p class="text-sm">${noServices}</p></div>`;
      return;
    }
    const minJobLabel = (typeof FandezI18n !== 'undefined') ? FandezI18n.t('client.js.min_job') : 'mín.';
    grid.innerHTML = active.map(s => `
      <a href="/cliente/servicio/${s.id}" class="group flex flex-col items-center gap-3 p-5 rounded-2xl zilo-card-premium hover:border-zilo-accent/25 transition-all">
        ${FandezIcons.wrap(s.icon, null, 'w-14 h-14', 28)}
        <span class="font-medium text-sm text-center px-1" style="overflow-wrap:anywhere">${s.name}</span>
        <span class="w-full text-center leading-tight">
          <span class="block text-[10px] text-zilo-muted">${averageLabel}</span>
          <span class="block text-xs font-medium text-zilo-muted tabular-nums">${fmt(s.averagePrice)}${s.pricingUnit === 'm2' ? ' / m²' : ''}</span>
          ${s.showMinJob && s.minJobPrice ? `<span class="block text-[10px] text-zilo-muted tabular-nums mt-0.5">${minJobLabel} ${fmt(s.minJobPrice)}</span>` : ''}
        </span>
      </a>
    `).join('');
  });

  socket.emit('aland_join', { clientId: '<%= user.id %>' });

  (function refreshAttentionAlerts() {
    if (!window.FandezAlerts) return;
    FandezAlerts.ensurePermission();
    const items = <%- JSON.stringify((typeof attentionItems !== 'undefined' ? attentionItems : []).filter(function(i){ return i.urgency === 'high'; }).slice(0, 2)) %>;
    items.forEach(function(item) {
      FandezAlerts.notify({
        type: 'alert',
        title: item.title,
        body: item.body,
        tag: 'fandez-attention-' + item.requestId + '-' + item.type,
        requireInteraction: true,
        url: item.url,
        system: true
      });
    });
  })();

  socket.on('client_open_request_alert', (payload) => {
    if (window.FandezAlerts) {
      FandezAlerts.notify({
        type: 'alert',
        title: payload?.title || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.open_request_title') : 'Open request'),
        body: payload?.body || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.open_request_body') : 'You have a pending request in Fandez.'),
        tag: 'fandez-open-' + (payload?.requestId || 'x'),
        requireInteraction: true,
        url: payload?.url || '/cliente',
        system: true
      });
    } else {
      FandezNotify.show(payload?.body || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.open_request_body') : 'You have a pending request'), 'warning');
    }
  });

  socket.on('client_tech_arrived', (payload) => {
    if (!payload || payload.techStatus !== 'en_sitio') return;
    if (window.FandezAlerts) {
      FandezAlerts.notify({
        type: 'alert',
        title: payload.title || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.arrived_alert_title') : 'Técnico en tu domicilio'),
        body: payload.body || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.arrived') : '¡Ha llegado!'),
        tag: 'fandez-arrived-' + (payload.requestId || 'x'),
        requireInteraction: true,
        url: payload.url || '/cliente',
        system: true
      });
    } else if (window.FandezNotify) {
      FandezNotify.show(payload.body || 'El técnico llegó a tu domicilio', 'info');
    }
  });

  socket.on('no_provider_choice_required', (payload) => {
    const url = payload?.url
      || (payload?.requestId ? `/cliente/solicitud/${encodeURIComponent(payload.requestId)}/sin-socio` : null)
      || '/cliente';
    if (window.FandezAlerts) {
      FandezAlerts.notify({
        type: 'alert',
        title: typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_title') : 'Sin socio aún',
        body: typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_notify_body') : 'Elige cómo continuar con tu búsqueda.',
        tag: 'fandez-no-provider',
        requireInteraction: true,
        url,
        system: true
      });
    } else if (window.FandezNotify) {
      FandezNotify.show(typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_notify_body') : 'Elige cómo continuar con tu búsqueda.', 'warning');
    }
    setTimeout(() => { window.location.href = url; }, 900);
  });
</script>

<%- include('../partials/footer', { pageScript: '/js/guide.js' }) %>
