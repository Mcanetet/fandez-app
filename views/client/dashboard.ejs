<%- include('../partials/head') %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="clientDashboard">
  <header class="app-session-header sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border" data-tour="welcome">
    <div class="app-session-header__row">
      <a href="/cliente/perfil" class="app-session-header__identity group">
        <div class="app-session-header__avatar group-hover:border-zilo-accent/40 transition">
          <%= typeof profile !== 'undefined' ? profile.name.split(' ').map(n=>n[0]).join('').slice(0,2) : '?' %>
        </div>
        <div class="app-session-header__meta">
          <span class="session-role-pill session-role-pill--client"><%= t('session.role.client') %></span>
          <h1><%= user.name.split(' ')[0] %></h1>
        </div>
      </a>
      <div class="app-session-header__end">
        <%- include('../partials/lang-switcher') %>
        <% if (typeof referral !== 'undefined' && referral.creditsCLP > 0) { %>
          <span class="px-2 py-1 rounded-lg bg-zilo-success/15 text-zilo-success text-[10px] font-semibold whitespace-nowrap"><%= formatCLP(referral.creditsCLP) %></span>
        <% } %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-24">
    <%- include('../partials/site-alert') %>

    <% if (typeof launchNoticeActive !== 'undefined' && launchNoticeActive) { %>
    <section class="mb-5 p-4 rounded-2xl border border-zilo-accent/25 bg-zilo-accent-soft/40">
      <p class="text-[10px] font-semibold uppercase tracking-wide text-zilo-accent mb-1"><%= t('launch.client.kicker') %></p>
      <p class="text-sm text-zilo-text leading-relaxed"><%= t('launch.banner.dashboard') %></p>
    </section>
    <% } %>

    <% const attentionList = typeof attentionItems !== 'undefined' ? attentionItems : []; %>
    <% const hasActive = activeRequests && activeRequests.length > 0; %>
    <% const isReturning = Boolean((typeof lastCompleted !== 'undefined' && lastCompleted) || (passport && passport.entries && passport.entries.length)); %>

    <% if (attentionList.length) { %>
    <section class="mb-5 p-4 rounded-2xl border border-amber-400/50 bg-amber-50" id="clientAttentionBanner">
      <p class="text-xs font-semibold text-amber-900 mb-1"><%= t('client.dashboard.pending_alert') %></p>
      <ul class="space-y-2">
        <% attentionList.slice(0, 3).forEach(function(item) { %>
          <li>
            <a href="<%= item.url %>" class="block p-3 rounded-xl bg-white/80 border border-amber-200 hover:border-amber-400 transition">
              <strong class="text-sm block text-zilo-text"><%= item.title %></strong>
              <span class="text-xs text-zilo-muted"><%= item.body %></span>
            </a>
          </li>
        <% }) %>
      </ul>
      <p class="text-[11px] text-amber-800/80 mt-3"><%= t('client.dashboard.cancel_policy_hint', {
        afterAccepted: typeof formatCLP === 'function' ? formatCLP((typeof cancellationPolicy !== 'undefined' && cancellationPolicy.afterTechAccepted) || 15000) : '$15.000',
        enRoute: typeof formatCLP === 'function' ? formatCLP((typeof cancellationPolicy !== 'undefined' && cancellationPolicy.enRouteOrOnSite) || 30000) : '$30.000'
      }) %></p>
    </section>
    <% } %>

    <% const pendingNoProvider = (activeRequests || []).filter(function(item) { return item.noProviderDecisionStatus === 'pending'; }); %>
    <% pendingNoProvider.forEach(function(item) { %>
    <section class="mb-5 p-4 rounded-2xl border border-amber-300 bg-amber-50" data-no-provider-card="<%= item.id %>">
      <p class="text-xs font-semibold text-aland-strong mb-1"><%= t('client.dashboard.action_required') %></p>
      <strong class="text-sm block mb-1"><%= t('client.dashboard.no_provider_title', { service: item.serviceName }) %></strong>
      <p class="text-xs text-amber-900 mb-3"><%= t('client.dashboard.no_provider_body', { minutes: (typeof requestTimeouts !== 'undefined' ? requestTimeouts.unassignedNoticeMinutes : 15) }) %></p>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-no-provider-choice="continue" data-request-id="<%= item.id %>"
          class="py-2.5 px-2 rounded-xl bg-zilo-accent text-white text-xs font-semibold"><%= t('client.js.no_provider_continue') %></button>
        <button type="button" data-no-provider-choice="refund" data-request-id="<%= item.id %>"
          class="py-2.5 px-2 rounded-xl bg-white border border-red-300 text-red-700 text-xs font-semibold"><%= t('client.dashboard.no_provider_refund_btn') %></button>
      </div>
    </section>
    <% }); %>

    <% if (hasActive) { %>
    <!-- Modo visita activa: tracking + opción de pedir otro servicio -->
    <section class="mb-6">
      <div class="flex items-center justify-between mb-3">
        <h2 class="zilo-label !mb-0"><%= t('client.in_progress') %></h2>
        <span class="text-[10px] font-semibold text-zilo-accent"><%= t(activeRequests.length === 1 ? 'client.dashboard.active_one' : 'client.dashboard.active_many', { count: activeRequests.length }) %></span>
      </div>
      <div class="space-y-2">
        <% activeRequests.forEach(function(req) { %>
          <a href="/cliente/servicio/<%= req.serviceId %>?tracking=<%= req.id %>"
            class="flex items-center gap-3 p-4 rounded-2xl zilo-card-premium border border-zilo-accent/20 hover:border-zilo-accent/40 transition">
            <div class="w-11 h-11 rounded-xl bg-zilo-accent/10 text-zilo-accent flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <strong class="text-sm block truncate"><%= req.serviceName %></strong>
              <% if (req.isGift) { %><span class="text-[10px] text-zilo-accent"><%= t('client.dashboard.gift_badge') %> · <%= req.beneficiaryName %></span><% } %>
              <span class="text-xs text-zilo-muted block mt-0.5 truncate"><%= req.statusLabel || req.status %></span>
            </div>
            <span class="text-[11px] font-semibold text-zilo-accent shrink-0"><%= t('client.dashboard.follow') %></span>
          </a>
        <% }); %>
      </div>
    </section>

    <% if (mod('client_solicitar')) { %>
    <h2 class="zilo-label mb-1" data-tour="services" id="servicesSection"><%= t('client.dashboard.request_another') %></h2>
    <p class="text-xs text-zilo-muted mb-3"><%= t('client.dashboard.request_another_hint') %></p>
    <div id="servicesGrid" class="grid grid-cols-2 gap-3 mb-5">
      <% (services || []).forEach(function(service, idx) { %>
        <a href="/cliente/servicio/<%= service.id %>" data-service-id="<%= service.id %>"
          class="service-item group flex flex-col items-center gap-3 p-5 rounded-2xl zilo-card-premium hover:border-zilo-accent/25 hover:-translate-y-0.5 transition-all duration-300 <%= idx >= 6 ? 'hidden service-item--extra' : '' %>">
          <%- include('../partials/service-icon', { icon: service.icon, size: 'lg' }) %>
          <span class="font-medium text-sm text-center leading-tight px-1" style="overflow-wrap:anywhere"><%= service.name %></span>
          <span class="w-full text-center leading-tight">
            <span class="block text-[10px] text-zilo-muted"><%= t('client.from_price') %></span>
            <span class="block text-xs font-medium text-zilo-muted tabular-nums"><%= formatCLP(service.averagePrice) %><% if (service.pricingUnit === 'm2') { %> / m²<% } %></span>
          </span>
        </a>
      <% }); %>
    </div>
    <% if ((services || []).length > 6) { %>
    <button type="button" id="btnShowMoreServicesActive" class="w-full mb-5 py-2.5 rounded-xl zilo-btn-ghost text-sm"><%= t('client.dashboard.more_services') %></button>
    <script>
      document.getElementById('btnShowMoreServicesActive')?.addEventListener('click', function () {
        document.querySelectorAll('#servicesGrid .service-item--extra').forEach(function (el) { el.classList.remove('hidden'); });
        this.remove();
      });
    </script>
    <% } %>
    <% } %>

    <% } else { %>
    <!-- Modo calma: CTA única + servicios -->
    <section class="mb-5">
      <h2 class="zilo-display text-2xl leading-tight mb-1"><%= t('client.dashboard.hero_title') %></h2>
      <p class="text-sm text-zilo-muted mb-4"><%= t('client.dashboard.hero_sub') %></p>
      <% if (typeof trustStats !== 'undefined') { %>
      <p class="text-[11px] text-zilo-muted mb-4">
        ★ <%= trustStats.avgRating || '4.9' %> · <%= trustStats.verifiedProviders || 100 %>% <%= t('client.dashboard.trust_compact') %> · <%= t('trust.eta_title', { time: trustStats.responseTime || '~45 min' }) %>
      </p>
      <% } %>
    </section>

    <% if (typeof lastCompleted !== 'undefined' && lastCompleted && mod('client_solicitar')) { %>
    <a href="/cliente/servicio/<%= lastCompleted.serviceId %>" class="block zilo-card-premium rounded-2xl p-4 mb-5 border border-emerald-500/20 bg-emerald-50/50 hover:border-emerald-500/35 transition">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <p class="zilo-label mb-0.5"><%= t('client.dashboard.repeat') %></p>
          <strong class="text-sm block truncate"><%= lastCompleted.serviceName %></strong>
          <span class="text-xs text-zilo-muted"><%= t('client.dashboard.repeat_sub') %></span>
        </div>
        <svg class="w-5 h-5 text-zilo-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </div>
    </a>
    <% } %>

    <% if (mod('client_solicitar')) { %>
    <h2 class="zilo-label mb-3" data-tour="services"><%= t('client.services') %></h2>
    <div id="servicesGrid" class="grid grid-cols-2 gap-3 mb-5">
      <% (services || []).forEach(function(service, idx) { %>
        <a href="/cliente/servicio/<%= service.id %>" data-service-id="<%= service.id %>"
          class="service-item group flex flex-col items-center gap-3 p-5 rounded-2xl zilo-card-premium hover:border-zilo-accent/25 hover:-translate-y-0.5 transition-all duration-300 <%= idx >= 6 ? 'hidden service-item--extra' : '' %>">
          <%- include('../partials/service-icon', { icon: service.icon, size: 'lg' }) %>
          <span class="font-medium text-sm text-center leading-tight px-1" style="overflow-wrap:anywhere"><%= service.name %></span>
          <span class="w-full text-center leading-tight">
            <span class="block text-[10px] text-zilo-muted"><%= t('client.from_price') %></span>
            <span class="block text-xs font-medium text-zilo-muted tabular-nums"><%= formatCLP(service.averagePrice) %><% if (service.pricingUnit === 'm2') { %> / m²<% } %></span>
          </span>
        </a>
      <% }); %>
    </div>
    <% if ((services || []).length > 6) { %>
    <button type="button" id="btnShowMoreServices" class="w-full mb-5 py-2.5 rounded-xl zilo-btn-ghost text-sm"><%= t('client.dashboard.more_services') %></button>
    <script>
      document.getElementById('btnShowMoreServices')?.addEventListener('click', function () {
        document.querySelectorAll('.service-item--extra').forEach(function (el) { el.classList.remove('hidden'); });
        this.remove();
      });
    </script>
    <% } %>
    <% } else { %>
      <div class="zilo-empty zilo-card-premium rounded-2xl mb-5">
        <p class="zilo-display"><%= t('client.requests_paused') %></p>
        <p class="text-sm"><%= t('client.requests_paused_desc') %></p>
      </div>
    <% } %>

    <% if (isReturning && typeof passport !== 'undefined' && passport && mod('client_pasaporte')) { %>
    <a href="/cliente/hogar" data-tour="passport" class="block zilo-card-premium rounded-2xl p-4 mb-5 border border-zilo-accent/15 hover:border-zilo-accent/30 transition">
      <div class="flex items-center gap-4">
        <div class="zilo-health-ring !w-16 !h-16 shrink-0">
          <svg width="64" height="64" viewBox="0 0 64 64" class="!w-16 !h-16">
            <circle cx="32" cy="32" r="28" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="5"/>
            <circle cx="32" cy="32" r="28" fill="none" stroke="#C45C14" stroke-width="5" stroke-linecap="round"
              stroke-dasharray="<%= 2 * Math.PI * 28 %>"
              stroke-dashoffset="<%= 2 * Math.PI * 28 * (1 - passport.healthScore / 100) %>"/>
          </svg>
          <div class="score">
            <strong class="text-lg text-zilo-accent font-semibold"><%= passport.healthScore %></strong>
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <p class="zilo-label mb-0.5"><%= t('client.passport') %></p>
          <strong class="text-sm block"><%= t('client.passport.level.' + (passport.levelKey || 'fair')) %></strong>
          <span class="text-xs text-zilo-muted"><%= t('client.passport_records', { count: passport.entries.length }) %></span>
        </div>
        <svg class="w-5 h-5 text-zilo-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
      </div>
    </a>
    <% } %>

    <% if (isReturning && mod('client_referidos')) { %>
    <a href="/cliente/invitar" data-tour="points" class="flex items-center justify-between p-4 mb-5 rounded-2xl zilo-card-premium border border-zilo-accent/15 hover:border-zilo-accent/30 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-zilo-accent/10 flex items-center justify-center">
          <svg class="w-4 h-4 text-zilo-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div>
          <strong class="text-sm block"><%= t('client.dashboard.refer_cta_title') %></strong>
          <span class="text-[10px] text-zilo-muted"><%= t('client.dashboard.refer_cta_sub') %></span>
        </div>
      </div>
      <span class="text-xs text-zilo-accent font-medium"><%= t('client.invite_arrow') %></span>
    </a>
    <% } %>

    <details class="mb-2 group">
      <summary class="text-xs text-zilo-muted cursor-pointer list-none flex items-center gap-1 py-2">
        <span class="group-open:hidden"><%= t('client.dashboard.more_help') %></span>
        <span class="hidden group-open:inline"><%= t('client.dashboard.less_help') %></span>
      </summary>
      <div class="pt-2">
        <%- include('../partials/guide-card', {
          title: t('client.guide.card_title'),
          summary: t('client.guide.summary'),
          linkText: t('client.guide.link')
        }) %>
      </div>
    </details>
    <% } %>
  </main>

  <%- include('../partials/nav-client', { navActive: 'inicio' }) %>
</div>

<%- include('../partials/guide-modal', {
  role: 'client',
  title: t('client.guide.title'),
  steps: [
    { title: t('client.guide.step1_title'), body: t('client.guide.step1_body'), tip: t('client.guide.step1_tip') },
    { title: t('client.guide.step2_title'), body: t('client.guide.step2_body'), tip: t('client.guide.step2_tip') },
    { title: t('client.guide.step3_title'), body: t('client.guide.step3_body'), tip: t('client.guide.step3_tip') },
    { title: t('client.guide.step4_title'), body: t('client.guide.step4_body'), tip: t('client.guide.step4_tip') },
    { title: t('client.guide.step5_title'), body: t('client.guide.step5_body') }
  ],
  extras: [
    { title: t('client.guide.extra_support_title'), body: t('client.guide.extra_support_body') },
    { title: t('client.guide.extra_gift_title'), body: t('client.guide.extra_gift_body') }
  ]
}) %>

<%- include('../partials/onboarding-tour') %>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  <% if (typeof referralBonus !== 'undefined' && referralBonus) { %>
  document.addEventListener('DOMContentLoaded', () => {
    const bonusMsg = (typeof FandezI18n !== 'undefined')
      ? FandezI18n.t('client.js.referral_bonus', { amount: '<%= referralBonus.toLocaleString(locale === "en" ? "en-US" : "es-CL") %>' })
      : '¡$<%= referralBonus.toLocaleString("es-CL") %> de crédito por invitación!';
    FandezNotify.show(bonusMsg, 'success');
  });
  <% } %>
  socket.on('modules_updated', ({ modules }) => {
    setTimeout(() => location.reload(), 600);
  });
  socket.on('services_updated', ({ services }) => {
    const grid = document.getElementById('servicesGrid');
    if (!grid) return;
    const active = services.filter(s => s.enabled);
    const locale = document.documentElement.lang === 'en' ? 'en-US' : 'es-CL';
    const fmt = n => new Intl.NumberFormat(locale, { style: 'currency', currency: 'CLP', maximumFractionDigits: 0 }).format(n);
    const averageLabel = (typeof FandezI18n !== 'undefined') ? FandezI18n.t('client.js.from_price') : 'promedio';
    const noServices = (typeof FandezI18n !== 'undefined') ? FandezI18n.t('client.js.no_services') : 'No hay servicios disponibles.';
    if (active.length === 0) {
      grid.innerHTML = `<div class="col-span-2 text-center py-16 text-zilo-muted"><p class="text-sm">${noServices}</p></div>`;
      return;
    }
    grid.innerHTML = active.map(s => `
      <a href="/cliente/servicio/${s.id}" class="group flex flex-col items-center gap-3 p-5 rounded-2xl zilo-card-premium hover:border-zilo-accent/25 transition-all">
        ${FandezIcons.wrap(s.icon, null, 'w-14 h-14', 28)}
        <span class="font-medium text-sm text-center px-1" style="overflow-wrap:anywhere">${s.name}</span>
        <span class="w-full text-center leading-tight">
          <span class="block text-[10px] text-zilo-muted">${averageLabel}</span>
          <span class="block text-xs font-medium text-zilo-muted tabular-nums">${fmt(s.averagePrice)}${s.pricingUnit === 'm2' ? ' / m²' : ''}</span>
        </span>
      </a>
    `).join('');
  });

  socket.emit('aland_join', { clientId: '<%= user.id %>' });

  (function refreshAttentionAlerts() {
    if (!window.FandezAlerts) return;
    FandezAlerts.ensurePermission();
    const items = <%- JSON.stringify((typeof attentionItems !== 'undefined' ? attentionItems : []).filter(function(i){ return i.urgency === 'high'; }).slice(0, 2)) %>;
    items.forEach(function(item) {
      FandezAlerts.notify({
        type: 'alert',
        title: item.title,
        body: item.body,
        tag: 'fandez-attention-' + item.requestId + '-' + item.type,
        requireInteraction: true,
        url: item.url,
        system: true
      });
    });
  })();

  socket.on('client_open_request_alert', (payload) => {
    if (window.FandezAlerts) {
      FandezAlerts.notify({
        type: 'alert',
        title: payload?.title || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.open_request_title') : 'Open request'),
        body: payload?.body || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.open_request_body') : 'You have a pending request in Fandez.'),
        tag: 'fandez-open-' + (payload?.requestId || 'x'),
        requireInteraction: true,
        url: payload?.url || '/cliente',
        system: true
      });
    } else {
      FandezNotify.show(payload?.body || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.open_request_body') : 'You have a pending request'), 'warning');
    }
  });

  socket.on('client_tech_arrived', (payload) => {
    if (!payload || payload.techStatus !== 'en_sitio') return;
    if (window.FandezAlerts) {
      FandezAlerts.notify({
        type: 'alert',
        title: payload.title || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.arrived_alert_title') : 'Técnico en tu domicilio'),
        body: payload.body || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.arrived') : '¡Ha llegado!'),
        tag: 'fandez-arrived-' + (payload.requestId || 'x'),
        requireInteraction: true,
        url: payload.url || '/cliente',
        system: true
      });
    } else if (window.FandezNotify) {
      FandezNotify.show(payload.body || 'El técnico llegó a tu domicilio', 'info');
    }
  });

  socket.on('no_provider_choice_required', () => {
    if (window.FandezAlerts) FandezAlerts.notify({
      type: 'alert',
      title: typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.dashboard.action_required') : 'Action required',
      body: typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_notify_body') : 'Aland needs you to choose how to continue.',
      tag: 'fandez-no-provider',
      requireInteraction: true
    });
    else FandezNotify.show(typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_notify_body') : 'Aland needs you to choose how to continue.', 'warning');
    setTimeout(() => location.reload(), 1200);
  });

  document.querySelectorAll('[data-no-provider-choice]').forEach((button) => {
    button.addEventListener('click', async () => {
      const choice = button.dataset.noProviderChoice;
      const requestId = button.dataset.requestId;
      const confirmRefund = typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_refund_confirm') : '¿Solicitar la devolución? La iniciamos el siguiente día hábil al mismo medio.';
      if (choice === 'refund' && !confirm(confirmRefund)) return;
      const buttons = button.closest('[data-no-provider-card]')?.querySelectorAll('button') || [];
      buttons.forEach((item) => { item.disabled = true; });
      try {
        await fetch(`/cliente/solicitud/${encodeURIComponent(requestId)}/timeout-busqueda`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: '{}'
        }).catch(() => null);
        const response = await fetch(`/cliente/solicitud/${encodeURIComponent(requestId)}/sin-socio`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ choice })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.success) throw new Error(data.error || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_error') : 'Could not save your choice'));
        const refundDone = choice === 'refund' || data.choice === 'refund';
        FandezNotify.show(
          data.already && data.message
            ? data.message
            : (refundDone
              ? (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.refund_requested_body') : 'La iniciamos el siguiente día hábil. En tarjeta, el banco define cuándo lo ves.')
              : (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.keep_searching_body') : "We'll keep searching.")),
          'success'
        );
        setTimeout(() => location.reload(), 700);
      } catch (error) {
        buttons.forEach((item) => { item.disabled = false; });
        FandezNotify.show(error.message || (typeof FandezI18n !== 'undefined' ? FandezI18n.t('client.js.no_provider_error') : 'Could not save your choice'), 'error');
      }
    });
  });
</script>

