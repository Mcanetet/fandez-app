<%- include('../partials/head') %>

<% const credit = typeof referralCreditCLP === 'number' ? referralCreditCLP : 5000; %>
<div class="max-w-lg mx-auto min-h-screen flex flex-col pb-24 zilo-page-enter client-skin" id="invitarPage" data-share-url="<%= shareUrl %>" data-code="<%= referral.code %>" data-credit="<%= credit %>">
  <%- include('../partials/back-header', { backUrl: '/cliente', label: 'Beneficios', title: 'Compartir' }) %>

  <main class="flex-1 px-5 py-8 space-y-8">
    <section class="invite-hero">
      <h2 class="invite-hero__title">Trae a alguien de confianza</h2>
      <p class="invite-hero__sub">Comparte Fandez. Tu amigo tiene <%= formatCLP(credit) %> en su primera visita. Tú los recibes cuando esa visita cierre.</p>
    </section>

    <section class="invite-link">
      <span class="zilo-label">Tu enlace</span>
      <p class="invite-link__url" id="referralLink"><%= String(shareUrl || '').replace(/^https?:\/\//, '') %></p>
    </section>

    <div class="space-y-2">
      <button type="button" id="btnShare" class="zilo-btn-primary">Compartir</button>
      <button type="button" id="btnCopyLink" class="zilo-btn-ghost w-full">Copiar enlace</button>
    </div>

    <details class="invite-code">
      <summary>¿Tienes un código?</summary>
      <div class="flex gap-2 mt-3">
        <input type="text" id="inputReferralCode" placeholder="CÓDIGO" maxlength="12" class="zilo-input flex-1 uppercase font-mono" autocomplete="off">
        <button type="button" id="btnApplyCode" class="zilo-btn-primary !w-auto !px-5 !py-3 text-sm shrink-0">Aplicar</button>
      </div>
    </details>
  </main>

  <%- include('../partials/nav-client', { navActive: 'invitar' }) %>
</div>

<%- include('../partials/footer', { pageScript: '/js/share.js' }) %>
