        <p id="loaderSub" class="text-sm text-zilo-muted mb-2 leading-relaxed px-1"><%= t('client.service.searching_sub') %></p>
        <p id="searchViewersHint" class="text-[11px] text-zilo-accent font-medium mb-4"><%= t('client.js.search_viewers', { count: '3' }) %></p>

