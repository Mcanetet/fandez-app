<%- include('../partials/head', { useMap: true }) %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="servicePage"
  data-service-id="<%= service.id %>"
  data-service-name="<%= service.name %>"
  data-visit-price="<%= service.visitPrice %>"
  data-tracking="<%= typeof tracking !== 'undefined' ? tracking : '' %>"
  data-whatsapp="<%= company.whatsapp %>">

  <%- include('../partials/back-header', {
    backUrl: '/cliente',
    title: service.name,
    centerTitle: true,
    titleClass: 'text-base font-semibold'
  }) %>

  <main class="flex-1 px-5 py-5 pb-28">
    <%- include('../partials/checkout-progress', { checkoutStep: typeof tracking !== 'undefined' && tracking ? 3 : 1 }) %>
    <%- include('../partials/trust-strip', { trustStats: typeof trustStats !== 'undefined' ? trustStats : {} }) %>

    <div class="text-center p-6 rounded-2xl zilo-card-premium mb-5 relative overflow-hidden zilo-page-enter-delay-1">
      <div class="absolute inset-0 bg-gradient-to-b from-zilo-accent/5 to-transparent pointer-events-none"></div>
      <div class="relative flex justify-center mb-4">
        <%- include('../partials/service-icon', { icon: service.icon, size: 'xl' }) %>
      </div>
      <p class="text-zilo-muted text-sm relative leading-relaxed"><%= service.description %></p>
    </div>

    <div class="p-5 rounded-2xl zilo-card-premium mb-5 zilo-page-enter-delay-1" id="pricingBox">
      <p class="zilo-label mb-4"><%= t('client.service.rates') %></p>
      <div class="flex justify-between py-3 border-b border-zilo-border">
        <span class="text-zilo-muted text-sm"><%= t('client.service.work_base') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayVisitPrice"><%= formatCLP(pricing.servicePrice) %></strong>
      </div>
      <div id="urgencyAdjustmentRow" class="hidden flex justify-between py-2 border-b border-zilo-border text-sm">
        <span class="text-zilo-muted" id="urgencyAdjustmentLabel"><%= t('client.service.dynamic_surcharge') %></span>
        <strong id="displayUrgencyAdj" class="text-orange-600">—</strong>
      </div>
      <div class="flex justify-between py-3 border-b border-zilo-border hidden" id="servicePriceRow">
        <span class="text-zilo-muted text-sm"><%= t('client.service.service_est') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayServicePrice"><%= formatCLP(0) %></strong>
      </div>
      <div class="flex justify-between py-3">
        <span class="text-zilo-muted text-sm font-medium"><%= t('client.service.total_est') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayTotalPrice"><%= formatCLP(pricing.servicePrice) %></strong>
      </div>
      <p class="text-[11px] text-zilo-muted/70 mt-3"><%= t('client.service.pay_hint_dynamic') %></p>
      <details class="mt-3 text-left">
        <summary class="text-xs text-zilo-accent font-medium cursor-pointer select-none"><%= t('client.service.guarantees') %></summary>
        <ul class="mt-2 space-y-1.5 text-[11px] text-zilo-muted leading-relaxed pl-1">
          <li>✓ <%= t('client.service.g1') %></li>
          <li>✓ <%= t('client.service.g2') %></li>
          <li>✓ <%= t('client.service.g3') %></li>
          <li>✓ <%= t('client.service.g4') %></li>
          <li>✓ <%= t('client.service.g5') %></li>
        </ul>
      </details>
    </div>

    <% if (urgencyTiers && urgencyTiers.length) { %>
    <div class="p-5 rounded-2xl zilo-card-premium mb-5 zilo-page-enter-delay-1">
      <p class="zilo-label mb-3"><%= t('client.service.when') %></p>
      <div class="space-y-2" id="urgencyOptions">
        <% urgencyTiers.forEach((tier, i) => {
          const isDefault = tier.id === 'scheduled' || (i === urgencyTiers.length - 1 && !urgencyTiers.some(t => t.id === 'scheduled'));
          const pct = Number(tier.surchargePercent != null ? tier.surchargePercent : tier.adjustmentPercent) || 0;
          let badge = t('client.service.urgency_normal');
          let badgeClass = 'text-zilo-muted';
          if (pct > 0) { badge = '+' + pct + '%'; badgeClass = 'text-amber-700'; }
          else if (pct < 0) { badge = pct + '%'; badgeClass = 'text-emerald-700'; }
        %>
          <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer urgency-option <%= isDefault ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>" data-tier="<%= tier.id %>">
            <input type="radio" name="urgencyTier" value="<%= tier.id %>" class="mt-1 accent-zilo-accent" <%= isDefault ? 'checked' : '' %>>
            <div class="flex-1 min-w-0">
              <div class="flex justify-between items-start gap-2">
                <strong class="text-sm"><%= tier.label %></strong>
                <span class="text-xs font-medium shrink-0 urgency-pct <%= badgeClass %>"><%= badge %></span>
              </div>
              <% if (tier.description) { %><p class="text-[11px] text-zilo-muted mt-0.5"><%= tier.description %></p><% } %>
            </div>
          </label>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% if (mod('client_aland')) { %>
    <section class="p-4 rounded-xl zilo-card-premium mb-5 zilo-page-enter-delay-1 border border-aland/25 aland-surface" id="alandChatSection" data-auto-open="<%= (typeof currentQuery !== 'undefined' && String(currentQuery).includes('aland=1')) ? '1' : '0' %>">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-sm font-semibold text-aland-strong"><%= t('client.service.aland_title') %></p>
          <p class="text-[11px] text-zilo-muted"><%= t('client.service.aland_sub') %></p>
        </div>
        <button type="button" id="alandChatToggle" class="text-xs px-3 py-1.5 rounded-lg aland-chip"><%= t('client.service.aland_open') %></button>
      </div>
      <div id="alandChatPanel" class="hidden border border-zilo-border rounded-xl overflow-hidden">
        <div id="alandChatMessages" class="h-56 overflow-y-auto p-3 space-y-2 bg-zilo-bg text-sm"></div>
        <form id="alandChatForm" class="flex gap-2 p-2 border-t border-zilo-border bg-white">
          <input type="text" id="alandChatInput" placeholder="<%= t('client.service.aland_placeholder') %>" class="flex-1 px-3 py-2 rounded-lg border border-zilo-border text-sm" autocomplete="off">
          <button type="submit" class="px-4 py-2 rounded-lg aland-btn text-sm font-medium"><%= t('client.service.aland_send') %></button>
        </form>
      </div>
    </section>
    <% } %>

    <section id="requestForm" class="space-y-4 zilo-page-enter-delay-2">
      <% if (mod('client_regalo')) { %>
      <div class="p-4 rounded-2xl zilo-gift-card">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="giftToggle" class="w-5 h-5 rounded accent-zilo-accent">
          <div>
            <strong class="text-sm block"><%= t('client.service.gift') %></strong>
            <span class="text-xs text-zilo-muted"><%= mod('client_guardian') ? t('client.service.gift_guardian') : t('client.service.gift_other') %></span>
          </div>
        </label>
        <div id="giftFields" class="hidden mt-4 space-y-3 pt-3 border-t border-zilo-accent/15">
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.beneficiary') %></label>
            <input type="text" id="giftName" placeholder="<%= t('client.service.gift_name_ph') %>" class="zilo-input">
          </div>
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.gift_phone_label') %></label>
            <input type="tel" id="giftPhone" placeholder="<%= t('client.service.gift_phone_ph') %>" class="zilo-input">
          </div>
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.gift_message') %></label>
            <input type="text" id="giftMessage" placeholder="..." class="zilo-input">
          </div>
        </div>
      </div>
      <% } %>

      <div>
        <label for="address" class="zilo-label block mb-1.5" id="addressLabel"><%= t('client.service.address') %></label>
        <input type="text" id="address" placeholder="<%= t('client.service.address_ph') %>"
          value="<%= typeof profile !== 'undefined' ? profile.address : '' %>" class="zilo-input">
        <input type="hidden" id="lat"><input type="hidden" id="lng">
      </div>

      <div>
        <label class="zilo-label block mb-1.5"><%= t('client.service.location') %></label>
        <div id="addressMap" class="w-full h-44 rounded-2xl overflow-hidden border border-zilo-border bg-zilo-bg"></div>
        <p id="mapStatus" class="text-[10px] text-zilo-muted mt-1.5"><%= t('client.service.map_hint') %></p>
        <div id="coverageAlert" class="hidden mt-2 p-3 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 text-xs leading-relaxed" role="alert"></div>
      </div>

      <% if (typeof activities !== 'undefined' && activities.length) { %>
      <div>
        <label for="activityId" class="zilo-label block mb-1.5"><%= t('client.service.subservice') %> *</label>
        <select id="activityId" name="activityId" required class="zilo-input">
          <option value=""><%= t('client.service.subservice_ph') %></option>
          <% activities.forEach(function(act) { %>
            <option value="<%= act.id %>" data-base="<%= act.basePrice %>">
              <%= act.name %> — <%= formatCLP(act.basePrice) %>
            </option>
          <% }); %>
          <option value="otro" data-base="100000">Otro — describir (desde $100.000)</option>
        </select>
        <p class="text-[11px] text-zilo-muted mt-1"><%= t('client.service.subservice_hint') %></p>
        <div id="customActivityFields" class="hidden mt-3 space-y-2 p-3 rounded-xl border border-zilo-border bg-zilo-surface/40">
          <label for="customActivityName" class="zilo-label block">Describe el servicio *</label>
          <input type="text" id="customActivityName" maxlength="120" class="zilo-input w-full" placeholder="Ej: Instalar grifería de duchas + sellado">
          <p class="text-[11px] text-zilo-muted">El socio puede ajustar el detalle y precio en terreno; tú lo validas.</p>
        </div>
      </div>
      <% } %>

      <div>
        <label for="notes" class="zilo-label block mb-1.5"><%= t('client.service.detail') %> *</label>
        <textarea id="notes" rows="3" required placeholder="<%= t('client.service.detail_ph') %>" class="zilo-input resize-none"></textarea>
      </div>

      <div class="space-y-4">
        <div>
          <label class="zilo-label block mb-1.5"><%= t('client.service.photo') %> *</label>
          <p class="text-[11px] text-zilo-muted mb-2"><%= t('client.service.photo_required_hint') %></p>
          <button type="button" id="btnPhotoHelp" class="w-full mb-3 py-2.5 px-3 rounded-xl border border-zilo-accent/30 bg-zilo-accent/10 text-zilo-accent text-xs font-semibold text-left flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span><%= t('client.service.photo_help_link') %></span>
          </button>
          <input type="file" id="clientPhoto" accept="image/*" capture="environment" required class="block w-full text-xs text-zilo-muted file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent file:text-xs file:font-medium">
          <div id="clientPhotoPreview" class="hidden mt-2">
            <img src="" alt="<%= t('client.service.preview_alt') %>" class="w-full max-h-40 object-cover rounded-xl border border-zilo-border">
          </div>
        </div>

        <div id="brandPhotoBlock">
          <label class="zilo-label block mb-1.5"><%= t('client.service.photo_brand') %> *</label>
          <p class="text-[11px] text-zilo-muted mb-2"><%= t('client.service.photo_brand_hint') %></p>
          <input type="file" id="clientBrandPhoto" accept="image/*" capture="environment" class="block w-full text-xs text-zilo-muted file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent file:text-xs file:font-medium">
          <div id="clientBrandPhotoPreview" class="hidden mt-2">
            <img src="" alt="<%= t('client.service.photo_brand') %>" class="w-full max-h-40 object-cover rounded-xl border border-zilo-border">
          </div>
        </div>

        <label class="flex items-start gap-2.5 p-3 rounded-xl border border-zilo-border cursor-pointer">
          <input type="checkbox" id="brandNotVisible" class="mt-0.5 accent-zilo-accent shrink-0">
          <span class="text-sm leading-snug">
            <strong class="block font-medium"><%= t('client.service.brand_not_visible') %></strong>
            <span class="text-[11px] text-zilo-muted"><%= t('client.service.brand_not_visible_hint') %></span>
          </span>
        </label>
      </div>

      <button type="button" id="btnRequest" class="zilo-btn-primary"><%= t('client.service.continue') %></button>
      <p class="text-center text-[10px] text-zilo-muted"><%= t('client.service.secure_pay') %></p>
    </section>

    <div id="stickyOrderBar" class="sticky-order-bar" aria-hidden="true">
      <div class="sticky-order-inner max-w-lg mx-auto">
        <div class="min-w-0">
          <p class="text-[10px] text-zilo-muted uppercase tracking-wide"><%= t('client.service.visit_est') %></p>
          <strong class="text-zilo-accent text-base" id="stickyTotal"><%= formatCLP(pricing.servicePrice) %></strong>
        </div>
        <button type="button" id="btnRequestSticky" class="sticky-order-btn"><%= t('client.service.continue') %></button>
      </div>
    </div>

    <div id="stickyTrackBar" class="sticky-track-bar" aria-hidden="true">
      <div class="sticky-track-inner max-w-lg mx-auto">
        <div class="min-w-0 sticky-track-copy">
          <p class="zilo-label !text-[9px]" id="stickyTrackLabel">Tu visita</p>
          <strong id="stickyTrackStatus" class="text-sm text-zilo-text block truncate">Conectando…</strong>
        </div>
        <div class="sticky-track-actions">
          <button type="button" id="stickyTrackChat" class="sticky-track-btn sticky-track-btn--primary">Mensajes</button>
          <a id="stickyTrackCall" href="tel:" class="sticky-track-btn sticky-track-btn--ghost hidden">Llamar</a>
        </div>
      </div>
    </div>

    <div id="loaderOverlay" class="hidden fixed inset-0 z-[200] search-overlay flex items-center justify-center overflow-y-auto py-6">
      <div class="search-overlay-orb search-overlay-orb-a" aria-hidden="true"></div>
      <div class="search-overlay-orb search-overlay-orb-b" aria-hidden="true"></div>
      <div class="search-overlay-grid" aria-hidden="true"></div>
      <div class="relative text-center px-5 max-w-sm w-full" id="searchExperience" data-timeout-ms="900000">
        <% const carouselServices = (typeof catalogServices !== 'undefined' && catalogServices.length)
          ? catalogServices
          : [service]; %>
        <div class="search-services-marquee mb-5" aria-hidden="true">
          <div class="search-services-track">
            <% [0, 1].forEach(function () { %>
              <% carouselServices.forEach(function (s) { %>
                <span class="search-services-chip">
                  <%- include('../partials/service-icon', { icon: s.icon, size: 'xs' }) %>
                  <span><%= s.name %></span>
                </span>
              <% }); %>
            <% }); %>
          </div>
        </div>

        <div class="search-hero-card mb-5">
          <div class="relative w-36 h-36 mx-auto flex items-center justify-center">
            <div class="search-hero-core w-full h-full rounded-full flex flex-col items-center justify-center">
              <div class="zilo-radar-wrap" aria-hidden="true">
                <div class="zilo-radar"></div>
                <div class="zilo-radar"></div>
                <div class="zilo-radar-core">
                  <span class="zilo-search-plunger" title="Buscando técnico">
                    <svg viewBox="0 0 64 64" width="40" height="40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect x="28.5" y="4" width="7" height="22" rx="3.5" fill="#8B5A2B"/>
                      <rect x="29.5" y="5" width="2" height="18" rx="1" fill="#C4A484" opacity="0.55"/>
                      <path d="M16 30c0-6.5 7.2-10 16-10s16 3.5 16 10v2.5c0 1.2-.8 2.2-1.9 2.5L44 38H20l-2.1-3c-1.1-.3-1.9-1.3-1.9-2.5V30z" fill="#E11D48"/>
                      <path d="M18 35.5C18 42 24.5 48 32 48s14-6 14-12.5" stroke="#BE123C" stroke-width="5" stroke-linecap="round" fill="none"/>
                      <ellipse cx="32" cy="48.5" rx="18" ry="7.5" fill="#9F1239"/>
                      <ellipse cx="32" cy="47" rx="12" ry="3.2" fill="#F43F5E" opacity="0.45"/>
                      <path d="M22 33c2.5-3 7-4.5 12-4" stroke="#FDA4AF" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
                    </svg>
                  </span>
                </div>
              </div>
              <p id="searchTimer" class="font-mono text-2xl font-bold tracking-tight text-zilo-text tabular-nums leading-none">00:00</p>
              <p class="text-[10px] text-zilo-muted uppercase tracking-[0.14em] mt-1"><%= t('client.service.search_elapsed') %></p>
            </div>
          </div>
        </div>

        <p id="searchPhaseLabel" class="search-phase-pill mb-3"><%= t('client.service.search_phase_near') %></p>
        <h3 id="loaderText" class="zilo-display text-[1.35rem] mb-2 leading-snug tracking-tight"><%= t('client.service.searching') %></h3>
        <p id="loaderSub" class="text-sm text-zilo-muted mb-5 leading-relaxed px-1"><%= t('client.service.searching_sub') %></p>

        <div class="mb-5 px-1">
          <div class="flex justify-between text-[10px] text-zilo-muted mb-1.5">
            <span><%= t('client.service.search_progress_start') %></span>
            <span id="searchProgressLabel" class="font-medium text-zilo-accent">0 / 15 min</span>
          </div>
          <div class="h-2 rounded-full bg-white/70 border border-zilo-border/60 overflow-hidden shadow-inner">
            <div id="searchProgressBar" class="h-full rounded-full search-progress-fill transition-all duration-500" style="width:0%"></div>
          </div>
        </div>

        <div class="search-timeline mb-5 text-left" id="searchSteps">
          <div id="step1" class="search-timeline-item is-active">
            <span class="search-timeline-marker" aria-hidden="true"></span>
            <span class="search-timeline-copy"><%= t('client.service.loader_locating') %></span>
          </div>
          <div id="step2" class="search-timeline-item">
            <span class="search-timeline-marker" aria-hidden="true"></span>
            <span class="search-timeline-copy"><%= t('client.service.loader_filtering') %></span>
          </div>
          <div id="step3" class="search-timeline-item">
            <span class="search-timeline-marker" aria-hidden="true"></span>
            <span class="search-timeline-copy"><%= t('client.service.loader_waiting') %></span>
          </div>
          <div id="step4" class="search-timeline-item">
            <span class="search-timeline-marker" aria-hidden="true"></span>
            <span class="search-timeline-copy"><%= t('client.service.loader_busy') %></span>
          </div>
        </div>

        <div id="searchTipCard" class="search-tip-card text-left mb-5 min-h-[3.25rem]">
          <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-zilo-muted mb-1"><%= t('client.service.search_tip_label') %></p>
          <p id="searchTipText" class="text-xs text-zilo-text leading-relaxed"><%= t('client.service.search_tip_1') %></p>
        </div>

        <p class="text-[11px] text-zilo-muted mb-4 px-2"><%= t('client.service.searching_hint') %></p>
        <div class="flex flex-col gap-2.5 pb-2">
          <button type="button" id="btnCancelSearch" class="search-cancel-btn">
            <%= t('client.service.cancel_search') %>
          </button>
          <button type="button" data-open-aland class="search-aland-btn">
            <span><%= t('client.service.talk_aland') %></span>
          </button>
        </div>
      </div>
    </div>

    <section id="scheduledPanel" class="hidden mt-5 p-5 rounded-2xl border border-sky-200 bg-gradient-to-br from-sky-50 via-white to-indigo-50 animate-slide-up shadow-zilo">
      <div class="flex items-start gap-3 mb-4">
        <div class="w-11 h-11 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <div class="min-w-0 text-left">
          <p class="zilo-label text-sky-700 mb-0.5"><%= t('client.service.scheduled_label') %></p>
          <strong class="text-base block mb-1"><%= t('client.service.scheduled_title') %></strong>
          <p id="scheduledSub" class="text-sm text-zilo-muted leading-relaxed"><%= t('client.service.scheduled_sub') %></p>
          <p id="scheduledWhen" class="text-sm font-semibold text-zilo-accent mt-2"></p>
        </div>
      </div>
      <button type="button" id="btnCancelScheduled" class="w-full py-3 px-3 rounded-xl border border-red-200 bg-white text-red-700 text-sm font-semibold">
        <%= t('client.service.cancel_scheduled') %>
      </button>
    </section>

    <section id="noProviderChoicePanel" class="hidden mt-5 p-5 rounded-2xl border border-amber-300 bg-gradient-to-br from-amber-50 to-white animate-slide-up shadow-zilo">
      <div class="flex items-start gap-3 mb-3">
        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-semibold text-aland-strong mb-0.5">Aland</p>
          <strong class="text-sm block mb-1"><%= t('client.js.no_provider_title') %> <span id="noProviderServiceName"></span></strong>
          <p class="text-xs text-amber-900/90 leading-relaxed"><%= t('client.js.no_provider_body') %></p>
        </div>
      </div>
      <div class="p-3 rounded-xl bg-white border border-amber-200/80 mb-3 text-left">
        <p class="text-xs font-semibold text-zilo-text mb-1"><%= t('client.js.no_provider_notify_title') %></p>
        <p class="text-[11px] text-zilo-muted leading-relaxed"><%= t('client.js.no_provider_notify_body') %></p>
      </div>
      <div class="space-y-2">
        <button type="button" id="btnNoProviderContinue" class="w-full py-3 px-3 rounded-xl bg-zilo-accent text-white text-sm font-semibold shadow-sm">
          <%= t('client.js.no_provider_continue') %>
        </button>
        <button type="button" id="btnNoProviderRefund" class="w-full py-2.5 px-3 rounded-xl bg-white border border-red-200 text-red-700 text-xs font-semibold">
          <%= t('client.js.no_provider_refund') %>
        </button>
        <button type="button" data-open-aland class="w-full py-2 text-xs font-semibold text-aland-strong hover:underline">
          <%= t('client.service.talk_aland') %>
        </button>
      </div>
    </section>

    <section id="providerCard" class="hidden mt-5 space-y-4 animate-slide-up">
      <div id="budgetBanner" class="hidden p-4 rounded-2xl border border-zilo-warning/30 bg-zilo-warning/10">
        <p class="text-sm font-semibold text-zilo-warning mb-1"><%= t('client.service.budget_pending') %></p>
        <p id="budgetBannerText" class="text-xs text-zilo-muted mb-3"></p>
        <div class="flex gap-2">
          <button type="button" id="btnApproveBudget" class="flex-1 py-2 rounded-xl zilo-btn-primary !text-sm"><%= t('client.service.approve') %></button>
          <button type="button" id="btnRejectBudget" class="flex-1 py-2 rounded-xl zilo-btn-ghost !text-sm"><%= t('client.service.reject') %></button>
        </div>
      </div>
      <div id="activityChangeBanner" class="hidden p-4 rounded-2xl border border-zilo-accent/30 bg-zilo-accent/5">
        <p class="text-sm font-semibold text-zilo-accent mb-1"><%= t('client.js.activity_change_title') %></p>
        <p id="activityChangeText" class="text-xs text-zilo-muted mb-2"></p>
        <img id="activityChangePhoto" src="" alt="" class="hidden w-full max-h-36 object-cover rounded-xl border border-zilo-border mb-3">
        <div class="flex gap-2">
          <button type="button" id="btnApproveActivityChange" class="flex-1 py-2 rounded-xl zilo-btn-primary !text-sm"><%= t('client.js.activity_change_approve') %></button>
          <button type="button" id="btnRejectActivityChange" class="flex-1 py-2 rounded-xl zilo-btn-ghost !text-sm"><%= t('client.js.activity_change_reject') %></button>
        </div>
      </div>
      <div id="additionalPaymentBanner" class="hidden p-4 rounded-2xl border border-amber-300 bg-amber-50">
        <p class="text-sm font-semibold text-amber-900 mb-1">Pago adicional pendiente</p>
        <p id="additionalPaymentText" class="text-xs text-amber-800 mb-3"></p>
        <a id="additionalPaymentLink" href="#" class="block text-center py-2.5 rounded-xl zilo-btn-primary !text-sm">Continuar al pago</a>
      </div>
      <section id="completionSummary" class="hidden p-5 rounded-2xl border border-zilo-success/30 bg-zilo-success/5">
        <p class="zilo-label mb-1">Servicio completado</p>
        <h2 class="text-base font-semibold mb-4">Total final del servicio</h2>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-zilo-muted">Visita</span>
            <span id="finalVisit">—</span>
          </div>
          <div class="flex justify-between" id="finalServiceRow">
            <span class="text-zilo-muted">Servicio adicional</span>
            <span id="finalService">—</span>
          </div>
          <div id="finalMaterialsBlock" class="hidden">
            <div class="flex justify-between">
              <span class="text-zilo-muted">Materiales a costo</span>
              <span id="finalMaterials">—</span>
            </div>
            <div id="finalMaterialsList" class="mt-2 pl-3 border-l-2 border-zilo-border space-y-1 text-xs text-zilo-muted"></div>
          </div>
          <div class="flex justify-between pt-3 border-t border-zilo-border">
            <strong>Total final</strong>
            <strong class="text-zilo-accent text-lg" id="finalGrandTotal">—</strong>
          </div>
        </div>
        <p class="text-[11px] text-zilo-muted mt-3">Los materiales se incluyen a su valor real, sin comisión ni recargos Fundez.</p>
        <a id="finalVoucherLink" href="#" target="_blank" class="hidden mt-3 block text-center py-2.5 rounded-xl zilo-btn-ghost !text-sm">Ver voucher del trabajo</a>
        <a id="finalProviderInvoiceLink" href="#" target="_blank" class="hidden mt-2 block text-center py-2.5 rounded-xl zilo-btn-ghost !text-sm">Ver factura o boleta del socio</a>
        <a id="finalReviewLink" href="/cliente/historial" class="mt-2 block text-center py-2.5 rounded-xl zilo-btn-primary !text-sm">Calificar y dejar un comentario</a>
      </section>
      <div class="p-4 rounded-2xl zilo-card-premium mb-4" id="tripStatusHero">
        <p class="zilo-label mb-1">Estado de tu visita</p>
        <strong id="tripStatusTitle" class="text-base block text-zilo-text">Conectando con tu equipo…</strong>
        <p id="tripStatusSub" class="text-sm text-zilo-muted mt-1 leading-relaxed">Te avisamos en cuanto el técnico acepte y salga hacia ti.</p>
        <div class="flex gap-2 mt-3">
          <button type="button" id="tripHeroChat" class="flex-1 py-2.5 rounded-xl zilo-btn-primary !text-xs">Mensajes</button>
          <a id="tripHeroCall" href="tel:" class="flex-1 py-2.5 rounded-xl zilo-btn-ghost !text-xs text-center hidden">Llamar</a>
        </div>
      </div>
      <div class="p-4 rounded-2xl zilo-card-premium">
        <div class="flex justify-between items-center mb-4">
          <p class="zilo-label"><%= t('client.service.tracking') %></p>
          <span id="tripEta" class="text-xs text-zilo-success font-medium"><%= t('client.service.eta') %></span>
        </div>
        <div class="trip-timeline">
          <div class="trip-step done" data-step="paid"><span class="trip-dot"></span><div><strong class="text-xs"><%= t('client.service.timeline_paid') %></strong><p class="text-[10px] text-zilo-muted"><%= t('client.service.paid_sub') %></p></div></div>
          <div class="trip-step active" data-step="assigned"><span class="trip-dot"></span><div><strong class="text-xs"><%= t('client.service.assigned') %></strong><p class="text-[10px] text-zilo-muted" id="tripProviderLabel"><%= t('client.service.connecting_dots') %></p></div></div>
          <div class="trip-step" data-step="enroute"><span class="trip-dot"></span><div><strong class="text-xs"><%= t('client.service.timeline_way') %></strong><p class="text-[10px] text-zilo-muted"><%= t('client.service.enroute_sub') %></p></div></div>
          <div class="trip-step" data-step="arrived"><span class="trip-dot"></span><div><strong class="text-xs"><%= t('client.service.timeline_site') %></strong><p class="text-[10px] text-zilo-muted"><%= t('client.service.onsite_sub') %></p></div></div>
          <div class="trip-step" data-step="working"><span class="trip-dot"></span><div><strong class="text-xs">En trabajo</strong><p class="text-[10px] text-zilo-muted">Diagnóstico o reparación</p></div></div>
          <div class="trip-step" data-step="done"><span class="trip-dot"></span><div><strong class="text-xs">Completado</strong><p class="text-[10px] text-zilo-muted">Listo para calificar</p></div></div>
        </div>
      </div>

      <div class="p-5 rounded-2xl zilo-card-premium" id="providerLiveCard">
        <div id="liveTrackShell" class="live-track-shell mb-3 hidden">
          <div id="liveTrackEta" class="live-track-eta is-waiting">
            <div class="live-track-eta__time" id="liveEtaMinutes">—<small>min</small></div>
            <div class="live-track-eta__copy">
              <strong id="liveEtaTitle"><%= t('client.service.live_waiting_title') %></strong>
              <span id="liveEtaSub"><%= t('client.service.live_waiting_sub') %></span>
            </div>
          </div>
          <div id="trackingMap" class="w-full"></div>
        </div>
        <p id="liveTrackHint" class="live-track-hint hidden"><%= t('client.service.live_scheduled_hint') %></p>
        <p id="providerLocationStatus" class="hidden text-[10px] text-zilo-success mb-3 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-zilo-success animate-pulse"></span>
          <%= t('client.service.live_location') %>
        </p>
        <div class="flex items-center gap-3 mb-3">
          <div id="providerAvatar" class="w-14 h-14 rounded-xl zilo-card-premium flex items-center justify-center font-semibold text-zilo-accent border border-zilo-accent/20">—</div>
          <div class="flex-1">
            <h3 id="providerName" class="font-semibold">—</h3>
            <div class="flex items-center gap-1.5 text-sm">
              <span id="providerStars" class="text-zilo-accent">★★★★★</span>
              <span id="providerRating" class="font-medium">—</span>
              <span id="providerReviews" class="text-zilo-muted text-xs">—</span>
            </div>
            <p id="providerVerifiedStatus" class="hidden text-[10px] text-zilo-success mt-0.5"></p>
          </div>
          <span class="zilo-badge" id="providerAssignBadge"><%= t('client.service.assigned_badge') %></span>
        </div>
        <div id="providerVerification" class="flex flex-wrap gap-1.5 mb-3"></div>
        <p id="providerAdherence" class="hidden text-xs text-zilo-muted mb-2"></p>
        <p id="providerBio" class="text-sm text-zilo-muted mb-4 leading-relaxed"></p>
        <p class="zilo-label mb-3"><%= t('client.service.reviews') %></p>
        <div id="reviewsList" class="space-y-2 mb-4"></div>
        <a id="providerPhone" href="tel:" class="zilo-btn-ghost w-full mb-2"><%= t('client.service.call_tech') %></a>
        <a id="providerEmail" href="mailto:" class="hidden zilo-btn-ghost w-full mb-2 !text-xs"><%= t('client.service.email_tech') %></a>
        <button type="button" id="openJobChatBtn" class="hidden zilo-btn-primary w-full mb-2 !text-sm">Mensajes con el socio</button>
        <button type="button" id="btnChangeProvider" class="hidden w-full mb-2 py-2.5 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-xs font-semibold">Cambiar de socio (seguir buscando)</button>
        <button type="button" id="btnCancelService" class="w-full mb-2 py-2.5 rounded-xl border border-red-200 bg-white text-red-700 text-xs font-semibold"><%= t('client.service.cancel_track') %></button>
        <a id="whatsappSupport" href="#aland-support" data-open-aland class="zilo-btn-ghost w-full text-aland-strong border-aland/25"><%= t('client.service.concierge') %></a>
      </div>

      <section id="jobChatPanel" class="job-chat-panel hidden p-0 rounded-2xl zilo-card-premium overflow-hidden border border-zilo-border">
        <div class="px-5 py-4 border-b border-zilo-border bg-white">
          <p class="zilo-label !text-[9px]">Chat del servicio</p>
          <h3 id="jobChatPeer" class="text-sm font-semibold text-zilo-text">Equipo Fundez</h3>
          <p class="text-[10px] text-zilo-muted mt-0.5">Escribes como Cliente · verás si responde el Socio o el Técnico</p>
        </div>
        <div id="jobChatThread" class="job-chat-thread max-h-72 overflow-y-auto px-4 py-4 space-y-2.5 min-h-[140px]"></div>
        <form id="jobChatForm" class="job-chat-composer">
          <label class="job-chat-composer__label" for="jobChatInput">Tu mensaje</label>
          <div class="job-chat-composer__row">
            <input id="jobChatInput" type="text" maxlength="1000" autocomplete="off" placeholder="Escribe aquí al equipo…" class="job-chat-input">
            <button type="submit" class="job-chat-send">Enviar</button>
          </div>
          <p class="job-chat-composer__hint">Cada mensaje muestra si lo envió el <strong>Cliente</strong>, el <strong>Socio</strong> o el <strong>Técnico</strong>.</p>
        </form>
      </section>
    </section>
  </main>
</div>

<%
  const _photoTips = (typeof photoTips !== 'undefined' && photoTips) ? photoTips : {
    title: t('client.service.photo_help_eyebrow'),
    steps: [
      t('client.service.photo_required_hint'),
      t('client.service.photo_brand_hint'),
      t('client.service.brand_not_visible_hint')
    ],
    notes: null,
    imageUrl: null
  };
%>
<div id="photoHelpModal" class="hidden fixed inset-0 z-[400]" aria-hidden="true" role="dialog" aria-labelledby="photoHelpTitle">
  <div id="photoHelpBackdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center sm:p-5 pointer-events-none">
    <div class="guide-modal-panel w-full max-w-lg max-h-[88vh] sm:max-h-[85vh] overflow-hidden flex flex-col pointer-events-auto animate-slide-up sm:rounded-2xl">
      <div class="zilo-modal-accent-bar shrink-0"></div>
      <div class="flex items-center justify-between px-5 py-4 border-b border-zilo-border shrink-0">
        <div>
          <p class="zilo-label !text-[9px]"><%= t('client.service.photo_help_eyebrow') %></p>
          <h2 id="photoHelpTitle" class="text-base font-semibold leading-snug"><%= _photoTips.title %></h2>
        </div>
        <button type="button" id="photoHelpClose" class="zilo-icon-btn" aria-label="<%= t('client.service.photo_help_close') %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto px-5 py-5 space-y-4">
        <% if (_photoTips.imageUrl) { %>
          <figure class="rounded-xl overflow-hidden border border-zilo-border bg-zilo-bg">
            <img src="<%= _photoTips.imageUrl %>" alt="<%= _photoTips.imageAlt || _photoTips.title %>" class="w-full max-h-48 object-cover" loading="lazy">
            <figcaption class="px-3 py-2 text-[10px] text-zilo-muted"><%= t('client.service.photo_help_example') %></figcaption>
          </figure>
        <% } %>
        <% (_photoTips.steps || []).forEach((step, i) => { %>
          <article class="flex gap-3">
            <span class="w-7 h-7 rounded-lg bg-zilo-accent/15 text-zilo-accent text-xs font-bold flex items-center justify-center shrink-0"><%= i + 1 %></span>
            <p class="text-sm text-zilo-muted leading-relaxed pt-1"><%= step %></p>
          </article>
        <% }); %>
        <% if (_photoTips.notes) { %>
          <div class="p-3 rounded-xl bg-zilo-bg/80 border border-zilo-border">
            <strong class="text-xs block text-zilo-accent mb-1"><%= t('client.service.photo_help_notes_label') %></strong>
            <p class="text-xs text-zilo-muted leading-relaxed"><%= _photoTips.notes %></p>
          </div>
        <% } %>
      </div>
      <div class="px-5 py-4 border-t border-zilo-border shrink-0 safe-bottom">
        <button type="button" id="photoHelpOk" class="zilo-btn-primary !py-3"><%= t('client.service.photo_help_ok') %></button>
      </div>
    </div>
  </div>
</div>

</div>

<div id="cancelModal" class="hidden fixed inset-0 z-[420]" aria-hidden="true" role="dialog" aria-labelledby="cancelModalTitle">
  <div id="cancelModalBackdrop" class="absolute inset-0 bg-black/55 backdrop-blur-sm"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center sm:p-5 pointer-events-none">
    <div class="w-full max-w-lg max-h-[88vh] overflow-hidden flex flex-col pointer-events-auto bg-white rounded-t-3xl sm:rounded-2xl border border-zilo-border shadow-xl">
      <div class="px-5 py-4 border-b border-zilo-border">
        <p class="zilo-label !text-[9px]">Cancelaciones</p>
        <h2 id="cancelModalTitle" class="text-base font-semibold"><%= t('client.service.cancel_title') %></h2>
        <p id="cancelFeeSummary" class="text-sm text-zilo-muted mt-1"></p>
        <p id="cancelRefundSummary" class="text-xs text-zilo-accent font-medium mt-0.5"></p>
      </div>
      <div class="flex-1 overflow-y-auto px-5 py-4 space-y-3">
        <label class="text-xs text-zilo-muted block" for="cancelReasonSelect"><%= t('client.service.cancel_reason_label') %></label>
        <select id="cancelReasonSelect" class="zilo-input w-full">
          <option value="">Cargando…</option>
        </select>
        <div id="cancelReasonOtherWrap" class="hidden">
          <label class="text-xs text-zilo-muted block" for="cancelReasonText"><%= t('client.service.cancel_reason_other') %></label>
          <textarea id="cancelReasonText" rows="3" maxlength="400" class="zilo-input w-full mt-1 resize-none" placeholder="<%= t('client.service.cancel_reason_other') %>"></textarea>
        </div>
      </div>
      <div class="px-5 py-4 border-t border-zilo-border space-y-2 safe-bottom">
        <button type="button" id="cancelModalConfirm" class="w-full py-3 rounded-xl bg-red-600 text-white text-sm font-semibold"><%= t('client.service.cancel_confirm_btn') %></button>
        <button type="button" id="cancelModalClose" class="w-full py-2.5 rounded-xl zilo-btn-ghost !text-sm"><%= t('client.service.cancel_close') %></button>
      </div>
    </div>
  </div>
</div>

