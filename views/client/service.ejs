          </div>
          <div id="step2" class="search-timeline-item">
            <span class="search-timeline-marker" aria-hidden="true"></span>
            <span class="search-timeline-copy"><%= t('client.service.loader_filtering') %></span>
          </div>
          <div id="step3" class="search-timeline-item">
            <span class="search-timeline-marker" aria-hidden="true"></span>
            <span class="search-timeline-copy"><%= t('client.service.loader_waiting') %></span>
          </div>
          <div id="step4" class="search-timeline-item">
            <span class="search-timeline-marker" aria-hidden="true"></span>
