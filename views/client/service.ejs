        <div id="jobChatThread" class="job-chat-thread max-h-72 overflow-y-auto px-4 py-4 space-y-2.5 min-h-[140px]"></div>
        <form id="jobChatForm" class="job-chat-composer">
          <label class="job-chat-composer__label" for="jobChatInput">Tu mensaje</label>
          <div data-role="chat-photo-preview" class="job-chat-photo-preview hidden">
            <img data-role="chat-photo-thumb" alt="">
            <button type="button" data-role="chat-photo-clear" class="job-chat-photo-clear" aria-label="Quitar foto">×</button>
          </div>
          <div class="job-chat-composer__row">
            <button type="button" class="job-chat-attach" data-role="chat-photo-btn" aria-label="Adjuntar foto" title="Adjuntar foto">
              <svg fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/><circle cx="9" cy="9" r="1.5"/></svg>
            </button>
            <input type="file" accept="image/*" class="sr-only" data-role="chat-photo-input" data-chat-composer="1" tabindex="-1">
            <input id="jobChatInput" type="text" maxlength="1000" autocomplete="off" placeholder="Escribe o adjunta una foto…" class="job-chat-input">
            <button type="submit" class="job-chat-send">Enviar</button>
          </div>
          <p class="job-chat-composer__hint">Puedes mandar texto y fotos. Cada mensaje muestra si lo envió el <strong>Cliente</strong>, el <strong>Socio</strong> o el <strong>Técnico</strong>.</p>
        </form>
      </section>
    </section>
  </main>
</div>

<%
  const _photoTips = (typeof photoTips !== 'undefined' && photoTips) ? photoTips : {
    title: t('client.service.photo_help_eyebrow'),
    steps: [
      t('client.service.photo_required_hint'),
      t('client.service.photo_brand_hint'),
      t('client.service.brand_not_visible_hint')
    ],
    notes: null,
    imageUrl: null
  };
%>
<div id="photoHelpModal" class="hidden fixed inset-0 z-[400]" aria-hidden="true" role="dialog" aria-labelledby="photoHelpTitle">
  <div id="photoHelpBackdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center sm:p-5 pointer-events-none">
    <div class="guide-modal-panel w-full max-w-lg max-h-[88vh] sm:max-h-[85vh] overflow-hidden flex flex-col pointer-events-auto animate-slide-up sm:rounded-2xl">
      <div class="zilo-modal-accent-bar shrink-0"></div>
      <div class="flex items-center justify-between px-5 py-4 border-b border-zilo-border shrink-0">
        <div>
          <p class="zilo-label !text-[9px]"><%= t('client.service.photo_help_eyebrow') %></p>
          <h2 id="photoHelpTitle" class="text-base font-semibold leading-snug"><%= _photoTips.title %></h2>
        </div>
        <button type="button" id="photoHelpClose" class="zilo-icon-btn" aria-label="<%= t('client.service.photo_help_close') %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto px-5 py-5 space-y-4">
        <% if (_photoTips.imageUrl) { %>
          <figure class="rounded-xl overflow-hidden border border-zilo-border bg-zilo-bg">
            <img src="<%= _photoTips.imageUrl %>" alt="<%= _photoTips.imageAlt || _photoTips.title %>" class="w-full max-h-48 object-cover" loading="lazy">
            <figcaption class="px-3 py-2 text-[10px] text-zilo-muted"><%= t('client.service.photo_help_example') %></figcaption>
          </figure>
        <% } %>
        <% (_photoTips.steps || []).forEach((step, i) => { %>
          <article class="flex gap-3">
            <span class="w-7 h-7 rounded-lg bg-zilo-accent/15 text-zilo-accent text-xs font-bold flex items-center justify-center shrink-0"><%= i + 1 %></span>
            <p class="text-sm text-zilo-muted leading-relaxed pt-1"><%= step %></p>
          </article>
        <% }); %>
        <% if (_photoTips.notes) { %>
          <div class="p-3 rounded-xl bg-zilo-bg/80 border border-zilo-border">
            <strong class="text-xs block text-zilo-accent mb-1"><%= t('client.service.photo_help_notes_label') %></strong>
            <p class="text-xs text-zilo-muted leading-relaxed"><%= _photoTips.notes %></p>
          </div>
        <% } %>
      </div>
      <div class="px-5 py-4 border-t border-zilo-border shrink-0 safe-bottom">
        <button type="button" id="photoHelpOk" class="zilo-btn-primary !py-3"><%= t('client.service.photo_help_ok') %></button>
      </div>
    </div>
  </div>
</div>

</div>

<div
  id="cancelModal"
  class="hidden fixed inset-0 z-[420]"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="cancelModalTitle"
>
  <script type="application/json" id="cancelReasonsJson"><%- JSON.stringify(typeof cancellationReasons !== 'undefined' ? cancellationReasons : []) %></script>
  <div id="cancelModalBackdrop" class="absolute inset-0 bg-black/55 backdrop-blur-sm"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center sm:p-5 pointer-events-none">
    <div class="cancel-sheet w-full max-w-lg max-h-[90vh] overflow-hidden flex flex-col pointer-events-auto bg-white rounded-t-3xl sm:rounded-2xl border border-zilo-border shadow-xl">
      <div class="px-5 pt-4 pb-3 border-b border-zilo-border">
        <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-zilo-border sm:hidden" aria-hidden="true"></div>
        <p class="zilo-label !text-[9px]"><%= t('client.service.cancel_eyebrow') %></p>
        <h2 id="cancelModalTitle" class="text-lg font-semibold leading-snug mt-0.5"><%= t('client.service.cancel_retention_title') %></h2>
        <p id="cancelRetentionHook" class="text-sm text-zilo-muted mt-1.5 leading-relaxed"><%= t('client.service.cancel_retention_hook') %></p>
      </div>

      <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
        <div class="cancel-keep-card">
          <p class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_keep_title') %></p>
          <ul class="cancel-keep-list">
            <li><%= t('client.service.cancel_keep_1') %></li>
            <li><%= t('client.service.cancel_keep_2') %></li>
            <li><%= t('client.service.cancel_keep_3') %></li>
          </ul>
        </div>

        <div id="cancelMoneyCard" class="cancel-money-card hidden" aria-live="polite">
          <p class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_policy_title') %></p>
          <ul id="cancelPolicyList" class="cancel-policy-list mb-3"></ul>
          <div class="cancel-money-divider"></div>
          <p class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_breakdown_title') %></p>
          <div class="cancel-money-rows">
            <div class="cancel-money-row">
              <span><%= t('client.service.cancel_paid_label') %></span>
              <strong id="cancelPaidAmount">—</strong>
            </div>
            <div class="cancel-money-row">
              <span><%= t('client.service.cancel_retention_label') %></span>
              <strong id="cancelFeeSummary">—</strong>
            </div>
            <div class="cancel-money-row cancel-money-row--total">
              <span><%= t('client.service.cancel_refund_total_label') %></span>
              <strong id="cancelRefundSummary">—</strong>
            </div>
          </div>
          <p id="cancelLossHint" class="text-xs text-zilo-muted mt-2 leading-relaxed"></p>
          <div id="cancelRefundDestination" class="mt-3 pt-3 border-t border-zilo-border/80 space-y-2">
            <p class="text-xs font-semibold text-zilo-text"><%= t('client.service.cancel_dest_title') %></p>
            <label class="flex items-start gap-2.5 p-2.5 rounded-xl border border-emerald-200 bg-emerald-50/50 cursor-pointer">
              <input type="radio" name="cancelRefundDest" value="credit" class="mt-0.5 accent-[#C45C14]" checked>
              <span class="text-xs leading-relaxed">
                <strong class="block text-emerald-900"><%= t('client.service.cancel_dest_credit') %></strong>
                <span class="text-zilo-muted"><%= t('client.service.cancel_dest_credit_hint') %></span>
              </span>
            </label>
            <label class="flex items-start gap-2.5 p-2.5 rounded-xl border border-zilo-border cursor-pointer">
              <input type="radio" name="cancelRefundDest" value="card" class="mt-0.5 accent-[#C45C14]">
              <span class="text-xs leading-relaxed">
                <strong class="block text-zilo-text"><%= t('client.service.cancel_dest_card') %></strong>
                <span class="text-zilo-muted"><%= t('client.service.cancel_dest_card_hint') %></span>
              </span>
            </label>
          </div>
        </div>

        <fieldset class="m-0 p-0 border-0">
          <legend class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_reason_label') %></legend>
          <div id="cancelReasonList" class="cancel-reason-list" role="radiogroup" aria-label="<%= t('client.service.cancel_reason_label') %>"></div>
        </fieldset>

        <div id="cancelSoftTip" class="cancel-soft-tip hidden" role="status"></div>
      </div>

      <div class="px-5 py-4 border-t border-zilo-border space-y-2 safe-bottom bg-white">
        <button type="button" id="cancelModalClose" class="w-full py-3.5 rounded-xl zilo-btn-primary !text-sm font-semibold">
          <%= t('client.service.cancel_keep_btn') %>
        </button>
        <button type="button" id="cancelModalConfirm" class="cancel-confirm-btn w-full py-2.5 rounded-xl text-sm font-semibold" disabled>
          <%= t('client.service.cancel_confirm_btn') %>
        </button>
      </div>
    </div>
  </div>
</div>

<div id="safetyModal" class="hidden fixed inset-0 z-[430]" aria-hidden="true" role="dialog" aria-labelledby="safetyModalTitle">
  <div id="safetyModalBackdrop" class="absolute inset-0 bg-black/55 backdrop-blur-sm"></div>
  <div class="relative z-10 max-w-lg mx-auto h-full flex flex-col justify-end sm:justify-center px-0 sm:px-5">
    <div class="bg-white rounded-t-3xl sm:rounded-2xl border border-zilo-border shadow-xl max-h-[90vh] flex flex-col overflow-hidden">
      <div class="px-5 pt-5 pb-3 border-b border-zilo-border">
        <p class="zilo-label text-red-700 mb-1">Seguridad</p>
        <h2 id="safetyModalTitle" class="text-lg font-semibold leading-snug">¿Qué está pasando?</h2>
        <p class="text-xs text-zilo-muted mt-1 leading-relaxed">Si hay riesgo inmediato, llama al <strong>133</strong>. También registramos la alerta en Fandez.</p>
      </div>
      <div class="px-5 py-4 overflow-y-auto space-y-3 flex-1">
        <div id="safetyCategoryList" class="space-y-2"></div>
        <div>
          <label class="text-xs text-zilo-muted" for="safetyNotes">Detalle opcional</label>
          <textarea id="safetyNotes" rows="2" maxlength="800" class="zilo-input w-full mt-1 text-sm" placeholder="Solo lo esencial. No hace falta probar nada aquí."></textarea>
        </div>
        <a href="tel:133" class="block w-full py-3 rounded-xl border border-red-300 bg-red-50 text-red-800 text-sm font-semibold text-center">Llamar 133 · Carabineros</a>
      </div>
      <div class="px-5 py-4 border-t border-zilo-border space-y-2 safe-bottom bg-white">
        <button type="button" id="safetyModalSubmit" class="w-full py-3.5 rounded-xl bg-red-700 text-white text-sm font-semibold" disabled>Enviar alerta</button>
        <button type="button" id="safetyModalClose" class="w-full py-2.5 rounded-xl zilo-btn-ghost !text-sm">Cerrar</button>
      </div>
    </div>
  </div>
</div>

