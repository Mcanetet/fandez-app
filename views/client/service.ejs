<%- include('../partials/head', { useMap: true }) %>

<% const brandOptionalServices = ['pintura', 'cerrajero', 'jardineria']; %>
<% const brandOptional = brandOptionalServices.indexOf(String(service.id || '').toLowerCase()) !== -1; %>
<% const perM2 = String(service.id || '') === 'jardineria' || service.pricingUnit === 'm2'; %>
<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="servicePage"
  data-service-id="<%= service.id %>"
  data-service-name="<%= service.name %>"
  data-visit-price="<%= typeof serviceFromPrice !== 'undefined' ? serviceFromPrice : (service.fromPrice || pricing.servicePrice) %>"
  data-from-price="<%= typeof serviceFromPrice !== 'undefined' ? serviceFromPrice : (service.fromPrice || pricing.servicePrice) %>"
  data-pricing-unit="<%= perM2 ? 'm2' : 'job' %>"
  data-tracking="<%= typeof tracking !== 'undefined' ? tracking : '' %>"
  data-resume-id="<%= typeof checkoutDraft !== 'undefined' && checkoutDraft ? checkoutDraft.id : '' %>"
  data-whatsapp="<%= company.whatsapp %>"
  data-brand-optional="<%= brandOptional ? '1' : '0' %>"
  data-user-name="<%= user && user.name ? user.name : 'Cliente' %>">

  <%- include('../partials/back-header', {
    backUrl: '/cliente',
    title: service.name,
    centerTitle: true,
    titleClass: 'text-base font-semibold'
  }) %>

  <main class="flex-1 px-5 py-5 pb-28">
    <%- include('../partials/checkout-progress', { checkoutStep: typeof tracking !== 'undefined' && tracking ? 3 : 1 }) %>
    <%- include('../partials/trust-strip', { trustStats: typeof trustStats !== 'undefined' ? trustStats : {} }) %>

    <% if (typeof checkoutDraft !== 'undefined' && checkoutDraft && !(typeof tracking !== 'undefined' && tracking)) { %>
    <div id="resumeDraftBanner" class="mb-4 p-4 rounded-2xl border border-zilo-accent/25 bg-zilo-accent/8">
      <p class="text-sm font-semibold text-zilo-ink mb-1"><%= t('client.service.resume_title') %></p>
      <p class="text-xs text-zilo-muted leading-relaxed mb-3"><%= t('client.service.resume_body') %></p>
      <div class="flex gap-2">
        <a href="/pagos/checkout?ref=<%= checkoutDraft.id %>" class="zilo-btn-primary !py-2.5 !text-sm flex-1 text-center"><%= t('client.service.resume_pay') %></a>
        <button type="button" id="btnEditDraft" class="zilo-btn-ghost !py-2.5 !text-sm shrink-0"><%= t('client.service.resume_edit') %></button>
      </div>
    </div>
    <script type="application/json" id="checkoutDraftJson"><%- JSON.stringify(checkoutDraft).replace(/</g, '\\u003c') %></script>
    <% } %>

    <%- include('../partials/service-overview-card', {
      overview: typeof serviceOverview !== 'undefined' ? serviceOverview : null,
      service: service,
      t: t
    }) %>

    <div class="p-5 rounded-2xl zilo-card-premium mb-5 zilo-page-enter-delay-1" id="pricingBox">
      <p class="zilo-label mb-4"><%= t('client.service.rates') %></p>
      <% const displayFrom = typeof serviceFromPrice !== 'undefined' ? serviceFromPrice : (service.fromPrice || pricing.servicePrice); %>
      <div class="flex justify-between py-3 border-b border-zilo-border">
        <span class="text-zilo-muted text-sm"><%= perM2 ? t('client.service.work_base_m2') : t('client.service.work_base') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayVisitPrice"><%= formatCLP(displayFrom) %><% if (perM2) { %> / m²<% } %></strong>
      </div>
      <div id="scheduleAdjustmentRow" class="hidden flex justify-between py-2 border-b border-zilo-border text-sm">
        <span class="text-zilo-muted" id="scheduleAdjustmentLabel"><%= t('client.service.schedule_surcharge') %></span>
        <strong id="displayScheduleAdj" class="text-orange-600">—</strong>
      </div>
      <div id="urgencyAdjustmentRow" class="hidden flex justify-between py-2 border-b border-zilo-border text-sm">
        <span class="text-zilo-muted" id="urgencyAdjustmentLabel"><%= t('client.service.urgency_surcharge') %></span>
        <strong id="displayUrgencyAdj" class="text-orange-600">—</strong>
      </div>
      <div class="flex justify-between py-3 border-b border-zilo-border hidden" id="servicePriceRow">
        <span class="text-zilo-muted text-sm"><%= t('client.service.service_est') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayServicePrice"><%= formatCLP(0) %></strong>
      </div>
      <div class="flex justify-between py-3">
        <span class="text-zilo-muted text-sm font-medium"><%= t('client.service.total_est') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayTotalPrice"><%= perM2 ? '—' : formatCLP(displayFrom) %></strong>
      </div>
      <p class="text-[11px] text-zilo-muted/70 mt-3"><%= t('client.service.pay_hint_dynamic') %></p>
      <details class="mt-3 text-left">
        <summary class="text-xs text-zilo-accent font-medium cursor-pointer select-none"><%= t('client.service.guarantees') %></summary>
        <ul class="mt-2 space-y-1.5 text-[11px] text-zilo-muted leading-relaxed pl-1">
          <li>✓ <%= t('client.service.g1') %></li>
          <li>✓ <%= t('client.service.g2') %></li>
          <li>✓ <%= t('client.service.g3') %></li>
          <li>✓ <%= t('client.service.g4') %></li>
          <li>✓ <%= t('client.service.g5') %></li>
        </ul>
      </details>
    </div>

    <% if (urgencyTiers && urgencyTiers.length) { %>
    <%
      const primaryUrgency = urgencyTiers.filter(function(tier) { return tier.id === 'today' || tier.id === 'immediate'; });
      const scheduleUrgency = urgencyTiers.filter(function(tier) { return tier.id !== 'today' && tier.id !== 'immediate'; });
      const hasToday = urgencyTiers.some(function(tier) { return tier.id === 'today'; });
      function urgencyBadge(tier) {
        const pct = Number(tier.surchargePercent != null ? tier.surchargePercent : tier.adjustmentPercent) || 0;
        if (pct > 0) return { text: '+' + pct + '%', cls: 'text-amber-700' };
        if (pct < 0) return { text: pct + '%', cls: 'text-emerald-700' };
        return { text: t('client.service.urgency_normal'), cls: 'text-zilo-muted' };
      }
    %>
    <div class="p-5 rounded-2xl zilo-card-premium mb-5 zilo-page-enter-delay-1">
      <p class="zilo-label mb-1"><%= t('client.service.when') %></p>
      <p class="text-[11px] text-zilo-muted mb-3"><%= t('client.service.when_hint') %></p>
      <div class="space-y-2" id="urgencyOptions">
        <% (primaryUrgency.length ? primaryUrgency : urgencyTiers).forEach(function(tier) {
          const isDefault = hasToday ? tier.id === 'today' : (tier.id === 'immediate' || tier === urgencyTiers[0]);
          const isUpgrade = tier.id === 'immediate';
          const badge = urgencyBadge(tier);
        %>
          <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer urgency-option <%= isDefault ? 'border-zilo-accent bg-zilo-accent/5' : (isUpgrade ? 'border-amber-300/70 bg-amber-50/40' : 'border-zilo-border') %>" data-tier="<%= tier.id %>">
            <input type="radio" name="urgencyTier" value="<%= tier.id %>" class="mt-1 accent-zilo-accent" <%= isDefault ? 'checked' : '' %>>
            <div class="flex-1 min-w-0">
              <div class="flex justify-between items-start gap-2">
                <strong class="text-sm"><%= tier.id === 'today' ? t('client.service.urgency_today') : (tier.id === 'immediate' ? t('client.service.urgency_now') : tier.label) %></strong>
                <span class="text-xs font-medium shrink-0 urgency-pct <%= badge.cls %>"><%= badge.text %></span>
              </div>
              <% if (isUpgrade) { %>
                <p class="text-[11px] text-amber-800/80 mt-0.5"><%= t('client.service.urgency_now_hint') %></p>
              <% } else if (tier.description) { %>
                <p class="text-[11px] text-zilo-muted mt-0.5"><%= tier.description %></p>
              <% } %>
            </div>
          </label>
        <% }); %>
        <% if (scheduleUrgency.length && primaryUrgency.length) { %>
        <details class="rounded-xl border border-zilo-border overflow-hidden" id="urgencyScheduleDetails">
          <summary class="px-3 py-2.5 text-sm cursor-pointer text-zilo-muted hover:text-zilo-text list-none flex items-center justify-between gap-2">
            <span><%= t('client.service.schedule_later') %></span>
            <span class="text-[10px] uppercase tracking-wide"><%= t('client.service.schedule_later_hint') %></span>
          </summary>
          <div class="space-y-2 p-2 pt-0 border-t border-zilo-border">
            <% scheduleUrgency.forEach(function(tier) {
              const badge = urgencyBadge(tier);
            %>
              <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer urgency-option border-zilo-border" data-tier="<%= tier.id %>">
                <input type="radio" name="urgencyTier" value="<%= tier.id %>" class="mt-1 accent-zilo-accent">
                <div class="flex-1 min-w-0">
                  <div class="flex justify-between items-start gap-2">
                    <strong class="text-sm"><%= tier.label %></strong>
                    <span class="text-xs font-medium shrink-0 urgency-pct <%= badge.cls %>"><%= badge.text %></span>
                  </div>
                  <% if (tier.description) { %><p class="text-[11px] text-zilo-muted mt-0.5"><%= tier.description %></p><% } %>
                </div>
              </label>
            <% }); %>
          </div>
        </details>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (mod('client_aland')) { %>
    <section class="p-4 rounded-xl zilo-card-premium mb-5 zilo-page-enter-delay-1 border border-aland/25 aland-surface" id="alandChatSection" data-auto-open="<%= (typeof currentQuery !== 'undefined' && String(currentQuery).includes('aland=1')) ? '1' : '0' %>">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-sm font-semibold text-aland-strong"><%= t('client.service.aland_title') %></p>
          <p class="text-[11px] text-zilo-muted"><%= t('client.service.aland_sub') %></p>
        </div>
        <button type="button" id="alandChatToggle" class="text-xs px-3 py-1.5 rounded-lg aland-chip"><%= t('client.service.aland_open') %></button>
      </div>
      <div id="alandChatPanel" class="hidden border border-zilo-border rounded-xl overflow-hidden">
        <div id="alandChatMessages" class="h-56 overflow-y-auto p-3 space-y-2 bg-zilo-bg text-sm"></div>
        <form id="alandChatForm" class="flex gap-2 p-2 border-t border-zilo-border bg-white">
          <input type="text" id="alandChatInput" placeholder="<%= t('client.service.aland_placeholder') %>" class="flex-1 px-3 py-2 rounded-lg border border-zilo-border text-sm" autocomplete="off">
          <button type="submit" class="px-4 py-2 rounded-lg aland-btn text-sm font-medium"><%= t('client.service.aland_send') %></button>
        </form>
      </div>
    </section>
    <% } %>

    <section id="requestForm" class="space-y-4 zilo-page-enter-delay-2">
      <% if (mod('client_regalo')) { %>
      <div class="p-4 rounded-2xl zilo-gift-card">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="giftToggle" class="w-5 h-5 rounded accent-zilo-accent">
          <div>
            <strong class="text-sm block"><%= t('client.service.gift') %></strong>
            <span class="text-xs text-zilo-muted"><%= mod('client_guardian') ? t('client.service.gift_guardian') : t('client.service.gift_other') %></span>
          </div>
        </label>
        <div id="giftFields" class="hidden mt-4 space-y-3 pt-3 border-t border-zilo-accent/15">
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.beneficiary') %></label>
            <input type="text" id="giftName" placeholder="<%= t('client.service.gift_name_ph') %>" class="zilo-input">
          </div>
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.gift_phone_label') %></label>
            <input type="tel" id="giftPhone" placeholder="<%= t('client.service.gift_phone_ph') %>" class="zilo-input">
          </div>
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.gift_message') %></label>
            <input type="text" id="giftMessage" placeholder="..." class="zilo-input">
          </div>
        </div>
      </div>
      <% } %>

      <div>
        <label for="address" class="zilo-label block mb-1.5" id="addressLabel"><%= t('client.service.address') %></label>
        <input type="text" id="address" placeholder="<%= t('client.service.address_ph') %>"
          value="<%= typeof profile !== 'undefined' ? profile.address : '' %>" class="zilo-input">
        <input type="hidden" id="lat"><input type="hidden" id="lng">
      </div>

      <div>
        <label class="zilo-label block mb-1.5"><%= t('client.service.location') %></label>
        <div id="addressMap" class="w-full h-44 rounded-2xl overflow-hidden border border-zilo-border bg-zilo-bg"></div>
        <p id="mapStatus" class="text-[10px] text-zilo-muted mt-1.5"><%= t('client.service.map_hint') %></p>
        <div id="coverageAlert" class="hidden mt-2 p-3 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 text-xs leading-relaxed" role="alert"></div>
      </div>

      <% if (typeof activities !== 'undefined' && activities.length) { %>
      <div>
        <label for="activityId" class="zilo-label block mb-1.5"><%= t('client.service.subservice') %> *</label>
        <select id="activityId" name="activityId" required class="zilo-input">
          <option value=""><%= t('client.service.subservice_ph') %></option>
          <% activities.forEach(function(act) { %>
            <option value="<%= act.id %>" data-base="<%= act.basePrice %>" data-unit="<%= act.pricingUnit || 'job' %>" data-per-m2="<%= act.pricePerM2 || act.basePrice %>" data-min-m2="<%= act.minM2 || 15 %>" data-quote-mode="<%= act.quoteMode || '' %>">
              <%= act.name %> — <%= act.quoteMode === 'landscape'
                ? ('desde ' + formatCLP(act.pricePerM2 || act.basePrice) + ' / m²')
                : (act.pricingUnit === 'm2' ? (formatCLP(act.pricePerM2 || act.basePrice) + ' / m²') : formatCLP(act.basePrice)) %>
            </option>
          <% }); %>
          <option value="otro" data-base="<%= perM2 ? 5500 : 100000 %>" data-unit="<%= perM2 ? 'm2' : 'job' %>" data-per-m2="<%= perM2 ? 5500 : '' %>" data-min-m2="15">
            <%= perM2 ? 'Otro — describir (desde $5.500 / m²)' : 'Otro — describir (desde $100.000)' %>
          </option>
        </select>
        <p class="text-[11px] text-zilo-muted mt-1"><%= t('client.service.subservice_hint') %></p>
        <div id="customActivityFields" class="hidden mt-3 space-y-2 p-3 rounded-xl border border-zilo-border bg-zilo-surface/40">
          <label for="customActivityName" class="zilo-label block">Describe el servicio *</label>
          <input type="text" id="customActivityName" maxlength="120" class="zilo-input w-full" placeholder="Ej: Instalar grifería de duchas + sellado">
          <p class="text-[11px] text-zilo-muted">El socio puede ajustar el detalle y precio en terreno; tú lo validas.</p>
        </div>
      </div>
      <% } %>

      <% if (perM2) { %>
      <div id="gardenAreaBlock">
        <label for="squareMeters" class="zilo-label block mb-1.5"><%= t('client.service.area_m2') %> *</label>
        <input type="number" id="squareMeters" name="squareMeters" min="10" step="1" inputmode="numeric" required class="zilo-input" placeholder="<%= t('client.service.area_m2_ph') %>">
        <p class="text-[11px] text-zilo-muted mt-1" id="gardenAreaHint"><%= t('client.service.area_m2_hint') %></p>
      </div>

      <div id="landscapeFactors" class="hidden space-y-3 p-4 rounded-2xl border border-emerald-200/80 bg-emerald-50/40">
        <div>
          <p class="zilo-label mb-1"><%= t('client.service.landscape_title') %></p>
          <p class="text-[11px] text-zilo-muted"><%= t('client.service.landscape_hint') %></p>
        </div>
        <div>
          <label for="landscapeStandard" class="zilo-label block mb-1.5"><%= t('client.service.landscape_standard') %> *</label>
          <select id="landscapeStandard" class="zilo-input">
            <option value=""><%= t('client.service.landscape_standard_ph') %></option>
            <option value="basico" data-rate="25000"><%= t('client.service.landscape_std_basic') %></option>
            <option value="intermedio" data-rate="45000"><%= t('client.service.landscape_std_mid') %></option>
            <option value="alto" data-rate="70000"><%= t('client.service.landscape_std_high') %></option>
          </select>
        </div>
        <div>
          <label for="landscapeTerrain" class="zilo-label block mb-1.5"><%= t('client.service.landscape_terrain') %> *</label>
          <select id="landscapeTerrain" class="zilo-input">
            <option value=""><%= t('client.service.landscape_terrain_ph') %></option>
            <option value="plano" data-mult="1"><%= t('client.service.landscape_terrain_flat') %></option>
            <option value="pendiente" data-mult="1.15"><%= t('client.service.landscape_terrain_slope') %></option>
            <option value="acceso_dificil" data-mult="1.25"><%= t('client.service.landscape_terrain_hard') %></option>
          </select>
        </div>
        <div>
          <label for="landscapeSpecies" class="zilo-label block mb-1.5"><%= t('client.service.landscape_species') %> *</label>
          <select id="landscapeSpecies" class="zilo-input">
            <option value=""><%= t('client.service.landscape_species_ph') %></option>
            <option value="economicas" data-mult="1"><%= t('client.service.landscape_species_eco') %></option>
            <option value="mixtas" data-mult="1.1"><%= t('client.service.landscape_species_mix') %></option>
            <option value="premium" data-mult="1.2"><%= t('client.service.landscape_species_premium') %></option>
          </select>
        </div>
        <div>
          <p class="zilo-label mb-2"><%= t('client.service.landscape_includes') %></p>
          <div class="space-y-2 text-sm">
            <label class="flex items-center gap-2"><input type="checkbox" id="landscapeDesign" class="accent-zilo-accent"> <%= t('client.service.landscape_inc_design') %></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="landscapeIrrigation" class="accent-zilo-accent"> <%= t('client.service.landscape_inc_irrigation') %></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="landscapeEarthwork" class="accent-zilo-accent"> <%= t('client.service.landscape_inc_earthwork') %></label>
            <label class="flex items-center gap-2"><input type="checkbox" id="landscapeLighting" class="accent-zilo-accent"> <%= t('client.service.landscape_inc_lighting') %></label>
          </div>
          <p class="text-[11px] text-zilo-muted mt-2"><%= t('client.service.landscape_materials_note') %></p>
        </div>
      </div>
      <% } %>

      <div>
        <label for="notes" class="zilo-label block mb-1.5"><%= t('client.service.detail') %> *</label>
        <textarea id="notes" rows="3" required placeholder="<%= perM2 ? t('client.service.detail_garden_ph') : t('client.service.detail_ph') %>" class="zilo-input resize-none"></textarea>
      </div>

      <div class="space-y-4">
        <div>
          <label class="zilo-label block mb-1.5"><%= perM2 ? t('client.service.photo_garden') : t('client.service.photo') %> <% if (!perM2) { %><span class="font-normal text-zilo-muted"><%= t('client.service.photo_opt') %></span><% } else { %><span class="font-normal text-zilo-muted">*</span><% } %></label>
          <p class="text-[11px] text-zilo-muted mb-2"><%= perM2 ? t('client.service.photo_garden_hint') : t('client.service.photo_optional_hint') %></p>
          <button type="button" id="btnPhotoHelp" class="w-full mb-3 py-2.5 px-3 rounded-xl border border-zilo-accent/30 bg-zilo-accent/10 text-zilo-accent text-xs font-semibold text-left flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span><%= t('client.service.photo_help_link') %></span>
          </button>
          <input type="file" id="clientPhoto" accept="image/*" capture="environment" class="block w-full text-xs text-zilo-muted file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent file:text-xs file:font-medium">
          <div id="clientPhotoPreview" class="hidden mt-2">
            <img src="" alt="<%= t('client.service.preview_alt') %>" class="w-full max-h-40 object-cover rounded-xl border border-zilo-border">
          </div>
        </div>

        <div id="brandPhotoBlock" class="<%= brandOptional ? 'hidden' : '' %>">
          <label class="zilo-label block mb-1.5"><%= t('client.service.photo_brand') %> <span class="font-normal text-zilo-muted"><%= t('client.service.photo_opt') %></span></label>
          <p class="text-[11px] text-zilo-muted mb-2"><%= t('client.service.photo_brand_hint') %></p>
          <input type="file" id="clientBrandPhoto" accept="image/*" capture="environment" class="block w-full text-xs text-zilo-muted file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent file:text-xs file:font-medium">
          <div id="clientBrandPhotoPreview" class="hidden mt-2">
            <img src="" alt="<%= t('client.service.photo_brand') %>" class="w-full max-h-40 object-cover rounded-xl border border-zilo-border">
          </div>
        </div>

        <label class="flex items-start gap-2.5 p-3 rounded-xl border border-zilo-border cursor-pointer <%= brandOptional ? 'hidden' : '' %>" id="brandNotVisibleLabel">
          <input type="checkbox" id="brandNotVisible" class="mt-0.5 accent-zilo-accent shrink-0" <%= brandOptional ? 'checked' : '' %>>
          <span class="text-sm leading-snug">
            <strong class="block font-medium"><%= t('client.service.brand_not_visible') %></strong>
            <span class="text-[11px] text-zilo-muted"><%= t('client.service.brand_not_visible_hint') %></span>
          </span>
        </label>
      </div>

      <button type="button" id="btnRequest" class="zilo-btn-primary"><%= t('client.service.continue') %></button>
      <p class="text-center text-[10px] text-zilo-muted"><%= t('client.service.secure_pay') %></p>
    </section>

    <div id="stickyOrderBar" class="sticky-order-bar" aria-hidden="true">
      <div class="sticky-order-inner max-w-lg mx-auto">
        <div class="min-w-0">
          <p class="text-[10px] text-zilo-muted uppercase tracking-wide"><%= t('client.service.visit_est') %></p>
          <strong class="text-zilo-accent text-base" id="stickyTotal"><%= perM2 ? '—' : formatCLP(typeof displayFrom !== 'undefined' ? displayFrom : (service.fromPrice || pricing.servicePrice)) %></strong>
        </div>
        <button type="button" id="btnRequestSticky" class="sticky-order-btn"><%= t('client.service.continue') %></button>
      </div>
    </div>

    <div id="stickyTrackBar" class="sticky-track-bar" aria-hidden="true">
      <div class="sticky-track-inner max-w-lg mx-auto">
        <div class="min-w-0 sticky-track-copy">
          <p class="zilo-label !text-[9px]" id="stickyTrackLabel">Tu visita</p>
