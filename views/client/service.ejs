      <div class="flex items-center justify-between px-5 py-4 border-b border-zilo-border shrink-0">
        <div>
          <p class="zilo-label !text-[9px]"><%= t('client.service.photo_help_eyebrow') %></p>
          <h2 id="photoHelpTitle" class="text-base font-semibold leading-snug"><%= _photoTips.title %></h2>
        </div>
        <button type="button" id="photoHelpClose" class="zilo-icon-btn" aria-label="<%= t('client.service.photo_help_close') %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto px-5 py-5 space-y-4">
        <% if (_photoTips.imageUrl) { %>
          <figure class="rounded-xl overflow-hidden border border-zilo-border bg-zilo-bg">
            <img src="<%= _photoTips.imageUrl %>" alt="<%= _photoTips.imageAlt || _photoTips.title %>" class="w-full max-h-48 object-cover" loading="lazy">
            <figcaption class="px-3 py-2 text-[10px] text-zilo-muted"><%= t('client.service.photo_help_example') %></figcaption>
          </figure>
        <% } %>
        <% (_photoTips.steps || []).forEach((step, i) => { %>
          <article class="flex gap-3">
            <span class="w-7 h-7 rounded-lg bg-zilo-accent/15 text-zilo-accent text-xs font-bold flex items-center justify-center shrink-0"><%= i + 1 %></span>
            <p class="text-sm text-zilo-muted leading-relaxed pt-1"><%= step %></p>
          </article>
        <% }); %>
        <% if (_photoTips.notes) { %>
          <div class="p-3 rounded-xl bg-zilo-bg/80 border border-zilo-border">
            <strong class="text-xs block text-zilo-accent mb-1"><%= t('client.service.photo_help_notes_label') %></strong>
            <p class="text-xs text-zilo-muted leading-relaxed"><%= _photoTips.notes %></p>
          </div>
        <% } %>
      </div>
      <div class="px-5 py-4 border-t border-zilo-border shrink-0 safe-bottom">
        <button type="button" id="photoHelpOk" class="zilo-btn-primary !py-3"><%= t('client.service.photo_help_ok') %></button>
      </div>
    </div>
  </div>
</div>

</div>

<div
  id="cancelModal"
  class="hidden fixed inset-0 z-[420]"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="cancelModalTitle"
>
  <script type="application/json" id="cancelReasonsJson"><%- JSON.stringify(typeof cancellationReasons !== 'undefined' ? cancellationReasons : []) %></script>
  <div id="cancelModalBackdrop" class="absolute inset-0 bg-black/55 backdrop-blur-sm"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center sm:p-5 pointer-events-none">
    <div class="cancel-sheet w-full max-w-lg max-h-[90vh] overflow-hidden flex flex-col pointer-events-auto bg-white rounded-t-3xl sm:rounded-2xl border border-zilo-border shadow-xl">
      <div class="px-5 pt-4 pb-3 border-b border-zilo-border">
        <div class="mx-auto mb-3 h-1 w-10 rounded-full bg-zilo-border sm:hidden" aria-hidden="true"></div>
        <p class="zilo-label !text-[9px]"><%= t('client.service.cancel_eyebrow') %></p>
        <h2 id="cancelModalTitle" class="text-lg font-semibold leading-snug mt-0.5"><%= t('client.service.cancel_retention_title') %></h2>
        <p id="cancelRetentionHook" class="text-sm text-zilo-muted mt-1.5 leading-relaxed"><%= t('client.service.cancel_retention_hook') %></p>
      </div>

      <div class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
        <div class="cancel-keep-card">
          <p class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_keep_title') %></p>
          <ul class="cancel-keep-list">
            <li><%= t('client.service.cancel_keep_1') %></li>
            <li><%= t('client.service.cancel_keep_2') %></li>
            <li><%= t('client.service.cancel_keep_3') %></li>
          </ul>
        </div>

        <div id="cancelMoneyCard" class="cancel-money-card hidden" aria-live="polite">
          <p class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_policy_title') %></p>
          <ul id="cancelPolicyList" class="cancel-policy-list mb-3"></ul>
          <div class="cancel-money-divider"></div>
          <p class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_breakdown_title') %></p>
          <div class="cancel-money-rows">
            <div class="cancel-money-row">
              <span><%= t('client.service.cancel_paid_label') %></span>
              <strong id="cancelPaidAmount">—</strong>
            </div>
            <div class="cancel-money-row">
              <span><%= t('client.service.cancel_retention_label') %></span>
              <strong id="cancelFeeSummary">—</strong>
            </div>
            <div class="cancel-money-row cancel-money-row--total">
              <span><%= t('client.service.cancel_refund_total_label') %></span>
              <strong id="cancelRefundSummary">—</strong>
            </div>
          </div>
          <p id="cancelLossHint" class="text-xs text-zilo-muted mt-2 leading-relaxed"></p>
        </div>

        <fieldset class="m-0 p-0 border-0">
          <legend class="text-xs font-semibold text-zilo-text mb-2"><%= t('client.service.cancel_reason_label') %></legend>
          <div id="cancelReasonList" class="cancel-reason-list" role="radiogroup" aria-label="<%= t('client.service.cancel_reason_label') %>"></div>
        </fieldset>

        <div id="cancelSoftTip" class="cancel-soft-tip hidden" role="status"></div>
      </div>

      <div class="px-5 py-4 border-t border-zilo-border space-y-2 safe-bottom bg-white">
        <button type="button" id="cancelModalClose" class="w-full py-3.5 rounded-xl zilo-btn-primary !text-sm font-semibold">
          <%= t('client.service.cancel_keep_btn') %>
        </button>
        <button type="button" id="cancelModalConfirm" class="cancel-confirm-btn w-full py-2.5 rounded-xl text-sm font-semibold" disabled>
          <%= t('client.service.cancel_confirm_btn') %>
        </button>
      </div>
    </div>
  </div>
</div>

