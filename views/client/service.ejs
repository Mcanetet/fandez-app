<% const payFlowNow = typeof inlinePayFlow !== 'undefined' && inlinePayFlow; %>
<%- include('../partials/head', { useMap: !payFlowNow, preloadMp: typeof mpEmbedCheckout !== 'undefined' && mpEmbedCheckout }) %>

<% const brandOptionalServices = ['pintura', 'cerrajero', 'jardineria', 'paisajismo', 'limpieza', 'escombros', 'fotovoltaico', 'piscinas']; %>
<% const brandOptional = brandOptionalServices.indexOf(String(service.id || '').toLowerCase()) !== -1; %>
<% const isGarden = String(service.id || '') === 'paisajismo'; %>
<% const isFv = String(service.id || '') === 'fotovoltaico'; %>
<% const isCleaning = String(service.id || '') === 'limpieza'; %>
<% const isEscombros = String(service.id || '') === 'escombros'; %>
<% const servicePath = typeof resolvedServicePath !== 'undefined' ? resolvedServicePath : 'now'; %>
<% const isProjectPath = servicePath === 'project' || isGarden || isFv; %>
<% const perM2 = isCleaning || (!isGarden && !isFv && !isEscombros && service.pricingUnit === 'm2'); %>
<% const draftAmount = (typeof checkoutDraft !== 'undefined' && checkoutDraft)
  ? (checkoutDraft.amountDue || checkoutDraft.visitTotal || checkoutDraft.basePrice || 0)
  : 0; %>
<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter<%= payFlowNow ? ' service-pay-flow' : '' %>" id="servicePage"
  data-service-id="<%= service.id %>"
  data-service-name="<%= service.name %>"
  data-client-id="<%= user && user.id ? user.id : '' %>"
  data-visit-price="<%= typeof serviceFromPrice !== 'undefined' ? serviceFromPrice : (service.fromPrice || pricing.servicePrice) %>"
  data-from-price="<%= typeof serviceFromPrice !== 'undefined' ? serviceFromPrice : (service.fromPrice || pricing.servicePrice) %>"
  data-pricing-unit="<%= isEscombros ? 'mixed' : (perM2 ? 'm2' : 'job') %>"
  data-cleaning="<%= isCleaning ? '1' : '0' %>"
  data-escombros="<%= isEscombros ? '1' : '0' %>"
  data-escombros-min="297500"
  data-garden-intake="<%= isGarden ? '1' : '0' %>"
  data-fv-intake="<%= isFv ? '1' : '0' %>"
  data-service-path="<%= isProjectPath ? 'project' : 'now' %>"
  data-min-m2="<%= isGarden ? 100 : (isCleaning ? 20 : (isEscombros ? 1 : 10)) %>"
  data-tracking="<%= typeof tracking !== 'undefined' ? tracking : '' %>"
  data-resume-id="<%= typeof checkoutDraft !== 'undefined' && checkoutDraft ? checkoutDraft.id : '' %>"
  data-pay-flow="<%= payFlowNow ? '1' : '0' %>"
  data-whatsapp="<%= company.whatsapp %>"
  data-brand-optional="<%= brandOptional ? '1' : '0' %>"
  data-user-name="<%= user && user.name ? user.name : 'Cliente' %>"
  data-address-lat="<%= typeof profile !== 'undefined' && profile.addressLat != null ? profile.addressLat : '' %>"
  data-address-lng="<%= typeof profile !== 'undefined' && profile.addressLng != null ? profile.addressLng : '' %>"
  data-mp-embed="<%= typeof mpEmbedCheckout !== 'undefined' && mpEmbedCheckout ? '1' : '0' %>"
  data-mp-public-key="<%= typeof mpPublicKey !== 'undefined' ? mpPublicKey : '' %>"
  data-mp-token-configured="<%= typeof mpTokenConfigured !== 'undefined' && mpTokenConfigured ? '1' : '0' %>"
  data-max-installments="<%= typeof maxCardInstallments !== 'undefined' ? maxCardInstallments : 3 %>">

  <%- include('../partials/back-header', {
    backUrl: '/cliente',
    title: service.name,
    centerTitle: true,
    titleClass: 'text-base font-semibold'
  }) %>

  <main class="flex-1 px-5 py-5 pb-28">
    <%- include('../partials/checkout-progress', { checkoutStep: typeof tracking !== 'undefined' && tracking ? 3 : 1 }) %>
    <%- include('../partials/trust-strip', { trustStats: typeof trustStats !== 'undefined' ? trustStats : {} }) %>

    <% if (!(typeof tracking !== 'undefined' && tracking)) { %>
    <div class="mb-4 p-3 rounded-2xl border <%= isProjectPath ? 'border-emerald-200 bg-emerald-50/60' : 'border-amber-200 bg-amber-50/50' %>">
      <p class="text-[11px] font-semibold uppercase tracking-wide <%= isProjectPath ? 'text-emerald-800' : 'text-amber-900' %> mb-0.5">
        <%= isProjectPath ? t('client.service.path_project_badge') : t('client.service.path_now_badge') %>
      </p>
      <p class="text-xs leading-relaxed <%= isProjectPath ? 'text-emerald-900/80' : 'text-amber-950/80' %>">
        <%= isProjectPath ? t('client.service.path_project_body') : t('client.service.path_now_body') %>
      </p>
    </div>
    <% } %>

    <% if (typeof checkoutDraft !== 'undefined' && checkoutDraft && !(typeof tracking !== 'undefined' && tracking)) { %>
    <div id="resumeDraftBanner" class="mb-4 p-4 rounded-2xl border border-zilo-accent/25 bg-zilo-accent/8">
      <p class="text-sm font-semibold text-zilo-ink mb-1"><%= t('client.service.resume_title') %></p>
      <p class="text-xs text-zilo-muted leading-relaxed mb-3"><%= t('client.service.resume_body') %></p>
      <div class="flex gap-2">
        <button type="button" id="btnResumePay" data-request-id="<%= checkoutDraft.id %>" class="zilo-btn-primary !py-2.5 !text-sm flex-1 text-center"><%= t('client.service.resume_pay') %></button>
        <button type="button" id="btnEditDraft" class="zilo-btn-ghost !py-2.5 !text-sm shrink-0"><%= t('client.service.resume_edit') %></button>
      </div>
    </div>
    <script type="application/json" id="checkoutDraftJson"><%- JSON.stringify(checkoutDraft).replace(/</g, '\\u003c') %></script>
    <% } %>

    <%- include('../partials/service-overview-card', {
      overview: typeof serviceOverview !== 'undefined' ? serviceOverview : null,
      service: service,
      t: t
    }) %>

    <div class="p-5 rounded-2xl zilo-card-premium mb-5 zilo-page-enter-delay-1" id="pricingBox">
      <p class="zilo-label mb-4"><%= t('client.service.rates') %></p>
      <% const displayFrom = typeof serviceFromPrice !== 'undefined' ? serviceFromPrice : (service.fromPrice || pricing.servicePrice); %>
      <% const escombrosMin = Number(typeof service !== 'undefined' && service.minJobPrice) || 297500; %>
      <div class="flex justify-between py-3 border-b border-zilo-border">
        <span class="text-zilo-muted text-sm"><%= isGarden ? 'Evaluación técnica' : (isEscombros ? (t('client.from_price') + ' / m²') : (perM2 ? t('client.service.work_base_m2') : t('client.service.work_base'))) %></span>
        <strong class="text-zilo-accent font-semibold text-right" id="displayVisitPrice"><%= formatCLP(displayFrom) %><% if (perM2 || isEscombros) { %> / m²<% } %><% if (isEscombros) { %><span class="block text-[11px] font-medium text-zilo-muted mt-0.5"><%= t('client.min_job') %> <%= formatCLP(escombrosMin) %></span><% } %></strong>
      </div>
      <div id="scheduleAdjustmentRow" class="hidden flex justify-between py-2 border-b border-zilo-border text-sm">
        <span class="text-zilo-muted" id="scheduleAdjustmentLabel"><%= t('client.service.schedule_surcharge') %></span>
        <strong id="displayScheduleAdj" class="text-orange-600">—</strong>
      </div>
      <div id="urgencyAdjustmentRow" class="hidden flex justify-between py-2 border-b border-zilo-border text-sm">
        <span class="text-zilo-muted" id="urgencyAdjustmentLabel"><%= t('client.service.urgency_surcharge') %></span>
        <strong id="displayUrgencyAdj" class="text-orange-600">—</strong>
      </div>
      <div id="zoneAdjustmentRow" class="hidden flex justify-between py-2 border-b border-zilo-border text-sm">
        <span class="text-zilo-muted" id="zoneAdjustmentLabel"><%= t('client.service.zone_surcharge') %></span>
        <strong id="displayZoneAdj" class="text-orange-600">—</strong>
      </div>
      <div class="flex justify-between py-3 border-b border-zilo-border hidden" id="servicePriceRow">
        <span class="text-zilo-muted text-sm"><%= t('client.service.service_est') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayServicePrice"><%= formatCLP(0) %></strong>
      </div>
      <div class="flex justify-between py-3">
        <span class="text-zilo-muted text-sm font-medium"><%= t('client.service.total_est') %></span>
        <strong class="text-zilo-accent font-semibold" id="displayTotalPrice"><%= perM2 ? '—' : formatCLP(displayFrom) %></strong>
      </div>
      <p class="text-[11px] text-zilo-muted/70 mt-3"><%= isFv
        ? 'Pagas la evaluación ahora. El precio del kit/proyecto te lo arma el instalador después del levantamiento.'
        : (isGarden
        ? 'Pagas la evaluación técnica ahora. Diseño, construcción o mantención se cotizan después según el alcance acordado con el socio.'
        : t('client.service.pay_hint_dynamic')) %></p>
      <details class="mt-3 text-left">
        <summary class="text-xs text-zilo-accent font-medium cursor-pointer select-none"><%= t('client.service.guarantees') %></summary>
        <ul class="mt-2 space-y-1.5 text-[11px] text-zilo-muted leading-relaxed pl-1">
          <li>✓ <%= t('client.service.g1') %></li>
          <li>✓ <%= t('client.service.g2') %></li>
          <li>✓ <%= t('client.service.g3') %></li>
          <li>✓ <%= t('client.service.g4') %></li>
          <li>✓ <%= t('client.service.g5') %></li>
        </ul>
      </details>
    </div>

    <% if (urgencyTiers && urgencyTiers.length) { %>
    <%
      const primaryTierIds = { today: 1, immediate: 1, critical: 1 };
      const primaryUrgency = isProjectPath
        ? []
        : urgencyTiers.filter(function(tier) { return primaryTierIds[tier.id]; });
      const scheduleUrgency = urgencyTiers.filter(function(tier) { return !primaryTierIds[tier.id]; });
      const projectUrgency = isProjectPath
        ? (scheduleUrgency.length ? scheduleUrgency : urgencyTiers.filter(function(tier) { return tier.id !== 'immediate'; }))
        : [];
      const hasToday = !isProjectPath && urgencyTiers.some(function(tier) { return tier.id === 'today'; });
      function urgencyBadge(tier) {
        const pct = Number(tier.surchargePercent != null ? tier.surchargePercent : tier.adjustmentPercent) || 0;
        if (pct > 0) return { text: '+' + pct + '%', cls: 'text-amber-700' };
        if (pct < 0) return { text: pct + '%', cls: 'text-emerald-700' };
        return { text: t('client.service.urgency_normal'), cls: 'text-zilo-muted' };
      }
    %>
    <div class="p-5 rounded-2xl zilo-card-premium mb-5 zilo-page-enter-delay-1">
      <p class="zilo-label mb-1"><%= isProjectPath ? t('client.service.when_project') : t('client.service.when') %></p>
      <p class="text-[11px] text-zilo-muted mb-3"><%= isProjectPath ? t('client.service.when_project_hint') : t('client.service.when_hint') %></p>
      <div class="space-y-2" id="urgencyOptions">
        <% if (isProjectPath) {
          projectUrgency.forEach(function(tier, idx) {
            const isDefault = idx === 0;
            const badge = urgencyBadge(tier);
        %>
          <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer urgency-option <%= isDefault ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>" data-tier="<%= tier.id %>">
            <input type="radio" name="urgencyTier" value="<%= tier.id %>" class="mt-1 accent-zilo-accent" <%= isDefault ? 'checked' : '' %>>
            <div class="flex-1 min-w-0">
              <div class="flex justify-between items-start gap-2">
                <strong class="text-sm"><%= tier.label %></strong>
                <span class="text-xs font-medium shrink-0 urgency-pct <%= badge.cls %>"><%= badge.text %></span>
              </div>
              <% if (tier.description) { %><p class="text-[11px] text-zilo-muted mt-0.5"><%= tier.description %></p><% } %>
            </div>
          </label>
        <% }); } else {
          (primaryUrgency.length ? primaryUrgency : urgencyTiers).forEach(function(tier) {
          const isFastTier = tier.id === 'immediate' || tier.id === 'critical';
          const isDefault = hasToday ? tier.id === 'today' : (isFastTier || tier === urgencyTiers[0]);
          const isUpgrade = isFastTier;
          const badge = urgencyBadge(tier);
        %>
          <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer urgency-option <%= isDefault ? 'border-zilo-accent bg-zilo-accent/5' : (isUpgrade ? 'border-amber-300/70 bg-amber-50/40' : 'border-zilo-border') %>" data-tier="<%= tier.id %>">
            <input type="radio" name="urgencyTier" value="<%= tier.id %>" class="mt-1 accent-zilo-accent" <%= isDefault ? 'checked' : '' %>>
            <div class="flex-1 min-w-0">
              <div class="flex justify-between items-start gap-2">
                <strong class="text-sm"><%= tier.id === 'today' ? t('client.service.urgency_today') : (isFastTier ? t('client.service.urgency_now') : tier.label) %></strong>
                <span class="text-xs font-medium shrink-0 urgency-pct <%= badge.cls %>"><%= badge.text %></span>
              </div>
              <% if (isUpgrade) { %>
                <p class="text-[11px] text-amber-800/80 mt-0.5"><%= tier.description || t('client.service.urgency_now_sla') %></p>
              <% } else if (tier.description) { %>
                <p class="text-[11px] text-zilo-muted mt-0.5"><%= tier.description %></p>
              <% } %>
            </div>
          </label>
        <% }); %>
        <% if (scheduleUrgency.length && primaryUrgency.length) { %>
        <details class="rounded-xl border border-zilo-border overflow-hidden" id="urgencyScheduleDetails">
          <summary class="px-3 py-2.5 text-sm cursor-pointer text-zilo-muted hover:text-zilo-text list-none flex items-center justify-between gap-2">
            <span><%= t('client.service.schedule_later') %></span>
            <span class="text-[10px] uppercase tracking-wide"><%= t('client.service.schedule_later_hint') %></span>
          </summary>
          <div class="space-y-2 p-2 pt-0 border-t border-zilo-border">
            <% scheduleUrgency.forEach(function(tier) {
              const badge = urgencyBadge(tier);
            %>
              <label class="flex items-start gap-3 p-3 rounded-xl border cursor-pointer urgency-option border-zilo-border" data-tier="<%= tier.id %>">
                <input type="radio" name="urgencyTier" value="<%= tier.id %>" class="mt-1 accent-zilo-accent">
                <div class="flex-1 min-w-0">
                  <div class="flex justify-between items-start gap-2">
                    <strong class="text-sm"><%= tier.label %></strong>
                    <span class="text-xs font-medium shrink-0 urgency-pct <%= badge.cls %>"><%= badge.text %></span>
                  </div>
                  <% if (tier.description) { %><p class="text-[11px] text-zilo-muted mt-0.5"><%= tier.description %></p><% } %>
                </div>
              </label>
            <% }); %>
          </div>
        </details>
        <% } %>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (mod('client_aland')) { %>
    <section class="p-4 rounded-xl zilo-card-premium mb-5 zilo-page-enter-delay-1 border border-aland/25 aland-surface" id="alandChatSection" data-auto-open="<%= (typeof currentQuery !== 'undefined' && String(currentQuery).includes('aland=1')) ? '1' : '0' %>">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-sm font-semibold text-aland-strong"><%= t('client.service.aland_title') %></p>
          <p class="text-[11px] text-zilo-muted"><%= t('client.service.aland_sub') %></p>
        </div>
        <button type="button" id="alandChatToggle" class="text-xs px-3 py-1.5 rounded-lg aland-chip"><%= t('client.service.aland_open') %></button>
      </div>
      <div id="alandChatPanel" class="hidden border border-zilo-border rounded-xl overflow-hidden">
        <div id="alandChatMessages" class="h-56 overflow-y-auto p-3 space-y-2 bg-zilo-bg text-sm"></div>
        <form id="alandChatForm" class="job-chat-composer !p-2 !border-0 border-t border-zilo-border">
          <div class="job-chat-composer__row">
            <input type="text" id="alandChatInput" placeholder="<%= t('client.service.aland_placeholder') %>" class="job-chat-input" autocomplete="off">
            <button type="submit" class="job-chat-send"><%= t('client.service.aland_send') %></button>
          </div>
        </form>
      </div>
    </section>
    <% } %>

    <section id="requestForm" class="space-y-4 zilo-page-enter-delay-2<%= payFlowNow ? ' hidden' : '' %>">
      <div id="serviceOrderSections" class="space-y-4<%= payFlowNow ? ' hidden' : '' %>">
      <% if (mod('client_regalo')) { %>
      <div class="p-4 rounded-2xl zilo-gift-card">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="giftToggle" class="w-5 h-5 rounded accent-zilo-accent">
          <div>
            <strong class="text-sm block"><%= t('client.service.gift') %></strong>
            <span class="text-xs text-zilo-muted"><%= mod('client_guardian') ? t('client.service.gift_guardian') : t('client.service.gift_other') %></span>
          </div>
        </label>
        <div id="giftFields" class="hidden mt-4 space-y-3 pt-3 border-t border-zilo-accent/15">
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.beneficiary') %></label>
            <input type="text" id="giftName" placeholder="<%= t('client.service.gift_name_ph') %>" class="zilo-input">
          </div>
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.gift_phone_label') %></label>
            <input type="tel" id="giftPhone" placeholder="<%= t('client.service.gift_phone_ph') %>" class="zilo-input">
          </div>
          <div>
            <label class="zilo-label block mb-1"><%= t('client.service.gift_message') %></label>
            <input type="text" id="giftMessage" placeholder="..." class="zilo-input">
          </div>
        </div>
      </div>
      <% } %>

      <% if (isGarden) { %>
        <%- include('../partials/garden-intake') %>
      <% } else if (isFv) { %>
        <%- include('../partials/fv-intake') %>
      <% } else if (typeof activities !== 'undefined' && activities.length) { %>
      <div id="activityPickerBlock">
        <p class="zilo-label mb-1"><%= t('client.service.subservice') %> *</p>
        <p class="text-[11px] text-zilo-muted mb-3"><%= t('client.service.subservice_pick_hint') %></p>
        <div class="space-y-2" id="activityCardList" role="radiogroup" aria-label="<%= t('client.service.subservice') %>">
          <% activities.forEach(function(act) {
            const unit = act.pricingUnit || 'job';
            const priceLabel = unit === 'm2'
              ? (formatCLP(act.pricePerM2 || act.basePrice) + ' / m²')
              : (unit === 'm3'
                ? (formatCLP(act.pricePerM2 || act.basePrice) + ' / m³')
                : formatCLP(act.basePrice));
            const blurb = act.clientBlurb || act.description || '';
          %>
            <label class="activity-card group flex gap-3 p-3.5 rounded-2xl border border-zilo-border bg-white cursor-pointer transition hover:border-zilo-accent/35 hover:bg-zilo-accent/[0.03]"
              data-activity-card
              data-id="<%= act.id %>"
              data-base="<%= act.basePrice %>"
              data-unit="<%= unit %>"
              data-per-m2="<%= act.pricePerM2 || act.basePrice %>"
              data-min-m2="<%= act.minM2 || (unit === 'm3' || unit === 'm2' ? 1 : 15) %>"
              data-quote-mode="<%= act.quoteMode || '' %>"
              data-blurb="<%= String(blurb).replace(/"/g, '&quot;') %>"
              data-price-label="<%= priceLabel %>">
              <input type="radio" name="activityPick" value="<%= act.id %>" class="sr-only activity-card-radio" data-activity-radio>
              <span class="activity-card__radio mt-0.5 shrink-0 w-5 h-5 rounded-full border-2 border-zilo-border flex items-center justify-center" aria-hidden="true">
                <span class="activity-card__dot w-2.5 h-2.5 rounded-full bg-zilo-accent"></span>
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-start justify-between gap-3">
                  <span class="text-sm font-semibold text-zilo-text leading-snug"><%= act.name %></span>
                  <span class="text-sm font-bold text-zilo-accent tabular-nums whitespace-nowrap"><%= priceLabel %></span>
                </span>
                <% if (blurb) { %>
                <span class="block text-[11px] text-zilo-muted mt-1 leading-relaxed line-clamp-2"><%= blurb %></span>
                <% } %>
              </span>
            </label>
          <% }); %>
          <label class="activity-card group flex gap-3 p-3.5 rounded-2xl border border-dashed border-zilo-border bg-[#f7f3ee]/60 cursor-pointer transition hover:border-zilo-accent/35"
            data-activity-card
            data-id="otro"
            data-base="<%= isCleaning ? 1500 : 100000 %>"
            data-unit="<%= perM2 ? 'm2' : 'job' %>"
            data-per-m2="<%= isCleaning ? 1500 : '' %>"
            data-min-m2="<%= isCleaning ? 20 : 15 %>"
            data-quote-mode=""
            data-blurb="<%= t('client.service.subservice_other_blurb') %>"
            data-price-label="<%= isCleaning ? 'desde $1.500 / m²' : 'desde $100.000' %>">
            <input type="radio" name="activityPick" value="otro" class="sr-only activity-card-radio" data-activity-radio>
            <span class="activity-card__radio mt-0.5 shrink-0 w-5 h-5 rounded-full border-2 border-zilo-border flex items-center justify-center" aria-hidden="true">
              <span class="activity-card__dot w-2.5 h-2.5 rounded-full bg-zilo-accent"></span>
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-start justify-between gap-3">
                <span class="text-sm font-semibold text-zilo-text">Otro</span>
                <span class="text-sm font-bold text-zilo-muted tabular-nums whitespace-nowrap"><%= isCleaning ? 'desde $1.500 / m²' : 'desde $100.000' %></span>
              </span>
              <span class="block text-[11px] text-zilo-muted mt-1 leading-relaxed"><%= t('client.service.subservice_other_blurb') %></span>
            </span>
          </label>
        </div>
        <input type="hidden" id="activityId" name="activityId" value="" required>

        <div id="activitySelectedPanel" class="hidden mt-3 p-4 rounded-2xl border border-zilo-accent/25 bg-gradient-to-br from-zilo-accent/[0.07] to-transparent">
          <p class="text-[10px] font-semibold uppercase tracking-wide text-zilo-accent mb-1"><%= t('client.service.subservice_selected') %></p>
          <p class="text-base font-semibold text-zilo-text leading-snug" id="activitySelectedName">—</p>
          <p class="text-sm text-zilo-muted mt-1.5 leading-relaxed" id="activitySelectedBlurb"></p>
          <p class="mt-3 flex items-baseline justify-between gap-2">
            <span class="text-xs text-zilo-muted"><%= t('client.service.subservice_price_label') %></span>
            <span class="text-lg font-bold text-zilo-accent tabular-nums" id="activitySelectedPrice">—</span>
          </p>
          <p class="text-[10px] text-zilo-muted mt-1"><%= t('client.service.subservice_price_note') %></p>
        </div>

        <div id="customActivityFields" class="hidden mt-3 space-y-2 p-3 rounded-xl border border-zilo-border bg-zilo-surface/40">
          <label for="customActivityName" class="zilo-label block"><%= t('client.service.subservice_other_label') %> *</label>
          <input type="text" id="customActivityName" maxlength="120" class="zilo-input w-full" placeholder="<%= t('client.service.subservice_other_ph') %>">
          <p class="text-[11px] text-zilo-muted"><%= t('client.service.subservice_other_hint') %></p>
        </div>
      </div>
      <% } %>

      <% if (perM2 || isEscombros) { %>
      <div id="gardenAreaBlock" class="<%= isEscombros ? 'hidden' : '' %>">
