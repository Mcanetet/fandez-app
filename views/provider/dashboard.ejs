<%- include('../partials/head', { useMap: true }) %>

<%
  const firstName = (provider.name || '').split(' ')[0] || provider.name;
  function livePhase(job) {
    const ts = String(job && job.techStatus || '');
    if (['en_sitio', 'diagnostico', 'reparando', 'comprando', 'presupuesto_pendiente', 'presupuesto_aprobado'].includes(ts)) return 3;
    if (ts === 'en_camino') return 2;
    if (job && (job.status === 'assigned' || job.status === 'in_progress' || job.technicianId)) return 1;
    return 0;
  }
%>
<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter home-client client-skin" id="providerDashboard" data-provider-id="<%= provider.id %>">
  <header class="app-session-header client-session-header sticky top-0 z-50" data-tour="welcome">
    <div class="app-session-header__row client-session-header__row">
      <a href="/proveedor/perfil" class="app-session-header__identity client-session-header__identity group" aria-label="<%= t('nav.profile') %>" data-tour="profile">
        <div class="app-session-header__avatar client-session-header__avatar">
          <%= provider.avatar || '?' %>
        </div>
        <div class="app-session-header__meta client-session-header__meta">
          <h1 class="client-session-header__name"><%= firstName %></h1>
        </div>
      </a>
      <div class="app-session-header__end client-session-header__end">
        <%- include('../partials/lang-switcher') %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-24">
    <%- include('../partials/site-alert') %>

    <%
      const hasActiveJobs = typeof activeJobs !== 'undefined' && activeJobs.length > 0;
      const pendingPayout = Number((typeof providerStats !== 'undefined' && providerStats && providerStats.pendingPayout) || 0);
    %>

    <% if (mod('provider_verificacion') && typeof verificationCheck !== 'undefined' && verificationCheck && !verificationCheck.ok) { %>
    <a href="/proveedor/perfil#verificacion" data-tour="verification" class="mb-4 block text-sm font-medium text-[#C45C14]">
      <%= t('provider.dashboard.verify_line') %>
    </a>
    <% } else if (typeof showContractBanner !== 'undefined' && showContractBanner && mod('provider_contrato')) { %>
    <a href="/proveedor/contrato" data-tour="contract" class="mb-4 block text-sm font-medium text-[#C45C14]">
      <%= t('provider.dashboard.contract_line') %>
    </a>
    <% } %>

    <% if (hasActiveJobs) { %>
    <section class="home-pulse-stack" aria-label="<%= t('provider.dashboard.active_jobs') %>">
      <div class="home-live-stack" id="activeJobsList">
        <% activeJobs.forEach(function(job) {
          const phase = livePhase(job);
          const barPct = Math.round(((phase + 1) / 4) * 100);
          const shortStatus = phase >= 3
            ? t('provider.dashboard.live_step_home')
            : phase === 2
              ? t('provider.dashboard.live_step_road')
              : t('provider.dashboard.live_step_assigned');
        %>
          <a href="/proveedor/trabajo/<%= job.id %>" class="home-live">
            <strong class="home-live__title"><%= job.serviceName %></strong>
            <p class="home-live__status"><%= shortStatus %></p>
            <span class="home-live__bar" aria-hidden="true"><i style="width:<%= barPct %>%"></i></span>
            <span class="home-live__cta"><%= t('provider.dashboard.live_cta') %></span>
          </a>
        <% }); %>
      </div>
      <% if (pendingPayout > 0) { %>
      <a href="/proveedor/finanzas" class="home-refund-line">
        <%= t('provider.dashboard.payout_line', { amount: formatCLP(pendingPayout) }) %>
      </a>
      <% } %>
    </section>
    <% } %>

    <% if (!hasActiveJobs) { %>
    <section class="home-hero mb-5">
      <h2 class="home-hero__title"><%= t('provider.dashboard.hero_title') %></h2>
    </section>
    <% } %>

    <% if (mod('provider_online')) { %>
    <section data-tour="online" class="provider-online-bar mb-5 <%= typeof canGoOnline !== 'undefined' && !canGoOnline ? 'is-blocked' : '' %>"
      <% if (typeof canGoOnline !== 'undefined' && !canGoOnline && !provider.online) { %>
      data-online-blocked="1"
      data-online-missing="<%= (verificationCheck?.missing || []).join('|') %>"
      <% } %>
      aria-label="<%= t('provider.online') %>"
    >
      <div class="provider-online-bar__left">
        <span class="provider-online-bar__indicator <%= provider.online ? 'is-on' : '' %>" aria-hidden="true">
          <span id="statusDot" class="provider-online-bar__dot <%= provider.online ? 'is-on' : '' %>"></span>
        </span>
        <div class="provider-online-bar__copy min-w-0">
          <h2 id="statusText" class="provider-online-bar__title"><%= provider.online ? t('provider.online') : t('provider.offline') %></h2>
          <p id="statusSub" class="provider-online-bar__sub"><%= provider.online ? t('provider.dashboard.online_hint') : (typeof canGoOnline !== 'undefined' && !canGoOnline ? t('provider.dashboard.verify_line') : t('provider.dashboard.offline_hint')) %></p>
        </div>
      </div>
      <div class="provider-online-bar__control">
        <label class="toggle-ios provider-online-bar__toggle" title="<%= typeof canGoOnline !== 'undefined' && !canGoOnline ? t('provider.dashboard.verify_line') : '' %>">
          <input type="checkbox" id="onlineToggle" <%= provider.online ? 'checked' : '' %> <%= typeof canGoOnline !== 'undefined' && !canGoOnline && !provider.online ? 'disabled' : '' %> aria-describedby="statusSub">
          <span class="slider"></span>
        </label>
      </div>
    </section>
    <% } %>

    <% if (!hasActiveJobs && pendingPayout > 0) { %>
    <a href="/proveedor/finanzas" class="home-refund-line mb-5">
      <%= t('provider.dashboard.payout_line', { amount: formatCLP(pendingPayout) }) %>
    </a>
    <% } %>

    <% if (mod('provider_aceptar')) { %>
    <section id="workWall" data-tour="work-wall" class="mb-5">
      <div class="flex items-center justify-between mb-3 gap-2">
        <h3 class="home-section-title !mb-0"><%= t('provider.dashboard.wall_title') %></h3>
        <button type="button" id="btnRefreshWall" class="text-xs font-semibold text-[#C45C14]" title="<%= t('provider.js.refresh_wall') %>">
          <span id="workWallCount"><%= pendingCount %></span>
        </button>
      </div>
      <div id="workWallEmpty" class="<%= pendingCount > 0 ? 'hidden' : '' %>">
        <p class="text-sm text-zilo-muted"><%= t('provider.no_requests') %></p>
        <p class="text-xs text-zilo-muted mt-1" data-wall-hint></p>
      </div>
      <div id="workWallList" class="space-y-3"></div>
    </section>
    <% } %>

    <% if (mod('provider_mensajes')) { %>
    <a href="/proveedor/mensajes" class="home-quiet-link">
      <span><%= t('provider.mensajes_title') %></span>
      <span>Abrir</span>
    </a>
    <% } %>

    <details class="mb-2 group" data-tour="history" id="providerHistory">
      <summary class="home-quiet-link cursor-pointer list-none">
        <span><%= t('provider.dashboard.history_link_title') %></span>
        <span>Ver</span>
      </summary>
      <div class="pt-3 space-y-3">
        <% if (!myRequests.length) { %>
          <p class="text-sm text-zilo-muted"><%= t('provider.dashboard.no_jobs') %></p>
        <% } else { %>
          <% myRequests.slice(0, 6).forEach(function(req) { %>
            <div class="flex items-baseline justify-between gap-3 py-2 border-b border-[rgba(26,24,20,0.08)]">
              <div class="min-w-0">
                <strong class="text-sm block truncate"><%= req.serviceName %></strong>
                <span class="text-xs text-zilo-muted"><%= formatDate(req.createdAt, { day: 'numeric', month: 'short' }) %></span>
              </div>
              <% if (req.providerPayout != null) { %>
                <span class="text-sm font-semibold text-[#C45C14] shrink-0"><%= formatCLP(req.providerPayout) %></span>
              <% } else { %>
                <span class="text-xs text-zilo-muted shrink-0"><%= req.statusLabel || req.status %></span>
              <% } %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </details>

    <details class="mb-2 group">
      <summary class="text-xs text-zilo-muted cursor-pointer list-none flex items-center gap-1 py-2">
        <span class="group-open:hidden"><%= t('provider.dashboard.more_help') %></span>
        <span class="hidden group-open:inline"><%= t('client.dashboard.less_help') %></span>
      </summary>
      <div class="pt-2">
        <%- include('../partials/guide-card', {
          summary: t('provider.guide.summary'),
          linkText: t('provider.guide.link')
        }) %>
      </div>
    </details>
  </main>

  <%- include('../partials/nav-provider', { navActive: 'inicio' }) %>
</div>

<%# Modal fuera del dashboard: el page-enter usa transform y rompe position:fixed al scrollear el muro %>
<div id="requestModal" class="hidden fixed inset-0 z-[700]" role="dialog" aria-modal="true" aria-labelledby="requestModalTitle">
  <button type="button" id="requestModalBackdrop" class="absolute inset-0 bg-black/45" aria-label="Cerrar"></button>
  <div class="request-modal-panel relative z-10 w-full max-w-lg mx-auto flex flex-col">
    <div class="zilo-modal-sheet request-modal-sheet flex flex-col min-h-0 rounded-t-3xl sm:rounded-3xl safe-bottom">
      <div class="zilo-modal-accent-bar absolute top-0 left-0 right-0 pointer-events-none"></div>

      <!-- Cabecera fija: en celular no se pierde al scrollear la foto -->
      <div class="request-modal-header shrink-0 flex items-center gap-3 px-5 pt-5 pb-3 sm:px-6">
        <div class="w-11 h-11 rounded-full bg-zilo-accent/15 border border-zilo-accent/30 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-zilo-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 id="requestModalTitle" class="zilo-display text-xl leading-tight"><%= t('provider.dashboard.new_request') %></h2>
          <p class="text-xs text-zilo-muted truncate"><%= t('provider.js.new_request_sub') %></p>
        </div>
        <button type="button" id="btnCloseRequestModal" class="zilo-icon-btn shrink-0" aria-label="<%= t('nav.back') %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div class="request-modal-body flex-1 min-h-0 overflow-y-auto overscroll-contain px-5 sm:px-6 pb-3">
        <div id="modalService" class="flex items-center justify-center gap-3 mb-4">
          <span id="modalServiceIcon"></span>
          <span id="modalServiceName" class="zilo-display text-2xl">—</span>
        </div>

        <!-- Foto + descripción del cliente (lo primero a revisar) -->
        <div id="modalClientPhotos" class="hidden space-y-3 mb-3"></div>
        <div id="modalDescriptionBlock" class="mb-4">
          <p class="zilo-label mb-1.5">Descripción del cliente</p>
          <p id="modalNotes" class="text-sm text-zilo-text p-3 rounded-xl bg-zilo-bg/80 border border-zilo-border whitespace-pre-wrap break-words"></p>
        </div>

        <div id="modalMap" class="relative h-36 sm:h-40 rounded-2xl overflow-hidden border border-zilo-border mb-3 bg-zilo-bg"></div>
        <div class="flex items-center gap-2 mb-4 px-1">
          <svg class="w-4 h-4 text-zilo-muted shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <div class="min-w-0 flex-1">
            <p id="modalAddress" class="text-xs font-medium truncate">—</p>
            <p id="modalCoords" class="text-[10px] text-zilo-muted font-mono">—</p>
          </div>
          <span class="zilo-badge zilo-badge-success shrink-0">GPS</span>
        </div>

        <div class="space-y-2 mb-3">
          <div id="modalGiftBadge" class="hidden p-3 rounded-xl zilo-gift-card">
            <div class="flex items-center gap-2 mb-1">
              <svg class="w-4 h-4 text-zilo-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
              <span class="text-xs font-semibold text-zilo-accent uppercase tracking-wider"><%= t('provider.dashboard.gift') %></span>
            </div>
            <p class="text-sm"><%= t('provider.dashboard.beneficiary') %>: <strong id="modalBeneficiary">—</strong></p>
            <p id="modalGiftPhone" class="text-xs text-zilo-muted"></p>
            <p id="modalGiftMessage" class="text-xs text-zilo-muted italic mt-1"></p>
          </div>
          <div class="flex items-center gap-2 text-sm text-zilo-muted">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span id="modalClient">—</span>
          </div>
          <div class="flex items-center gap-2 text-sm">
            <span id="modalPrice" class="font-semibold text-zilo-accent">—</span>
          </div>
        </div>
      </div>

      <div class="request-modal-footer shrink-0 flex gap-3 px-5 sm:px-6 pt-2 pb-5 bg-white border-t border-zilo-border/70">
        <button type="button" id="btnDecline" class="zilo-modal-decline"><%= t('provider.dashboard.dismiss_forever') %></button>
        <button type="button" id="btnAccept" class="zilo-modal-accept"><%= t('provider.dashboard.take_now') %></button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/guide-modal', {
  role: 'provider',
  title: 'Guía rápida del socio',
  steps: [
    { title: 'Activar modo en línea', body: 'Con el interruptor superior te pones disponible. Sin eso no llegan pedidos.', tip: 'Activa notificaciones del navegador.' },
