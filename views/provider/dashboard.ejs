  ]
}) %>

<%- include('../partials/onboarding-tour') %>

<%- include('../partials/footer', { pageScript: '/js/provider.js', extraScripts: ['/js/visit-schedule.js', '/js/image-upload.js', '/js/provider-invoice.js'] }) %>
