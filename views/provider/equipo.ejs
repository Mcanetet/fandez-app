<%- include('../partials/head') %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter">
  <header class="app-session-header sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border">
    <div class="app-session-header__row">
      <div class="app-session-header__identity">
        <a href="/proveedor" class="zilo-icon-btn" title="Volver" aria-label="Volver">
          <svg fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </a>
        <div class="app-session-header__meta">
          <p class="session-role-pill session-role-pill--provider"><%= t('session.role.provider') %></p>
          <h1>Servicios y equipo</h1>
        </div>
      </div>
      <div class="app-session-header__end app-session-header__end--logout">
        <%- include('../partials/lang-switcher') %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-10">
    <div class="mb-5 p-4 rounded-2xl zilo-card-premium border border-zilo-accent/15">
      <p class="zilo-label mb-1">Tu equipo</p>
      <p class="text-2xl font-bold text-zilo-accent"><%= technicians.length %></p>
      <p class="text-xs text-zilo-muted">técnicos registrados · cada servicio activo necesita un técnico listo (o actívate tú mismo abajo)</p>
    </div>

    <% if (typeof ok !== 'undefined' && ok === 'self') { %>
      <div class="mb-4 p-3 rounded-xl border border-zilo-success/30 bg-zilo-success/10 text-sm text-zilo-success">Listo: quedaste como técnico con tu cuenta de socio. Sin otro correo ni expediente aparte.</div>
    <% } %>
    <% if (typeof ok !== 'undefined' && ok === 'linked') { %>
      <div class="mb-4 p-3 rounded-xl border border-zilo-success/30 bg-zilo-success/10 text-sm text-zilo-success">
        <%= typeof okDetail === 'string' && okDetail ? okDetail : 'El técnico ya estaba registrado y se enlazó a tu empresa.' %>
      </div>
    <% } %>
    <% if (typeof ok !== 'undefined' && ok === 'invited') { %>
      <div class="mb-4 p-3 rounded-xl border border-zilo-success/30 bg-zilo-success/10 text-sm text-zilo-success">
        <%= typeof okDetail === 'string' && okDetail ? okDetail : 'Invitación enviada al correo del técnico.' %>
      </div>
    <% } %>
    <% if (typeof inviteWarn !== 'undefined' && inviteWarn) { %>
      <div class="mb-4 p-3 rounded-xl border border-amber-300 bg-amber-50 text-sm text-amber-900"><%= inviteWarn %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-3 rounded-xl border border-zilo-danger/30 bg-zilo-danger/10 text-sm text-zilo-danger"><%= error %></div>
    <% } %>

    <% if (typeof selfOperator === 'undefined' || !selfOperator) { %>
      <section class="mb-5 zilo-card-premium rounded-2xl p-5 border border-zilo-accent/25 bg-zilo-accent-soft/20">
        <p class="zilo-label mb-1">¿Vas tú a las visitas?</p>
        <h2 class="text-sm font-semibold mb-1">Agregarme como técnico con mi cuenta de socio</h2>
        <p class="text-xs text-zilo-muted mb-3">Mismo correo y tus documentos de socio. No creas otra cuenta ni expediente de técnico aparte.</p>
        <% if (typeof canEnableSelf !== 'undefined' && canEnableSelf) { %>
          <form method="POST" action="/proveedor/equipo/yo-hago-servicio">
            <button type="submit" class="w-full py-3.5 rounded-xl zilo-btn-primary font-semibold">Agregarme como técnico con mi cuenta de socio</button>
          </form>
          <% if (typeof selfReady !== 'undefined' && !selfReady) { %>
            <p class="text-[11px] text-amber-800 mt-2">
              Quedarás en el equipo ya. Para tomar pedidos falta:
              <%= (selfGateMissing && selfGateMissing.length) ? selfGateMissing.join(', ') : 'verificación o contrato' %>.
            </p>
          <% } %>
        <% } else { %>
          <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-3">
            Primero activa al menos un servicio de tu empresa (pestaña Servicios).
          </p>
        <% } %>
      </section>
    <% } else { %>
      <section class="mb-5 zilo-card-premium rounded-2xl p-5 border border-zilo-success/25">
        <p class="text-sm text-zilo-success font-medium mb-1">Ya estás en el equipo como técnico (tu cuenta de socio)</p>
        <% if (typeof selfReady !== 'undefined' && selfReady) { %>
          <button type="button" id="btnEnterTerrainTop" class="w-full py-3 rounded-xl zilo-btn-ghost">Ir a mi panel de visitas</button>
          <script>
            document.getElementById('btnEnterTerrainTop')?.addEventListener('click', async () => {
              const res = await fetch('/proveedor/entrar-terreno', { method: 'POST', headers: { Accept: 'application/json' } });
              const data = await res.json().catch(() => ({}));
              if (!res.ok || !data.success) {
                if (window.FandezNotify) FandezNotify.show(data.error || 'No se pudo entrar', 'error');
                return;
              }
              window.location.href = '/tecnico';
            });
          </script>
        <% } else { %>
          <p class="text-xs text-amber-800">
            Completa verificación y contrato para tomar pedidos
            <% if (typeof selfGateMissing !== 'undefined' && selfGateMissing.length) { %>
              (falta: <%= selfGateMissing.join(', ') %>)
            <% } %>.
          </p>
          <a href="/proveedor/perfil" class="inline-flex text-xs font-semibold text-zilo-accent mt-2">Ir a mi perfil →</a>
        <% } %>
      </section>
    <% } %>

    <nav class="flex gap-1 mb-5 p-1 rounded-xl bg-zilo-elevated border border-zilo-border sticky top-[4.5rem] z-20" id="equipoTabs" role="tablist" aria-label="Secciones de equipo">
      <button type="button" class="equipo-tab flex-1 py-2.5 rounded-lg text-xs font-semibold bg-white text-zilo-accent shadow-sm" data-tab="servicios" role="tab" aria-selected="true">Servicios</button>
      <button type="button" class="equipo-tab flex-1 py-2.5 rounded-lg text-xs font-semibold text-zilo-muted" data-tab="tecnicos" role="tab" aria-selected="false">Técnicos</button>
      <button type="button" class="equipo-tab flex-1 py-2.5 rounded-lg text-xs font-semibold text-zilo-muted" data-tab="agregar" role="tab" aria-selected="false">Agregar</button>
    </nav>

    <div data-equipo-panel="servicios" class="equipo-panel space-y-6">
    <section class="mb-6 zilo-card-premium rounded-2xl p-5" id="servicesSection">
      <p class="zilo-label mb-1">Servicios de la empresa</p>
      <p class="text-xs text-zilo-muted mb-4">Elige qué servicios ofrece tu empresa. Luego asigna a cada técnico uno o más de esos mismos servicios (ej. eléctrico y gasfitería).</p>
      <div class="space-y-2" id="serviceToggles">
        <% (typeof serviceStatus !== 'undefined' ? serviceStatus : []).forEach(svc => { %>
          <label class="flex items-center justify-between gap-3 p-3 rounded-xl border border-zilo-border bg-zilo-bg/40">
            <div class="min-w-0 flex items-center gap-2">
              <% if (svc.icon) { %><%- include('../partials/service-icon', { icon: svc.icon, size: 'xs' }) %><% } %>
              <div class="min-w-0">
                <span class="text-sm font-medium block truncate"><%= svc.name %></span>
                <span class="text-[10px] <%= svc.enabled ? (svc.covered ? 'text-zilo-success' : 'text-amber-600') : 'text-zilo-muted' %>">
                  <% if (!svc.enabled) { %>
                    No ofrecido por la empresa
                  <% } else if (svc.covered) { %>
                    <%= svc.readyCount === 1 ? '1 técnico listo' : svc.readyCount + ' técnicos listos' %>
                  <% } else { %>
                    Activo · falta técnico con expediente
                  <% } %>
                </span>
              </div>
            </div>
            <span class="toggle-ios shrink-0" title="Activar / desactivar servicio de la empresa">
              <input
                type="checkbox"
                class="service-toggle"
                data-service-id="<%= svc.id %>"
                <%= svc.enabled ? 'checked' : '' %>
              >
              <span class="slider"></span>
            </span>
          </label>
        <% }); %>
      </div>
      <p id="servicesFeedback" class="text-[11px] text-zilo-muted mt-3 hidden"></p>
    </section>
    </div>

    <div data-equipo-panel="tecnicos" class="equipo-panel hidden">
    <section class="mb-6 zilo-page-enter">
      <p class="zilo-label mb-2">Técnicos</p>
      <p class="text-xs text-zilo-muted mb-4">Asigna pedidos desde Mis trabajos, o activa “Puede tomar pedidos” para que el técnico tome del muro. Un técnico puede estar en varias empresas.</p>

      <% if (technicians.length === 0) { %>
        <div class="zilo-empty zilo-card-premium rounded-2xl">
          <p class="zilo-display">Aún no tienes técnicos</p>
          <p class="text-sm mb-3">Si vas tú a domicilio, usa el botón de arriba. Si no, agrega a tu equipo en la pestaña Agregar.</p>
        </div>
      <% } else { %>
        <div class="space-y-2" id="techList">
          <% technicians.forEach(t => {
            const techSpecs = (t.specialties || []).map(id => {
              const svc = (services || []).find(s => s.id === id);
              return svc ? svc.name : id;
            });
          %>
            <div class="tech-list-card rounded-xl zilo-card-premium border border-zilo-border/70" data-tech-id="<%= t.id %>" data-tech-name="<%= t.name %>" data-tech-phone="<%= t.phone || '' %>" data-tech-email="<%= t.email %>" data-tech-specialties="<%= (t.specialties || []).join(',') %>" data-self="<%= t.isSelfOperator ? '1' : '0' %>" data-doc-front="<%= t.docs && t.docs.idCardFront ? '1' : '0' %>" data-doc-back="<%= t.docs && t.docs.idCardBack ? '1' : '0' %>" data-doc-criminal="<%= t.docs && t.docs.criminalRecord ? '1' : '0' %>" data-pay-mode="<%= t.paySummary && t.paySummary.mode ? t.paySummary.mode : '' %>" data-pay-value="<%= t.paySummary && t.paySummary.value != null ? t.paySummary.value : '' %>" data-pay-hide="<%= t.paySummary && t.paySummary.hideFromTechnician ? '1' : '0' %>" data-pay-by-service="<%= t.paySummary && t.paySummary.byService ? encodeURIComponent(JSON.stringify(t.paySummary.byService)) : '' %>">
              <div class="tech-list-card__head">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl bg-zilo-accent/15 border border-zilo-accent/25 flex items-center justify-center text-xs font-semibold text-zilo-accent shrink-0" data-role="tech-avatar"><%= t.avatar %></div>
                  <div class="min-w-0">
                    <strong class="text-sm block truncate" data-role="tech-name"><%= t.name %></strong>
                    <span class="text-xs text-zilo-muted truncate block" data-role="tech-email"><%= t.displayEmail || t.email %></span>
                    <% if (t.phone) { %><span class="text-[10px] text-zilo-muted truncate block" data-role="tech-phone"><%= t.phone %></span><% } %>
                    <span class="text-[10px] text-zilo-muted truncate block mt-0.5 <%= techSpecs.length ? '' : 'hidden' %>" data-role="tech-specs"><%= techSpecs.join(' · ') %></span>
                    <% if (!t.isSelfOperator) { %>
                      <span class="text-[10px] <%= t.paySummary && t.paySummary.configured ? 'text-zilo-success' : 'text-amber-600' %> block" data-role="tech-pay">
                        <%= t.paySummary && t.paySummary.configured
                          ? ('Pago: ' + t.paySummary.label + (t.paySummary.byServiceCount ? (' · ' + t.paySummary.byServiceCount + ' por oficio') : ''))
                          : 'Pago: sin definir — edítalo' %>
                      </span>
                      <span class="text-[10px] <%= t.emailVerified ? 'text-zilo-success' : 'text-amber-600' %> block">
                        <%= t.invitePending
                          ? 'Invitación pendiente — debe abrir el correo'
                          : (t.emailVerified ? 'Email verificado' : 'Email pendiente') %>
                      </span>
                      <span class="text-[10px] <%= t.dossierCheck.ok ? 'text-zilo-success' : 'text-amber-600' %> block" data-role="tech-dossier">
                        <%= t.dossierCheck.ok
                          ? 'Expediente completo · listo para pedidos'
                          : ('Expediente incompleto' + (t.dossierCheck.missing && t.dossierCheck.missing.length
                            ? (': ' + t.dossierCheck.missing.join(', '))
                            : ' — sube docs en Editar')) %>
                      </span>
                    <% } else { %>
                      <span class="text-[10px] text-zilo-success block">Tú · cuenta de socio</span>
                      <span class="text-[10px] <%= t.dossierCheck.ok ? 'text-zilo-success' : 'text-amber-600' %> block">
                        <%= t.dossierCheck.ok
                          ? 'Listo para visitas'
                          : ('Pendiente para pedidos' + (t.dossierCheck.missing && t.dossierCheck.missing.length
                            ? (': ' + t.dossierCheck.missing.join(', '))
                            : '')) %>
                      </span>
                    <% } %>
                  </div>
                </div>
                <label class="toggle-ios shrink-0" title="Activar / desactivar">
                  <input type="checkbox" class="tech-toggle" data-id="<%= t.id %>" <%= t.active !== false ? 'checked' : '' %>>
                  <span class="slider"></span>
                </label>
              </div>
              <% if (!t.isSelfOperator) { %>
                <label class="flex items-start gap-3 p-3 rounded-xl border border-zilo-border bg-zilo-bg/50 cursor-pointer">
                  <input type="checkbox" class="tech-claim-wall mt-0.5 accent-[#C45C14] shrink-0" data-id="<%= t.id %>" <%= t.canClaimWall ? 'checked' : '' %>>
                  <span class="min-w-0">
                    <span class="text-sm font-medium text-zilo-text block">Puede tomar pedidos</span>
                    <span class="text-[11px] text-zilo-muted block">Si está activo, este técnico ve el muro y puede aceptar pedidos sin que tú se los asignes.</span>
                  </span>
                </label>
              <% } else { %>
                <p class="text-[11px] text-zilo-muted">Como “yo hago el servicio”, siempre puedes tomar pedidos del muro.</p>
              <% } %>
              <div class="tech-list-card__actions">
                <a href="/proveedor/equipo/<%= t.id %>/expediente" class="flex-1 py-2.5 rounded-xl zilo-btn-ghost !text-xs text-center">Expediente</a>
                <% if (!t.isSelfOperator) { %>
                  <% if (t.invitePending) { %>
                    <button type="button" class="flex-1 py-2.5 rounded-xl zilo-btn-primary !text-xs tech-resend-invite-btn" data-id="<%= t.id %>" data-email="<%= t.email %>">Reenviar invitación</button>
                  <% } %>
                  <button type="button" class="flex-1 py-2.5 rounded-xl zilo-btn-ghost !text-xs tech-edit-btn" data-id="<%= t.id %>">Editar</button>
                  <button type="button" class="flex-1 py-2.5 rounded-xl border border-red-200 text-red-700 !text-xs font-semibold tech-unlink-btn" data-id="<%= t.id %>">Quitar</button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </section>
    </div>

    <div data-equipo-panel="agregar" class="equipo-panel hidden space-y-6">
    <section class="zilo-card-premium rounded-2xl p-5 mb-6 border border-zilo-accent/20">
      <p class="zilo-label mb-1">¿Eres tú el técnico?</p>
      <p class="text-xs text-zilo-muted mb-3">No uses tu correo abajo: usa el botón de arriba «Agregarme como técnico con mi cuenta de socio».</p>
    </section>

    <section class="zilo-card-premium rounded-2xl p-5">
      <p class="zilo-label mb-3">Agregar técnico</p>
      <p class="text-xs text-zilo-muted mb-3">
        Pon su correo y datos. Si es <strong>nuevo</strong>, le mandamos invitación para que cree su cuenta.
        Si ya tiene cuenta de técnico, lo vinculamos a tu empresa y le avisamos por correo.
      </p>
      <form method="POST" action="/proveedor/equipo" class="space-y-3">
        <div>
          <label class="text-xs text-zilo-muted">Nombre completo</label>
          <input type="text" name="name" required class="zilo-input w-full mt-1" placeholder="Ej: Juan Pérez">
        </div>
        <div>
          <label class="text-xs text-zilo-muted">Correo</label>
          <input type="email" name="email" required class="zilo-input w-full mt-1" placeholder="tecnico@correo.cl">
        </div>
        <div>
          <label class="text-xs text-zilo-muted">Teléfono <span class="opacity-60">(opcional)</span></label>
          <input type="tel" name="phone" class="zilo-input w-full mt-1" placeholder="+56 9 ...">
        </div>
        <div>
          <span class="text-xs text-zilo-muted block mb-2">Especialidades del técnico</span>
          <p class="text-[10px] text-zilo-muted mb-2">Solo servicios que tu empresa ya activó.</p>
          <% const companyServices = (typeof serviceStatus !== 'undefined' ? serviceStatus : []).filter(s => s.enabled); %>
          <% if (!companyServices.length) { %>
            <p class="text-xs text-amber-600 p-3 rounded-xl border border-amber-200 bg-amber-50">Activa primero los servicios de la empresa para poder agregarlo.</p>
          <% } else { %>
            <div class="grid grid-cols-1 gap-2 max-h-48 overflow-y-auto pr-1">
              <% companyServices.forEach(s => { %>
                <label class="flex items-center gap-2 text-sm p-2 rounded-lg border border-zilo-border">
                  <input type="checkbox" name="specialties" value="<%= s.id %>" class="rounded accent-[#C45C14] shrink-0" checked>
                  <span class="truncate"><%= s.name %></span>
                </label>
              <% }); %>
            </div>
          <% } %>
        </div>
        <%- include('../partials/technician-pay-terms', {
          payIdPrefix: 'create',
          showByService: true,
          servicesForPay: companyServices || []
        }) %>
        <button type="submit" class="w-full py-3 rounded-xl zilo-btn-primary" <%= companyServices.length ? '' : 'disabled' %>>Agregar y enviar invitación</button>
      </form>
      <p class="text-[11px] text-zilo-muted mt-3">El técnico nuevo recibe el correo, crea su contraseña y sube el carnet. Tú cargas el certificado de antecedentes.</p>
    </section>
    </div>
  </main>
</div>

<div id="techEditModal" class="hidden fixed inset-0 z-[90] flex items-end sm:items-center justify-center p-4 bg-black/50">
  <div class="w-full max-w-md max-h-[92vh] overflow-y-auto rounded-2xl bg-zilo-surface border border-zilo-border p-5 shadow-xl">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-semibold text-sm">Editar técnico</h3>
      <button type="button" id="techEditClose" class="text-zilo-muted text-sm">Cerrar</button>
    </div>
    <form id="techEditForm" class="space-y-3">
      <input type="hidden" id="techEditId" value="">
      <div>
        <label class="text-xs text-zilo-muted">Nombre</label>
        <input type="text" id="techEditName" required class="zilo-input w-full mt-1" maxlength="80">
      </div>
      <div>
        <label class="text-xs text-zilo-muted">Teléfono</label>
        <input type="tel" id="techEditPhone" class="zilo-input w-full mt-1" placeholder="+56 9 ...">
      </div>
      <div>
        <label class="text-xs text-zilo-muted">Nueva contraseña <span class="opacity-60">(opcional)</span></label>
        <input type="password" id="techEditPassword" minlength="10" class="zilo-input w-full mt-1" placeholder="Dejar vacío para no cambiar">
      </div>
      <div>
        <span class="text-xs text-zilo-muted block mb-2">Servicios que realiza</span>
        <p class="text-[10px] text-zilo-muted mb-2">Solo los servicios activos de tu empresa. Debe quedar al menos uno.</p>
        <% const editCompanyServices = (typeof serviceStatus !== 'undefined' ? serviceStatus : []).filter(s => s.enabled); %>
        <% if (!editCompanyServices.length) { %>
          <p class="text-xs text-amber-600 p-2 rounded-lg border border-amber-200 bg-amber-50">Activa servicios de la empresa primero.</p>
        <% } else { %>
          <div id="techEditSpecialties" class="grid grid-cols-1 gap-2 max-h-40 overflow-y-auto pr-1">
            <% editCompanyServices.forEach(s => { %>
              <label class="flex items-center gap-2 text-sm p-2 rounded-lg border border-zilo-border">
                <input type="checkbox" value="<%= s.id %>" data-service-name="<%= s.name %>" class="tech-edit-spec rounded accent-[#C45C14] shrink-0">
                <span class="truncate"><%= s.name %></span>
              </label>
            <% }); %>
          </div>
        <% } %>
      </div>
      <div id="techEditPayWrap">
        <%- include('../partials/technician-pay-terms', {
          payIdPrefix: 'edit',
          showByService: true,
          servicesForPay: editCompanyServices || []
        }) %>
      </div>
      <p class="text-[11px] text-zilo-muted">El correo no se cambia aquí.</p>
      <div id="techEditDocs" class="space-y-3 pt-2 border-t border-zilo-border">
        <p class="text-xs font-semibold">Documentos para validar</p>
        <p class="text-[10px] text-zilo-muted">El técnico sube el carnet. Tú subes el certificado de antecedentes. Ambos se pueden ver y reemplazar aquí.</p>
        <div class="space-y-2" data-doc-block="idCardFront">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs">Carnet — frente</span>
            <a id="techEditDocFrontLink" href="#" target="_blank" rel="noopener" class="text-[10px] text-zilo-accent font-semibold hidden">Ver</a>
            <span id="techEditDocFrontPending" class="text-[10px] text-amber-600">Pendiente</span>
          </div>
          <input type="file" id="techEditDocFront" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" data-pick="both" class="block w-full text-xs">
          <button type="button" data-edit-doc="idCardFront" class="w-full zilo-btn-ghost !py-2 !text-xs">Subir / reemplazar frente</button>
        </div>
        <div class="space-y-2" data-doc-block="idCardBack">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs">Carnet — reverso</span>
            <a id="techEditDocBackLink" href="#" target="_blank" rel="noopener" class="text-[10px] text-zilo-accent font-semibold hidden">Ver</a>
            <span id="techEditDocBackPending" class="text-[10px] text-amber-600">Pendiente</span>
          </div>
          <input type="file" id="techEditDocBack" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" data-pick="both" class="block w-full text-xs">
          <button type="button" data-edit-doc="idCardBack" class="w-full zilo-btn-ghost !py-2 !text-xs">Subir / reemplazar reverso</button>
        </div>
        <div class="space-y-2" data-doc-block="criminalRecord">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs">Certificado de antecedentes <span class="text-zilo-muted">(lo sube el socio)</span></span>
            <a id="techEditDocCriminalLink" href="#" target="_blank" rel="noopener" class="text-[10px] text-zilo-accent font-semibold hidden">Ver</a>
            <span id="techEditDocCriminalPending" class="text-[10px] text-amber-600">Pendiente</span>
          </div>
          <input type="file" id="techEditDocCriminal" accept="image/jpeg,image/png,image/webp,application/pdf" data-pick="both" class="block w-full text-xs">
          <button type="button" data-edit-doc="criminalRecord" class="w-full zilo-btn-ghost !py-2 !text-xs">Subir / reemplazar antecedentes</button>
        </div>
      </div>
      <button type="submit" class="w-full py-3 rounded-xl zilo-btn-primary">Guardar cambios</button>
    </form>
  </div>
</div>

