<%- include('../partials/head') %>
<%
  const ledger = typeof finance !== 'undefined' && finance ? finance : { stats: {}, rows: [] };
  const stats = ledger.stats || {};
  const setup = typeof payoutSetup !== 'undefined' && payoutSetup ? payoutSetup : {
    payoutCadence: 'weekly',
    pendingDocuments: [],
    needsBank: false,
    bankReady: true,
    bankAccount: {},
    canReceivePayouts: true,
    docsComplete: true
  };
  const bank = setup.bankAccount || {};
  const accountTypes = typeof bankAccountTypes !== 'undefined' ? bankAccountTypes : [
    { id: 'cuenta corriente', label: 'Cuenta corriente' },
    { id: 'cuenta vista', label: 'Cuenta vista / RUT' },
    { id: 'cuenta ahorro', label: 'Cuenta de ahorro' }
  ];
%>
<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter">
  <header class="app-session-header sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border">
    <div class="app-session-header__row">
      <div class="app-session-header__identity">
        <a href="/proveedor" class="zilo-icon-btn" title="Volver" aria-label="Volver">
          <svg fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </a>
        <div class="app-session-header__meta">
          <p class="session-role-pill session-role-pill--provider"><%= t('session.role.provider') %></p>
          <h1><%= t('provider.finance.page_title') %></h1>
        </div>
      </div>
      <div class="app-session-header__end app-session-header__end--logout">
        <%- include('../partials/lang-switcher') %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-28 space-y-4">
    <section class="grid grid-cols-2 gap-2" aria-label="<%= t('provider.finance.title') %>">
      <div class="tech-list-card rounded-2xl zilo-card-premium border border-zilo-accent/20">
        <strong class="text-zilo-accent text-lg block"><%= formatCLP(stats.pendingPayout || ledger.pendingTotal || 0) %></strong>
        <span class="text-[11px] text-zilo-muted"><%= t('provider.finance.pending') %></span>
      </div>
      <div class="tech-list-card rounded-2xl zilo-card-premium">
        <strong class="text-lg block"><%= formatCLP(stats.paidTotal || ledger.paidTotal || 0) %></strong>
        <span class="text-[11px] text-zilo-muted"><%= t('provider.finance.paid_total') %></span>
      </div>
      <div class="tech-list-card rounded-2xl zilo-card-premium">
        <strong class="text-base block text-zilo-success"><%= stats.nextPayDateLabel || t('provider.finance.no_schedule') %></strong>
        <span class="text-[11px] text-zilo-muted"><%= stats.nextPayAmount ? formatCLP(stats.nextPayAmount) : t('provider.finance.next_pay') %></span>
      </div>
      <div class="tech-list-card rounded-2xl zilo-card-premium">
        <strong class="text-base block"><%= stats.monthCompleted || 0 %></strong>
        <span class="text-[11px] text-zilo-muted"><%= t('provider.finance.month_jobs') %></span>
      </div>
    </section>

    <p class="text-xs text-zilo-muted leading-relaxed"><%= t('provider.finance.hint') %></p>

    <section class="rounded-2xl zilo-card-premium border border-zilo-border p-4 space-y-3" id="payoutCadenceCard">
      <div>
        <p class="zilo-label mb-1"><%= t('provider.finance.cadence_title') %></p>
        <p class="text-[11px] text-zilo-muted"><%= t('provider.finance.cadence_hint') %></p>
      </div>
      <div class="grid grid-cols-2 gap-2" role="group" aria-label="<%= t('provider.finance.cadence_title') %>">
        <label class="flex items-center gap-2 p-3 rounded-xl border cursor-pointer <%= setup.payoutCadence !== 'monthly' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>">
          <input type="radio" name="payoutCadence" value="weekly" class="accent-zilo-accent" <%= setup.payoutCadence !== 'monthly' ? 'checked' : '' %>>
          <span class="text-sm font-semibold"><%= t('provider.finance.cadence_weekly') %></span>
        </label>
        <label class="flex items-center gap-2 p-3 rounded-xl border cursor-pointer <%= setup.payoutCadence === 'monthly' ? 'border-zilo-accent bg-zilo-accent/5' : 'border-zilo-border' %>">
          <input type="radio" name="payoutCadence" value="monthly" class="accent-zilo-accent" <%= setup.payoutCadence === 'monthly' ? 'checked' : '' %>>
          <span class="text-sm font-semibold"><%= t('provider.finance.cadence_monthly') %></span>
        </label>
      </div>
      <p id="cadenceStatus" class="text-[11px] text-zilo-muted min-h-[1rem]" role="status"></p>
    </section>

    <% if ((setup.pendingDocuments || []).length) { %>
    <section class="rounded-2xl zilo-card-premium border border-amber-200 bg-amber-50/60 p-4 space-y-3">
      <div>
        <p class="zilo-label mb-1 text-amber-900"><%= t('provider.finance.pending_docs_title') %></p>
        <p class="text-[11px] text-amber-800/80"><%= t('provider.finance.pending_docs_hint') %></p>
      </div>
      <ul class="space-y-2">
        <% setup.pendingDocuments.forEach(function(doc) { %>
          <li class="flex items-start justify-between gap-2 text-sm">
            <span class="text-zilo-text"><%= doc.label %></span>
            <a href="/proveedor/contrato" class="text-zilo-accent font-semibold text-xs shrink-0"><%= t('provider.finance.upload_doc') %></a>
          </li>
        <% }); %>
      </ul>
      <a href="/proveedor/contrato" class="inline-flex text-sm font-semibold text-zilo-accent hover:underline"><%= t('provider.finance.go_contract') %></a>
    </section>
    <% } %>

    <% if (setup.needsBank) { %>
    <section class="rounded-2xl zilo-card-premium border border-zilo-border p-4 space-y-3" id="bankAccountCard">
      <div>
        <p class="zilo-label mb-1"><%= t('provider.finance.bank_title') %></p>
        <p class="text-[11px] text-zilo-muted"><%= t('provider.finance.bank_hint') %></p>
      </div>
      <form id="providerBankForm" class="space-y-2.5">
        <div>
          <label class="register-form__label" for="bankName"><%= t('provider.finance.bank_name') %></label>
          <input type="text" id="bankName" name="bankName" required class="zilo-input" value="<%= bank.bankName || '' %>" placeholder="Ej: Banco de Chile">
        </div>
        <div>
          <label class="register-form__label" for="accountType"><%= t('provider.finance.account_type') %></label>
          <select id="accountType" name="accountType" required class="zilo-input">
            <% accountTypes.forEach(function(opt) { %>
              <option value="<%= opt.id %>" <%= (bank.accountType || 'cuenta corriente') === opt.id ? 'selected' : '' %>><%= opt.label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="register-form__label" for="accountNumber"><%= t('provider.finance.account_number') %></label>
          <input type="text" id="accountNumber" name="accountNumber" required class="zilo-input" value="<%= bank.accountNumber || '' %>" placeholder="000123456789" inputmode="numeric">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div>
            <label class="register-form__label" for="holderName"><%= t('provider.finance.holder_name') %></label>
            <input type="text" id="holderName" name="holderName" required class="zilo-input" value="<%= bank.holderName || (provider && provider.name) || '' %>">
          </div>
          <div>
            <label class="register-form__label" for="holderRut"><%= t('provider.finance.holder_rut') %></label>
            <input type="text" id="holderRut" name="holderRut" required class="zilo-input" value="<%= bank.holderRut || '' %>" placeholder="12.345.678-9">
          </div>
        </div>
        <button type="submit" class="zilo-btn-primary !py-2.5 text-sm w-full"><%= t('provider.finance.save_bank') %></button>
        <p id="bankFormStatus" class="text-[11px] text-zilo-muted min-h-[1rem]" role="status"></p>
      </form>
    </section>
    <% } else if (setup.docsComplete && setup.bankReady) { %>
      <p class="text-[11px] text-zilo-success"><%= t('provider.finance.ready_hint') %></p>
    <% } %>

    <section>
      <div class="flex items-center justify-between mb-3">
        <p class="zilo-label mb-0"><%= t('provider.finance.ledger_title') %></p>
        <span class="text-[11px] text-zilo-muted tabular-nums"><%= (ledger.rows || []).length %></span>
      </div>
      <p class="text-[11px] text-zilo-muted mb-3"><%= t('provider.finance.invoice_gate_hint') %></p>

      <% if (!(ledger.rows || []).length) { %>
        <div class="zilo-empty zilo-card-premium rounded-2xl">
          <p class="zilo-display text-base"><%= t('provider.finance.empty') %></p>
          <p class="text-sm"><%= t('provider.finance.empty_sub') %></p>
        </div>
      <% } else { %>
        <div class="tech-list-stack">
          <% ledger.rows.forEach(row => { %>
            <article class="tech-list-card rounded-2xl zilo-card-premium border border-zilo-border/80">
              <div class="tech-list-card__head">
                <div class="tech-list-card__body min-w-0">
                  <strong class="text-sm block truncate"><%= row.serviceName %><% if (row.activityName) { %> · <%= row.activityName %><% } %></strong>
                  <span class="text-xs text-zilo-muted block truncate"><%= row.clientName %><% if (row.communeName) { %> · <%= row.communeName %><% } %></span>
                  <span class="text-[10px] text-zilo-muted"><%= row.completedAtLabel || '' %></span>
                </div>
                <div class="text-right shrink-0">
                  <span class="zilo-badge <%= row.payoutStatus === 'pagado' ? 'zilo-badge-success' : 'zilo-badge-muted' %> mb-1"><%= row.payoutStatusLabel %></span>
                  <strong class="text-sm text-zilo-success block"><%= formatCLP(row.providerPayout) %></strong>
                </div>
              </div>
              <details>
                <summary class="text-[11px] text-zilo-accent font-semibold cursor-pointer py-0.5"><%= t('provider.settlement') %></summary>
                <div class="mt-2 text-[11px] text-zilo-muted space-y-0.5">
                  <p><%= t('provider.settlement_charged') %>: <%= formatCLP(row.grandTotal) %></p>
                  <p><%= t('provider.settlement_card') %>: −<%= formatCLP(row.cardFee) %></p>
                  <p><%= t('provider.settlement_app') %>: −<%= formatCLP(row.laborCommission) %></p>
                  <% if (row.materialsTotal) { %>
                    <p class="text-zilo-success"><%= t('provider.settlement_materials_keep') %>: <%= formatCLP(row.materialsTotal) %></p>
                  <% } %>
                  <% if (row.payoutScheduledLabel && row.payoutStatus !== 'pagado') { %>
                    <p><%= t('provider.finance.scheduled') %>: <%= row.payoutScheduledLabel %></p>
                  <% } %>
                  <p class="text-zilo-success font-medium"><%= t('provider.js.your_payout') %>: <%= formatCLP(row.providerPayout) %></p>
                </div>
              </details>
              <%- include('../partials/provider-invoice-upload', { invoicePlan: row.providerInvoicePlan, invoiceRequestId: row.id }) %>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('../partials/nav-provider', { navActive: 'finanzas' }) %>
</div>
<script>
(function () {
  const cadenceInputs = document.querySelectorAll('input[name="payoutCadence"]');
  const cadenceStatus = document.getElementById('cadenceStatus');
  cadenceInputs.forEach((input) => {
    input.addEventListener('change', async () => {
      if (!input.checked) return;
      if (cadenceStatus) cadenceStatus.textContent = 'Guardando…';
      try {
        const res = await fetch('/proveedor/finanzas/liquidacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ payoutCadence: input.value })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(data.error || 'No se pudo guardar');
        if (cadenceStatus) cadenceStatus.textContent = input.value === 'monthly' ? 'Liquidación mensual activada.' : 'Liquidación semanal activada.';
        if (window.FandezNotify) FandezNotify.show(cadenceStatus.textContent, 'success');
        document.querySelectorAll('#payoutCadenceCard label').forEach((label) => {
          const radio = label.querySelector('input');
          const on = radio && radio.checked;
          label.classList.toggle('border-zilo-accent', on);
          label.classList.toggle('bg-zilo-accent/5', on);
          label.classList.toggle('border-zilo-border', !on);
        });
      } catch (err) {
        if (cadenceStatus) cadenceStatus.textContent = err.message || 'Error';
        if (window.FandezNotify) FandezNotify.show(err.message || 'Error', 'error');
      }
    });
  });

  const bankForm = document.getElementById('providerBankForm');
  const bankStatus = document.getElementById('bankFormStatus');
  if (bankForm) {
    bankForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (bankStatus) bankStatus.textContent = 'Guardando…';
      const fd = new FormData(bankForm);
      try {
        const res = await fetch('/proveedor/finanzas/banco', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            bankName: fd.get('bankName'),
            accountType: fd.get('accountType'),
            accountNumber: fd.get('accountNumber'),
            holderName: fd.get('holderName'),
            holderRut: fd.get('holderRut')
          })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(data.error || 'No se pudo guardar la cuenta');
        if (bankStatus) bankStatus.textContent = 'Cuenta guardada. Ya puedes liquidar cuando subas las facturas.';
        if (window.FandezNotify) FandezNotify.show('Datos bancarios guardados', 'success');
      } catch (err) {
        if (bankStatus) bankStatus.textContent = err.message || 'Error';
        if (window.FandezNotify) FandezNotify.show(err.message || 'Error', 'error');
      }
    });
  }
})();
</script>
<%- include('../partials/footer', { pageScript: '/js/provider-invoice.js', extraScripts: ['/js/image-upload.js'] }) %>
