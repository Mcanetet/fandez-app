<%- include('partials/head') %>

<div class="min-h-screen relative fandez-landing">
  <div class="fandez-landing-atmosphere" aria-hidden="true"></div>

  <header class="relative z-10 flex items-center justify-between px-5 py-5 max-w-lg mx-auto">
    <div class="flex items-center gap-3">
      <%- include('partials/logo', { className: 'w-11 h-12', logoId: 'landing', logoVariant: 'amber' }) %>
      <span class="fandez-wordmark text-3xl"><%= t('app.name') %></span>
    </div>
    <div class="flex items-center gap-2">
      <%- include('partials/lang-switcher') %>
      <a href="/login" class="zilo-btn-ghost text-sm !w-auto !py-2"><%= t('landing.login_btn') %></a>
    </div>
  </header>

  <main class="relative z-10 px-5 pt-2 pb-12 max-w-lg mx-auto">
    <p class="zilo-label mb-3"><%= t('landing.hero.eyebrow') %></p>
    <h1 class="zilo-display text-[2.65rem] leading-[1.08] mb-4">
      <%= t('landing.hero.title1') %><br>
      <span class="text-zilo-accent"><%= t('landing.hero.title2') %></span>
    </h1>
    <p class="text-zilo-muted text-base leading-relaxed mb-7 max-w-sm">
      <%= t('landing.hero.subtitle') %>
    </p>

    <% if (typeof referralBanner !== 'undefined' && referralBanner) { %>
      <div class="mb-6 p-4 rounded-xl zilo-card-premium border border-zilo-accent/20 bg-zilo-accent-soft/40">
        <p class="text-sm font-medium text-zilo-accent"><%= t('landing.invite.received') %></p>
        <p class="text-xs text-zilo-muted mt-1"><%- t('landing.invite.credit', { code: referralBanner }) %></p>
      </div>
    <% } %>

    <div class="landing-cta-stack">
      <a href="/registro" class="zilo-btn-primary">
        <%= t('landing.cta.signup') %>
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/registro?emergency=1" class="landing-urgent-cta">
        <span class="landing-urgent-cta__icon" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
        </span>
        <span class="landing-urgent-cta__body">
          <span class="landing-urgent-cta__title"><%= t('landing.emergency_cta') %></span>
          <span class="landing-urgent-cta__hint"><%= t('landing.emergency_hint') %></span>
        </span>
      </a>
      <button type="button" data-install-app class="zilo-btn-ghost zilo-btn-block fandez-install-entry">
        <svg class="w-5 h-5 shrink-0 text-zilo-accent" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0l4-4m-4 4l-4-4"/><path d="M5 19h14"/></svg>
        <%= t('landing.install_cta') %>
      </button>
    </div>
    <p class="text-center text-sm text-zilo-muted mb-10">
      <%= t('landing.cta.has_account') %>
      <a href="/login" class="text-zilo-accent font-semibold hover:underline"><%= t('landing.cta.login') %></a>
    </p>

    <div class="landing-stat-card mb-8">
      <div class="landing-stat-grid">
        <div class="landing-stat-item">
          <strong class="landing-stat-value text-zilo-accent">4.9</strong>
          <span class="landing-stat-label"><%= t('landing.stat.rating') %></span>
        </div>
        <div class="landing-stat-item landing-stat-item--divider">
          <strong class="landing-stat-value">24/7</strong>
          <span class="landing-stat-label"><%= t('landing.stat.emergency') %></span>
        </div>
        <div class="landing-stat-item">
          <strong class="landing-stat-value">100%</strong>
          <span class="landing-stat-label"><%= t('landing.stat.verified') %></span>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <p class="fandez-wordmark text-lg mb-4"><%= t('landing.only_fandez') %></p>
      <ul class="landing-feature-list">
        <li>
          <span class="landing-feature-icon" aria-hidden="true">
            <%- include('partials/ui-icon', { name: 'home', size: 16, className: 'text-zilo-accent' }) %>
          </span>
          <span class="landing-feature-text"><%= t('landing.feature.passport') %></span>
        </li>
        <li>
          <span class="landing-feature-icon" aria-hidden="true">
            <%- include('partials/ui-icon', { name: 'wallet', size: 16, className: 'text-zilo-accent' }) %>
          </span>
          <span class="landing-feature-text"><%= t('landing.feature.card') %></span>
        </li>
        <li>
          <span class="landing-feature-icon" aria-hidden="true">
            <%- include('partials/ui-icon', { name: 'shield', size: 16, className: 'text-zilo-accent' }) %>
          </span>
          <span class="landing-feature-text"><%= t('landing.feature.guardian') %></span>
        </li>
        <li>
          <span class="landing-feature-icon" aria-hidden="true">
            <%- include('partials/ui-icon', { name: 'spark', size: 16, className: 'text-zilo-accent' }) %>
          </span>
          <span class="landing-feature-text"><%= t('landing.feature.gift') %></span>
        </li>
      </ul>
    </div>

    <a href="/registro?role=provider" class="group block rounded-2xl p-5 mb-8 border border-zilo-border bg-white hover:border-zilo-accent/40 transition">
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl bg-zilo-accent-soft border border-zilo-accent/20 flex items-center justify-center shrink-0 text-zilo-accent">
          <%- include('partials/ui-icon', { name: 'wallet', size: 20 }) %>
        </div>
        <div class="flex-1 min-w-0">
          <h2 class="zilo-display text-xl text-zilo-text mb-1"><%= t('landing.partner_title') %></h2>
          <p class="text-sm text-zilo-muted leading-relaxed mb-3"><%= t('landing.partner_body') %></p>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zilo-accent group-hover:underline">
            <%= t('landing.partner_cta') %>
            <svg class="w-4 h-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </div>
    </a>
  </main>

  <section class="relative z-10 px-5 pb-10 max-w-lg mx-auto">
    <p class="text-sm font-semibold text-zilo-text mb-3 text-center"><%= t('landing.specialties') %></p>
    <div class="flex flex-wrap justify-center gap-2">
      <% (services || []).forEach(s => { %>
        <span class="zilo-specialty-pill">
          <%- include('partials/service-icon', { icon: s.icon, size: 'xs' }) %>
          <%= s.name %>
        </span>
      <% }); %>
    </div>
  </section>

  <footer class="relative z-10 text-center py-8 text-zilo-muted text-xs border-t border-zilo-border space-y-2">
    <p><a href="/quienes-somos" class="hover:text-zilo-accent transition"><%= t('landing.about_link') %></a></p>
    <p><%= t('footer.copyright') %></p>
  </footer>
</div>

<%- include('partials/footer') %>
