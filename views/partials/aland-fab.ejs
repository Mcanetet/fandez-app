<!-- FAB + panel flotante Aland (soporte cliente) -->
<% if (typeof user !== 'undefined' && user && user.role === 'client' && typeof mod === 'function' && mod('client_aland')) { %>
<div id="alandFabRoot" class="fixed bottom-24 right-5 z-40 flex flex-col items-end gap-2" data-aland-fab data-client-id="<%= user.id %>">
  <div id="alandFabPanel" class="hidden w-[min(100vw-2rem,22rem)] rounded-xl border border-aland/25 bg-white shadow-zilo overflow-hidden mb-1">
    <div class="flex items-center justify-between px-3 py-2.5 bg-aland text-white">
      <div>
        <p class="text-sm font-semibold leading-tight">Sofía</p>
        <p class="text-[10px] text-white/80">Soporte Fandez</p>
      </div>
      <button type="button" id="alandFabClose" class="w-8 h-8 rounded-lg hover:bg-white/10 text-lg leading-none" aria-label="Cerrar">×</button>
    </div>
    <div id="alandFabMessages" class="h-64 overflow-y-auto p-3 space-y-2 bg-zilo-bg text-sm"></div>
    <form id="alandFabForm" class="job-chat-composer !p-2 !border-0 border-t border-zilo-border">
      <div class="job-chat-composer__row">
        <input type="text" id="alandFabInput" maxlength="2000" placeholder="Escribe tu consulta…" class="job-chat-input" autocomplete="off">
        <button type="submit" class="job-chat-send">Enviar</button>
      </div>
    </form>
  </div>
  <button type="button" id="alandFabToggle"
    class="w-12 h-12 rounded-xl bg-aland text-white border border-aland-strong flex items-center justify-center hover:bg-aland-strong transition"
    title="Hablar con Sofía" aria-label="Abrir Sofía" data-tour="concierge">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
    </svg>
  </button>
</div>
<script src="<%= typeof asset === 'function' ? asset('/js/aland-fab.js') : '/js/aland-fab.js' %>"></script>
<% } %>
