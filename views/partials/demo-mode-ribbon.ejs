<%
  var demoOn = false;
  if (typeof showDemoRibbon !== 'undefined') {
    demoOn = Boolean(showDemoRibbon);
  } else if (typeof appModeStatus !== 'undefined' && appModeStatus && appModeStatus.isDemo) {
    demoOn = true;
  }
  if (typeof forceDemoRibbon !== 'undefined' && forceDemoRibbon) demoOn = true;
%>
<% if (demoOn) { %>
<div class="demo-mode-ribbon" role="status" aria-live="polite">
  <span class="demo-mode-ribbon__label"><%= typeof t === 'function' ? t('demo.ribbon.label') : 'Demo 2.0' %></span>
  <span class="demo-mode-ribbon__text"><%= typeof t === 'function' ? t('demo.ribbon.text') : 'Estás en Demo 2.0: pruebas y reclutamiento de socios hasta el Productivo 2.0.' %></span>
</div>
<% } %>
