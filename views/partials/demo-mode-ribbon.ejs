<%
  var demoOn = typeof appModeStatus !== 'undefined' && appModeStatus && appModeStatus.isDemo;
  if (typeof forceDemoRibbon !== 'undefined' && forceDemoRibbon) demoOn = true;
%>
<% if (demoOn) { %>
<div class="demo-mode-ribbon" role="status" aria-live="polite">
  <span class="demo-mode-ribbon__label"><%= typeof t === 'function' ? t('demo.ribbon.label') : 'Modo DEMO' %></span>
  <span class="demo-mode-ribbon__text"><%= typeof t === 'function' ? t('demo.ribbon.text') : 'Esta página está en modo DEMO para hacer pruebas y reclutar socios hasta el lanzamiento.' %></span>
</div>
<% } %>
