<%#
  Iconos UI Fundez — trazo fino, sin emoji.
  Uso: include('partials/ui-icon', { name: 'shield', size: 18 })
%>
<%
  const _sz = typeof size !== 'undefined' ? Number(size) : 18;
  const _name = typeof name !== 'undefined' ? String(name) : 'dot';
  const _class = typeof className !== 'undefined' ? className : '';
%>
<span class="ui-icon <%= _class %>" aria-hidden="true">
  <svg width="<%= _sz %>" height="<%= _sz %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <% if (_name === 'shield') { %>
      <path d="M12 3l7 3v5.5c0 4.4-2.9 8.2-7 9.5-4.1-1.3-7-5.1-7-9.5V6l7-3z"/>
      <path d="M9.5 12.2l1.7 1.7 3.5-3.8"/>
    <% } else if (_name === 'star') { %>
      <path d="M12 3.4l2.2 4.6 5.1.7-3.7 3.6.9 5.1L12 15.4 7.5 17.4l.9-5.1L4.7 8.7l5.1-.7L12 3.4z"/>
    <% } else if (_name === 'bolt') { %>
      <path d="M13 2.5L6.8 13.2h5L10.2 21.5 17.5 10.2h-5L13 2.5z"/>
    <% } else if (_name === 'wallet') { %>
      <rect x="3" y="6" width="18" height="13" rx="2.5"/>
      <path d="M3 10h18"/>
      <circle cx="16.5" cy="14.5" r="1.1" fill="currentColor" stroke="none"/>
    <% } else if (_name === 'check') { %>
      <circle cx="12" cy="12" r="8.25"/>
      <path d="M8.8 12.2l2.2 2.2 4.3-4.5"/>
    <% } else if (_name === 'chart') { %>
      <path d="M4 19V5"/>
      <path d="M4 19h16"/>
      <path d="M8 15.5v-3.5"/>
      <path d="M12 15.5V9"/>
      <path d="M16 15.5v-6"/>
      <path d="M8.5 8.5l3.2-3.2 2.6 2.2 3.2-3.5"/>
    <% } else if (_name === 'clock') { %>
      <circle cx="12" cy="12" r="8.25"/>
      <path d="M12 7.5V12l3 1.8"/>
    <% } else if (_name === 'spark') { %>
      <path d="M12 3.5l1.15 4.35L17.5 9l-4.35 1.15L12 14.5l-1.15-4.35L6.5 9l4.35-1.15L12 3.5z"/>
      <path d="M18.5 14.5l.55 2.1 2.1.55-2.1.55-.55 2.1-.55-2.1-2.1-.55 2.1-.55.55-2.1z"/>
    <% } else if (_name === 'heart') { %>
      <path d="M12 20s-6.5-4.1-8.4-7.3C2.1 10.4 3.2 7.2 6.2 6.3c1.7-.5 3.4.2 4.3 1.5.9-1.3 2.6-2 4.3-1.5 3 .9 4.1 4.1 2.6 6.4C18.5 15.9 12 20 12 20z"/>
    <% } else if (_name === 'home') { %>
      <path d="M4.5 11.5L12 5l7.5 6.5"/>
      <path d="M7 10.8V19h10v-8.2"/>
    <% } else { %>
      <circle cx="12" cy="12" r="3"/>
    <% } %>
  </svg>
</span>
