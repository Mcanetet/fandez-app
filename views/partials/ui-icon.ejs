<%#
  Iconos UI Fandez — trazo editorial, metáforas propias.
  Uso: include('partials/ui-icon', { name: 'shield', size: 18 })
%>
<%
  const _sz = typeof size !== 'undefined' ? Number(size) : 18;
  const _name = typeof name !== 'undefined' ? String(name) : 'dot';
  const _class = typeof className !== 'undefined' ? className : '';
%>
<span class="ui-icon <%= _class %>" aria-hidden="true">
  <svg width="<%= _sz %>" height="<%= _sz %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
    <% if (_name === 'shield') { %>
      <path d="M12 3.2 19 6v5.2c0 4.5-3 8.3-7 9.8-4-1.5-7-5.3-7-9.8V6l7-2.8z" fill="currentColor" fill-opacity="0.08"/>
      <path d="M12 3.2 19 6v5.2c0 4.5-3 8.3-7 9.8-4-1.5-7-5.3-7-9.8V6l7-2.8z"/>
      <path d="M9.4 12.1 11.2 14l3.6-3.9"/>
    <% } else if (_name === 'star') { %>
      <path d="M12 3.6 13.9 8.4l5.2.5-4 3.7 1.2 5.1L12 15.6 7.7 17.7l1.2-5.1-4-3.7 5.2-.5L12 3.6z" fill="currentColor" fill-opacity="0.1"/>
      <path d="M12 3.6 13.9 8.4l5.2.5-4 3.7 1.2 5.1L12 15.6 7.7 17.7l1.2-5.1-4-3.7 5.2-.5L12 3.6z"/>
    <% } else if (_name === 'bolt') { %>
      <path d="M12.8 2.8 6.5 13.2h5.2L10.4 21.2 17.8 10.2h-5.2L12.8 2.8z" fill="currentColor" fill-opacity="0.12"/>
      <path d="M12.8 2.8 6.5 13.2h5.2L10.4 21.2 17.8 10.2h-5.2L12.8 2.8z"/>
    <% } else if (_name === 'wallet' || _name === 'card') { %>
      <%# Tarjeta / pago elegante (no billetera Lucide) %>
      <rect x="3.2" y="6.2" width="17.6" height="11.6" rx="2.2" fill="currentColor" fill-opacity="0.07"/>
      <rect x="3.2" y="6.2" width="17.6" height="11.6" rx="2.2"/>
      <path d="M3.2 10.2h17.6"/>
      <path d="M7 14.4h4.2"/>
      <circle cx="16.6" cy="14.4" r="1" fill="currentColor" stroke="none"/>
    <% } else if (_name === 'briefcase' || _name === 'partner') { %>
      <%# Maletín de oficio / pedidos para socio %>
      <rect x="3.5" y="8" width="17" height="11.5" rx="2" fill="currentColor" fill-opacity="0.08"/>
      <rect x="3.5" y="8" width="17" height="11.5" rx="2"/>
      <path d="M9 8V6.4A1.9 1.9 0 0 1 10.9 4.5h2.2A1.9 1.9 0 0 1 15 6.4V8"/>
      <path d="M3.5 12.5h17"/>
      <path d="M11.2 12.5v2.2h1.6v-2.2"/>
    <% } else if (_name === 'urgent' || _name === 'sos') { %>
      <%# Casa con pulso — urgencia, no triángulo de alerta %>
      <path d="M4.5 11.2 12 4.6l7.5 6.6"/>
      <path d="M7 10.6V19h10v-8.4"/>
      <path d="M8.6 14.4h2.1l1.1-2.4 1.5 4.2 1.1-1.8H15.4"/>
    <% } else if (_name === 'check') { %>
      <circle cx="12" cy="12" r="8.2" fill="currentColor" fill-opacity="0.08"/>
      <circle cx="12" cy="12" r="8.2"/>
      <path d="M8.6 12.2 11 14.5l4.4-4.6"/>
    <% } else if (_name === 'chart') { %>
      <path d="M4.5 19V5.5"/>
      <path d="M4.5 19h15"/>
      <path d="M8.2 15.2v-3.2"/>
      <path d="M12 15.2V9.5"/>
      <path d="M15.8 15.2v-5.5"/>
      <path d="M8.5 8.8 11.4 6l2.4 2 3.2-3.2"/>
    <% } else if (_name === 'clock') { %>
      <circle cx="12" cy="12" r="8.2" fill="currentColor" fill-opacity="0.06"/>
      <circle cx="12" cy="12" r="8.2"/>
      <path d="M12 7.6V12l2.8 1.7"/>
    <% } else if (_name === 'spark') { %>
      <path d="M12 3.4 13.1 7.8 17.5 8.9 13.1 10 12 14.4 10.9 10 6.5 8.9 10.9 7.8 12 3.4z" fill="currentColor" fill-opacity="0.12"/>
      <path d="M12 3.4 13.1 7.8 17.5 8.9 13.1 10 12 14.4 10.9 10 6.5 8.9 10.9 7.8 12 3.4z"/>
      <path d="M18.4 14.6l.55 2.1 2.1.55-2.1.55-.55 2.1-.55-2.1-2.1-.55 2.1-.55.55-2.1z"/>
    <% } else if (_name === 'heart') { %>
      <path d="M12 19.6s-6.2-3.9-8-7C2.4 10.2 3.5 7.2 6.4 6.4c1.6-.5 3.2.2 4.1 1.4.9-1.2 2.5-1.9 4.1-1.4 2.9.8 4 3.8 2.4 6.2-1.8 3.1-8 7-8 7z" fill="currentColor" fill-opacity="0.1"/>
      <path d="M12 19.6s-6.2-3.9-8-7C2.4 10.2 3.5 7.2 6.4 6.4c1.6-.5 3.2.2 4.1 1.4.9-1.2 2.5-1.9 4.1-1.4 2.9.8 4 3.8 2.4 6.2-1.8 3.1-8 7-8 7z"/>
    <% } else if (_name === 'home') { %>
      <path d="M4.5 11.2 12 4.6l7.5 6.6"/>
      <path d="M7 10.6V19h10v-8.4"/>
      <path d="M10.2 19v-4h3.6V19"/>
    <% } else if (_name === 'map') { %>
      <path d="M9 4.5 4.5 6.2V19l4.5-1.5L15 19l4.5-1.7V5.5L15 7.2 9 4.5z"/>
      <path d="M9 4.5V17.5M15 7.2V19"/>
    <% } else { %>
      <circle cx="12" cy="12" r="3" fill="currentColor" fill-opacity="0.15"/>
      <circle cx="12" cy="12" r="3"/>
    <% } %>
  </svg>
</span>
