<%#
  Grid de oficios — camino ahora | proyecto
  locals: services, camino ('ahora'|'proyecto'), gridId, formatCLP, t
%>
<%
  const list = Array.isArray(services) ? services : [];
  const pathQ = camino === 'proyecto' ? 'proyecto' : 'ahora';
  const gid = gridId || ('servicesGrid-' + pathQ);
%>
<div id="<%= gid %>" class="home-svc-grid grid grid-cols-2 gap-3 mb-2">
  <% list.forEach(function(service) { %>
    <a href="/cliente/servicio/<%= service.id %>?camino=<%= pathQ %>" data-service-id="<%= service.id %>" data-camino="<%= pathQ %>"
      class="home-svc service-item group">
      <%- include('service-icon', { icon: service.icon, size: 'lg' }) %>
      <span class="home-svc__name"><%= service.name %></span>
      <span class="home-svc__price">
        <span class="home-svc__from"><%= camino === 'proyecto' ? t('client.from_eval') : t('client.from_price') %></span>
        <span class="home-svc__amt tabular-nums"><%= formatCLP(service.averagePrice || service.fromPrice) %><% if (service.pricingUnit === 'm2') { %> / m²<% } %></span>
        <% if (service.showMinJob && service.minJobPrice) { %>
        <span class="home-svc__min tabular-nums"><%= t('client.min_job') %> <%= formatCLP(service.minJobPrice) %></span>
        <% } %>
      </span>
    </a>
  <% }); %>
</div>
<% if (list.length) { %>
<p class="text-[10px] text-zilo-muted text-center mb-1 -mt-0.5 tracking-wide"><%= t('client.prices_iva_note') %></p>
<% } %>
<% if (!list.length) { %>
<p class="text-xs text-zilo-muted text-center py-4"><%= t('client.dashboard.no_services_group') %></p>
<% } %>
