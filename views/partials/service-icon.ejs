<%#
  Iconos de oficio Fandez — metáforas propias, no Lucide genérico.
  Uso: include('partials/service-icon', { icon: service.icon, size: 'lg' })
  size: xs | sm | md | lg | xl
%>
<%
  const sizes = { xs: 14, sm: 18, md: 22, lg: 28, xl: 36 };
  const boxSizes = { xs: 'w-7 h-7', sm: 'w-9 h-9', md: 'w-11 h-11', lg: 'w-14 h-14', xl: 'w-[4.5rem] h-[4.5rem]' };
  const s = sizes[size || 'md'] || 22;
  const box = boxSizes[size || 'md'] || 'w-11 h-11';
  const heroClass = size === 'xl' ? ' zilo-icon-hero' : '';
  const key = String(icon || '').toLowerCase();
%>
<span class="zilo-icon-wrap<%= heroClass %> <%= box %> rounded-xl flex items-center justify-center shrink-0" aria-hidden="true">
  <svg class="zilo-icon" width="<%= s %>" height="<%= s %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
    <% if (key === 'electrico') { %>
      <%# Tablero + chispa — no rayo suelto %>
      <rect x="5" y="3.5" width="14" height="17" rx="2"/>
      <path d="M8.5 7.5h7M8.5 11h4"/>
      <path d="M14.2 14.2 12 18.5l3.2-1.4 1.1 3.1 2.2-4.4h-2.8z" fill="currentColor" fill-opacity="0.14" stroke="currentColor"/>
    <% } else if (key === 'gasfiter') { %>
      <%# Grifo con gota %>
      <path d="M7 10.5V8.2A3.2 3.2 0 0 1 10.2 5h2.1A3.2 3.2 0 0 1 15.5 8.2V10"/>
      <path d="M6.2 10.5h11.6c.7 0 1.2.6 1.1 1.3l-.5 3.2A3 3 0 0 1 15.5 18H8.5a3 3 0 0 1-2.9-3l-.5-3.2c-.1-.7.4-1.3 1.1-1.3z"/>
      <path d="M12 18.2v1.3"/>
      <path d="M12 21.2c.55 0 1-.4 1-.9s-.45-1.1-1-1.1-1 .6-1 1.1.45.9 1 .9z" fill="currentColor" fill-opacity="0.2"/>
    <% } else if (key === 'cerrajero') { %>
      <%# Puerta + ojo de cerradura %>
      <path d="M8 21V6.5A2.5 2.5 0 0 1 10.5 4h7A2.5 2.5 0 0 1 20 6.5V21"/>
      <path d="M4 21h16"/>
      <circle cx="14.2" cy="12.2" r="1.55"/>
      <path d="M14.2 13.75v2.4"/>
    <% } else if (key === 'aires') { %>
      <%# Split + ola de aire %>
      <rect x="3.5" y="6" width="17" height="7.5" rx="1.8"/>
      <path d="M7 9.8h10"/>
      <path d="M6.5 16.2c1.6 1.4 3.4 1.4 5 0s3.4-1.4 5 0"/>
      <path d="M6.5 19c1.6 1.4 3.4 1.4 5 0s3.4-1.4 5 0"/>
    <% } else if (key === 'calderas') { %>
      <%# Caldera + llama %>
      <rect x="5.5" y="4" width="13" height="15.5" rx="2"/>
      <path d="M9 4V2.8h6V4"/>
      <path d="M12 9.2c1.7 1.5 1.8 3.2 0 4.8-1.8-1.6-1.7-3.3 0-4.8z" fill="currentColor" fill-opacity="0.16"/>
      <path d="M9.2 17.2h5.6"/>
    <% } else if (key === 'generadores') { %>
      <%# Generador portátil + ficha %>
      <rect x="3.5" y="7" width="13.5" height="11" rx="2"/>
      <circle cx="9" cy="12.5" r="2.4"/>
      <path d="M9 10.1v4.8M6.6 12.5h4.8"/>
      <path d="M17 10.5h2.2a1.3 1.3 0 0 1 1.3 1.3v1.4a1.3 1.3 0 0 1-1.3 1.3H17"/>
      <path d="M7.2 5.2v1.8M14.2 5.2v1.8"/>
    <% } else if (key === 'pintura') { %>
      <%# Rodillo en muro %>
      <rect x="4" y="4.5" width="9.5" height="5.2" rx="1.4"/>
      <path d="M13.5 7.1h3.2a1.4 1.4 0 0 1 1.4 1.4V12"/>
      <path d="M16.8 12v6.2a1.3 1.3 0 0 1-1.3 1.3h-.2"/>
      <path d="M4.8 12.5h7.2M4.8 15h5.5M4.8 17.5h6.2" opacity="0.85"/>
    <% } else if (key === 'termos') { %>
      <%# Termo vertical + calor %>
      <rect x="7.2" y="3.2" width="9.6" height="17.6" rx="2.2"/>
      <path d="M10 3.2V2h4v1.2"/>
      <path d="M10.2 9.2c1.1-.9 2.5-.9 3.6 0"/>
      <path d="M10.2 12c1.1-.9 2.5-.9 3.6 0"/>
      <path d="M10.2 14.8c1.1-.9 2.5-.9 3.6 0"/>
      <circle cx="12" cy="18.2" r="0.7" fill="currentColor" stroke="none"/>
    <% } else if (key === 'piscinas') { %>
      <%# Piscina en planta + olas %>
      <rect x="3.5" y="6.5" width="17" height="11" rx="3"/>
      <path d="M6.5 11.2c1.4 1.1 2.9 1.1 4.3 0s2.9-1.1 4.3 0 2.9 1.1 4.3 0"/>
      <path d="M6.5 14.5c1.4 1.1 2.9 1.1 4.3 0s2.9-1.1 4.3 0 2.9 1.1 4.3 0"/>
    <% } else if (key === 'grua') { %>
      <%# Grúa / remolque con gancho y auto %>
      <path d="M3.5 16.5h10.5"/>
      <circle cx="6.2" cy="18.5" r="1.5"/>
      <circle cx="11.8" cy="18.5" r="1.5"/>
      <path d="M4.2 16.5V11.2h6.2l2.2 3.2H14"/>
      <path d="M14 12.5h3.2l2.3 3.2H14"/>
      <path d="M16.2 8.2 19.5 5.2"/>
      <path d="M19.5 5.2v3.4"/>
      <path d="M18.4 8.6h2.2"/>
      <path d="M19.5 8.6v2.2"/>
      <path d="M5.5 13.2h4.2"/>
    <% } else if (key === 'jardineria') { %>
      <%# Tijera de poda + hoja %>
      <circle cx="7.2" cy="7.2" r="2.3"/>
      <circle cx="7.2" cy="16.8" r="2.3"/>
      <path d="M9.1 8.6 18.5 4.8"/>
      <path d="M9.1 15.4 18.5 19.2"/>
      <path d="M14.8 9.5c2.2 1.1 3.4 2.8 2.6 4.4-1.8-.2-3.4-1.6-4.2-3.5.9-.4 1.2-.7 1.6-.9z" fill="currentColor" fill-opacity="0.14"/>
    <% } else if (key === 'paisajismo') { %>
      <%# Sendero + árbol (distinto a jardinería) %>
      <path d="M12 14.5c-2.8-3.6-6.2-4.4-6.8-1.6 1.7.1 3.3 1.2 4.3 3.4"/>
      <path d="M12 14.5c2.8-3.6 6.2-4.4 6.8-1.6-1.7.1-3.3 1.2-4.3 3.4"/>
      <path d="M12 11.8V20"/>
      <path d="M5 20h14"/>
      <path d="M8.2 20c1.2-2.4 2.6-3.6 3.8-3.6S14.6 17.6 15.8 20"/>
    <% } else if (key === 'fotovoltaico') { %>
      <%# Panel solar + arco de sol %>
      <path d="M5 14.5 12 5.8l7 8.7H5z" fill="currentColor" fill-opacity="0.1"/>
      <path d="M5 14.5 12 5.8l7 8.7"/>
      <path d="M8.2 14.5 12 9.6l3.8 4.9"/>
      <path d="M12 5.8v-2"/>
      <path d="M7.5 8.2 6.2 6.9M16.5 8.2l1.3-1.3"/>
      <path d="M4.5 17.5h15M6.5 20h11"/>
    <% } else if (key === 'limpieza') { %>
      <%# Paño + brillo %>
      <path d="M8.5 4.5h7l1.3 4.2H7.2L8.5 4.5z"/>
      <path d="M7.2 8.7h9.6v1.6a4.8 4.8 0 0 1-4.8 4.8 4.8 4.8 0 0 1-4.8-4.8V8.7z"/>
      <path d="M12 15.1V20.5M9.5 20.5h5"/>
      <path d="M17.8 4.2l.45 1.5 1.5.45-1.5.45-.45 1.5-.45-1.5-1.5-.45 1.5-.45.45-1.5z" fill="currentColor" fill-opacity="0.2"/>
    <% } else if (key === 'lavavajillas') { %>
      <%# Lavavajillas con vajilla %>
      <rect x="4" y="3.2" width="16" height="17.6" rx="2"/>
      <path d="M4 9.2h16"/>
      <path d="M8 12.5v4.2M12 12.2v4.5M16 12.5v4.2"/>
      <circle cx="8" cy="6.4" r="0.7" fill="currentColor" stroke="none"/>
      <circle cx="11" cy="6.4" r="0.7" fill="currentColor" stroke="none"/>
    <% } else if (key === 'lavadora') { %>
      <%# Lavadora con tambor %>
      <rect x="4.5" y="2.8" width="15" height="18.4" rx="2.2"/>
      <circle cx="12" cy="13.2" r="4.6"/>
      <circle cx="12" cy="13.2" r="2" fill="currentColor" fill-opacity="0.12"/>
      <circle cx="8.2" cy="5.6" r="0.65" fill="currentColor" stroke="none"/>
      <path d="M11 5.6h4.8"/>
    <% } else if (key === 'otros') { %>
      <%# Multiherramienta %>
      <path d="M8.2 4.5 4.8 7.9l3.2 3.2"/>
      <path d="M7.2 9.5 14 16.3a2.1 2.1 0 0 0 3 0l.6-.6a2.1 2.1 0 0 0 0-3L10.8 5.9"/>
      <path d="M14.5 7.2l2.8-2.8a1.6 1.6 0 0 1 2.3 0l.2.2a1.6 1.6 0 0 1 0 2.3l-2.6 2.6"/>
      <circle cx="7.5" cy="17.8" r="2.1"/>
    <% } else { %>
      <%# Fallback: casa Fandez %>
      <path d="M4.5 11.2 12 4.8l7.5 6.4"/>
      <path d="M7.2 10.5V19h9.6v-8.5"/>
      <path d="M10.2 19v-4.2h3.6V19"/>
    <% } %>
  </svg>
</span>
