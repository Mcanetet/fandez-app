<% const stats = typeof trustStats !== 'undefined' ? trustStats : {}; %>
<% const numLocale = (typeof locale !== 'undefined' && locale === 'en') ? 'en-US' : 'es-CL'; %>
<div class="trust-strip" role="region" aria-label="<%= t('trust.aria') %>">
  <div class="trust-strip-item">
    <%- include('ui-icon', { name: 'shield', size: 18, className: 'trust-strip-icon' }) %>
    <div>
      <strong><%= t('trust.verified_title') %></strong>
      <span><%= t('trust.verified_sub', { percent: stats.verifiedProviders || '100' }) %></span>
    </div>
  </div>
  <div class="trust-strip-item">
    <%- include('ui-icon', { name: 'star', size: 18, className: 'trust-strip-icon' }) %>
    <div>
      <strong><%= t('trust.rating_title', { rating: stats.avgRating || '4.9' }) %></strong>
      <span><%= t('trust.rating_sub', { count: stats.completedServices ? Number(stats.completedServices).toLocaleString(numLocale) + '+' : '1.200+' }) %></span>
    </div>
  </div>
  <div class="trust-strip-item">
    <%- include('ui-icon', { name: 'bolt', size: 18, className: 'trust-strip-icon' }) %>
    <div>
      <strong><%= t('trust.eta_title', { time: stats.responseTime || '~45 min' }) %></strong>
      <span><%= t('trust.eta_sub') %></span>
    </div>
  </div>
</div>
