<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'es' %>" class="h-full fandez-only-light">
<head>
  <meta charset="UTF-8">
  <style id="fandez-theme-first-paint">
    html { color-scheme: only light; background: #ffffff; }
    body { color-scheme: only light; background: #ffffff; color: #1a1814; }
  </style>
  <script src="<%= typeof asset === 'function' ? asset('/js/force-light.js') : '/js/force-light.js' %>"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="color-scheme" content="only light">
  <meta name="supported-color-schemes" content="only light">
  <meta name="theme-color" content="#FFFFFF">
  <meta name="application-name" content="Fandez">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Fandez">
  <meta name="mobile-web-app-capable" content="yes">
  <% var favBase = (typeof siteUrl !== 'undefined' && siteUrl) ? String(siteUrl).replace(/\/$/, '') : ''; %>
  <% var favV = typeof assetVersion !== 'undefined' ? assetVersion : '1'; %>
  <!-- v6: paths nuevos — Hostinger CDN y Safari ignoran ?v= en favicon.ico -->
  <link rel="icon" href="<%= favBase %>/favicon.svg?v=<%= favV %>" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="48x48" href="<%= favBase %>/icons/fandez-v6-96.png?v=<%= favV %>">
  <link rel="icon" type="image/png" sizes="96x96" href="<%= favBase %>/icons/fandez-v6-96.png?v=<%= favV %>">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= favBase %>/icons/fandez-v6-192.png?v=<%= favV %>">
  <link rel="shortcut icon" href="<%= favBase %>/icons/fandez-v6.ico?v=<%= favV %>">
  <link rel="icon" href="<%= favBase %>/icons/fandez-v6.ico?v=<%= favV %>" sizes="any">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= favBase %>/icons/fandez-v6-180.png?v=<%= favV %>">
  <link rel="manifest" href="/site.webmanifest?v=<%= favV %>">
  <title><%= title %></title>
  <%- include('seo-meta', { seo: typeof seo !== 'undefined' ? seo : null }) %>
  <link rel="stylesheet" href="<%= asset('/css/tailwind.css') %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
  <style>
    @font-face {
      font-family: 'Unbounded';
      src: url('/fonts/unbounded-700.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
  </style>
  <link rel="stylesheet" href="<%= asset('/css/main.css') %>">
  <link rel="stylesheet" href="<%= asset('/css/force-light.css') %>">
  <% if (typeof useMap !== 'undefined' && useMap) { %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <% } %>
</head>
<body class="bg-zilo-bg text-zilo-text font-sans min-h-full antialiased zilo-body <%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <!-- Splash propio (el del SO no anima): logo ámbar palpita como Tinder al abrir la app -->
  <style>
    #fandezSplash{
      position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;
      background:var(--zilo-bg,#FFFFFF);transition:opacity .38s ease,visibility .38s ease;
    }
    #fandezSplash.fandez-splash--out{opacity:0;visibility:hidden;pointer-events:none}
    #fandezSplash .fandez-splash__mark{
      width:112px;height:112px;border-radius:26px;display:block;
      animation:fandezSplashPulse 1.15s ease-in-out infinite;
      transform-origin:center center;
      will-change:transform;
      box-shadow:0 10px 28px rgba(196,92,20,.22);
    }
    @keyframes fandezSplashPulse{
      0%,100%{transform:scale(1)}
      50%{transform:scale(1.12)}
    }
    @media (prefers-reduced-motion:reduce){
      #fandezSplash .fandez-splash__mark{animation:none}
    }
    @media (min-width:901px){
      html:not(.fandez-standalone) #fandezSplash{display:none !important}
    }
  </style>
  <script>
    (function(){
      try{
        if(window.matchMedia('(display-mode: standalone)').matches||window.navigator.standalone===true){
          document.documentElement.classList.add('fandez-standalone');
        }
      }catch(e){}
    })();
  </script>
  <div id="fandezSplash" role="presentation" aria-hidden="true">
    <img class="fandez-splash__mark" src="<%= favBase %>/icons/fandez-v6-192.png?v=<%= favV %>" width="192" height="192" alt="" decoding="async" fetchpriority="high">
  </div>
  <script>
    (function(){
      var el=document.getElementById('fandezSplash');
      if(!el)return;
      var desktop=false;
      try{desktop=window.matchMedia('(min-width:901px)').matches&&!document.documentElement.classList.contains('fandez-standalone');}catch(e){}
      if(desktop){el.remove();return;}
      var minMs=1100;
      var t0=Date.now();
      function hide(){
        var wait=Math.max(0,minMs-(Date.now()-t0));
        setTimeout(function(){
          el.classList.add('fandez-splash--out');
          setTimeout(function(){el.remove();},420);
        },wait);
      }
      if(document.readyState==='complete')hide();
      else window.addEventListener('load',hide);
      setTimeout(hide,4000);
    })();
  </script>
