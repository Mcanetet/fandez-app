<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'es' %>" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#C45C14">
  <meta name="application-name" content="Fundez">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Fundez">
  <meta name="mobile-web-app-capable" content="yes">
  <% var favBase = (typeof siteUrl !== 'undefined' && siteUrl) ? String(siteUrl).replace(/\/$/, '') : ''; %>
  <% var favV = typeof assetVersion !== 'undefined' ? assetVersion : '1'; %>
  <!-- v5: paths nuevos — Hostinger CDN y Safari ignoran ?v= en favicon.ico -->
  <link rel="icon" href="<%= favBase %>/favicon.svg?v=<%= favV %>" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="48x48" href="<%= favBase %>/icons/fundez-v5-96.png?v=<%= favV %>">
  <link rel="icon" type="image/png" sizes="96x96" href="<%= favBase %>/icons/fundez-v5-96.png?v=<%= favV %>">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= favBase %>/icons/fundez-v5-192.png?v=<%= favV %>">
  <link rel="shortcut icon" href="<%= favBase %>/icons/fundez-v5.ico?v=<%= favV %>">
  <link rel="icon" href="<%= favBase %>/icons/fundez-v5.ico?v=<%= favV %>" sizes="any">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= favBase %>/icons/fundez-v5-180.png?v=<%= favV %>">
  <link rel="manifest" href="/site.webmanifest?v=<%= favV %>">
  <title><%= title %></title>
  <%- include('seo-meta', { seo: typeof seo !== 'undefined' ? seo : null }) %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            zilo: {
              bg: '#F4F2EE',
              surface: '#FFFFFF',
              card: '#FFFFFF',
              elevated: '#EBE6DF',
              border: '#E6E0D8',
              accent: '#C45C14',
              'accent-soft': '#F3E6D8',
              'accent-strong': '#9A3F0A',
              text: '#1A1814',
              muted: '#6B635A',
              success: '#2F6B4F',
              warning: '#B47814',
              danger: '#B83A2E'
            },
            aland: {
              DEFAULT: '#2A6A5B',
              soft: '#E4F0EC',
              strong: '#1F5045'
            }
          },
          fontFamily: {
            sans: ['"Source Sans 3"', 'system-ui', 'sans-serif'],
            display: ['"Bricolage Grotesque"', '"Source Sans 3"', 'system-ui', 'sans-serif']
          },
          borderRadius: { '4xl': '2rem' },
          animation: {
            'pulse-slow': 'pulse 3s cubic-bezier(0.4,0,0.6,1) infinite',
            'slide-up': 'slideUp 0.35s ease-out',
            'fade-in': 'fadeIn 0.25s ease-out',
            'radar': 'radarPulse 2s ease-out infinite',
            'bounce-in': 'bounceIn 0.4s ease-out',
            'shimmer': 'shimmer 2.5s ease-in-out infinite'
          },
          keyframes: {
            slideUp: { from: { transform: 'translateY(100%)', opacity: '0' }, to: { transform: 'translateY(0)', opacity: '1' } },
            fadeIn: { from: { opacity: '0' }, to: { opacity: '1' } },
            radarPulse: { '0%': { transform: 'scale(0.3)', opacity: '0.8' }, '100%': { transform: 'scale(1.4)', opacity: '0' } },
            bounceIn: { '0%': { transform: 'scale(0.92)', opacity: '0' }, '100%': { transform: 'scale(1)', opacity: '1' } },
            shimmer: { '0%,100%': { opacity: '0.5' }, '50%': { opacity: '1' } }
          },
          boxShadow: {
            'zilo': '0 1px 2px rgba(26,24,20,0.05), 0 6px 16px rgba(26,24,20,0.06)',
            'zilo-glow': '0 1px 2px rgba(26,24,20,0.05)'
          }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= asset('/css/main.css') %>">
  <% if (typeof useMap !== 'undefined' && useMap) { %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <% } %>
</head>
<body class="bg-zilo-bg text-zilo-text font-sans min-h-full antialiased zilo-body <%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <!-- Splash propio (el del SO no anima): logo ámbar palpita como Tinder al abrir la app -->
  <style>
    #fundezSplash{
      position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;
      background:#F4F2EE;transition:opacity .38s ease,visibility .38s ease;
    }
    #fundezSplash.fundez-splash--out{opacity:0;visibility:hidden;pointer-events:none}
    #fundezSplash .fundez-splash__mark{
      width:112px;height:112px;border-radius:26px;display:block;
      animation:fundezSplashPulse 1.15s ease-in-out infinite;
      transform-origin:center center;
      will-change:transform;
      box-shadow:0 10px 28px rgba(196,92,20,.22);
    }
    @keyframes fundezSplashPulse{
      0%,100%{transform:scale(1)}
      50%{transform:scale(1.12)}
    }
    @media (prefers-reduced-motion:reduce){
      #fundezSplash .fundez-splash__mark{animation:none}
    }
    @media (min-width:901px){
      html:not(.fundez-standalone) #fundezSplash{display:none !important}
    }
  </style>
  <script>
    (function(){
      try{
        if(window.matchMedia('(display-mode: standalone)').matches||window.navigator.standalone===true){
          document.documentElement.classList.add('fundez-standalone');
        }
      }catch(e){}
    })();
  </script>
  <div id="fundezSplash" role="presentation" aria-hidden="true">
    <img class="fundez-splash__mark" src="<%= favBase %>/icons/fundez-v5-192.png?v=<%= favV %>" width="192" height="192" alt="" decoding="async" fetchpriority="high">
  </div>
  <script>
    (function(){
      var el=document.getElementById('fundezSplash');
      if(!el)return;
      var desktop=false;
      try{desktop=window.matchMedia('(min-width:901px)').matches&&!document.documentElement.classList.contains('fundez-standalone');}catch(e){}
      if(desktop){el.remove();return;}
      var minMs=1100;
      var t0=Date.now();
      function hide(){
        var wait=Math.max(0,minMs-(Date.now()-t0));
        setTimeout(function(){
          el.classList.add('fundez-splash--out');
          setTimeout(function(){el.remove();},420);
        },wait);
      }
      if(document.readyState==='complete')hide();
      else window.addEventListener('load',hide);
      setTimeout(hide,4000);
    })();
  </script>
