<%# Técnico stick · gorra con visera · interactúa con letras / arbusto %>
<div class="stick-tech" data-stick-tech aria-hidden="true">
  <div class="stick-tech__stage" data-stick-stage>
    <!-- Arbusto que crece y se poda -->
    <svg class="stick-tech__prop stick-tech__prop--bush" viewBox="0 0 72 56" fill="none" stroke="#141414" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <g class="stick-tech__bush-body">
        <path d="M36 52V28"/>
        <path d="M36 30c-10-2-18 4-18 14 0 0 8 2 18 2s18-2 18-2c0-10-8-16-18-14z"/>
        <path d="M22 36c-4-6-2-12 4-14"/>
        <path d="M50 36c4-6 2-12-4-14"/>
        <path d="M28 24c2-6 8-8 12-6"/>
        <path d="M44 24c-2-6-8-8-12-6"/>
      </g>
      <g class="stick-tech__bush-cut" opacity="0">
        <path d="M20 40l8-6M28 44l10-8M42 42l8-5"/>
        <path d="M24 48h24" stroke-dasharray="2 3"/>
      </g>
    </svg>

    <!-- Gota / tubo -->
    <svg class="stick-tech__prop stick-tech__prop--drip" viewBox="0 0 40 48" fill="none" stroke="#141414" stroke-width="2" stroke-linecap="round">
      <path d="M12 8v10c0 6 4 10 8 10s8-4 8-10V8"/>
      <path class="stick-tech__drip" d="M20 30c0 4-2 7-2 10"/>
      <circle class="stick-tech__drop" cx="18" cy="42" r="2.2" fill="#141414" stroke="none"/>
    </svg>

    <!-- Chispa -->
    <svg class="stick-tech__prop stick-tech__prop--spark" viewBox="0 0 40 40" fill="none" stroke="#141414" stroke-width="2" stroke-linecap="round">
      <circle cx="20" cy="20" r="7"/>
      <path d="M20 6v4M20 30v4M6 20h4M30 20h4M9 9l3 3M28 28l3 3M31 9l-3 3M9 31l3-3"/>
    </svg>

    <!-- Actor: mira a la izquierda (hacia el logo) · visera hacia adelante -->
    <div class="stick-tech__actor" data-stick-actor>
      <svg class="stick-tech__svg" viewBox="0 0 64 96" fill="none" stroke="#141414" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
        <!-- Gorra con visera a la IZQUIERDA -->
        <g class="stick-tech__cap">
          <path d="M20 22c1.2-7.2 7-11 12.5-11S43.8 14.8 45 22H20z" fill="#141414" stroke="#141414"/>
          <path d="M18 22h29" stroke-width="2.4"/>
          <!-- Visera hacia la izquierda -->
          <path class="stick-tech__visor" d="M34 22H12c-.4 0-.7.4-.5.8 1.8 3.2 7.2 5.2 12.8 5.2 3.2 0 5.6-.6 7.2-1.4.6-.3.8-.9.5-1.4l-.6-1.2c-.2-.4-.6-.6-1-.6z" fill="#141414" stroke="#141414" stroke-width="1.5"/>
        </g>
        <circle cx="32" cy="28" r="8"/>
        <path d="M32 36v22"/>
        <!-- Brazo trasero (derecha) -->
        <path class="stick-tech__arm stick-tech__arm--back" d="M32 42c6 2 10 8 11 14"/>
        <!-- Brazo delantero (izquierda) + herramientas -->
        <g class="stick-tech__arm-front">
          <path class="stick-tech__arm stick-tech__arm--front-line" d="M32 42c-6 2-10 8-11 14"/>
          <g class="stick-tech__tool stick-tech__tool--wrench" transform="translate(12 52)">
            <path d="M10 2L2 10"/>
            <path d="M12 4c-2-2-4-2-6 0L4 6l4 4 2-2c2-2 2-4 0-6z"/>
          </g>
          <g class="stick-tech__tool stick-tech__tool--brush" transform="translate(8 48)">
            <path d="M14 4L4 14"/>
            <path d="M2 12h6v6H2z" fill="#141414" fill-opacity=".2"/>
            <path d="M2 12h6M2 15h6M2 18h6"/>
          </g>
          <g class="stick-tech__tool stick-tech__tool--cloth" transform="translate(8 50)">
            <path d="M12 2c-4-1-8 1-10 4 3 2 7 3 11 2 0-2 0-4-1-6z" fill="#141414" fill-opacity=".12"/>
            <path d="M12 3c-3-1-7 0-10 3"/>
          </g>
          <g class="stick-tech__tool stick-tech__tool--driver" transform="translate(10 50)">
            <path d="M8 2v12"/>
            <path d="M6 2h4"/>
            <path d="M8 14l-1.5 3M8 14l1.5 3"/>
          </g>
          <g class="stick-tech__tool stick-tech__tool--shears" transform="translate(8 51)">
            <path d="M12 10L4 2"/>
            <path d="M4 10l8-8"/>
            <circle cx="12" cy="11" r="1.6"/>
            <circle cx="4" cy="11" r="1.6"/>
          </g>
        </g>
        <path class="stick-tech__leg stick-tech__leg--l" d="M32 58l-8 22"/>
        <path class="stick-tech__leg stick-tech__leg--r" d="M32 58l8 22"/>
      </svg>
    </div>
  </div>
</div>
