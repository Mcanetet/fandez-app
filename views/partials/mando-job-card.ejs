<%
  const job = typeof r !== 'undefined' ? r : null;
  const team = Array.isArray(technicians) ? technicians : [];
  if (!job) return;
  const eligibleTechs = team.filter(tech => Array.isArray(tech.specialties) && tech.specialties.includes(job.serviceId));
  const waitingAccept = Boolean(job.technicianId && job.techStatus === 'asignado');
  const needsAssign = !job.technicianId;
  const canReassign = !['completado'].includes(job.techStatus) && job.status !== 'completed' && job.status !== 'cancelled';
  const showAssignBox = needsAssign || waitingAccept || (canReassign && job.technicianId);
%>
<div class="py-3 border-b border-[rgba(26,24,20,0.08)]" data-request-id="<%= job.id %>"
  data-agenda-day="<%= job.agendaDay || 'today' %>"
  data-tech-status="<%= job.techStatus || '' %>"
  data-service-id="<%= job.serviceId %>"
  data-lat="<%= job.coords && job.coords.lat != null ? job.coords.lat : '' %>"
  data-lng="<%= job.coords && job.coords.lng != null ? job.coords.lng : '' %>">
  <div class="flex justify-between items-start mb-2">
    <div class="min-w-0">
      <strong class="text-sm block truncate"><%= job.serviceName %></strong>
      <span class="text-xs text-zilo-muted block truncate"><%= job.clientName %></span>
    </div>
    <span class="text-xs font-semibold text-[#C45C14] shrink-0" data-role="status"><%= job.techStatusLabel || job.statusLabel || job.techStatus || job.status %></span>
  </div>
  <p class="text-xs text-zilo-muted mb-3 truncate"><%= job.address || t('provider.dashboard.no_address') %></p>

  <div data-role="assign-area" class="mt-3 space-y-2">
    <% if (job.technicianId && !needsAssign && !waitingAccept) { %>
      <div class="space-y-2">
        <p class="text-xs"><%= t('provider.mando_page.tech_label') %>: <strong data-role="tech-name"><%= job.technicianName %></strong></p>
        <a href="/proveedor/trabajo/<%= job.id %>" class="block text-center zilo-btn-primary !py-3 !text-sm"><%= t('provider.mando_page.open_field') %></a>
        <div class="flex gap-2">
          <% if (job.guardianToken) { %>
            <a href="/seguimiento/<%= job.guardianToken %>" target="_blank" rel="noopener" class="flex-1 text-center zilo-btn-ghost !py-2 !text-xs"><%= t('provider.mando_page.live_map') %></a>
          <% } %>
          <button type="button" class="flex-1 zilo-btn-ghost !py-2 !text-xs" data-role="open-chat" data-id="<%= job.id %>" data-client="<%= job.clientName || 'Cliente' %>"><%= t('provider.mando_page.chat_client') %></button>
        </div>
      </div>
    <% } %>

    <% if (showAssignBox) { %>
      <div class="p-3 rounded-xl border <%= waitingAccept || needsAssign ? (waitingAccept ? 'border-amber-300 bg-amber-50' : 'border-zilo-accent/30 bg-zilo-accent/5') : 'border-zilo-border bg-zilo-bg/50' %> space-y-2"
        <% if (waitingAccept) { %>
        data-accept-deadline="<%= job.technicianAssignedAt || '' %>"
        data-accept-timeout-min="<%= typeof requestTimeouts !== 'undefined' ? requestTimeouts.techAcceptMinutes : 10 %>"
        <% } %>
      >
        <% if (waitingAccept) { %>
          <p class="text-xs text-amber-900"><%= t('provider.mando_page.waiting_accept', { name: job.technicianName }) %></p>
          <p class="text-sm font-semibold text-amber-950 tabular-nums" data-role="accept-countdown"><%= typeof requestTimeouts !== 'undefined' ? requestTimeouts.techAcceptMinutes : 10 %>:00</p>
          <p class="text-[11px] text-amber-800/80"><%= t('provider.mando_page.accept_timeout_hint') %></p>
        <% } else if (needsAssign) { %>
          <p class="text-xs font-semibold text-zilo-text">Asigna un técnico para esta visita</p>
          <p class="text-[11px] text-zilo-muted">Elige quién va. Si eliges a otra persona, tendrá unos minutos para aceptar en su celular.</p>
        <% } else { %>
          <p class="text-xs font-semibold text-zilo-text">Reasignar técnico</p>
          <p class="text-[11px] text-zilo-muted">Puedes cambiar de técnico en cualquier momento. Le llega correo y aviso.</p>
        <% } %>

        <% if (team.length > 0) { %>
          <% if (job.awaitingProviderReassign && !waitingAccept && needsAssign) { %>
            <p class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-xl p-2"><%= t('provider.mando_page.reassign_hint') %></p>
            <p class="text-xs font-semibold text-amber-900 tabular-nums"
              data-reassign-deadline="<%= job.techAcceptTimedOutAt || '' %>"
              data-reassign-timeout-min="<%= typeof requestTimeouts !== 'undefined' ? requestTimeouts.providerReassignMinutes : 10 %>"
              data-role="reassign-countdown"></p>
          <% } %>
          <label class="zilo-label block !text-[10px]" for="tech-select-<%= job.id %>"><%= needsAssign && !waitingAccept ? t('provider.mando_page.pick_tech') : 'Cambiar técnico' %></label>
          <select id="tech-select-<%= job.id %>" class="zilo-select-tech zilo-input text-sm" data-role="tech-select" <%= eligibleTechs.length ? '' : 'disabled' %>>
            <option value=""><%= eligibleTechs.length ? t('provider.mando_page.pick_placeholder') : t('provider.mando_page.no_eligible') %></option>
            <% eligibleTechs.forEach(tech => { %>
              <option value="<%= tech.id %>" <%= job.technicianId === tech.id ? 'selected' : '' %>><%= tech.isSelfOperator ? (tech.name + ' (tú)') : tech.name %></option>
            <% }); %>
          </select>
          <button type="button" class="zilo-btn-primary w-full !py-3 !text-sm" data-role="assign-btn" data-id="<%= job.id %>" <%= eligibleTechs.length ? '' : 'disabled' %>><%= needsAssign && !waitingAccept ? t('provider.mando_page.assign_btn') : 'Reasignar técnico' %></button>
          <% if (!eligibleTechs.length) { %>
            <a href="/proveedor/equipo" class="block text-center text-[11px] text-zilo-accent underline"><%= t('provider.mando_page.activate_tech') %></a>
          <% } %>
        <% } else { %>
          <a href="/proveedor/equipo" class="block text-center zilo-btn-ghost !py-3 !text-sm"><%= t('provider.mando_page.add_tech') %></a>
        <% } %>

        <% if (needsAssign || waitingAccept) { %>
          <a href="/proveedor/trabajo/<%= job.id %>" class="block text-center zilo-btn-ghost !py-2 !text-xs"><%= t('provider.mando_page.view_job') %></a>
        <% } %>
        <details class="mt-1">
          <summary class="text-[11px] text-zilo-muted cursor-pointer py-1">Más opciones</summary>
          <button type="button" class="w-full mt-2 py-2 text-xs text-red-700 underline" data-role="desert-btn" data-id="<%= job.id %>"><%= t('provider.mando_page.release') %></button>
        </details>
      </div>
    <% } else { %>
      <a href="/proveedor/equipo" class="block text-center zilo-btn-ghost !py-3 !text-sm"><%= t('provider.mando_page.add_tech') %></a>
      <button type="button" class="w-full zilo-btn-ghost !py-2.5 !text-sm mt-2" data-role="open-chat" data-id="<%= job.id %>" data-client="<%= job.clientName || 'Cliente' %>"><%= t('provider.mando_page.chat_client') %></button>
      <details class="mt-2">
        <summary class="text-[11px] text-zilo-muted cursor-pointer py-1">Más opciones</summary>
        <button type="button" class="w-full mt-2 py-2 text-xs text-red-700 underline" data-role="desert-btn" data-id="<%= job.id %>"><%= t('provider.mando_page.release_short') %></button>
      </details>
    <% } %>
  </div>
</div>
