<%#
  Ficha visual del servicio: problemas + imagen + acordeones.
  Locals: overview, service, t (opcional)
%>
<% if (typeof overview !== 'undefined' && overview) { %>
<%
  const ov = overview;
  const svc = typeof service !== 'undefined' ? service : {};
  const problems = Array.isArray(ov.problems) ? ov.problems : [];
  const mid = Math.ceil(problems.length / 2);
  const colA = problems.slice(0, mid);
  const colB = problems.slice(mid);
  const more = Array.isArray(ov.moreProblems) ? ov.moreProblems : [];
%>
<section class="service-overview mb-5 zilo-page-enter-delay-1" aria-label="<%= ov.title %>">
  <div class="service-overview-card zilo-card-premium rounded-2xl overflow-hidden border border-zilo-border">
    <div class="service-overview-main">
      <div class="service-overview-copy">
        <div class="flex items-start gap-3 mb-3">
          <div class="shrink-0 mt-0.5">
            <%- include('service-icon', { icon: svc.icon || 'lavadora', size: 'lg' }) %>
          </div>
          <div class="min-w-0">
            <h2 class="text-base font-semibold text-zilo-text leading-snug"><%= ov.title %></h2>
            <p class="text-xs text-zilo-muted mt-0.5 leading-relaxed"><%= ov.subtitle %></p>
          </div>
        </div>

        <% if (problems.length) { %>
        <div class="service-overview-problems">
          <ul class="service-overview-col">
            <% colA.forEach(function(item) { %>
              <li class="service-overview-item">
                <span class="service-overview-check" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>
                </span>
                <span><%= item %></span>
              </li>
            <% }); %>
          </ul>
          <% if (colB.length) { %>
          <ul class="service-overview-col">
            <% colB.forEach(function(item) { %>
              <li class="service-overview-item">
                <span class="service-overview-check" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>
                </span>
                <span><%= item %></span>
              </li>
            <% }); %>
          </ul>
          <% } %>
        </div>
        <% } %>

        <% if (more.length) { %>
        <details class="service-overview-more mt-3">
          <summary class="text-xs font-semibold text-zilo-accent cursor-pointer list-none flex items-center gap-1">
            <%= typeof t === 'function' ? t('client.service.overview_see_all') : 'Ver todos los problemas que atendemos' %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
          </summary>
          <ul class="mt-2 space-y-1.5">
            <% more.forEach(function(item) { %>
              <li class="service-overview-item text-zilo-muted">
                <span class="service-overview-check opacity-80" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7"/></svg>
                </span>
                <span><%= item %></span>
              </li>
            <% }); %>
          </ul>
        </details>
        <% } else if (problems.length) { %>
        <details class="service-overview-more mt-3">
          <summary class="text-xs font-semibold text-zilo-accent cursor-pointer list-none flex items-center gap-1">
            <%= typeof t === 'function' ? t('client.service.overview_see_all') : 'Ver todos los problemas que atendemos' %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
          </summary>
          <p class="mt-2 text-[11px] text-zilo-muted leading-relaxed"><%= typeof t === 'function' ? t('client.service.overview_problems_hint') : 'Estos son los problemas más frecuentes que resolvemos.' %> <%= typeof t === 'function' ? t('client.service.overview_see_all_hint') : 'Si tu caso no aparece, descríbelo en el detalle: el técnico lo evalúa en la visita.' %></p>
        </details>
        <% } %>
      </div>

      <% if (ov.hasImage && ov.image) { %>
      <div class="service-overview-media">
        <img src="<%= ov.image %>" alt="<%= ov.imageAlt || ov.title %>" class="service-overview-img" loading="lazy" width="280" height="320">
      </div>
      <% } else { %>
      <div class="service-overview-media service-overview-media--placeholder" aria-hidden="true">
        <%- include('service-icon', { icon: svc.icon || 'lavadora', size: 'xl' }) %>
      </div>
      <% } %>
    </div>

    <div class="border-t border-zilo-border divide-y divide-zilo-border">
      <details class="service-overview-acc group">
        <summary class="service-overview-acc-summary">
          <span class="service-overview-acc-icon" aria-hidden="true">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <strong class="text-sm block text-zilo-text"><%= typeof t === 'function' ? t('client.service.overview_includes') : 'Incluye este servicio' %></strong>
            <span class="text-[11px] text-zilo-muted leading-snug"><%= ov.includesSummary || (typeof t === 'function' ? t('client.service.overview_includes_sub') : 'Lo que cubre la visita y la mano de obra') %></span>
          </span>
          <svg class="w-4 h-4 text-zilo-muted shrink-0 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <ul class="px-4 pb-4 space-y-1.5">
          <% (ov.includes || []).forEach(function(item) { %>
            <li class="text-xs text-zilo-muted flex gap-2"><span class="text-emerald-600">✓</span><span><%= item %></span></li>
          <% }); %>
        </ul>
      </details>

      <details class="service-overview-acc group">
        <summary class="service-overview-acc-summary">
          <span class="service-overview-acc-icon" aria-hidden="true">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <strong class="text-sm block text-zilo-text"><%= typeof t === 'function' ? t('client.service.overview_excludes') : '¿Qué no incluye?' %></strong>
            <span class="text-[11px] text-zilo-muted leading-snug"><%= ov.excludesSummary || (typeof t === 'function' ? t('client.service.overview_excludes_sub') : 'Para evitar sorpresas en el presupuesto') %></span>
          </span>
          <svg class="w-4 h-4 text-zilo-muted shrink-0 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <ul class="px-4 pb-4 space-y-1.5">
          <% (ov.excludes || []).forEach(function(item) { %>
            <li class="text-xs text-zilo-muted flex gap-2"><span class="text-amber-600">–</span><span><%= item %></span></li>
          <% }); %>
        </ul>
      </details>

      <% if (ov.brands && ov.brands.length) { %>
      <details class="service-overview-acc group">
        <summary class="service-overview-acc-summary">
          <span class="service-overview-acc-icon" aria-hidden="true">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <strong class="text-sm block text-zilo-text"><%= typeof t === 'function' ? t('client.service.overview_brands') : 'Marcas que atendemos' %></strong>
            <span class="text-[11px] text-zilo-muted leading-snug"><%= ov.brandsSummary || (ov.brands || []).slice(0, 6).join(', ') || (typeof t === 'function' ? t('client.service.overview_brands_sub') : 'Trabajamos con las principales marcas del mercado') %></span>
          </span>
          <svg class="w-4 h-4 text-zilo-muted shrink-0 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
        </summary>
        <div class="px-4 pb-4 flex flex-wrap gap-2">
          <% ov.brands.forEach(function(brand) { %>
            <span class="text-[11px] px-2.5 py-1 rounded-lg border border-zilo-border bg-zilo-bg text-zilo-text"><%= brand %></span>
          <% }); %>
        </div>
      </details>
      <% } %>
    </div>
  </div>
</section>
<% } %>
