<%# Logos de marcas — Visa siempre visible (el Brick de MP a veces no lo pinta). %>
<div class="mp-card-brands flex items-center gap-2.5 mb-3" aria-label="Tarjetas aceptadas: Visa, Mastercard, American Express">
  <span class="mp-card-brands__item inline-flex items-center justify-center h-7 px-2 rounded-md border border-zilo-border bg-white" title="Visa">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 16" width="40" height="14" role="img" aria-label="Visa">
      <rect width="48" height="16" rx="2" fill="#1A1F71"/>
      <text x="24" y="11.5" text-anchor="middle" fill="#fff" font-family="Arial, Helvetica, sans-serif" font-size="9" font-weight="700" letter-spacing="0.5">VISA</text>
    </svg>
  </span>
  <span class="mp-card-brands__item inline-flex items-center justify-center h-7 px-2 rounded-md border border-zilo-border bg-white" title="Mastercard">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 24" width="32" height="18" role="img" aria-label="Mastercard">
      <circle cx="15" cy="12" r="9" fill="#EB001B"/>
      <circle cx="25" cy="12" r="9" fill="#F79E1B"/>
      <path d="M20 5.2a9 9 0 0 1 0 13.6 9 9 0 0 1 0-13.6z" fill="#FF5F00"/>
    </svg>
  </span>
  <span class="mp-card-brands__item inline-flex items-center justify-center h-7 px-2 rounded-md border border-zilo-border bg-white" title="American Express">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 16" width="40" height="14" role="img" aria-label="American Express">
      <rect width="48" height="16" rx="2" fill="#2E77BC"/>
      <text x="24" y="11.5" text-anchor="middle" fill="#fff" font-family="Arial, Helvetica, sans-serif" font-size="7" font-weight="700">AMEX</text>
    </svg>
  </span>
  <span class="text-[10px] text-zilo-muted leading-tight">Visa · Mastercard · Amex</span>
</div>
