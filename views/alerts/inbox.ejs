<%
  const alertsHome = typeof alertsBase === 'string' ? alertsBase : (
    user?.role === 'provider' ? '/proveedor' : user?.role === 'tecnico' ? '/tecnico' : '/cliente'
  );
  const items = Array.isArray(alerts) ? alerts : [];
  const actionN = typeof actionCount === 'number' ? actionCount : items.filter((a) => a.urgency === 'high' || a.urgency === 'medium').length;
%>
<%- include('../partials/head') %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col pb-24 zilo-page-enter" id="alertsInboxPage"
  data-role="<%= user?.role || '' %>">

  <%- include('../partials/back-header', {
    backUrl: alertsHome,
    label: 'Bandeja',
    title: 'Alertas',
    showLogout: false
  }) %>

  <main class="flex-1 px-5 py-5 space-y-4">
    <div class="p-4 rounded-2xl zilo-card-premium">
      <p class="zilo-label mb-1">Pendientes</p>
      <p class="text-sm text-zilo-text">
        <% if (items.length === 0) { %>
          No tienes alertas abiertas ahora.
        <% } else if (actionN > 0) { %>
          <%= actionN %> requieren tu atención<%= items.length > actionN ? ` · ${items.length} en total` : '' %>.
        <% } else { %>
          <%= items.length %> aviso<%= items.length === 1 ? '' : 's' %> activos.
        <% } %>
      </p>
    </div>

    <% if (items.length) { %>
    <ul class="space-y-3" id="alertsServerList">
      <% items.forEach(function(a) {
        const tone = a.urgency === 'high' ? 'border-amber-300 bg-amber-50/80' : a.urgency === 'medium' ? 'border-zilo-accent/25 bg-zilo-accent-soft/20' : 'border-zilo-border bg-white/70';
      %>
        <li class="rounded-2xl border <%= tone %> p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <p class="text-[10px] uppercase tracking-wide text-zilo-muted mb-0.5">
                <%= a.urgency === 'high' ? 'Urgente' : a.urgency === 'medium' ? 'Atención' : 'Info' %>
              </p>
              <h3 class="text-sm font-semibold text-zilo-text leading-snug"><%= a.title %></h3>
              <% if (a.body) { %>
                <p class="text-xs text-zilo-muted mt-1 leading-relaxed"><%= a.body %></p>
              <% } %>
            </div>
            <% if (a.href) { %>
              <a href="<%= a.href %>" class="zilo-btn-primary !py-2 !px-3 !text-xs shrink-0"><%= a.cta || 'Revisar' %></a>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>
    <% } %>

    <section class="space-y-2" id="deviceAlertsSection">
      <p class="zilo-label">Avisos recientes del dispositivo</p>
      <p class="text-[11px] text-zilo-muted">Toasts y notificaciones que recibiste en este celular.</p>
      <ul class="space-y-2" id="deviceAlertsList"></ul>
      <p id="deviceAlertsEmpty" class="hidden text-xs text-zilo-muted py-2">Sin avisos recientes en este dispositivo.</p>
      <button type="button" id="clearDeviceAlerts" class="hidden zilo-btn-ghost !text-xs w-full">Limpiar avisos del dispositivo</button>
    </section>
  </main>
</div>

<script>
(function () {
  const KEY = 'fandez_alert_inbox';
  const listEl = document.getElementById('deviceAlertsList');
  const emptyEl = document.getElementById('deviceAlertsEmpty');
  const clearBtn = document.getElementById('clearDeviceAlerts');
  if (!listEl) return;

  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      const items = raw ? JSON.parse(raw) : [];
      return Array.isArray(items) ? items : [];
    } catch (_) {
      return [];
    }
  }

  function render() {
    const items = load().slice(0, 30);
    listEl.innerHTML = '';
    if (!items.length) {
      emptyEl?.classList.remove('hidden');
      clearBtn?.classList.add('hidden');
      return;
    }
    emptyEl?.classList.add('hidden');
    clearBtn?.classList.remove('hidden');
    items.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'rounded-xl border border-zilo-border bg-zilo-bg/40 p-3';
      const title = document.createElement('p');
      title.className = 'text-sm font-medium text-zilo-text';
      title.textContent = item.title || 'Aviso';
      const body = document.createElement('p');
      body.className = 'text-xs text-zilo-muted mt-0.5';
      body.textContent = item.body || '';
      li.appendChild(title);
      if (item.body) li.appendChild(body);
      if (item.url) {
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'inline-block mt-2 text-xs font-semibold text-zilo-accent';
        a.textContent = 'Abrir';
        li.appendChild(a);
      }
      listEl.appendChild(li);
    });
  }

  clearBtn?.addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch (_) {}
    render();
  });

  render();
})();
</script>

<% if (user?.role === 'client') { %>
  <%- include('../partials/nav-client', { navActive: 'alertas' }) %>
<% } else if (user?.role === 'provider') { %>
  <%- include('../partials/nav-provider', { navActive: 'alertas' }) %>
<% } else if (user?.role === 'tecnico') { %>
  <nav class="fixed bottom-0 inset-x-0 w-full max-w-lg mx-auto nav-client-bar flex safe-bottom z-50" aria-label="Técnico">
    <a href="/tecnico" class="flex-1 flex flex-col items-center gap-0.5 py-2.5 text-[9px] font-medium text-zilo-muted">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
      Inicio
    </a>
    <a href="/tecnico/alertas" class="flex-1 flex flex-col items-center gap-0.5 py-2.5 text-[9px] font-medium nav-client-active">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Alertas
    </a>
  </nav>
<% } %>
<%- include('../partials/footer') %>
