<%
  const alertsHome = typeof alertsBase === 'string' ? alertsBase : (
    user?.role === 'provider' ? '/proveedor' : user?.role === 'tecnico' ? '/tecnico' : '/cliente'
  );
  const items = Array.isArray(alerts) ? alerts : [];
  const actionN = typeof actionCount === 'number' ? actionCount : items.filter((a) => a.urgency === 'high' || a.urgency === 'medium').length;
%>
<%- include('../partials/head') %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col pb-24 zilo-page-enter" id="alertsInboxPage"
  data-role="<%= user?.role || '' %>">

  <%- include('../partials/back-header', {
    backUrl: alertsHome,
    label: 'Bandeja',
    title: 'Alertas',
    showLogout: false
  }) %>

  <main class="flex-1 px-5 py-5 space-y-5">
    <div class="alert-inbox-summary">
      <p class="alert-inbox-summary__label">Pendientes</p>
      <p class="alert-inbox-summary__text">
        <% if (items.length === 0) { %>
          No tienes alertas abiertas ahora.
        <% } else if (actionN > 0) { %>
          <strong><%= actionN %></strong> requieren tu atención<% if (items.length > actionN) { %> · <%= items.length %> en total<% } %>.
        <% } else { %>
          <strong><%= items.length %></strong> aviso<%= items.length === 1 ? '' : 's' %> activos.
        <% } %>
      </p>
    </div>

    <% if (!items.length) { %>
    <div class="alert-inbox-empty" role="status">
      <p class="alert-inbox-empty__title">Todo al día</p>
      <p class="alert-inbox-empty__text">Cuando haya una visita, pago o acción pendiente, aparecerá aquí.</p>
    </div>
    <% } %>

    <% if (items.length) { %>
    <ul class="alert-inbox-list" id="alertsServerList">
      <% items.forEach(function(a) {
        const urgency = a.urgency || 'low';
        const titleRaw = String(a.title || 'Aviso');
        const titleParts = titleRaw.split('·').map(function(s) { return s.trim(); }).filter(Boolean);
        const titleKicker = titleParts.length > 1 ? titleParts[0] : '';
        const titleMain = titleParts.length > 1 ? titleParts.slice(1).join(' · ') : titleRaw;
        const bodyText = a.body ? String(a.body).replace(/_/g, ' ') : '';
      %>
        <li class="alert-inbox-card alert-inbox-card--<%= urgency %>">
          <div class="alert-inbox-card__top">
            <span class="alert-inbox-badge alert-inbox-badge--<%= urgency %>">
              <%= urgency === 'high' ? 'Urgente' : urgency === 'medium' ? 'Atención' : 'En curso' %>
            </span>
          </div>
          <% if (titleKicker) { %>
            <p class="alert-inbox-card__kicker"><%= titleKicker %></p>
          <% } %>
          <h3 class="alert-inbox-card__title"><%= titleMain %></h3>
          <% if (bodyText) { %>
            <p class="alert-inbox-card__body"><%= bodyText %></p>
          <% } %>
          <% if (a.href) { %>
            <a href="<%= a.href %>" class="alert-inbox-card__cta"><%= a.cta || 'Revisar' %></a>
          <% } %>
        </li>
      <% }); %>
    </ul>
    <% } %>

    <details class="alert-inbox-device" id="deviceAlertsSection" <%= items.length ? '' : 'open' %>>
      <summary class="alert-inbox-device__summary">Historial en este dispositivo</summary>
      <p class="text-[11px] text-zilo-muted mb-3 mt-1">Avisos que llegaron por notificación o toast (sin duplicar los de arriba).</p>
      <ul class="alert-inbox-list" id="deviceAlertsList"></ul>
      <p id="deviceAlertsEmpty" class="hidden text-xs text-zilo-muted py-3 text-center">Sin avisos extra en este celular.</p>
      <button type="button" id="clearDeviceAlerts" class="hidden zilo-btn-ghost !text-xs w-full mt-2">Limpiar historial local</button>
    </details>
  </main>
</div>

<script>
(function () {
  const KEY = 'fandez_alert_inbox';
  const listEl = document.getElementById('deviceAlertsList');
  const emptyEl = document.getElementById('deviceAlertsEmpty');
  const clearBtn = document.getElementById('clearDeviceAlerts');
  const deviceSection = document.getElementById('deviceAlertsSection');
  if (!listEl) return;

  function serverHrefs() {
    const set = new Set();
    document.querySelectorAll('#alertsServerList .alert-inbox-card__cta[href]').forEach((a) => {
      try { set.add(new URL(a.href, window.location.origin).pathname + new URL(a.href, window.location.origin).search); } catch (_) {}
    });
    return set;
  }

  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      const items = raw ? JSON.parse(raw) : [];
      return Array.isArray(items) ? items : [];
    } catch (_) {
      return [];
    }
  }

  function render() {
    const known = serverHrefs();
    const items = load()
      .slice(0, 30)
      .filter((item) => {
        if (!item.url || !known.size) return true;
        try {
          const u = new URL(item.url, window.location.origin);
          const key = u.pathname + u.search;
          return !known.has(key);
        } catch (_) {
          return true;
        }
      });
    listEl.innerHTML = '';
    if (!items.length) {
      emptyEl?.classList.remove('hidden');
      clearBtn?.classList.add('hidden');
      if (deviceSection && known.size > 0) deviceSection.classList.add('hidden');
      else deviceSection?.classList.remove('hidden');
      return;
    }
    deviceSection?.classList.remove('hidden');
    emptyEl?.classList.add('hidden');
    clearBtn?.classList.remove('hidden');
    items.forEach((item) => {
      const li = document.createElement('li');
      li.className = 'alert-inbox-card alert-inbox-card--low';
      const titleRaw = String(item.title || 'Aviso');
      const parts = titleRaw.split('·').map((s) => s.trim()).filter(Boolean);
      const kicker = parts.length > 1 ? parts[0] : '';
      const main = parts.length > 1 ? parts.slice(1).join(' · ') : titleRaw;
      const top = document.createElement('div');
      top.className = 'alert-inbox-card__top';
      top.innerHTML = '<span class="alert-inbox-badge alert-inbox-badge--low">Reciente</span>';
      li.appendChild(top);
      if (kicker) {
        const k = document.createElement('p');
        k.className = 'alert-inbox-card__kicker';
        k.textContent = kicker;
        li.appendChild(k);
      }
      const h = document.createElement('h3');
      h.className = 'alert-inbox-card__title';
      h.textContent = main;
      li.appendChild(h);
      const bodyText = item.body ? String(item.body).replace(/_/g, ' ') : '';
      if (bodyText && bodyText !== main) {
        const body = document.createElement('p');
        body.className = 'alert-inbox-card__body';
        body.textContent = bodyText;
        li.appendChild(body);
      }
      if (item.url) {
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'alert-inbox-card__cta';
        a.textContent = 'Abrir';
        li.appendChild(a);
      }
      listEl.appendChild(li);
    });
  }

  clearBtn?.addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch (_) {}
    render();
  });

  render();
})();
</script>

<% if (user?.role === 'client') { %>
  <%- include('../partials/nav-client', { navActive: 'alertas' }) %>
<% } else if (user?.role === 'provider') { %>
  <%- include('../partials/nav-provider', { navActive: 'alertas' }) %>
<% } else if (user?.role === 'tecnico') { %>
  <nav class="fixed bottom-0 inset-x-0 w-full max-w-lg mx-auto nav-client-bar flex safe-bottom z-50" aria-label="Técnico">
    <a href="/tecnico" class="flex-1 flex flex-col items-center gap-0.5 py-2.5 text-[9px] font-medium text-zilo-muted">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
      Inicio
    </a>
    <a href="/tecnico/alertas" class="flex-1 flex flex-col items-center gap-0.5 py-2.5 text-[9px] font-medium nav-client-active">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
      Alertas
    </a>
  </nav>
<% } %>
<%- include('../partials/footer') %>
