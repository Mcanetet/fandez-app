<%- include('partials/head', { bodyClass: 'fandez-error-body' }) %>
<%
  var tt = typeof t !== 'undefined' ? t : function(k) { return k; };
  var errCode = typeof code !== 'undefined' ? code : 404;
  var isLost = errCode === 404;
  var isSystem = errCode >= 500 || errCode === 503;
  var isConnecting = errCode === 503;
  var variant = isLost ? 'lost' : isSystem ? 'system' : 'blocked';
  var prefix = isLost ? 'error.lost' : isSystem ? 'error.system' : 'error.blocked';
  var showCarousel = isLost || isSystem;
  var slogans = showCarousel
    ? [0, 1, 2, 3, 4].map(function(i) { return tt(prefix + '.slogan.' + i); })
    : [];
  var tips = isLost
    ? [0, 1, 2, 3].map(function(i) { return tt('error.lost.tip.' + i); })
    : isSystem
      ? [0, 1, 2, 3].map(function(i) { return tt('error.system.tip.' + i); })
      : [];
  var badge = tt(prefix + '.badge');
  var punchline = tt(prefix + '.punchline');
  var headline = tt(prefix + '.headline');
  var hook = tt(prefix + '.hook');
  var rawRetry = typeof retryPath !== 'undefined' && retryPath ? String(retryPath) : '';
  var retryHref = rawRetry && rawRetry.charAt(0) === '/' && rawRetry.indexOf('//') !== 0 ? rawRetry : '/';
  var homeHref = '/?landing=1';
  var isClient = typeof user !== 'undefined' && user && user.role === 'client';
  var hasSofia = isClient && typeof mod === 'function' && mod('client_aland');
  var sofiaHref = isClient ? '/cliente?aland=1' : '/login';
  var sofiaLabel = tt(isLost ? 'error.lost.cta_sofia' : 'error.system.cta_sofia');
  if (sofiaLabel.indexOf('error.') === 0) sofiaLabel = 'Hablar con Sofía';
%>

<div class="fandez-error-page fandez-error-page--<%= variant %>" data-variant="<%= variant %>" data-code="<%= errCode %>">
  <div class="fandez-error-bg" aria-hidden="true">
    <div class="fandez-error-orb fandez-error-orb--1"></div>
    <div class="fandez-error-orb fandez-error-orb--2"></div>
    <div class="fandez-error-grid"></div>
  </div>

  <header class="fandez-error-header">
    <a href="<%= homeHref %>" class="fandez-error-brand">
      <%- include('partials/logo', { className: 'w-9 h-9', logoId: 'error' }) %>
      <span class="fandez-wordmark text-lg"><%= tt('app.name') %></span>
    </a>
    <% if (typeof locales !== 'undefined') { %>
      <%- include('partials/lang-switcher') %>
    <% } %>
  </header>

  <main class="fandez-error-main zilo-page-enter">
    <div class="fandez-error-code-wrap">
      <span class="fandez-error-code fandez-error-glitch" data-text="<%= errCode %>"><%= errCode %></span>
      <span class="fandez-error-badge"><%= badge %></span>
    </div>

    <% if (showCarousel) { %>
      <p class="fandez-error-headline"><%= headline %></p>
      <div class="fandez-error-slogan-stage" id="errorSloganStage" aria-live="polite">
        <p class="fandez-error-slogan is-active" id="errorSloganText"><%= slogans[0] || (typeof message !== 'undefined' ? message : '') %></p>
      </div>
      <p class="fandez-error-punchline"><%- punchline %></p>
      <p class="fandez-error-hook"><%= hook %></p>

      <% if (tips.length) { %>
      <div class="fandez-error-tips" id="errorTips" aria-label="Fandez">
        <% tips.forEach(function(tip, i) { %>
          <div class="fandez-error-tip <%= i === 0 ? 'is-active' : '' %>" data-tip-index="<%= i %>">
            <span class="fandez-error-tip-dot"></span>
            <span><%= tip %></span>
          </div>
        <% }); %>
      </div>
      <% } %>
    <% } else { %>
      <h1 class="fandez-error-title"><%= typeof title !== 'undefined' ? title : headline %></h1>
      <p class="fandez-error-message"><%= typeof message !== 'undefined' ? message : '' %></p>
      <p class="fandez-error-punchline fandez-error-punchline--compact"><%- punchline %></p>
    <% } %>

    <div class="fandez-error-actions">
      <% if (isSystem) { %>
        <a href="<%= retryHref %>" id="errorRetryBtn" class="zilo-btn-primary fandez-error-btn" data-error-retry><%= tt('error.system.cta_retry') %></a>
        <a href="<%= homeHref %>" class="zilo-btn-ghost fandez-error-btn"><%= tt('error.back_home') %></a>
      <% } else { %>
        <a href="<%= homeHref %>" class="zilo-btn-primary fandez-error-btn"><%= tt('error.back_home') %></a>
      <% } %>
      <% if (isLost || isSystem) { %>
        <% if (hasSofia) { %>
          <button type="button" data-open-aland class="zilo-btn-ghost fandez-error-btn fandez-error-btn--sofia"><%= sofiaLabel %></button>
        <% } else { %>
          <a href="<%= sofiaHref %>" class="zilo-btn-ghost fandez-error-btn fandez-error-btn--sofia"><%= sofiaLabel %></a>
        <% } %>
      <% } %>
      <% if (isLost) { %>
        <a href="/registro" class="fandez-error-link-cta"><%= tt('error.lost.cta_signup') %> →</a>
      <% } %>
      <% if (isConnecting) { %>
        <p class="fandez-error-autoretry" id="errorAutoRetry" data-template="<%= tt('error.system.autoretry') %>" aria-live="polite"><%= tt('error.system.autoretry') %></p>
      <% } %>
    </div>

    <p class="fandez-error-domain">
      <a href="https://fandez.cl" class="fandez-error-domain-link">fandez.cl</a>
      <span>· Santiago, Chile</span>
    </p>
  </main>
</div>

<% if (showCarousel) { %>
<script>
  window.FandezErrorPage = {
    slogans: <%- JSON.stringify(slogans) %>,
    interval: <%= isSystem ? 3200 : 2800 %>,
    autoReloadMs: <%= isConnecting ? 8000 : 0 %>,
    retryPath: <%- JSON.stringify(retryHref) %>
  };
</script>
<% } else { %>
<script>
  window.FandezErrorPage = {
    slogans: [],
    interval: 0,
    autoReloadMs: 0,
    retryPath: <%- JSON.stringify(retryHref) %>
  };
</script>
<% } %>
<% var pageScript = '/js/error-page.js'; %>

<%- include('partials/footer') %>
