<%- include('partials/head') %>
<%
  const firstName = (typeof userName !== 'undefined' && userName)
    ? String(userName).trim().split(/\s+/)[0]
    : '';
  const showWelcome = typeof welcome !== 'undefined' ? welcome : true;
%>

<div class="min-h-screen flex items-center justify-center p-5 relative verify-page">
  <div class="fandez-landing-atmosphere" aria-hidden="true"></div>

  <div class="absolute top-5 right-5 z-20">
    <%- include('partials/lang-switcher') %>
  </div>

  <div class="relative z-10 w-full max-w-md zilo-card-premium rounded-3xl p-6 sm:p-8 zilo-page-enter" data-tour="welcome">
    <% if (showWelcome) { %>
      <div class="text-center mb-5 verify-welcome">
        <div class="verify-welcome__mark mx-auto mb-4" aria-hidden="true">
          <%- include('partials/logo', { className: 'w-14 h-14', logoId: 'verify', logoVariant: 'amber' }) %>
        </div>
        <p class="zilo-label mb-2"><%= t('app.name') %></p>
        <h1 class="zilo-display text-[1.85rem] leading-tight mb-2">
          <%= (typeof pendingLogin !== 'undefined' && pendingLogin)
            ? t('verify.pending_title')
            : (firstName
              ? t('verify.welcome_title_named', { name: firstName })
              : t('verify.welcome_title')) %>
        </h1>
        <p class="text-sm text-zilo-muted leading-relaxed">
          <%= (typeof pendingLogin !== 'undefined' && pendingLogin)
            ? t('verify.pending_body')
            : t('verify.welcome_body') %>
        </p>
      </div>

      <ol class="verify-steps mb-5" aria-label="<%= t('verify.title') %>">
        <li class="verify-step verify-step--done">
          <span class="verify-step__dot" aria-hidden="true"></span>
          <span><%= t('verify.step_account') %></span>
        </li>
        <li class="verify-step verify-step--current">
          <span class="verify-step__dot" aria-hidden="true"></span>
          <span><%= t('verify.step_email') %></span>
        </li>
        <li class="verify-step">
          <span class="verify-step__dot" aria-hidden="true"></span>
          <span><%= t('verify.step_ready') %></span>
        </li>
      </ol>
    <% } else { %>
      <div class="text-center mb-5">
        <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-zilo-accent/10 flex items-center justify-center">
          <svg class="w-7 h-7 text-zilo-accent" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><path d="M22 6l-10 7L2 6"/></svg>
        </div>
        <h1 class="zilo-display text-2xl mb-1"><%= t('verify.title') %></h1>
      </div>
    <% } %>

    <div class="mb-4 p-3 rounded-xl border border-zilo-accent/25 bg-zilo-accent-soft/50 text-center">
      <p class="text-sm font-semibold text-zilo-text"><%= t('verify.inbox_title') %></p>
      <p class="text-xs text-zilo-muted mt-1"><%= t('verify.subtitle') %></p>
      <p class="text-sm font-semibold text-zilo-accent mt-1 break-all"><%= email %></p>
    </div>

    <% if (error) { %>
      <div class="mb-4 p-3 rounded-xl bg-zilo-danger/10 border border-zilo-danger/30 text-zilo-danger text-sm text-center"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="mb-4 p-3 rounded-xl bg-zilo-success/10 border border-zilo-success/30 text-zilo-success text-sm text-center"><%= success %></div>
    <% } %>

    <% if (demoHint) { %>
      <div class="mb-4 p-3 rounded-xl border border-amber-200 bg-amber-50 text-amber-900 text-xs text-center leading-relaxed">
        <%= t('verify.demo_hint') %>
      </div>
    <% } %>

    <form id="verifyEmailForm" action="/verificar-email" method="POST" class="space-y-4" novalidate>
      <div>
        <label class="zilo-label block mb-2.5 text-center" id="otpLabel" for="code"><%= t('verify.code_label') %></label>
        <p class="text-[11px] text-zilo-muted text-center mb-3"><%= t('verify.code_instruction') %></p>
        <div class="verify-otp-wrap">
          <div class="verify-otp" aria-hidden="true">
            <% for (var i = 0; i < 6; i++) { %>
              <span class="verify-otp__digit zilo-input" data-otp-slot="<%= i %>"></span>
            <% } %>
          </div>
          <input
            type="text"
            id="code"
            name="code"
            class="verify-otp__control"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength="6"
            autocomplete="one-time-code"
            enterkeyhint="done"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            required
            aria-labelledby="otpLabel"
            aria-describedby="otpHint"
          >
        </div>
        <p id="otpHint" class="sr-only"><%= t('verify.code_instruction') %></p>
        <p id="otpError" class="hidden mt-2 text-center text-xs text-zilo-danger" role="alert"></p>
      </div>
      <button type="submit" id="verifySubmit" class="zilo-btn-primary"><%= t('verify.submit') %></button>
    </form>

    <div class="mt-4">
      <button type="button" id="btnResend" class="zilo-btn-ghost zilo-btn-block verify-resend-btn !py-2.5 text-sm"
        <%= cooldown > 0 ? 'disabled' : '' %>>
        <span id="resendLabel"><%= t('verify.resend') %></span>
        <span id="resendTimer" aria-live="polite"><%= cooldown > 0 ? ` (${cooldown}s)` : '' %></span>
      </button>
      <p id="codeExpiryHint" class="text-[11px] text-zilo-muted text-center mt-2" aria-live="polite"><%= t('verify.hint') %></p>
      <p class="text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-2 py-1.5 mt-2"><%= t('verify.gmail_hint') %></p>
      <p class="text-[11px] text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-2 py-1.5 mt-2"><%= t('verify.hotmail_hint') %></p>
      <a href="/logout" class="text-xs text-zilo-muted hover:text-zilo-accent block text-center mt-3"><%= t('verify.other_email') %></a>
    </div>

    <details class="mt-6 pt-4 border-t border-zilo-border text-xs text-zilo-muted">
      <summary class="cursor-pointer font-medium text-zilo-text"><%= t('verify.law_title') %></summary>
      <p class="mt-2 leading-relaxed">Al verificar tu correo confirmas que puedes acceder a esta cuenta. Fandez trata tus datos según nuestra <a href="/legal/privacidad" class="text-zilo-accent underline">Política de Privacidad</a>. Puedes ejercer tus derechos ARCO+ escribiendo a <a href="mailto:<%= company.dpoEmail %>" class="text-zilo-accent underline"><%= company.dpoEmail %></a> o en <a href="/legal/mis-datos" class="text-zilo-accent underline">Mis datos personales</a>.</p>
    </details>
  </div>
</div>

<script>
(function () {
  const form = document.getElementById('verifyEmailForm');
  const codeInput = document.getElementById('code');
  const slots = Array.from(document.querySelectorAll('[data-otp-slot]'));
  const otpError = document.getElementById('otpError');
  const submitBtn = document.getElementById('verifySubmit');
  const btn = document.getElementById('btnResend');
  const timerEl = document.getElementById('resendTimer');
  const expiryHint = document.getElementById('codeExpiryHint');
  let cooldown = Number(<%= Number(cooldown || 0) %>) || 0;
  let cooldownTimer = null;
  let expiryTimer = null;
  let codeExpiresAt = <%= codeExpiresAt ? JSON.stringify(codeExpiresAt) : 'null' %>;
  let autoSubmitting = false;
  const messages = {
    incomplete: <%= JSON.stringify(t('verify.error_incomplete')) %>,
    submitting: <%= JSON.stringify(t('verify.submitting')) %>,
    hint: <%= JSON.stringify(t('verify.hint')) %>,
    expiresIn: <%= JSON.stringify(t('verify.expires_in')) %>,
    expired: <%= JSON.stringify(t('verify.expired')) %>
  };

  function normalizeCode(raw) {
    return String(raw || '').replace(/\D/g, '').slice(0, 6);
  }

  function showOtpError(msg) {
    if (!otpError) return;
    if (!msg) {
      otpError.classList.add('hidden');
      otpError.textContent = '';
      return;
    }
    otpError.textContent = msg;
    otpError.classList.remove('hidden');
  }

  function paintSlots(code) {
    slots.forEach((slot, i) => {
      slot.textContent = code[i] || '';
      slot.classList.toggle('is-filled', Boolean(code[i]));
      slot.classList.toggle('is-active', code.length < 6 && i === code.length);
    });
  }

  function setCode(raw, { submitWhenFull = true } = {}) {
    if (!codeInput) return '';
    const code = normalizeCode(raw);
    if (codeInput.value !== code) codeInput.value = code;
    paintSlots(code);
    showOtpError('');
    if (submitWhenFull && code.length === 6 && form && !autoSubmitting) {
      autoSubmitting = true;
      setTimeout(() => {
        if (normalizeCode(codeInput.value).length === 6) form.requestSubmit();
        else autoSubmitting = false;
      }, 40);
    }
    return code;
  }

  codeInput?.addEventListener('input', () => {
    setCode(codeInput.value);
  });

  codeInput?.addEventListener('paste', (e) => {
    e.preventDefault();
    const text = (e.clipboardData || window.clipboardData).getData('text');
    setCode(text);
  });

  codeInput?.addEventListener('beforeinput', (e) => {
    if (!e.data || e.inputType === 'deleteContentBackward') return;
    const incoming = normalizeCode(e.data);
    if (incoming.length <= 1) return;
    e.preventDefault();
    const base = e.inputType === 'insertReplacementText'
      ? ''
      : normalizeCode(codeInput.value);
    setCode(base + incoming);
  });

  form?.addEventListener('submit', (e) => {
    const code = setCode(codeInput?.value || '', { submitWhenFull: false });
    if (!/^\d{6}$/.test(code)) {
      e.preventDefault();
      autoSubmitting = false;
      showOtpError(messages.incomplete);
      codeInput?.focus();
      return;
    }
    if (submitBtn && !submitBtn.dataset.submitting) {
      submitBtn.dataset.submitting = '1';
      submitBtn.disabled = true;
      submitBtn.textContent = messages.submitting;
    }
  });

  function clearCooldownTimer() {
    if (cooldownTimer) {
      clearInterval(cooldownTimer);
      cooldownTimer = null;
    }
  }

  function renderCooldown() {
    if (!btn || !timerEl) return;
    if (cooldown <= 0) {
      clearCooldownTimer();
      btn.disabled = false;
      timerEl.textContent = '';
      return;
    }
    btn.disabled = true;
    timerEl.textContent = ` (${cooldown}s)`;
  }

  function startCooldown(seconds) {
    clearCooldownTimer();
    cooldown = Math.max(0, Number(seconds) || 0);
    renderCooldown();
    if (cooldown <= 0) return;
    cooldownTimer = setInterval(() => {
      cooldown -= 1;
      if (cooldown <= 0) {
        cooldown = 0;
        renderCooldown();
        return;
      }
      renderCooldown();
    }, 1000);
  }

  function formatMmSs(totalSeconds) {
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  function markExpired() {
    if (expiryHint) {
      expiryHint.textContent = messages.expired;
      expiryHint.classList.remove('text-zilo-muted');
      expiryHint.classList.add('text-amber-800', 'font-semibold');
    }
    // Código muerto: permitir pedir otro de inmediato
    startCooldown(0);
    autoSubmitting = false;
    setCode('', { submitWhenFull: false });
  }

  function renderExpiry() {
    if (!expiryHint) return;
    if (!codeExpiresAt) {
      expiryHint.textContent = messages.hint;
      return;
    }
    const msLeft = new Date(codeExpiresAt).getTime() - Date.now();
    if (msLeft <= 0) {
      markExpired();
      if (expiryTimer) {
        clearInterval(expiryTimer);
        expiryTimer = null;
      }
      return;
    }
    const secs = Math.ceil(msLeft / 1000);
    expiryHint.textContent = messages.expiresIn.replace('{time}', formatMmSs(secs));
    expiryHint.classList.add('text-zilo-muted');
    expiryHint.classList.remove('text-amber-800', 'font-semibold');
  }

  function startExpiryWatch(iso) {
    if (expiryTimer) {
      clearInterval(expiryTimer);
      expiryTimer = null;
    }
    codeExpiresAt = iso || null;
    renderExpiry();
    if (!codeExpiresAt) return;
    expiryTimer = setInterval(renderExpiry, 1000);
  }

  startCooldown(cooldown);
  startExpiryWatch(codeExpiresAt);
  paintSlots('');

  btn?.addEventListener('click', async () => {
    if (!btn || btn.disabled) return;
    btn.disabled = true;
    try {
      const res = await fetch('/verificar-email/reenviar', {
        method: 'POST',
        headers: { Accept: 'application/json' }
      });
      const data = await res.json();
      if (!data.success) {
        FandezNotify?.show(data.error || 'No se pudo reenviar', 'warning');
        startCooldown(data.cooldown != null ? data.cooldown : 0);
        return;
      }
      FandezNotify?.show(data.demo
        ? <%= JSON.stringify(t('verify.resend_demo')) %>
        : <%= JSON.stringify(t('verify.resend_ok')) %>, 'success');
      autoSubmitting = false;
      setCode('', { submitWhenFull: false });
      codeInput?.focus();
      startCooldown(data.cooldown != null ? data.cooldown : 60);
      startExpiryWatch(data.expiresAt || null);
      if (expiryHint && data.expiresAt) {
        expiryHint.classList.remove('text-amber-800', 'font-semibold');
      }
    } catch (_) {
      FandezNotify?.show('Error de conexión', 'error');
      btn.disabled = false;
    }
  });

  document.querySelector('.verify-otp-wrap')?.addEventListener('click', () => {
    codeInput?.focus();
  });

  codeInput?.focus();
})();
</script>

<%- include('partials/footer') %>
