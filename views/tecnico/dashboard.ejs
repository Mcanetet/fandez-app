<%- include('../partials/head', { useMap: true }) %>
<%
  const activeJobs = Array.isArray(jobs) ? jobs : [];
  const doneJobs = Array.isArray(completedJobs) ? completedJobs : [];
  const showWall = Boolean(canClaimWall);
  const urgentCount = activeJobs.filter((j) => ['asignado', 'aceptado', 'en_camino', 'en_sitio'].includes(j.techStatus)).length;
  const techVer = (!tecnico.isSelfOperator && tecnico.verification) ? tecnico.verification : {};
  const dossier = (typeof dossierCheck !== 'undefined' && dossierCheck) ? dossierCheck : { ok: true, missing: [] };
  const docsMissing = !tecnico.isSelfOperator && !dossier.ok;
  const docsMissingLabel = (dossier.missing && dossier.missing.length)
    ? dossier.missing.join(', ')
    : 'documentos del expediente';
%>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="tecnicoPage"
  data-tecnico-id="<%= tecnico.id %>"
  data-can-claim-wall="<%= showWall ? '1' : '0' %>"
  data-docs-missing="<%= docsMissing ? '1' : '0' %>">
  <header class="app-session-header sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border">
    <div class="app-session-header__row">
      <div class="app-session-header__identity">
        <div class="app-session-header__avatar"><%= tecnico.avatar %></div>
        <div class="app-session-header__meta">
          <p class="session-role-pill session-role-pill--tecnico"><%= t('session.role.tecnico') %><%= socio ? ' · ' + socio.name : '' %></p>
          <h1><%= tecnico.name %></h1>
        </div>
      </div>
      <div class="app-session-header__end">
        <% if (typeof linkedProvider !== 'undefined' && linkedProvider) { %>
        <button type="button" id="btnBackToProvider" class="zilo-btn-ghost !py-1.5 !px-2.5 !text-[11px] whitespace-nowrap">Socio</button>
        <% } %>
        <%- include('../partials/lang-switcher') %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
    <div class="tech-header-alerts px-3 pb-2.5 space-y-1.5" id="techHeaderAlerts" aria-live="polite">
      <% if (docsMissing) { %>
      <a href="#techDocsSection" class="tech-header-alert tech-header-alert--docs">
        <span class="tech-header-alert__icon" aria-hidden="true">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15h6"/></svg>
        </span>
        <span class="tech-header-alert__text">Falta expediente: <%= docsMissingLabel %></span>
        <span class="tech-header-alert__cta">Subir</span>
      </a>
      <% } %>
      <button type="button" id="techGpsAlert" class="tech-header-alert tech-header-alert--gps" hidden>
        <span class="tech-header-alert__icon" aria-hidden="true">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </span>
        <span class="tech-header-alert__text" data-role="gps-text"><%= t('tecnico.js.enable_gps') %></span>
        <span class="tech-header-alert__cta" data-role="gps-cta">Activar</span>
      </button>
      <div id="techGpsActive" class="tech-header-alert tech-header-alert--gps-on" hidden>
        <span class="tech-header-alert__icon" aria-hidden="true">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </span>
        <span class="tech-header-alert__text">GPS activo · compartiendo ubicación</span>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-10 space-y-3">
    <section class="flex items-center justify-between p-4 rounded-2xl zilo-card-premium" data-tour="tech-online">
      <div class="flex items-center gap-3 min-w-0">
        <div id="techStatusDot" class="w-3 h-3 rounded-full shrink-0 <%= tecnico.online ? 'bg-zilo-success animate-pulse' : 'bg-zilo-muted/40' %>"></div>
        <div class="min-w-0">
          <h2 id="techStatusText" class="font-semibold text-sm"><%= tecnico.online ? t('tecnico.online') : t('tecnico.offline') %></h2>
          <p id="techStatusSub" class="text-xs text-zilo-muted truncate"><%= tecnico.online ? t('tecnico.online_sub') : t('tecnico.offline_sub') %></p>
        </div>
      </div>
      <label class="toggle-ios shrink-0">
        <input type="checkbox" id="techOnlineToggle" <%= tecnico.online ? 'checked' : '' %>>
        <span class="slider"></span>
      </label>
    </section>

    <% if (urgentCount > 0) { %>
      <div class="px-3 py-2.5 rounded-xl border border-amber-200/80 bg-amber-50/90 text-amber-950 text-sm font-semibold leading-snug">
        Tienes <%= urgentCount %> trabajo<%= urgentCount === 1 ? '' : 's' %> por atender
      </div>
    <% } %>

    <%
      function techJobPriority(j) {
        const s = j.techStatus || '';
        if (['en_sitio', 'diagnostico', 'reparando', 'comprando', 'materiales_pendiente', 'presupuesto_pendiente', 'presupuesto_aprobado'].includes(s)) return 100;
        if (s === 'en_camino') return 80;
        if (s === 'aceptado') return 60;
        if (s === 'asignado') {
          const start = Date.parse(j.technicianAssignedAt || '');
          const mins = (typeof requestTimeouts !== 'undefined' ? requestTimeouts.techAcceptMinutes : 10) || 10;
          if (Number.isFinite(start)) {
            const left = start + mins * 60000 - Date.now();
            if (left <= 0) return 55;
            if (left <= 60000) return 50;
          }
          return 40;
        }
        return 10;
      }
      const sortedJobs = activeJobs.slice().sort((a, b) => techJobPriority(b) - techJobPriority(a));
      const heroJob = sortedJobs[0] || null;
      const otherJobs = sortedJobs.slice(1);
    %>

    <!-- 1) Una visita ahora + resto plegado -->
    <section id="sectionActive" data-tour="tech-jobs" class="space-y-3">
      <% if (!heroJob) { %>
        <div class="zilo-empty !py-8 rounded-2xl border border-dashed border-zilo-border zilo-card-premium">
          <p class="text-base font-semibold"><%= t('tecnico.no_jobs') %></p>
          <p class="text-sm text-zilo-muted mt-1"><%= t('tecnico.no_jobs_sub') %></p>
        </div>
      <% } else { %>
        <div id="jobList" class="space-y-3">
          <%- include('../partials/tecnico-job-card', { j: heroJob, isHero: true, techLabels, requestTimeouts, t }) %>
        </div>
        <% if (otherJobs.length) { %>
        <details class="zilo-card-premium rounded-2xl overflow-hidden provider-home-fold" id="sectionOtherJobs">
          <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
            <div class="min-w-0">
              <strong class="text-sm">Otras visitas</strong>
              <p class="text-xs text-zilo-muted mt-0.5">Toca para verlas</p>
            </div>
            <span class="flex items-center gap-2 shrink-0">
              <span class="text-sm font-bold tabular-nums text-amber-700"><%= otherJobs.length %></span>
              <svg class="provider-home-fold__chevron w-4 h-4 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3 tech-list-stack" id="otherJobList">
            <% otherJobs.forEach(function(j) { %>
              <%- include('../partials/tecnico-job-card', { j, isHero: false, techLabels, requestTimeouts, t }) %>
            <% }); %>
          </div>
        </details>
        <% } %>
      <% } %>
    </section>

    <!-- 2) Pedidos hechos · siempre plegado -->
    <details class="zilo-card-premium rounded-2xl overflow-hidden provider-home-fold" id="sectionDone" data-tour="tech-history">
      <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="zilo-label !text-[9px] mb-0.5">Historial</p>
          <strong class="text-sm">Ya terminados</strong>
          <p class="text-[11px] text-zilo-muted mt-0.5">Toca para ver el resumen</p>
        </div>
        <span class="flex items-center gap-2 shrink-0">
          <span class="text-xs font-bold text-zilo-muted tabular-nums"><%= doneJobs.length %></span>
          <svg class="provider-home-fold__chevron w-4 h-4 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </span>
      </summary>
      <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3">
        <% if (!doneJobs.length) { %>
          <p class="text-xs text-zilo-muted py-3 text-center">Aún no hay trabajos cerrados.</p>
        <% } else { %>
          <ul class="tech-list-stack" id="doneJobList">
            <% doneJobs.forEach(j => { %>
              <li class="tech-list-card rounded-xl border border-zilo-border/80 bg-zilo-bg/40">
                <div class="tech-list-card__head">
                  <div class="tech-list-card__body min-w-0">
                    <p class="text-sm font-semibold truncate"><%= j.serviceName %><% if (j.activityName) { %> · <%= j.activityName %><% } %></p>
                    <p class="text-[11px] text-zilo-muted truncate"><%= j.communeName || j.address || '—' %></p>
                  </div>
                  <time class="text-[10px] text-zilo-muted shrink-0 tabular-nums pt-0.5"><%= j.completedAtLabel || '' %></time>
                </div>
                <% if (j.summary) { %>
                  <p class="text-[11px] text-zilo-muted line-clamp-2"><%= j.summary %></p>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </details>

    <!-- 3) Muro (opcional) · plegado si hay asignados -->
    <% if (showWall) { %>
    <details class="zilo-card-premium rounded-2xl overflow-hidden provider-home-fold group" id="sectionWall" data-tour="tech-wall"<%= (!activeJobs.length && tecnico.online) ? ' open' : '' %>>
      <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="zilo-label !text-[9px] mb-0.5">Disponibles</p>
          <strong class="text-sm">Pedidos sin asignación</strong>
          <p class="text-[11px] text-zilo-muted mt-0.5">Muro · tu socio te autorizó a tomarlos</p>
        </div>
        <span class="flex items-center gap-2 shrink-0">
          <span id="techWorkWallCount" class="text-xs font-bold text-zilo-accent tabular-nums">0</span>
          <svg class="provider-home-fold__chevron w-4 h-4 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </span>
      </summary>
      <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3">
        <div id="techWorkWallEmpty" class="zilo-empty !py-6 rounded-xl border border-dashed border-zilo-border">
          <p class="text-sm font-medium"><%= t('tecnico.dashboard.no_requests') %></p>
          <p class="text-xs text-zilo-muted mt-1"><%= t('tecnico.wall_empty_sub') %></p>
        </div>
        <div id="techWorkWallList" class="tech-list-stack"></div>
      </div>
    </details>
    <% } else { %>
    <div class="p-4 rounded-2xl border border-zilo-border bg-zilo-bg/50" data-tour="tech-wall-locked">
      <p class="text-sm font-semibold">Pedidos del muro</p>
      <p class="text-xs text-zilo-muted mt-1">Tu socio no activó “Puede tomar pedidos”. Él te asignará las visitas desde su panel.</p>
    </div>
    <% } %>

    <% if (!tecnico.isSelfOperator) { %>
      <details class="zilo-card-premium rounded-2xl overflow-hidden provider-home-fold" id="techDocsSection"
        data-has-front="<%= techVer.idCardFront ? '1' : '0' %>"
        data-has-back="<%= techVer.idCardBack ? '1' : '0' %>">
        <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="zilo-label !text-[9px] mb-0.5">Expediente</p>
            <strong class="text-sm">Tu carnet</strong>
            <p class="text-[11px] text-zilo-muted mt-0.5">
              <% if (docsMissing) { %>Falta subir frente y/o reverso<% } else { %>Expediente listo<% } %>
            </p>
          </div>
          <span class="flex items-center gap-2 shrink-0">
            <span class="text-[10px] font-semibold <%= docsMissing ? 'text-amber-700' : 'text-zilo-success' %>"><%= docsMissing ? 'Pendiente' : 'OK' %></span>
            <svg class="provider-home-fold__chevron w-4 h-4 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </span>
        </summary>
        <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3 space-y-3">
          <p class="text-xs text-zilo-muted">Solo subes el carnet (frente y reverso). El certificado de antecedentes lo carga tu socio.</p>
          <div class="grid grid-cols-1 gap-4">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <label class="text-xs font-medium" for="techDocFront">Carnet — frente</label>
                <% if (techVer.idCardFront) { %>
                  <a href="/media/technician/<%= tecnico.id %>/doc/idCardFront" target="_blank" rel="noopener" class="text-[10px] text-zilo-accent font-semibold">Ver</a>
                <% } else { %>
                  <span class="text-[10px] text-amber-600">Pendiente</span>
                <% } %>
              </div>
              <input type="file" id="techDocFront" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" data-pick="both" class="block w-full text-xs">
              <button type="button" data-tech-doc="idCardFront" class="mt-2.5 w-full zilo-btn-ghost !py-2.5 !text-xs">Subir frente</button>
            </div>
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <label class="text-xs font-medium" for="techDocBack">Carnet — reverso</label>
                <% if (techVer.idCardBack) { %>
                  <a href="/media/technician/<%= tecnico.id %>/doc/idCardBack" target="_blank" rel="noopener" class="text-[10px] text-zilo-accent font-semibold">Ver</a>
                <% } else { %>
                  <span class="text-[10px] text-amber-600">Pendiente</span>
                <% } %>
              </div>
              <input type="file" id="techDocBack" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" data-pick="both" class="block w-full text-xs">
              <button type="button" data-tech-doc="idCardBack" class="mt-2.5 w-full zilo-btn-ghost !py-2.5 !text-xs">Subir reverso</button>
            </div>
          </div>
        </div>
      </details>
    <% } %>

    <details class="rounded-2xl border border-zilo-border/60 p-4 provider-home-fold">
      <summary class="text-xs font-semibold cursor-pointer text-zilo-muted list-none flex items-center justify-between gap-2">
        <span>Seguridad de la cuenta</span>
        <svg class="provider-home-fold__chevron w-4 h-4 text-zilo-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="mt-3">
        <%- include('../partials/password-form') %>
      </div>
    </details>
  </main>
</div>

<%- include('../partials/guide-modal', {
  role: 'tecnico',
  title: 'Procedimiento de atención Fandez',
  steps: [
    { title: 'Disponibilidad', body: 'Activa el modo en línea para ver trabajos disponibles. Sin estar en línea no recibes pedidos nuevos.', tip: 'Activa notificaciones del navegador (sonido y vibración).' },
    { title: 'Tomar un trabajo', body: 'Revisa dirección, notas y fotos del cliente. El primero que acepta se queda con el servicio.', tip: 'No aceptes si no puedes llegar a tiempo.' },
    { title: 'En el domicilio', body: 'Saluda con tu nombre · Pide permiso de ingreso · Explica lo que ves · Pide aprobación antes de un sobrecosto · Foto al llegar y al terminar · Deja limpio.', tip: 'Usa el checklist en la pantalla de la visita.' },
    { title: 'Estados', body: 'En camino → En la puerta → Confirmar servicio → Diagnóstico → presupuesto si aplica → Trabajo listo. Cada cambio avisa al cliente.', tip: 'Nunca cobres extras sin aprobación en la app.' }
  ],
  extras: [
    { title: 'Sin sesgos', body: 'Trata cada caso por los hechos. No asumas capacidad de pago ni urgencias inventadas.' },
    { title: 'Calidad', body: 'El estándar Fandez es el de un servicio europeo: respeto al hogar, claridad y cierre limpio.' }
  ]
}) %>

<%- include('../partials/onboarding-tour') %>

<%- include('../partials/footer', { pageScript: '/js/tecnico.js', extraScripts: ['/js/image-upload.js'] }) %>
<script src="/js/guide.js"></script>
<script src="/js/map.js"></script>
<script>
(function () {
  document.querySelectorAll('#sectionDone, #techDocsSection, #sectionOtherJobs').forEach(function (el) {
    if (location.hash && el.id && location.hash === '#' + el.id) el.open = true;
    else el.open = false;
  });
})();
</script>
<% if (typeof linkedProvider !== 'undefined' && linkedProvider) { %>
<script>
  document.getElementById('btnBackToProvider')?.addEventListener('click', async () => {
    const res = await fetch('/tecnico/volver-socio', { method: 'POST', headers: { Accept: 'application/json' } });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.success) {
      if (window.FandezNotify) FandezNotify.show(data.error || 'No se pudo volver', 'error');
      return;
    }
    window.location.href = data.redirect || '/proveedor';
  });
</script>
<% } %>
