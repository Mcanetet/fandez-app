<%- include('../partials/head', { useMap: true }) %>
<%
  const activeJobs = Array.isArray(jobs) ? jobs : [];
  const doneJobs = Array.isArray(completedJobs) ? completedJobs : [];
  const showWall = Boolean(canClaimWall);
  const urgentCount = activeJobs.filter((j) => ['asignado', 'aceptado', 'en_camino', 'en_sitio'].includes(j.techStatus)).length;
%>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="tecnicoPage"
  data-tecnico-id="<%= tecnico.id %>"
  data-can-claim-wall="<%= showWall ? '1' : '0' %>">
  <header class="app-session-header sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border">
    <div class="app-session-header__row">
      <div class="app-session-header__identity">
        <div class="app-session-header__avatar"><%= tecnico.avatar %></div>
        <div class="app-session-header__meta">
          <p class="session-role-pill session-role-pill--tecnico"><%= t('session.role.tecnico') %><%= socio ? ' · ' + socio.name : '' %></p>
          <h1><%= tecnico.name %></h1>
        </div>
      </div>
      <div class="app-session-header__end">
        <% if (typeof linkedProvider !== 'undefined' && linkedProvider) { %>
        <button type="button" id="btnBackToProvider" class="zilo-btn-ghost !py-1.5 !px-2.5 !text-[11px] whitespace-nowrap">Socio</button>
        <% } %>
        <%- include('../partials/lang-switcher') %>
        <%- include('../partials/logout-btn', { withLabel: true }) %>
      </div>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-10 space-y-3">
    <section class="flex items-center justify-between p-4 rounded-2xl zilo-card-premium" data-tour="tech-online">
      <div class="flex items-center gap-3 min-w-0">
        <div id="techStatusDot" class="w-3 h-3 rounded-full shrink-0 <%= tecnico.online ? 'bg-zilo-success animate-pulse' : 'bg-zilo-muted/40' %>"></div>
        <div class="min-w-0">
          <h2 id="techStatusText" class="font-semibold text-sm"><%= tecnico.online ? t('tecnico.online') : t('tecnico.offline') %></h2>
          <p id="techStatusSub" class="text-xs text-zilo-muted truncate"><%= tecnico.online ? t('tecnico.online_sub') : t('tecnico.offline_sub') %></p>
        </div>
      </div>
      <label class="toggle-ios shrink-0">
        <input type="checkbox" id="techOnlineToggle" <%= tecnico.online ? 'checked' : '' %>>
        <span class="slider"></span>
      </label>
    </section>

    <% if (urgentCount > 0) { %>
      <div class="px-3 py-2 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-xs font-semibold">
        Tienes <%= urgentCount %> visita<%= urgentCount === 1 ? '' : 's' %> que requieren acción (aceptar, ir o marcar llegada).
      </div>
    <% } %>

    <% if (showWall) { %>
    <details class="zilo-card-premium rounded-2xl overflow-hidden group" id="sectionWall" data-tour="tech-wall" <%= tecnico.online ? 'open' : '' %>>
      <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="zilo-label !text-[9px] mb-0.5">Disponibles</p>
          <strong class="text-sm">Pedidos sin asignación</strong>
          <p class="text-[11px] text-zilo-muted mt-0.5">Muro · tu socio te autorizó a tomarlos</p>
        </div>
        <span id="techWorkWallCount" class="text-xs font-bold text-zilo-accent tabular-nums shrink-0">0</span>
      </summary>
      <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3">
        <div id="techWorkWallEmpty" class="zilo-empty !py-6 rounded-xl border border-dashed border-zilo-border">
          <p class="text-sm font-medium"><%= t('tecnico.dashboard.no_requests') %></p>
          <p class="text-xs text-zilo-muted mt-1"><%= t('tecnico.wall_empty_sub') %></p>
        </div>
        <div id="techWorkWallList" class="space-y-2"></div>
      </div>
    </details>
    <% } else { %>
    <div class="p-4 rounded-2xl border border-zilo-border bg-zilo-bg/50" data-tour="tech-wall-locked">
      <p class="text-sm font-semibold">Pedidos del muro</p>
      <p class="text-xs text-zilo-muted mt-1">Tu socio no activó “Puede tomar pedidos”. Él te asignará las visitas desde su panel.</p>
    </div>
    <% } %>

    <details class="zilo-card-premium rounded-2xl overflow-hidden" id="sectionActive" data-tour="tech-jobs" <%= activeJobs.length ? 'open' : '' %>>
      <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="zilo-label !text-[9px] mb-0.5">Ahora</p>
          <strong class="text-sm"><%= t('tecnico.assigned_title') %></strong>
          <p class="text-[11px] text-zilo-muted mt-0.5">Asignados y en curso · toca para entrar</p>
        </div>
        <span class="text-xs font-bold tabular-nums shrink-0 <%= activeJobs.length ? 'text-amber-700' : 'text-zilo-muted' %>"><%= activeJobs.length %></span>
      </summary>
      <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3">
        <% if (!activeJobs.length) { %>
          <div class="zilo-empty !py-6 rounded-xl border border-dashed border-zilo-border">
            <p class="text-sm font-medium"><%= t('tecnico.no_jobs') %></p>
            <p class="text-xs text-zilo-muted mt-1"><%= t('tecnico.no_jobs_sub') %></p>
          </div>
        <% } else { %>
          <div class="space-y-2" id="jobList">
            <% activeJobs.forEach(j => {
              const needsAction = ['asignado', 'aceptado', 'en_camino', 'en_sitio'].includes(j.techStatus);
              const highlight = needsAction;
            %>
              <div class="p-3.5 rounded-2xl border <%= highlight ? 'border-amber-400/70 bg-amber-50/70 shadow-sm ring-1 ring-amber-300/40' : 'border-zilo-border zilo-card-premium' %>"
                   data-job-id="<%= j.id %>"
                   data-tech-status="<%= j.techStatus %>"
                   data-confirm-status="<%= j.serviceConfirmStatus || '' %>"
                   data-address="<%= encodeURIComponent(j.address || '') %>"
                   data-commune="<%= encodeURIComponent(j.communeName || '') %>"
                   data-assigned-at="<%= j.technicianAssignedAt || '' %>"
                   data-accept-timeout-min="<%= typeof requestTimeouts !== 'undefined' ? requestTimeouts.techAcceptMinutes : 10 %>"
                   <% if (j.coords) { %>data-lat="<%= j.coords.lat %>" data-lng="<%= j.coords.lng %>"<% } %>>
                <div class="flex justify-between items-start gap-2 mb-1.5">
                  <div class="min-w-0">
                    <strong class="text-sm block truncate"><%= j.serviceName %></strong>
                    <span class="text-xs text-zilo-muted block truncate">
                      <% if (j.isGift && j.beneficiaryName) { %><%= t('tecnico.gift') %> · <%= j.beneficiaryName %><% } else { %><%= j.clientName %><% } %>
                    </span>
                  </div>
                  <span class="zilo-badge <%= highlight ? 'zilo-badge-success' : 'zilo-badge-muted' %> shrink-0" data-role="status"><%= techLabels[j.techStatus] || j.techStatus %></span>
                </div>
                <% if (j.techStatus === 'asignado') { %>
                  <p class="text-xs font-semibold text-amber-800 mb-2 tabular-nums" data-role="accept-countdown">Tienes <%= typeof requestTimeouts !== 'undefined' ? requestTimeouts.techAcceptMinutes : 10 %>:00 para aceptar</p>
                <% } %>
                <p class="text-xs text-zilo-text/90 mb-2 flex items-start gap-1.5 font-medium">
                  <svg class="w-3.5 h-3.5 mt-0.5 shrink-0 text-zilo-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span><%= j.address || t('tecnico.no_address') %></span>
                </p>
                <details class="mb-2">
                  <summary class="text-[11px] text-zilo-accent font-semibold cursor-pointer">Ver detalle</summary>
                  <div class="mt-2 space-y-2">
                    <% if (j.notes) { %>
                      <p class="text-xs text-zilo-muted italic p-2.5 rounded-lg bg-white/80 border border-zilo-border"><%= j.notes %></p>
                    <% } %>
                    <% if (j.clientPhotoUrl || j.clientBrandPhotoUrl || j.brandNotVisible) { %>
                      <p class="text-[10px] text-zilo-accent flex items-center gap-1">
                        <%= t('tecnico.client_photo') %><% if (j.brandNotVisible) { %> · <%= t('tecnico.brand_not_visible') %><% } %>
                      </p>
                    <% } %>
                  </div>
                </details>
                <div class="flex gap-2" data-role="actions"></div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </details>

    <details class="zilo-card-premium rounded-2xl overflow-hidden" id="sectionDone" data-tour="tech-history">
      <summary class="px-4 py-3.5 cursor-pointer list-none flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="zilo-label !text-[9px] mb-0.5">Historial</p>
          <strong class="text-sm">Trabajos hechos</strong>
          <p class="text-[11px] text-zilo-muted mt-0.5">Solo resumen · sin fotos pesadas</p>
        </div>
        <span class="text-xs font-bold text-zilo-muted tabular-nums shrink-0"><%= doneJobs.length %></span>
      </summary>
      <div class="px-4 pb-4 border-t border-zilo-border/70 pt-3">
        <% if (!doneJobs.length) { %>
          <p class="text-xs text-zilo-muted py-3 text-center">Aún no hay trabajos cerrados.</p>
        <% } else { %>
          <ul class="space-y-2" id="doneJobList">
            <% doneJobs.forEach(j => { %>
              <li class="p-3 rounded-xl border border-zilo-border/80 bg-zilo-bg/40">
                <div class="flex items-start justify-between gap-2">
                  <div class="min-w-0">
                    <p class="text-sm font-semibold truncate"><%= j.serviceName %><% if (j.activityName) { %> · <%= j.activityName %><% } %></p>
                    <p class="text-[11px] text-zilo-muted truncate"><%= j.communeName || j.address || '—' %></p>
                  </div>
                  <time class="text-[10px] text-zilo-muted shrink-0 tabular-nums"><%= j.completedAtLabel || '' %></time>
                </div>
                <% if (j.summary) { %>
                  <p class="text-[11px] text-zilo-muted mt-1.5 line-clamp-2"><%= j.summary %></p>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </details>

    <details class="rounded-2xl border border-zilo-border/60 p-3.5">
      <summary class="text-xs font-semibold cursor-pointer text-zilo-muted">Seguridad de la cuenta</summary>
      <div class="mt-3">
        <%- include('../partials/password-form') %>
      </div>
    </details>
  </main>
</div>

<%- include('../partials/guide-modal', {
  role: 'tecnico',
  title: 'Procedimiento de atención Fandez',
  steps: [
    { title: 'Disponibilidad', body: 'Activa el modo en línea para ver trabajos disponibles. Sin estar en línea no recibes pedidos nuevos.', tip: 'Activa notificaciones del navegador (sonido y vibración).' },
    { title: 'Tomar un trabajo', body: 'Revisa dirección, notas y fotos del cliente. El primero que acepta se queda con el servicio.', tip: 'No aceptes si no puedes llegar a tiempo.' },
    { title: 'En el domicilio', body: 'Saluda con tu nombre · Pide permiso de ingreso · Explica lo que ves · Pide aprobación antes de un sobrecosto · Foto al llegar y al terminar · Deja limpio.', tip: 'Usa el checklist en la pantalla de la visita.' },
    { title: 'Estados', body: 'En camino → En la puerta → Confirmar servicio → Diagnóstico → presupuesto si aplica → Trabajo listo. Cada cambio avisa al cliente.', tip: 'Nunca cobres extras sin aprobación en la app.' }
  ],
  extras: [
    { title: 'Sin sesgos', body: 'Trata cada caso por los hechos. No asumas capacidad de pago ni urgencias inventadas.' },
    { title: 'Calidad', body: 'El estándar Fandez es el de un servicio europeo: respeto al hogar, claridad y cierre limpio.' }
  ]
}) %>

<%- include('../partials/onboarding-tour') %>

<%- include('../partials/footer', { pageScript: '/js/tecnico.js' }) %>
<script src="/js/guide.js"></script>
<script src="/js/map.js"></script>
<% if (typeof linkedProvider !== 'undefined' && linkedProvider) { %>
<script>
  document.getElementById('btnBackToProvider')?.addEventListener('click', async () => {
    const res = await fetch('/tecnico/volver-socio', { method: 'POST', headers: { Accept: 'application/json' } });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.success) {
      if (window.FandezNotify) FandezNotify.show(data.error || 'No se pudo volver', 'error');
      return;
    }
    window.location.href = data.redirect || '/proveedor';
  });
</script>
<% } %>
