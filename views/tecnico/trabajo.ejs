<%- include('../partials/head') %>
<% const isObserver = typeof observerMode !== 'undefined' && observerMode; %>
<% const chatBase = typeof chatApiBase !== 'undefined' ? chatApiBase : '/tecnico'; %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="trabajoPage"
  data-request-id="<%= request.id %>"
  data-tech-status="<%= request.techStatus %>"
  data-return-url="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/tecnico' %>"
  data-observer="<%= isObserver ? '1' : '0' %>"
  data-chat-base="<%= chatBase %>"
  data-dest-lat="<%= request.coords && request.coords.lat != null ? request.coords.lat : '' %>"
  data-dest-lng="<%= request.coords && request.coords.lng != null ? request.coords.lng : '' %>">

  <header class="sticky top-0 z-50 bg-zilo-bg/90 backdrop-blur-xl border-b border-zilo-border px-5 py-4">
    <div class="flex items-center gap-3">
      <a href="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/tecnico' %>" class="zilo-icon-btn" title="Volver">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      <div class="min-w-0 flex-1">
        <p class="zilo-label !text-[9px]"><%= isObserver ? 'Vista del socio' : 'Visita en terreno' %></p>
        <h1 class="text-base font-semibold truncate"><%= request.serviceName %></h1>
      </div>
      <button type="button" id="btnOpenFieldChat" class="zilo-icon-btn !text-zilo-accent" title="Chat con el cliente" aria-label="Chat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
      </button>
    </div>
  </header>

  <main class="flex-1 px-5 py-5 pb-28 space-y-4">
    <% if (isObserver) { %>
      <div class="p-3 rounded-2xl border border-zilo-accent/25 bg-zilo-accent/5">
        <p class="text-sm font-semibold text-zilo-accent">Modo supervisión</p>
        <p class="text-xs text-zilo-muted mt-0.5">Ves lo mismo que el técnico en terreno. Puedes chatear con el cliente como <strong>Socio Fundez</strong>. Las acciones de visita las ejecuta el técnico.</p>
        <% if (request.technicianName) { %>
          <p class="text-[11px] text-zilo-muted mt-2">Técnico asignado: <strong><%= request.technicianName %></strong></p>
        <% } else { %>
          <p class="text-[11px] text-amber-700 mt-2">Aún sin técnico asignado.</p>
        <% } %>
      </div>
    <% } %>

    <%
      const budgetWaiting = request.techStatus === 'presupuesto_pendiente'
        && request.siteReport && ['pending','payment_pending'].includes(request.siteReport.budgetStatus);
      const budgetForm = request.techStatus === 'presupuesto_pendiente' && !budgetWaiting;
      let wizardStep = 'trayecto';
      if (request.techStatus === 'aceptado' && request.serviceConfirmStatus === 'pending') wizardStep = 'confirmar';
      else if (request.serviceConfirmStatus === 'change_pending'
        || (request.siteReport && request.siteReport.activityChange && ['pending','payment_pending'].includes(request.siteReport.activityChange.status)
          && ['aceptado','en_camino'].includes(request.techStatus))) wizardStep = 'cambio';
      else if (['aceptado','en_camino'].includes(request.techStatus)) wizardStep = 'trayecto';
      else if (request.techStatus === 'en_sitio') wizardStep = 'llegada';
      else if (request.techStatus === 'diagnostico') wizardStep = 'accion';
      else if (budgetForm) wizardStep = 'presupuesto';
      else if (budgetWaiting) wizardStep = 'espera';
      else if (request.techStatus === 'comprando') wizardStep = 'materiales';
      else if (['reparando','presupuesto_aprobado'].includes(request.techStatus)) wizardStep = 'cierre';
      else if (request.techStatus === 'completado') wizardStep = 'done';
      const wizardOrder = ['confirmar','trayecto','llegada','accion','presupuesto','espera','materiales','cierre','done'];
      const wizardIdx = Math.max(0, wizardOrder.indexOf(wizardStep === 'cambio' ? 'accion' : wizardStep));
      const wizardSteps = [
        { id: 'confirmar', label: 'Confirmar' },
        { id: 'trayecto', label: 'Trayecto' },
        { id: 'llegada', label: 'Llegada' },
        { id: 'accion', label: 'Decisión' },
        { id: 'materiales', label: 'Materiales' },
        { id: 'cierre', label: 'Cierre' }
      ];
    %>

    <nav class="field-wizard" id="fieldWizard" aria-label="Progreso de la visita"
      data-step="<%= wizardStep %>"
      data-tech-status="<%= request.techStatus %>"
      data-confirm-status="<%= request.serviceConfirmStatus || '' %>">
      <p class="zilo-label mb-2">Un paso a la vez</p>
      <ol class="field-wizard-track">
        <% wizardSteps.forEach(function(s) {
          const si = wizardOrder.indexOf(s.id);
          let state = 'upcoming';
          if (si < wizardIdx && si >= 0) state = 'done';
          else if (s.id === wizardStep || ((wizardStep === 'presupuesto' || wizardStep === 'espera') && s.id === 'accion')) state = 'active';
        %>
          <li class="field-wizard-step is-<%= state %>" data-wizard="<%= s.id %>">
            <span class="field-wizard-dot" aria-hidden="true"></span>
            <span class="field-wizard-label"><%= s.label %></span>
          </li>
        <% }); %>
      </ol>
    </nav>

    <details class="zilo-card-premium rounded-2xl overflow-hidden" id="fieldContext"<%= ['aceptado','en_camino'].includes(request.techStatus) || wizardStep === 'confirmar' ? ' open' : '' %>>
      <summary class="px-4 py-3 cursor-pointer list-none flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="zilo-label !text-[9px]">Cliente y mapa</p>
          <strong class="text-sm block truncate"><% if (request.isGift) { %>Regalo · <%= request.beneficiaryName %><% } else { %><%= request.clientName %><% } %></strong>
          <span class="text-xs text-zilo-muted truncate block"><%= request.address %></span>
        </div>
        <span class="zilo-badge zilo-badge-muted shrink-0" id="statusBadge"><%= techLabels[request.techStatus] || request.techStatus %></span>
      </summary>
      <div class="px-4 pb-4 space-y-3 border-t border-zilo-border pt-3">
        <div>
          <div class="flex items-center justify-between mb-2">
            <p class="zilo-label !text-[9px]">Ubicación en vivo</p>
            <span id="fieldLiveBadge" class="text-[10px] text-zilo-muted">Esperando GPS…</span>
          </div>
          <div id="fieldMap" class="w-full h-40 rounded-xl overflow-hidden border border-zilo-border bg-zilo-bg"></div>
        </div>
        <% if (request.notes) { %>
          <p class="text-xs text-zilo-muted italic p-2.5 rounded-lg bg-zilo-bg/80 border border-zilo-border"><%= request.notes %></p>
        <% } %>
        <% if (request.clientPhotoUrl || request.clientBrandPhotoUrl || request.brandNotVisible) { %>
          <div class="space-y-3">
            <% if (request.clientPhotoUrl) { %>
              <div>
                <p class="zilo-label mb-1.5">Foto del problema</p>
                <a href="<%= request.clientPhotoUrl %>" target="_blank" rel="noopener">
                  <img src="<%= request.clientPhotoUrl %>" alt="Foto del problema" class="w-full max-h-36 object-cover rounded-xl border border-zilo-border">
                </a>
              </div>
            <% } %>
            <% if (request.clientBrandPhotoUrl) { %>
              <div>
                <p class="zilo-label mb-1.5">Foto de la marca</p>
                <a href="<%= request.clientBrandPhotoUrl %>" target="_blank" rel="noopener">
                  <img src="<%= request.clientBrandPhotoUrl %>" alt="Foto de la marca" class="w-full max-h-36 object-cover rounded-xl border border-zilo-border">
                </a>
              </div>
            <% } else if (request.brandNotVisible) { %>
              <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">Sin marca a la vista — el cliente no pudo fotografiar etiqueta ni logo.</p>
            <% } %>
          </div>
        <% } %>
      </div>
    </details>

    <section id="stepConfirmarServicio" data-wizard-panel="confirmar" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'confirmar' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Antes de ir</p>
      <h2 class="text-sm font-semibold mb-1">Confirma el servicio pedido</h2>
      <p class="text-xs text-zilo-muted mb-3">
        Solicitado: <strong><%= request.activityName || request.serviceName %></strong>.
        Debes confirmar que es el mismo trabajo o proponer un cambio para que el cliente apruebe.
      </p>
      <div class="space-y-2">
        <button type="button" id="btnConfirmServiceSame" class="w-full py-3 rounded-xl zilo-btn-primary">Es el mismo servicio</button>
        <button type="button" id="btnShowServiceChange" class="w-full py-3 rounded-xl zilo-btn-ghost">Proponer modificación</button>
      </div>
    </section>

    <section id="stepTrayecto" data-wizard-panel="trayecto" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'trayecto' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Trayecto</p>
      <h2 class="text-sm font-semibold mb-2"><%= request.techStatus === 'aceptado' ? '¿Listo para ir al domicilio?' : 'Confirma al llegar' %></h2>
      <p class="text-xs text-zilo-muted mb-3"><%= request.techStatus === 'aceptado' ? 'El cliente verá que vas en camino y tu ubicación en vivo.' : 'Confirma únicamente cuando estés en el lugar.' %></p>
      <% if (request.coords && request.coords.lat != null && request.techStatus === 'aceptado') { %>
        <a href="https://www.google.com/maps/dir/?api=1&destination=<%= request.coords.lat %>,<%= request.coords.lng %>"
          target="_blank" rel="noopener"
          class="block w-full mb-2 py-3 rounded-xl zilo-btn-ghost text-center !text-sm">Abrir en Google Maps</a>
      <% } %>
      <button type="button" id="btnTrayecto" data-next-status="<%= request.techStatus === 'aceptado' ? 'en_camino' : 'en_sitio' %>"
        class="w-full py-3 rounded-xl zilo-btn-primary"><%= request.techStatus === 'aceptado' ? 'Iniciar viaje' : 'Ya llegué' %></button>
    </section>

    <!-- Paso 1: Llegada -->
    <section id="stepLlegada" data-wizard-panel="llegada" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'llegada' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Ahora · Llegada</p>
      <h2 class="text-sm font-semibold mb-3">Registra lo que observas</h2>
      <div class="space-y-3">
        <div>
          <label class="text-xs text-zilo-muted">Diagnóstico y observaciones *</label>
          <textarea id="diagnosis" rows="4" class="zilo-input w-full mt-1 resize-none" placeholder="Describe el problema, estado del equipo, lo que necesitas..."></textarea>
        </div>
        <div>
          <label class="text-xs text-zilo-muted">Foto inicial de la visita *</label>
          <input type="file" id="photoStart" accept="image/*" capture="environment" class="mt-1 block w-full text-xs text-zilo-muted file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent file:text-xs file:font-medium">
          <div id="photoStartPreview" class="hidden mt-2">
            <img src="" alt="Vista previa" class="w-full max-h-36 object-cover rounded-xl border border-zilo-border">
          </div>
        </div>
        <button type="button" id="btnLlegada" class="w-full py-3 rounded-xl zilo-btn-primary">Confirmar llegada</button>
      </div>
    </section>

    <div id="fieldExtraActions" class="<%= ['en_sitio','diagnostico','reparando','comprando','presupuesto_pendiente','presupuesto_aprobado'].includes(request.techStatus) || request.serviceConfirmStatus === 'change_pending' || request.serviceConfirmStatus === 'pending' ? '' : 'hidden' %>">
      <button type="button" id="btnToggleServiceChange" class="w-full py-2.5 rounded-xl border border-dashed border-zilo-border text-xs font-semibold text-zilo-muted hover:text-zilo-accent hover:border-zilo-accent/40 transition">
        ¿El trabajo es distinto? Proponer cambio
      </button>
    </div>

    <!-- Cambio de subservicio: secundario, no bloquea el paso activo -->
    <section id="stepCambioServicio" data-wizard-panel="cambio" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'cambio' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">¿El trabajo es distinto?</p>
      <h2 class="text-sm font-semibold mb-1">Proponer cambio de subservicio</h2>
      <p class="text-xs text-zilo-muted mb-3">
        Solicitado: <strong><%= request.activityName || '—' %></strong>.
        Si es otra cosa, elige el subservicio correcto o <strong>Otro</strong> (nombre y precio manual), sube foto y explica. El cliente debe aprobar.
      </p>
      <% if (request.siteReport && request.siteReport.activityChange && ['pending','payment_pending'].includes(request.siteReport.activityChange.status)) { %>
        <p class="text-sm text-amber-700 bg-amber-50 border border-amber-200 rounded-xl p-3"><%= request.siteReport.activityChange.status === 'payment_pending' ? 'Cambio aprobado; esperando el pago del cliente' : 'Cambio pendiente de aprobación del cliente' %>: <%= request.siteReport.activityChange.toActivityName %></p>
      <% } else { %>
        <div class="space-y-3">
          <div>
            <label class="text-xs text-zilo-muted">Nuevo subservicio *</label>
            <select id="changeActivityId" class="zilo-input w-full mt-1">
              <option value="">Cargando…</option>
            </select>
          </div>
          <div id="changeOtherFields" class="hidden space-y-3 p-3 rounded-xl border border-zilo-border bg-zilo-surface/40">
            <p class="text-xs text-zilo-muted">Describe el servicio real. El cliente debe validarlo.</p>
            <div>
              <label class="text-xs text-zilo-muted">Nombre del servicio *</label>
              <input type="text" id="changeCustomName" class="zilo-input w-full mt-1" maxlength="120" placeholder="Ej: Instalación de flapper + ajuste de estanque">
            </div>
            <div>
              <label class="text-xs text-zilo-muted">Precio base del trabajo (CLP) *</label>
              <input type="number" id="changeCustomBasePrice" class="zilo-input w-full mt-1" min="100000" step="1000" placeholder="100000">
              <p class="text-[11px] text-zilo-muted mt-1">Mín. $100.000. Luego se aplican horario y urgencia.</p>
            </div>
          </div>
          <div>
            <label class="text-xs text-zilo-muted">Explicación *</label>
            <textarea id="changeNotes" rows="2" class="zilo-input w-full mt-1 resize-none" placeholder="Ej: Era cambio de sanitario, no solo la llave"></textarea>
          </div>
          <div>
            <label class="text-xs text-zilo-muted">Foto que respalda el cambio *</label>
            <input type="file" id="changePhoto" accept="image/*" capture="environment" class="block w-full text-xs mt-1">
          </div>
          <button type="button" id="btnProposeChange" class="w-full py-3 rounded-xl zilo-btn-ghost">Enviar cambio al cliente</button>
        </div>
      <% } %>
    </section>

    <!-- Paso 2: Acción -->
    <section id="stepAccion" data-wizard-panel="accion" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'accion' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Ahora · Decisión</p>
      <h2 class="text-sm font-semibold mb-3">¿Qué harás ahora?</h2>
      <div class="grid gap-2">
        <button type="button" class="action-btn py-3 px-4 rounded-xl zilo-btn-primary !text-sm text-left" data-action="reparar">
          <strong class="block">Reparar ahora</strong>
          <span class="text-xs opacity-80">Tienes lo necesario para resolver</span>
        </button>
        <button type="button" class="action-btn py-3 px-4 rounded-xl zilo-btn-ghost !text-sm text-left" data-action="comprar">
          <strong class="block">Ir a comprar materiales</strong>
          <span class="text-xs text-zilo-muted">Necesitas repuestos o insumos</span>
        </button>
        <button type="button" class="action-btn py-3 px-4 rounded-xl zilo-btn-ghost !text-sm text-left" data-action="presupuesto">
          <strong class="block">Generar presupuesto</strong>
          <span class="text-xs text-zilo-muted">El trabajo es muy costoso, requiere aprobación</span>
        </button>
      </div>
    </section>

    <!-- Paso 2b: Presupuesto -->
    <section id="stepPresupuesto" data-wizard-panel="presupuesto" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'presupuesto' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Presupuesto</p>
      <div class="space-y-3">
        <div>
          <label class="text-xs text-zilo-muted">Total de visita + servicio (sin materiales) *</label>
          <input type="number" id="budgetAmount" min="1000" step="1000" class="zilo-input w-full mt-1" placeholder="Ej: 150000">
          <p class="text-[11px] text-zilo-muted mt-1">Los materiales se registran aparte y se suman a costo, sin comisión.</p>
        </div>
        <div>
          <label class="text-xs text-zilo-muted">Detalle del presupuesto *</label>
          <textarea id="budgetDesc" rows="3" class="zilo-input w-full mt-1 resize-none" placeholder="Trabajo a realizar, mano de obra y tiempo estimado..."></textarea>
        </div>
        <button type="button" id="btnPresupuesto" class="w-full py-3 rounded-xl zilo-btn-primary">Enviar presupuesto al cliente</button>
      </div>
    </section>

    <!-- Esperando cliente -->
    <section id="stepEsperaPresupuesto" data-wizard-panel="espera" class="zilo-card-premium rounded-2xl p-5 text-center field-step <%= wizardStep === 'espera' ? '' : 'hidden' %>">
      <p class="zilo-display text-lg mb-2"><%= request.siteReport && request.siteReport.budgetStatus === 'payment_pending' ? 'Esperando el pago' : 'Esperando al cliente' %></p>
      <p class="text-sm text-zilo-muted">Presupuesto de <strong class="text-zilo-accent"><%= request.siteReport ? formatCLP(request.siteReport.budgetAmount) : '' %></strong> enviado. <%= request.siteReport && request.siteReport.budgetStatus === 'payment_pending' ? 'El cliente lo aprobó; te avisaremos cuando pague.' : 'Te avisaremos cuando responda.' %></p>
      <% if (request.siteReport && request.siteReport.budgetDescription) { %>
        <p class="text-xs text-zilo-muted mt-3 p-3 rounded-lg bg-zilo-bg/80 border border-zilo-border text-left"><%= request.siteReport.budgetDescription %></p>
      <% } %>
    </section>

    <!-- Materiales: catálogo + boleta (compra) o stock -->
    <section id="stepMateriales" data-wizard-panel="materiales" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'materiales' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Materiales</p>
      <h2 class="text-sm font-semibold mb-1">Lo que usaste o compraste</h2>
      <p class="text-xs text-zilo-muted mb-3">Elige del catálogo (precio de mercado) o escribe uno. Si saliste a comprar, sube la boleta. Si lo llevabas, se cobra el precio de lista al cliente.</p>
      <div id="materialsList" class="space-y-2 mb-3">
        <% if (request.siteReport && request.siteReport.materials && request.siteReport.materials.length) { %>
          <% request.siteReport.materials.forEach(m => { %>
            <div class="p-3 rounded-xl bg-zilo-bg/80 border border-zilo-border text-sm">
              <div class="flex justify-between items-center gap-2">
                <span>
                  <%= m.description %>
                  <% if (m.source === 'stock') { %><span class="text-[10px] text-zilo-muted"> · stock</span><% } %>
                  <% if (m.source === 'purchased') { %><span class="text-[10px] text-zilo-muted"> · compra</span><% } %>
                </span>
                <strong class="text-zilo-accent shrink-0"><%= formatCLP(m.amount) %></strong>
              </div>
              <% if (m.reviewStatus) { %>
                <p class="text-[10px] mt-1 <%= m.reviewStatus === 'approved' ? 'text-emerald-600' : (m.reviewStatus === 'rejected' ? 'text-red-600' : 'text-amber-600') %>">
                  <%= m.reviewStatus === 'approved' ? 'OK' : (m.reviewStatus === 'rejected' ? 'Rechazada' : 'Revisión pendiente') %>
                  <% if (m.reviewReason) { %> · <%= m.reviewReason %><% } %>
                </p>
              <% } %>
            </div>
          <% }); %>
        <% } else { %>
          <p class="text-xs text-zilo-muted">Aún no hay materiales en esta visita.</p>
        <% } %>
      </div>
      <div class="space-y-2 border-t border-zilo-border pt-3">
        <div class="grid grid-cols-2 gap-2">
          <label class="zilo-choice-card zilo-choice-card--compact !min-h-0 !py-2.5 cursor-pointer">
            <input type="radio" name="matSource" value="stock" class="sr-only" checked>
            <span class="zilo-choice-title">Lo traje / stock</span>
            <span class="zilo-choice-desc">Precio de lista</span>
          </label>
          <label class="zilo-choice-card zilo-choice-card--compact !min-h-0 !py-2.5 cursor-pointer">
            <input type="radio" name="matSource" value="purchased" class="sr-only">
            <span class="zilo-choice-title">Salí a comprar</span>
            <span class="zilo-choice-desc">Con boleta</span>
          </label>
        </div>
        <div>
          <label class="text-xs text-zilo-muted">Catálogo recurrente</label>
          <select id="matCatalog" class="zilo-input w-full mt-1 !py-2 text-sm">
            <option value="">Otro / escribir manualmente…</option>
            <% (typeof materialsCatalog !== 'undefined' ? materialsCatalog : []).forEach(function(m) { %>
              <option value="<%= m.id %>" data-price="<%= m.marketPrice %>" data-unit="<%= m.unit %>" data-name="<%= m.name %>">
                <%= m.name %> — <%= formatCLP(m.marketPrice) %>/<%= m.unit %>
              </option>
            <% }); %>
          </select>
        </div>
        <input type="text" id="matDesc" class="zilo-input w-full !py-2 text-sm" placeholder="Nombre del material" autocomplete="off">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-xs text-zilo-muted">Cantidad</label>
            <input type="number" id="matQty" class="zilo-input w-full !py-2 text-sm" value="1" min="1" max="50">
          </div>
          <div>
            <label class="text-xs text-zilo-muted">Total CLP</label>
            <input type="number" id="matAmount" class="zilo-input w-full !py-2 text-sm" placeholder="Precio" min="100">
          </div>
        </div>
        <div id="matReceiptWrap" class="hidden">
          <label class="text-xs text-zilo-muted block">Boleta / factura *</label>
          <input type="file" id="matReceipt" accept="image/*,application/pdf" class="block w-full text-xs text-zilo-muted file:mr-2 file:py-1.5 file:px-2 file:rounded file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent">
          <p class="text-[11px] text-zilo-muted mt-1">Obligatorio si compraste el material. La IA verifica monto y legibilidad.</p>
        </div>
        <p id="matStockHint" class="text-[11px] text-zilo-muted">Sin boleta: se usa el precio de mercado del catálogo y se cobra al cliente a costo.</p>
        <button type="button" id="btnAddMaterial" class="w-full py-2.5 rounded-xl zilo-btn-ghost !text-sm">+ Agregar material</button>
        <button type="button" id="btnGoToCierre" class="w-full py-3 rounded-xl zilo-btn-primary !text-sm mt-1">Listo · Continuar al cierre</button>
      </div>
    </section>

    <section id="stepCierre" data-wizard-panel="cierre" class="zilo-card-premium rounded-2xl p-5 field-step <%= wizardStep === 'cierre' ? '' : 'hidden' %>">
      <p class="zilo-label mb-1">Ahora · Cierre</p>
      <h2 class="text-sm font-semibold mb-3">Resumen de la visita</h2>
      <div class="space-y-3">
        <details id="attentionChecklistBox" class="rounded-xl border border-zilo-border bg-zilo-bg/60 p-3" open>
          <summary class="text-sm font-semibold cursor-pointer text-zilo-accent">Procedimiento de atención Fundez</summary>
          <p class="text-[11px] text-zilo-muted mt-2 mb-2">Marca lo realizado. No bloquea el cierre, pero si faltan ítems te avisaremos.</p>
          <div class="space-y-2" id="attentionChecklist">
            <% (typeof attentionChecklist !== 'undefined' ? attentionChecklist : []).forEach(function(item) { %>
            <label class="flex items-start gap-2 text-xs text-zilo-text">
              <input type="checkbox" class="mt-0.5 accent-zilo-accent" data-checklist-id="<%= item.id %>">
              <span><%= item.label %></span>
            </label>
            <% }); %>
          </div>
        </details>
        <div>
          <label class="text-xs text-zilo-muted">Trabajo realizado *</label>
          <textarea id="workNotes" rows="4" class="zilo-input w-full mt-1 resize-none" placeholder="Qué hiciste, qué quedó funcionando, recomendaciones..."></textarea>
        </div>
        <div>
          <label class="text-xs text-zilo-muted">Foto final de la visita *</label>
          <input type="file" id="photoEnd" accept="image/*" capture="environment" class="mt-1 block w-full text-xs text-zilo-muted file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-zilo-accent/10 file:text-zilo-accent file:text-xs file:font-medium">
          <div id="photoEndPreview" class="hidden mt-2">
            <img src="" alt="Vista previa" class="w-full max-h-36 object-cover rounded-xl border border-zilo-border">
          </div>
        </div>
        <button type="button" id="btnBackToMaterials" class="<%= request.techStatus === 'comprando' || request.techStatus === 'reparando' || request.techStatus === 'presupuesto_aprobado' ? '' : 'hidden' %> w-full py-2.5 rounded-xl zilo-btn-ghost !text-xs">Volver a materiales</button>
        <button type="button" id="btnCompletar" class="w-full py-3 rounded-xl zilo-btn-primary">Completar visita</button>
      </div>
    </section>

    <!-- Liquidación final: total cobrado y desglose con porcentajes -->
    <section id="settlementResult" class="zilo-card-premium rounded-2xl p-5 hidden">
      <p class="zilo-label mb-1">Visita completada</p>
      <h2 class="text-sm font-semibold mb-3">Liquidación del servicio</h2>
      <div class="space-y-1.5 text-sm">
        <div class="flex justify-between">
          <span class="text-zilo-muted">Total cobrado al cliente</span>
          <strong id="setCharged">—</strong>
        </div>
        <div class="flex justify-between text-zilo-muted">
          <span id="setCardLabel">Tarjeta y administración 5%</span>
          <span id="setCard">—</span>
        </div>
        <div class="flex justify-between text-zilo-muted">
          <span id="setAppLabel">Fee aplicación 20%</span>
          <span id="setApp">—</span>
        </div>
        <div class="flex justify-between text-zilo-success" id="setMaterialsKeepRow">
          <span>Materiales (100% tuyos)</span>
          <span id="setMaterialsKeep">—</span>
        </div>
        <div class="flex justify-between text-zilo-muted hidden" id="setMaterialsRow">
          <span>Comisión materiales</span>
          <span id="setMaterials">—</span>
        </div>
        <div class="flex justify-between text-zilo-muted">
          <span id="setIvaLabel">IVA sobre comisión/cargos</span>
          <span id="setIva">—</span>
        </div>
        <div class="flex justify-between pt-2 mt-1 border-t border-zilo-border">
          <span class="font-medium">Tu neto</span>
          <strong class="text-zilo-success" id="setPayout">—</strong>
        </div>
        <p class="text-[11px] text-zilo-muted/80 mt-1">Del cobro de mano de obra: 5% tarjeta/admin y 20% fee app son de Fundez; el resto es tuyo. Los materiales no entran en ese porcentaje.</p>
      </div>
      <a href="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/tecnico' %>" class="mt-4 block w-full text-center py-3 rounded-xl zilo-btn-primary">Volver al panel</a>
    </section>
  </main>

  <div class="fixed bottom-0 inset-x-0 z-40 pointer-events-none">
    <div class="max-w-lg mx-auto px-5 pb-5 pointer-events-auto">
      <button type="button" id="btnOpenFieldChatFab" class="w-full py-3.5 rounded-2xl zilo-btn-primary shadow-lg flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        Mensajes con el cliente
      </button>
    </div>
  </div>
</div>

<div id="jobChatModal" class="fixed inset-0 z-[80] hidden">
  <div class="absolute inset-0 bg-black/40" data-role="chat-backdrop"></div>
  <div class="job-chat-sheet absolute inset-x-0 bottom-0 max-w-lg mx-auto rounded-t-3xl border border-zilo-border shadow-xl flex flex-col" style="max-height: 85vh;">
    <div class="flex items-center justify-between px-5 py-4 border-b border-zilo-border bg-white rounded-t-3xl">
      <div>
        <p class="zilo-label !text-[9px]">Chat del servicio</p>
        <h2 id="jobChatTitle" class="text-sm font-semibold text-zilo-text">Cliente</h2>
        <p id="jobChatYouAre" class="text-[10px] text-zilo-muted mt-0.5">Escribes como <%= isObserver ? 'Socio' : 'Técnico' %></p>
      </div>
      <button type="button" class="zilo-icon-btn" data-role="chat-close" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div id="jobChatThread" class="job-chat-thread flex-1 overflow-y-auto px-4 py-4 space-y-2.5 min-h-[220px]"></div>
    <form id="jobChatForm" class="job-chat-composer">
      <label class="job-chat-composer__label" for="jobChatInput">Tu mensaje</label>
      <div class="job-chat-composer__row">
        <input id="jobChatInput" type="text" maxlength="1000" autocomplete="off" placeholder="Escribe aquí para el cliente…" class="job-chat-input">
        <button type="submit" class="job-chat-send">Enviar</button>
      </div>
      <p class="job-chat-composer__hint">Se verá como <strong><%= isObserver ? 'Socio' : 'Técnico' %></strong>. Cada mensaje muestra quién lo envió.</p>
    </form>
  </div>
</div>

<%- include('../partials/footer', { pageScript: '/js/tecnico-trabajo.js', extraScripts: ['/js/map.js'] }) %>
