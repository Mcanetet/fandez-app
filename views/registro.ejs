<%- include('partials/head', { useMap: typeof useMap !== 'undefined' ? useMap : false }) %>

<div class="min-h-screen flex items-center justify-center p-5 relative">
  <div class="auth-shell auth-shell--wide relative z-10">
    <%- include('partials/auth-topbar', { backHref: '/', backLabel: t('auth.back_home'), backShort: t('auth.back_home_short') }) %>

    <div class="zilo-card-premium rounded-2xl p-5 sm:p-8 zilo-page-enter">
    <a href="/" class="flex flex-col items-center mb-6" aria-label="<%= t('app.name') %>">
      <%- include('partials/logo', { className: 'w-14 h-14 mb-3', logoId: 'registro' }) %>
      <span class="fandez-wordmark text-2xl tracking-tight"><%= t('app.name') %></span>
    </a>

    <h1 id="registerTitle" class="zilo-display text-3xl text-center mb-1"
      data-client="<%= t('register.title') %>"
      data-provider="<%= t('register.title_provider') %>"><%= form.role === 'client' ? t('register.title') : t('register.title_provider') %></h1>
    <p id="registerSub" class="text-zilo-muted text-center text-sm mb-6"
      data-client="<%= t('register.subtitle_full') %>"
      data-provider="<%= t('register.subtitle_provider') %>"><%= form.role === 'client' ? t('register.subtitle_full') : t('register.subtitle_provider') %></p>

    <%- include('partials/site-alert', { alertCompact: true }) %>

    <% if (typeof referralCode !== 'undefined' && referralCode) { %>
      <div class="mb-4 p-3 rounded-xl border border-zilo-accent/25 bg-zilo-accent-soft text-center">
        <p class="text-sm text-zilo-accent-strong"><%- t('auth.referral_code', { code: referralCode }) %></p>
        <p class="text-xs text-zilo-muted mt-1"><%= t('register.referral_credit') %></p>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="mb-4 p-3 rounded-xl bg-zilo-danger/10 border border-zilo-danger/30 text-zilo-danger text-sm text-center">
        <p><%= error %></p>
        <% if (typeof emailExists !== 'undefined' && emailExists) { %>
          <p class="mt-2 text-zilo-text text-xs">
            <%= t('register.error_email_exists_hint') %>
            <a href="/login" class="text-zilo-accent font-semibold hover:underline"><%= t('auth.login_link') %></a>
          </p>
        <% } %>
      </div>
    <% } %>

    <form id="registrationForm" action="/registro" method="POST" class="space-y-4">
      <div>
        <span class="zilo-label block mb-1.5"><%= t('register.role_label') %></span>
        <div class="zilo-choice-grid" id="roleSelector">
          <label>
            <input type="radio" name="role" value="provider" class="peer sr-only" <%= form.role !== 'client' ? 'checked' : '' %>>
            <div class="zilo-choice-card zilo-choice-card--compact transition peer-checked:border-zilo-accent peer-checked:bg-zilo-accent-soft peer-checked:text-zilo-accent-strong">
              <span class="zilo-choice-title"><%= t('register.role_provider') %></span>
              <span class="zilo-choice-desc"><%= t('register.role_provider_desc') %></span>
            </div>
          </label>
          <label>
            <input type="radio" name="role" value="client" class="peer sr-only" <%= form.role === 'client' ? 'checked' : '' %>>
            <div class="zilo-choice-card zilo-choice-card--compact transition peer-checked:border-zilo-accent peer-checked:bg-zilo-accent-soft peer-checked:text-zilo-accent-strong">
              <span class="zilo-choice-title"><%= t('register.role_client') %></span>
              <span class="zilo-choice-desc"><%= t('register.role_client_desc') %></span>
            </div>
          </label>
        </div>
        <% if (typeof launchNoticeActive !== 'undefined' && launchNoticeActive) { %>
        <div id="clientLaunchBanner" class="launch-inline <%= form.role === 'client' ? '' : 'hidden' %>">
          <div class="launch-notice__steps launch-notice__steps--inline">
            <div class="launch-notice__step">
              <p class="launch-notice__step-label"><%= t('launch.client.sept_label') %></p>
              <p class="launch-notice__step-text"><%= t('launch.client.sept_text') %></p>
            </div>
            <div class="launch-notice__step launch-notice__step--next">
              <p class="launch-notice__step-label"><%= t('launch.client.oct_label') %></p>
              <p class="launch-notice__step-text"><%= t('launch.client.oct_text') %></p>
            </div>
          </div>
          <p class="launch-inline__note"><%= t('launch.client.note') %></p>
        </div>
        <% } %>
      </div>

      <div>
        <label for="name" id="nameLabel" class="zilo-label block mb-1.5"
          data-label-natural="<%= t('register.name') %>"
          data-label-company="<%= t('register.contact_name') %>"><%= t('register.name') %></label>
        <input type="text" id="name" name="name" required autocomplete="name"
          data-placeholder-natural="<%= t('register.name_placeholder') %>"
          data-placeholder-company="<%= t('register.contact_name_placeholder') %>"
          placeholder="<%= t('register.name_placeholder') %>" class="zilo-input" value="<%= form.name || '' %>">
      </div>
      <div>
        <label for="email" class="zilo-label block mb-1.5"><%= t('auth.email') %></label>
        <input type="email" id="email" name="email" required autocomplete="email" placeholder="<%= t('auth.email_placeholder') %>" class="zilo-input" value="<%= form.email || '' %>">
      </div>
      <div>
        <label for="phone" class="zilo-label block mb-1.5"><%= t('register.phone') %></label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+56 9 1234 5678" class="zilo-input" value="<%= form.phone || '' %>" <%= form.role !== 'client' ? 'required' : '' %>>
      </div>
      <div>
        <%- include('partials/password-field', {
          id: 'password',
          name: 'password',
          label: t('register.password'),
          hint: t('register.password_hint'),
          autocomplete: 'new-password',
          required: true,
          minlength: 10
        }) %>
      </div>

      <div id="clientBillingFields" class="space-y-3 p-4 rounded-xl border border-zilo-border bg-zilo-bg/30 <%= form.role === 'client' ? '' : 'hidden' %>">
        <div>
          <p class="text-xs font-semibold text-zilo-text"><%= t('register.client_billing_title') %></p>
          <p class="text-[11px] text-zilo-muted mt-1"><%= t('register.client_billing_hint') %></p>
        </div>
        <div class="zilo-choice-grid">
          <label>
            <input type="radio" name="client_billing_type" value="natural" class="peer sr-only" <%= (form.clientBillingType || 'natural') !== 'empresa' ? 'checked' : '' %>>
            <div class="zilo-choice-card zilo-choice-card--compact transition peer-checked:border-zilo-accent peer-checked:bg-zilo-accent-soft peer-checked:text-zilo-accent-strong">
              <span class="zilo-choice-title"><%= t('register.client_type_natural') %></span>
            </div>
          </label>
          <label>
            <input type="radio" name="client_billing_type" value="empresa" class="peer sr-only" <%= form.clientBillingType === 'empresa' ? 'checked' : '' %>>
            <div class="zilo-choice-card zilo-choice-card--compact transition peer-checked:border-zilo-accent peer-checked:bg-zilo-accent-soft peer-checked:text-zilo-accent-strong">
              <span class="zilo-choice-title"><%= t('register.client_type_company') %></span>
            </div>
          </label>
        </div>
        <div id="clientCompanyFields" class="space-y-3 hidden">
          <div>
            <label for="client_legal_name" class="zilo-label block mb-1.5"><%= t('register.client_company_name') %></label>
            <input type="text" id="client_legal_name" name="client_legal_name" placeholder="<%= t('register.client_company_name_placeholder') %>" class="zilo-input" value="<%= form.clientLegalName || '' %>">
          </div>
          <div>
            <label for="client_giro" class="zilo-label block mb-1.5"><%= t('register.client_giro') %></label>
            <input type="text" id="client_giro" name="client_giro" placeholder="<%= t('register.client_giro_placeholder') %>" class="zilo-input" value="<%= form.clientGiro || '' %>">
          </div>
        </div>
        <div>
          <label for="client_rut" class="zilo-label block mb-1.5"><%= t('register.client_rut') %></label>
          <input type="text" id="client_rut" name="client_rut" placeholder="12.345.678-9" class="zilo-input" value="<%= form.clientRut || '' %>" autocomplete="off">
          <p id="clientRutHint" class="text-[10px] text-zilo-muted mt-1"><%= t('register.client_rut_hint_optional') %></p>
        </div>
      </div>

      <div id="addressFields" class="space-y-3">
        <p class="zilo-label mb-0"><%= t('register.zone_title') %></p>
        <p class="text-[11px] text-zilo-muted" id="addressHint"><%= form.role === 'client' ? t('register.zone_hint_client') : t('register.zone_hint') %></p>
        <div>
          <label for="address_region" class="zilo-label block mb-1.5"><%= t('register.region') %></label>
          <select id="address_region" name="address_region" required class="zilo-input">
            <option value=""><%= t('register.region_placeholder') %></option>
            <% (registrationRegions || []).forEach(function(r) { %>
              <option value="<%= r.code %>" <%= (form.addressRegion || '') === r.code ? 'selected' : '' %>><%= r.name %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label for="address_commune" class="zilo-label block mb-1.5"><%= t('register.commune') %></label>
          <select id="address_commune" name="address_commune" required class="zilo-input"
            data-placeholder="<%= t('register.commune_placeholder') %>"
            data-region-first="<%= t('register.commune_region_first') %>"
            data-loading="<%= t('register.commune_loading') %>"
            <%= form.addressRegion ? '' : 'disabled' %>>
            <option value=""><%= form.addressRegion ? t('register.commune_placeholder') : t('register.commune_region_first') %></option>
            <% (registrationCommunes || []).forEach(function(c) { %>
              <option value="<%= c.code %>" <%= (form.addressCommune || '') === c.code ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="relative">
          <label for="address" id="addressLabel" class="zilo-label block mb-1.5"><%= t('register.address_street') %></label>
          <input type="text" id="address" name="address" required autocomplete="street-address"
            placeholder="<%= t('register.address_commune_first') %>" class="zilo-input address-autocomplete-input" value="<%= form.address || '' %>"
            aria-autocomplete="list" aria-controls="addressSuggestions" aria-expanded="false" disabled>
          <input type="hidden" id="address_lat" name="address_lat" value="<%= form.addressLat || '' %>">
          <input type="hidden" id="address_lng" name="address_lng" value="<%= form.addressLng || '' %>">
          <input type="hidden" id="address_place_id" name="address_place_id" value="<%= form.addressPlaceId || '' %>">
          <div id="addressSuggestions" class="hidden absolute left-0 right-0 top-full mt-1 z-30 rounded-xl border border-zilo-border bg-white shadow-zilo max-h-52 overflow-y-auto" role="listbox"></div>
        </div>
        <button type="button" id="addressConfirmManual" class="address-confirm-manual zilo-btn-ghost zilo-btn-block !py-2.5 text-sm" hidden>
          <%= t('register.address_confirm_manual') %>
        </button>
        <div>
          <label for="address_unit" id="addressUnitLabel" class="zilo-label block mb-1.5"><%= form.role === 'client' ? t('register.address_unit') : t('register.address_unit_optional') %></label>
          <input type="text" id="address_unit" name="address_unit" <%= form.role === 'client' ? 'required' : '' %> autocomplete="address-line2" placeholder="<%= t('register.address_unit_placeholder') %>" class="zilo-input" value="<%= form.addressUnit || '' %>">
        </div>
        <div id="addressCoverageAlert" class="hidden p-2.5 rounded-xl border border-amber-200 bg-amber-50 text-amber-800 text-xs"></div>
        <div id="registerAddressMap" class="fandez-map-panel h-44 sm:h-52 rounded-2xl border border-zilo-border overflow-hidden bg-zilo-bg shadow-zilo"></div>
        <div id="addressMapActions" class="hidden flex flex-wrap gap-2">
          <button type="button" id="addressUseGps" class="zilo-btn-ghost !py-2 !px-3 text-xs"><%= t('register.address_use_gps') %></button>
        </div>
        <p id="addressMapStatus" class="text-[11px] text-zilo-muted min-h-[1rem]"></p>
      </div>

      <div id="providerFields" class="space-y-4 <%= form.role === 'client' ? 'hidden' : '' %>">
        <div class="space-y-2">
          <span class="zilo-label block mb-1.5"><%= t('register.specialties') %></span>
          <p class="text-[11px] text-zilo-muted mb-1"><%= t('register.specialties_hint') %></p>
          <div class="specialty-pick-grid">
            <% services.forEach(function(s){ %>
              <label class="specialty-pick">
                <input type="checkbox" name="specialties" value="<%= s.id %>" class="rounded accent-zilo-accent shrink-0 mt-0.5 specialty-check" <%= (form.specialties || []).includes(s.id) ? 'checked' : '' %>>
                <%- include('partials/service-icon', { icon: s.icon, size: 'xs' }) %>
                <span class="specialty-pick-name"><%= s.name %></span>
              </label>
            <% }); %>
            <label class="specialty-pick specialty-pick--wide">
              <input type="checkbox" id="specialtyOtros" name="specialties" value="otros" class="rounded accent-zilo-accent shrink-0 mt-0.5 specialty-check" <%= (form.specialties || []).includes('otros') || form.otherServiceName ? 'checked' : '' %>>
              <span class="specialty-pick-name"><%= t('register.other_service') %></span>
            </label>
          </div>
          <div id="otherServiceFields" class="<%= (form.specialties || []).includes('otros') || form.otherServiceName ? '' : 'hidden' %> space-y-3 p-3 rounded-xl border border-zilo-accent/25 bg-zilo-accent-soft/40">
            <div>
              <label for="other_service_name" class="zilo-label block mb-1.5"><%= t('register.other_service_name') %></label>
              <input type="text" id="other_service_name" name="other_service_name" maxlength="120" class="zilo-input" placeholder="<%= t('register.other_service_name_ph') %>" value="<%= form.otherServiceName || '' %>">
            </div>
            <div>
              <label for="other_service_description" class="zilo-label block mb-1.5"><%= t('register.other_service_desc') %></label>
              <textarea id="other_service_description" name="other_service_description" rows="2" maxlength="1000" class="zilo-input" placeholder="<%= t('register.other_service_desc_ph') %>"><%= form.otherServiceDescription || '' %></textarea>
            </div>
          </div>
        </div>
        <p class="text-[11px] text-zilo-muted"><%= t('register.provider_hint') %></p>
      </div>

      <div class="space-y-2">
        <label class="flex items-start gap-2.5 text-xs text-zilo-muted cursor-pointer">
          <input type="checkbox" name="consent_legal" required class="mt-0.5 rounded accent-zilo-accent shrink-0">
          <span><%- t('consent.legal') %></span>
        </label>
        <label class="flex items-start gap-2.5 text-[11px] text-zilo-muted/80 cursor-pointer">
          <input type="checkbox" name="consent_marketing" class="mt-0.5 rounded accent-zilo-accent shrink-0">
          <span><%- t('consent.marketing') %></span>
        </label>
      </div>

      <button type="submit" class="zilo-btn-primary"><%= t('register.submit') %></button>
    </form>

    <p class="text-center text-sm text-zilo-muted mt-6">
      <%= t('register.has_account') %>
      <a href="/login" class="text-zilo-accent font-semibold hover:underline"><%= t('auth.login_link') %></a>
    </p>
    </div>
  </div>
</div>

<%- include('partials/launch-notice-modal', { launchNoticeMode: 'client' }) %>

<script>
  (function () {
    const form = document.getElementById('registrationForm');
    const providerFields = document.getElementById('providerFields');
    const roleInputs = document.querySelectorAll('input[name="role"]');
    const validationMessages = <%- JSON.stringify({
      required: t('register.validation_required'),
      email: t('register.validation_email'),
      password: t('register.validation_password')
    }) %>;

    function sync() {
      const role = document.querySelector('input[name="role"]:checked').value;
      const isProvider = role === 'provider';
      providerFields.classList.toggle('hidden', !isProvider);
      const clientBanner = document.getElementById('clientLaunchBanner');
      if (clientBanner) clientBanner.classList.toggle('hidden', isProvider);
      const title = document.getElementById('registerTitle');
      const sub = document.getElementById('registerSub');
      if (title) title.textContent = isProvider ? title.dataset.provider : title.dataset.client;
      if (sub) sub.textContent = isProvider ? sub.dataset.provider : sub.dataset.client;
      const phone = document.getElementById('phone');
      if (phone) phone.required = isProvider;
      const unit = document.getElementById('address_unit');
      const unitLabel = document.getElementById('addressUnitLabel');
      if (unit) unit.required = !isProvider;
      if (unitLabel) {
        unitLabel.textContent = isProvider
          ? <%- JSON.stringify(t('register.address_unit_optional')) %>
          : <%- JSON.stringify(t('register.address_unit')) %>;
      }
    }

    form.addEventListener('invalid', (event) => {
      const field = event.target;
      if (field.id === 'address' || field.id === 'client_rut' || field.id === 'client_legal_name' || field.id === 'client_giro') return;
      field.setCustomValidity('');
      if (field.validity.valueMissing) {
        field.setCustomValidity(validationMessages.required);
      } else if (field.type === 'email' && field.validity.typeMismatch) {
        field.setCustomValidity(validationMessages.email);
      } else if (field.name === 'password' && field.validity.tooShort) {
        field.setCustomValidity(validationMessages.password);
      }
    }, true);

    form.querySelectorAll('input').forEach((field) => {
      const clearValidation = () => field.setCustomValidity('');
      field.addEventListener('input', clearValidation);
      field.addEventListener('change', clearValidation);
    });

    roleInputs.forEach(r => r.addEventListener('change', () => {
      sync();
      const selected = document.querySelector('input[name="role"]:checked');
      if (selected && selected.value === 'client' && typeof window.FandezOpenClientLaunchNotice === 'function') {
        window.FandezOpenClientLaunchNotice();
      }
    }));
    sync();
    const initialRole = document.querySelector('input[name="role"]:checked');
    if (initialRole && initialRole.value === 'client' && typeof window.FandezOpenClientLaunchNotice === 'function') {
      window.FandezOpenClientLaunchNotice();
    }
  })();
</script>

