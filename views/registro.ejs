<%- include('partials/head', { useMap: typeof useMap !== 'undefined' ? useMap : false }) %>

<div class="register-page min-h-screen flex justify-center relative <%= form.role === 'client' ? 'register-page--client items-start' : 'items-center p-5' %>">
  <div class="auth-shell auth-shell--wide relative z-10">
    <%- include('partials/auth-topbar', { backHref: '/', backLabel: t('auth.back_home'), backShort: t('auth.back_home_short') }) %>

    <div class="register-sheet zilo-page-enter <%= form.role === 'client' ? 'register-sheet--client' : '' %>" id="registerSheet">
    <a href="/" class="register-sheet__brand" aria-label="<%= t('app.name') %>">
      <%- include('partials/logo', { className: 'register-sheet__logo', logoId: 'registro' }) %>
      <span class="fandez-wordmark register-sheet__wordmark"><%= t('app.name') %></span>
    </a>

    <h1 id="registerTitle" class="register-sheet__title"
      data-client="<%= t('register.title') %>"
      data-provider="<%= t('register.title_provider') %>"><%= form.role === 'client' ? t('register.title') : t('register.title_provider') %></h1>
    <p id="registerSub" class="register-sheet__sub"
      data-client="<%= t('register.subtitle_full') %>"
      data-provider="<%= t('register.subtitle_provider') %>"><%= form.role === 'client' ? t('register.subtitle_full') : t('register.subtitle_provider') %></p>

    <%- include('partials/site-alert', { alertCompact: true }) %>

    <% if (typeof referralCode !== 'undefined' && referralCode && typeof mod === 'function' && mod('client_referidos')) { %>
      <div class="mb-4 p-3 rounded-xl border border-zilo-accent/25 bg-zilo-accent-soft text-center">
        <p class="text-sm text-zilo-accent-strong"><%- t('auth.referral_code', { code: referralCode }) %></p>
        <p class="text-xs text-zilo-muted mt-1"><%= t('register.referral_credit') %></p>
      </div>
    <% } %>

    <div id="registerError" class="mb-4 p-3 rounded-xl bg-zilo-danger/10 border border-zilo-danger/30 text-zilo-danger text-sm text-center <%= error ? '' : 'hidden' %>" role="alert" tabindex="-1" <%= error ? '' : 'hidden' %>>
      <p id="registerErrorText"><%= error || '' %></p>
      <p id="registerErrorLoginHint" class="mt-2 text-zilo-text text-xs <%= (typeof emailExists !== 'undefined' && emailExists) ? '' : 'hidden' %>">
        <%= t('register.error_email_exists_hint') %>
        <a href="/login" class="text-zilo-accent font-semibold hover:underline"><%= t('auth.login_link') %></a>
      </p>
    </div>
    <% if (error) { %>
      <script>
        (function () {
          var el = document.getElementById('registerError');
          if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        })();
      </script>
    <% } %>

    <form id="registrationForm" action="/registro" method="POST" class="register-form <%= form.role === 'client' ? 'register-form--client' : '' %>">
      <div class="register-form__block">
        <span class="register-form__label"><%= t('register.role_label') %></span>
        <div class="register-role" id="roleSelector" role="group" aria-label="<%= t('register.role_label') %>">
          <label class="register-role__option">
            <input type="radio" name="role" value="client" class="sr-only" <%= form.role === 'client' ? 'checked' : '' %>>
            <span class="register-role__chip">
              <span class="register-role__name"><%= t('register.role_client') %></span>
              <span class="register-role__desc"><%= t('register.role_client_desc') %></span>
            </span>
          </label>
          <label class="register-role__option">
            <input type="radio" name="role" value="provider" class="sr-only" <%= form.role !== 'client' ? 'checked' : '' %>>
            <span class="register-role__chip">
              <span class="register-role__name"><%= t('register.role_provider') %></span>
              <span class="register-role__desc"><%= t('register.role_provider_desc') %></span>
            </span>
          </label>
        </div>
        <% if (typeof launchNoticeActive !== 'undefined' && launchNoticeActive) { %>
        <div id="clientLaunchBanner" class="launch-inline <%= form.role === 'client' ? '' : 'hidden' %>">
          <div class="launch-notice__steps launch-notice__steps--inline">
            <div class="launch-notice__step">
              <p class="launch-notice__step-label"><%= t('launch.client.sept_label') %></p>
              <p class="launch-notice__step-text"><%= t('launch.client.sept_text') %></p>
            </div>
            <div class="launch-notice__step launch-notice__step--next">
              <p class="launch-notice__step-label"><%= t('launch.client.oct_label') %></p>
              <p class="launch-notice__step-text"><%= t('launch.client.oct_text') %></p>
            </div>
          </div>
          <p class="launch-inline__note"><%= t('launch.client.note') %></p>
        </div>
        <% } %>
        <p id="clientRegisterGuide" class="register-soft-tip <%= form.role === 'client' ? '' : 'hidden' %>" role="note"><%= t('register.client_tip') %></p>
      </div>

      <div class="register-form__fields register-form__fields--account">
        <div>
          <label for="first_name" class="register-form__label"><%= t('register.first_name') %></label>
          <input type="text" id="first_name" name="first_name" required autocomplete="given-name"
            placeholder="<%= t('register.first_name_placeholder') %>" class="zilo-input" value="<%= form.firstName || '' %>">
        </div>
        <div>
          <label for="last_name" class="register-form__label"><%= t('register.last_name') %></label>
          <input type="text" id="last_name" name="last_name" required autocomplete="family-name"
            placeholder="<%= t('register.last_name_placeholder') %>" class="zilo-input" value="<%= form.lastName || '' %>">
        </div>
        <div>
          <label for="email" class="register-form__label"><%= t('auth.email') %></label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="<%= t('auth.email_placeholder') %>" class="zilo-input" value="<%= form.email || '' %>">
        </div>
        <div>
          <label for="phone" class="register-form__label"><%= t('register.phone') %></label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+56 9 1234 5678" class="zilo-input" value="<%= form.phone || '' %>">
        </div>
        <div>
          <%- include('partials/password-field', {
            id: 'password',
            name: 'password',
            label: t('register.password'),
            hint: form.role === 'client' ? '' : t('register.password_hint'),
            autocomplete: 'new-password',
            required: true,
            minlength: 8
          }) %>
        </div>
      </div>

      <div id="clientBillingWrap" class="register-form__section <%= form.role === 'client' ? '' : 'hidden' %>">
        <label class="register-empresa-toggle">
          <input type="checkbox" id="clientEmpresaToggle" <%= form.clientBillingType === 'empresa' ? 'checked' : '' %>>
          <span>
            <strong><%= t('register.client_billing_toggle') %></strong>
            <em><%= t('register.client_billing_toggle_hint') %></em>
          </span>
        </label>
        <input type="hidden" name="client_billing_type" id="clientBillingTypeHidden" value="<%= form.clientBillingType === 'empresa' ? 'empresa' : 'natural' %>">

        <div id="clientNaturalFields" class="register-form__fields register-form__fields--tight mt-3 <%= form.clientBillingType === 'empresa' ? 'hidden' : '' %>">
          <div>
            <label for="client_rut" id="clientRutLabel" class="register-form__label"
              data-label-natural="<%= t('register.client_rut_natural') %>"
              data-label-company="<%= t('register.client_rut_company') %>"><%= t('register.client_rut_natural') %> <span class="register-form__optional"><%= t('register.optional') %></span></label>
            <input type="text" id="client_rut" name="client_rut" placeholder="12.345.678-9" class="zilo-input" value="<%= form.clientRut || '' %>" autocomplete="off">
            <p id="clientRutHint" class="register-form__field-hint"><%= t('register.client_rut_hint_natural') %></p>
          </div>
        </div>

        <div id="clientBillingFields" class="register-form__billing <%= form.clientBillingType === 'empresa' ? '' : 'hidden' %>" <%= form.clientBillingType === 'empresa' ? '' : 'hidden' %>>
          <p class="register-form__section-title mt-3"><%= t('register.client_billing_title') %></p>
          <p class="register-form__section-hint"><%= t('register.client_billing_hint') %></p>
          <div class="register-form__fields register-form__fields--tight">
            <div>
              <label for="client_legal_name" class="register-form__label"><%= t('register.client_company_name') %></label>
              <input type="text" id="client_legal_name" name="client_legal_name" placeholder="<%= t('register.client_company_name_placeholder') %>" class="zilo-input" value="<%= form.clientLegalName || '' %>">
            </div>
            <div>
              <label for="client_giro" class="register-form__label"><%= t('register.client_giro') %></label>
              <input type="text" id="client_giro" name="client_giro" placeholder="<%= t('register.client_giro_placeholder') %>" class="zilo-input" value="<%= form.clientGiro || '' %>">
            </div>
            <div id="clientCompanyRutSlot"></div>
          </div>
        </div>
      </div>

      <div id="addressFields" class="register-form__section register-form__zone">
        <p class="register-form__section-title"><%= t('register.zone_title') %></p>
        <p class="register-form__section-hint" id="addressHint"><%= form.role === 'client' ? t('register.zone_hint_client') : t('register.zone_hint') %></p>
        <div class="register-form__fields register-form__fields--zone">
        <div class="register-zone__region">
          <label for="address_region" class="register-form__label"><%= t('register.region') %></label>
          <select id="address_region" name="address_region" required class="zilo-input">
            <option value=""><%= t('register.region_placeholder') %></option>
            <% (registrationRegions || []).forEach(function(r) {
              var selectedRegion = form.addressRegion || 'region-metropolitana';
            %>
              <option value="<%= r.code %>" <%= selectedRegion === r.code ? 'selected' : '' %>><%= r.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="register-zone__commune">
          <label for="address_commune_search" class="register-form__label"><%= t('register.commune') %></label>
          <div class="relative">
            <input type="text" id="address_commune_search" class="zilo-input address-autocomplete-input"
              autocomplete="address-level2" role="combobox" aria-autocomplete="list"
              aria-controls="communeSuggestions" aria-expanded="false"
              placeholder="<%= form.addressRegion ? t('register.commune_search_placeholder') : t('register.commune_region_first') %>"
              <%= form.addressRegion ? '' : 'disabled' %>
              value="<%= (function(){ var list = registrationCommunes || []; var code = form.addressCommune || ''; for (var i = 0; i < list.length; i++) { if (list[i].code === code) return list[i].name; } return ''; })() %>">
            <select id="address_commune" name="address_commune" class="sr-only"
              tabindex="-1" aria-hidden="true"
              data-placeholder="<%= t('register.commune_placeholder') %>"
              data-region-first="<%= t('register.commune_region_first') %>"
              data-loading="<%= t('register.commune_loading') %>"
              data-search-placeholder="<%= t('register.commune_search_placeholder') %>"
              data-no-results="<%= t('register.commune_no_results') %>"
              <%= form.addressRegion ? '' : 'disabled' %>>
              <option value=""><%= form.addressRegion ? t('register.commune_placeholder') : t('register.commune_region_first') %></option>
              <% (registrationCommunes || []).forEach(function(c) { %>
                <option value="<%= c.code %>" <%= (form.addressCommune || '') === c.code ? 'selected' : '' %>><%= c.name %></option>
              <% }); %>
            </select>
            <div id="communeSuggestions" class="hidden absolute left-0 right-0 top-full mt-1 z-30 rounded-xl border border-zilo-border bg-white shadow-zilo max-h-52 overflow-y-auto" role="listbox"></div>
          </div>
          <p class="register-form__field-hint register-commune-hint"><%= t('register.commune_hint') %></p>
          <p id="addressCommuneFieldAlert" class="register-commune-field-alert hidden" role="status" aria-live="polite"></p>
        </div>
        <div class="relative register-zone__street">
          <label for="address" id="addressLabel" class="register-form__label"><%= t('register.address_street') %></label>
          <input type="text" id="address" name="address" required autocomplete="street-address"
            placeholder="<%= t('register.address_commune_first') %>" class="zilo-input address-autocomplete-input" value="<%= form.address || '' %>"
            aria-autocomplete="list" aria-controls="addressSuggestions" aria-expanded="false" disabled>
          <input type="hidden" id="address_lat" name="address_lat" value="<%= form.addressLat || '' %>">
          <input type="hidden" id="address_lng" name="address_lng" value="<%= form.addressLng || '' %>">
          <input type="hidden" id="address_place_id" name="address_place_id" value="<%= form.addressPlaceId || '' %>">
          <div id="addressSuggestions" class="hidden absolute left-0 right-0 top-full mt-1 z-30 rounded-xl border border-zilo-border bg-white shadow-zilo max-h-52 overflow-y-auto" role="listbox"></div>
        </div>
        <div class="register-zone__unit">
          <label for="address_unit" id="addressUnitLabel" class="register-form__label"><%= t('register.address_unit') %></label>
          <input type="text" id="address_unit" name="address_unit" autocomplete="address-line2" placeholder="<%= t('register.address_unit_placeholder') %>" class="zilo-input" value="<%= form.addressUnit || '' %>">
        </div>
        </div>
        <button type="button" id="addressConfirmManual" class="address-confirm-manual zilo-btn-ghost zilo-btn-block !py-2 text-sm" hidden>
          <%= t('register.address_confirm_manual') %>
        </button>
        <div id="addressCoverageAlert" class="hidden p-2.5 rounded-xl border border-amber-200 bg-amber-50 text-amber-800 text-xs"></div>
        <div class="register-coverage-extra space-y-2">
          <button type="button" id="coverageInterestOpen" class="text-[12px] font-semibold text-zilo-accent hover:underline">
            <%= t('coverage.interest_open') %>
          </button>
          <div id="coverageInterestBlock" class="hidden space-y-3 p-3 rounded-xl border border-zilo-border bg-zilo-bg/60" data-open="0">
            <div>
              <p class="text-sm font-semibold text-zilo-text"><%= t('coverage.interest_title') %></p>
              <p class="text-[11px] text-zilo-muted mt-0.5"><%= t('coverage.interest_hint') %></p>
            </div>
            <div>
              <label for="coverage_interest_commune" class="zilo-label block mb-1.5"><%= t('coverage.interest_label') %></label>
              <input type="text" id="coverage_interest_commune" maxlength="160" autocomplete="address-level2" class="zilo-input" placeholder="<%= t('coverage.interest_placeholder') %>">
            </div>
            <div>
              <label for="coverage_interest_email" class="zilo-label block mb-1.5"><%= t('coverage.interest_email_label') %></label>
              <input type="email" id="coverage_interest_email" maxlength="190" autocomplete="email" class="zilo-input" placeholder="<%= t('coverage.interest_email_placeholder') %>">
            </div>
            <button type="button" id="coverageInterestSubmit" class="zilo-btn-primary !py-2.5 text-sm"><%= t('coverage.interest_submit') %></button>
            <p id="coverageInterestStatus" class="text-[11px] text-zilo-muted min-h-[1rem]" role="status"></p>
          </div>
        </div>
        <div id="registerAddressMap" class="fandez-map-panel register-map h-36 sm:h-44 rounded-2xl border border-zilo-border overflow-hidden bg-zilo-bg shadow-zilo"></div>
        <div id="addressMapActions" class="hidden flex flex-wrap gap-2">
          <button type="button" id="addressUseGps" class="zilo-btn-ghost !py-2 !px-3 text-xs"><%= t('register.address_use_gps') %></button>
        </div>
        <p id="addressMapStatus" class="text-[11px] text-zilo-muted min-h-[1rem]"></p>
      </div>

      <div id="providerFields" class="space-y-3 <%= form.role === 'client' ? 'hidden' : '' %>">
        <div class="space-y-2">
          <span class="zilo-label block"><%= t('register.specialties') %></span>
          <p class="text-[11px] text-zilo-muted"><%= t('register.specialties_hint') %></p>
          <div class="specialty-pick-grid">
            <% services.filter(function(s){ return s.id !== 'otros'; }).forEach(function(s){ %>
              <label class="specialty-pick">
                <input type="checkbox" name="specialties" value="<%= s.id %>" class="rounded accent-zilo-accent shrink-0 mt-0.5 specialty-check" <%= (form.specialties || []).includes(s.id) ? 'checked' : '' %>>
                <%- include('partials/service-icon', { icon: s.icon, size: 'xs' }) %>
                <span class="specialty-pick-name"><%= s.name %></span>
              </label>
            <% }); %>
            <label class="specialty-pick specialty-pick--other">
              <input type="checkbox" id="specialtyOtros" name="specialties" value="otros" class="rounded accent-zilo-accent shrink-0 specialty-check" <%= (form.specialties || []).includes('otros') || form.otherServiceName ? 'checked' : '' %>>
              <span class="specialty-pick-name"><%= t('register.other_service') %></span>
            </label>
          </div>
          <div id="otherServiceFields" class="<%= (form.specialties || []).includes('otros') || form.otherServiceName ? '' : 'hidden' %>">
            <input type="text" id="other_service_name" name="other_service_name" maxlength="120" class="zilo-input" placeholder="<%= t('register.other_service_name_ph') %>" value="<%= form.otherServiceName || '' %>" aria-label="<%= t('register.other_service_name') %>">
            <input type="hidden" id="other_service_description" name="other_service_description" value="<%= form.otherServiceDescription || form.otherServiceName || '' %>">
          </div>
        </div>
        <p class="text-[11px] text-zilo-muted"><%= t('register.provider_hint') %></p>
      </div>

      <div class="space-y-2">
        <label class="flex items-start gap-2.5 text-xs text-zilo-muted cursor-pointer">
          <input type="checkbox" name="consent_legal" required class="mt-0.5 rounded accent-zilo-accent shrink-0">
          <span><%- t('consent.legal') %></span>
        </label>
        <label class="flex items-start gap-2.5 text-[11px] text-zilo-muted/80 cursor-pointer">
          <input type="checkbox" name="consent_marketing" class="mt-0.5 rounded accent-zilo-accent shrink-0">
          <span><%- t('consent.marketing') %></span>
        </label>
      </div>

      <button type="submit" class="zilo-btn-primary"><%= t('register.submit') %></button>
    </form>

    <div class="register-fun" id="registerFun" aria-live="polite">
      <p class="register-fun__kicker"><%= t('register.fun_kicker') %></p>
      <p class="register-fun__line" id="registerFunLine"><%= (registerFunLines && registerFunLines[0]) || t('register.fun_1') %></p>
      <div class="register-fun__dots" id="registerFunDots" aria-hidden="true"></div>
    </div>

    <p class="text-center text-sm text-zilo-muted mt-6">
      <%= t('register.has_account') %>
      <a href="/login" class="text-zilo-accent font-semibold hover:underline"><%= t('auth.login_link') %></a>
    </p>
    </div>
  </div>
</div>


<script>
  (function () {
    var lines = <%- JSON.stringify(registerFunLines && registerFunLines.length ? registerFunLines : [
      t('register.fun_1'),
      t('register.fun_2'),
      t('register.fun_3'),
      t('register.fun_4'),
      t('register.fun_5'),
      t('register.fun_6'),
      t('register.fun_7'),
      t('register.fun_8'),
      t('register.fun_9'),
      t('register.fun_10')
    ]) %>;
    var lineEl = document.getElementById('registerFunLine');
    var dotsEl = document.getElementById('registerFunDots');
    if (!lineEl || !lines.length) return;
    var i = 0;
    var showDots = lines.length <= 12;
    if (dotsEl) {
      if (showDots) {
        dotsEl.innerHTML = lines.map(function (_, idx) {
          return '<span class="register-fun__dot' + (idx === 0 ? ' is-active' : '') + '"></span>';
        }).join('');
      } else {
        dotsEl.innerHTML = '<span class="register-fun__dot is-active register-fun__dot--pulse"></span>';
      }
    }
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    function paint() {
      lineEl.classList.add('is-leaving');
      setTimeout(function () {
        lineEl.textContent = lines[i];
        lineEl.classList.remove('is-leaving');
        if (dotsEl && showDots) {
          Array.prototype.forEach.call(dotsEl.children, function (dot, idx) {
            dot.classList.toggle('is-active', idx === i);
          });
        }
      }, 220);
    }
    setInterval(function () {
      i = (i + 1) % lines.length;
      paint();
    }, 4200);
  })();
</script>

<%- include('partials/launch-notice-modal', { launchNoticeMode: 'client' }) %>

<script>
  (function () {
    const form = document.getElementById('registrationForm');
    const providerFields = document.getElementById('providerFields');
    const roleInputs = document.querySelectorAll('input[name="role"]');
    const validationMessages = <%- JSON.stringify({
      required: t('register.validation_required'),
      email: t('register.validation_email'),
      password: t('register.validation_password')
    }) %>;

    function sync() {
      const role = document.querySelector('input[name="role"]:checked').value;
      const isProvider = role === 'provider';
      const isClient = !isProvider;
      const page = document.querySelector('.register-page');
      const sheet = document.getElementById('registerSheet');
      if (page) {
        page.classList.toggle('register-page--client', isClient);
        page.classList.toggle('items-start', isClient);
        page.classList.toggle('items-center', isProvider);
        page.classList.toggle('p-5', isProvider);
      }
      if (sheet) sheet.classList.toggle('register-sheet--client', isClient);
      form.classList.toggle('register-form--client', isClient);
      providerFields.classList.toggle('hidden', !isProvider);
      const clientBanner = document.getElementById('clientLaunchBanner');
      if (clientBanner) clientBanner.classList.toggle('hidden', isProvider);
      const clientGuide = document.getElementById('clientRegisterGuide');
      if (clientGuide) clientGuide.classList.toggle('hidden', isProvider);
      const clientBillingWrap = document.getElementById('clientBillingWrap');
      if (clientBillingWrap) clientBillingWrap.classList.toggle('hidden', isProvider);
      const title = document.getElementById('registerTitle');
      const sub = document.getElementById('registerSub');
      if (title) title.textContent = isProvider ? title.dataset.provider : title.dataset.client;
      if (sub) sub.textContent = isProvider ? sub.dataset.provider : sub.dataset.client;
      const phone = document.getElementById('phone');
      if (phone) phone.required = true;
      const address = document.getElementById('address');
      const region = document.getElementById('address_region');
      if (address) address.required = true;
      if (region) region.required = true;
      const unit = document.getElementById('address_unit');
      const unitLabel = document.getElementById('addressUnitLabel');
      if (unit) unit.required = false;
      if (unitLabel) {
        unitLabel.textContent = <%- JSON.stringify(t('register.address_unit')) %>;
      }
    }

    form.addEventListener('invalid', (event) => {
      const field = event.target;
      if (field.id === 'address' || field.id === 'client_rut' || field.id === 'client_legal_name' || field.id === 'client_giro') return;
      field.setCustomValidity('');
      if (field.validity.valueMissing) {
        field.setCustomValidity(validationMessages.required);
      } else if (field.type === 'email' && field.validity.typeMismatch) {
        field.setCustomValidity(validationMessages.email);
      } else if (field.name === 'password' && field.validity.tooShort) {
        field.setCustomValidity(validationMessages.password);
      }
    }, true);

    form.querySelectorAll('input').forEach((field) => {
      const clearValidation = () => field.setCustomValidity('');
      field.addEventListener('input', clearValidation);
      field.addEventListener('change', clearValidation);
    });

    roleInputs.forEach(r => r.addEventListener('change', () => {
      sync();
      const selected = document.querySelector('input[name="role"]:checked');
      if (selected && selected.value === 'client' && typeof window.FandezOpenClientLaunchNotice === 'function') {
        window.FandezOpenClientLaunchNotice();
      }
    }));
    sync();
    const initialRole = document.querySelector('input[name="role"]:checked');
    if (initialRole && initialRole.value === 'client' && typeof window.FandezOpenClientLaunchNotice === 'function') {
      window.FandezOpenClientLaunchNotice();
    }
  })();
</script>

