<%- include('../partials/head', { useMap: true }) %>

<div class="max-w-lg mx-auto min-h-screen flex flex-col zilo-page-enter" id="guardianPage" data-token="<%= request.guardianToken %>" data-request-id="<%= request.id %>">
  <header class="px-5 py-6 border-b border-zilo-border">
    <div class="flex items-center gap-3 mb-3">
      <%- include('../partials/logo', { className: 'w-9 h-9' }) %>
      <div>
        <p class="zilo-label !text-[9px]">Modo Guardián</p>
        <h1 class="text-sm font-semibold">Seguimiento en vivo</h1>
      </div>
    </div>
    <p class="text-xs text-zilo-muted">Enlace privado · sin cuenta requerida</p>
  </header>

  <main class="flex-1 px-5 py-5 space-y-4">
    <div class="zilo-card-premium rounded-2xl p-5">
      <p class="zilo-label mb-2">Servicio</p>
      <h2 class="zilo-display text-2xl mb-1" id="gService"><%= request.serviceName %></h2>
      <% if (request.isGift) { %>
        <p class="text-sm text-zilo-accent mb-2">Regalo para <strong><%= request.beneficiaryName %></strong></p>
        <% if (request.giftMessage) { %><p class="text-xs text-zilo-muted italic">"<%= request.giftMessage %>"</p><% } %>
      <% } %>
      <p class="text-xs text-zilo-muted mt-3" id="gAddress"><%= request.address %></p>
    </div>

    <div class="zilo-card-premium rounded-2xl p-5 flex items-center gap-4">
      <div id="gStatusDot" class="w-3 h-3 rounded-full bg-zilo-accent animate-pulse shrink-0"></div>
      <div>
        <p class="zilo-label">Estado</p>
        <p class="font-semibold" id="gStatus"><%= request.statusLabel || request.techStatus || request.status %></p>
      </div>
    </div>

    <div id="gProvider" class="zilo-card-premium rounded-2xl p-5 <%= provider ? '' : 'hidden' %>">
      <p class="zilo-label mb-2">Técnico / socio</p>
      <p class="font-semibold" id="gProviderName"><%= provider ? provider.name : '' %></p>
      <p class="text-xs text-zilo-muted" id="gProviderRating"><%= provider ? provider.rating + '★' : '' %></p>
    </div>

    <div id="gEta" class="hidden live-track-eta !relative !left-auto !right-auto !top-auto !shadow-none border border-zilo-border">
      <div class="live-track-eta__time"><span id="gEtaMin">—</span><small>min</small></div>
      <div class="live-track-eta__copy">
        <strong>Llega en aprox.</strong>
        <span id="gEtaKm"></span>
      </div>
    </div>

    <% if (request.coords) { %>
    <div class="live-track-shell">
      <div id="guardianMap" class="w-full"
        data-lat="<%= request.coords.lat %>" data-lng="<%= request.coords.lng %>" data-label="<%= request.address %>"></div>
    </div>
    <% } %>

    <p class="text-center text-[10px] text-zilo-muted pt-4">
      Fandez — Pasaporte Hogar & Modo Guardián · Santiago, Chile
    </p>
  </main>
</div>

<script src="/js/map.js"></script>
<script>
(function () {
  const page = document.getElementById('guardianPage');
  const token = page.dataset.token;
  const requestId = page.dataset.requestId;
  const socket = io();
  let mapEl = null;

  document.addEventListener('DOMContentLoaded', () => {
    mapEl = document.getElementById('guardianMap');
    if (mapEl && typeof FandezMap !== 'undefined') {
      FandezMap.initTracking(mapEl, {
        destLat: mapEl.dataset.lat,
        destLng: mapEl.dataset.lng,
        destLabel: mapEl.dataset.label
      });
    }
    socket.emit('register_client', { requestId, guardianToken: token });
    socket.on('connect', () => {
      socket.emit('register_client', { requestId, guardianToken: token });
    });
  });

  socket.on(`provider_location_${requestId}`, (loc) => {
    if (mapEl && typeof FandezMap !== 'undefined') {
      FandezMap.updateProviderLocation(mapEl.id, loc.lat, loc.lng, parseFloat(mapEl.dataset.lat), parseFloat(mapEl.dataset.lng));
    }
    if (loc.etaMinutes != null) {
      const box = document.getElementById('gEta');
      box.classList.remove('hidden');
      document.getElementById('gEtaMin').textContent = loc.etaMinutes;
      document.getElementById('gEtaKm').textContent = loc.distanceKm != null ? `· ${loc.distanceKm} km` : '';
    }
  });

  const statusLabels = {
    pending_payment: 'Pendiente de pago',
    searching: 'Buscando técnico',
    scheduled: 'Visita programada',
    assigned: 'Técnico asignado',
    asignado: 'Técnico asignado',
    aceptado: 'Técnico aceptó el trabajo',
    en_camino: 'En camino',
    en_sitio: 'En el domicilio',
    arrived: 'En el domicilio',
    in_progress: 'Trabajando',
    completed: 'Completado',
    diagnostico: 'Diagnóstico en sitio',
    reparando: 'Reparando',
    comprando: 'Comprando materiales',
    presupuesto_pendiente: 'Presupuesto pendiente',
    presupuesto_aprobado: 'Presupuesto aprobado'
  };

  function techStatusLabel(request) {
    if (request.awaitingProviderReassign && !request.technicianId) {
      return 'El socio está asignando otro técnico';
    }
    if (request.techStatus === 'asignado') return 'Esperando que el técnico acepte';
    if (request.techStatus && statusLabels[request.techStatus]) return statusLabels[request.techStatus];
    return statusLabels[request.status] || request.status;
  }

  function updateUI(data) {
    const r = data.request;
    if (!r) return;
    document.getElementById('gStatus').textContent = techStatusLabel(r);
    if (data.provider) {
      document.getElementById('gProvider').classList.remove('hidden');
      document.getElementById('gProviderName').textContent = data.provider.name;
      document.getElementById('gProviderRating').textContent = data.provider.rating + '★';
    }
    if (data.location?.lat != null && mapEl && typeof FandezMap !== 'undefined') {
      FandezMap.updateProviderLocation(mapEl.id, data.location.lat, data.location.lng, parseFloat(mapEl.dataset.lat), parseFloat(mapEl.dataset.lng));
    }
    if (r.status === 'completed' || r.techStatus === 'completado') {
      document.getElementById('gStatusDot').className = 'w-3 h-3 rounded-full bg-zilo-success shrink-0';
    } else if (r.techStatus === 'en_camino') {
      document.getElementById('gStatusDot').className = 'w-3 h-3 rounded-full bg-zilo-accent animate-pulse shrink-0';
    }
  }

  setInterval(async () => {
    try {
      const res = await fetch(`/seguimiento/${token}/estado`);
      const data = await res.json();
      updateUI(data);
    } catch (_) {}
  }, 4000);

  socket.on(`request_update_${requestId}`, (payload) => updateUI(payload));
})();
</script>

<%- include('../partials/footer') %>
