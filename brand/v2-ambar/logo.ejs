<% const uid = typeof logoId !== 'undefined' ? logoId : 'z' + Math.random().toString(36).slice(2, 8); %>
<% const size = typeof className !== 'undefined' ? className : 'w-8 h-8'; %>

<svg class="<%= size %>" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Fundez — servicios del hogar">
  <rect x="1" y="1" width="46" height="46" rx="12" fill="#C45C14"/>
  <rect x="1" y="1" width="46" height="46" rx="12" fill="url(#zs-<%= uid %>)"/>

  <defs>
    <linearGradient id="zs-<%= uid %>" x1="24" y1="4" x2="24" y2="44" gradientUnits="userSpaceOnUse">
      <stop stop-color="#FFFFFF" stop-opacity="0.12"/>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <!-- Ventosa (sin mango) — contorno blanco -->
  <g transform="translate(24, 24) scale(0.28) translate(-60, -71)">
    <path
      fill="none"
      stroke="#FFFFFF"
      stroke-width="14"
      stroke-linejoin="round"
      stroke-linecap="round"
      d="
        M60 22
        C78 22 92 34 94 50
        C95 58 92 66 84 70
        C98 74 108 84 108 96
        C108 112 86 122 60 122
        C34 122 12 112 12 96
        C12 84 22 74 36 70
        C28 66 25 58 26 50
        C28 34 42 22 60 22
        Z
      "
    />
  </g>
</svg>
